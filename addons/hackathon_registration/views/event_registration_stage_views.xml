<odoo>
    <data>

        <record id="view_event_registration_stage_tree" model="ir.ui.view">
            <field name="name">event.registration.stage.tree</field>
            <field name="model">event.registration.stage</field>
            <field name="arch" type="xml">
                <list string="Event Registration Stages">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_event_registration_stage_form" model="ir.ui.view">
            <field name="name">event.registration.stage.form</field>
            <field name="model">event.registration.stage</field>
            <field name="arch" type="xml">
                <form string="Event Registration Stage">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_event_registration_stage" model="ir.actions.act_window">
            <field name="name">Registration Stages</field>
            <field name="res_model">event.registration.stage</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new registration stage
                </p>
            </field>
        </record>

        <menuitem
            id="menu_event_registration_stage"
            name="Attendee Stages"
            parent="event.menu_event_configuration"
            action="action_event_registration_stage"
            sequence="5"
        />

    </data>
</odoo>
