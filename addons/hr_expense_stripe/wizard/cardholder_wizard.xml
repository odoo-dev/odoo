<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hr_expense_stripe_cardholder_wizard_form" model="ir.ui.view">
            <field name="name">hr.expense.stripe.cardholder.wizard.form</field>
            <field name="model">hr.expense.stripe.cardholder.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="employee_stripe_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="firstname" required="1"/>
                            <field name="lastname" required="1"/>
                            <field name="birthday" required="1"/>
                        </group>
                        <group>
                            <field name="phone_number" required="1"/>
                            <field name="email" required="1"/>
                            <field name="billing_address_line1" required="1"/>
                            <field name="billing_address_line2" />
                            <field name="billing_address_city" required="1"/>
                            <field name="billing_address_state" required="company_country_id.code == 'US'"/>
                            <field name="billing_address_postal_code" required="1"/>
                            <field name="billing_address_country" required="1"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_save_cardholder" class="btn btn-primary" type="object">Save</button>
                        <button string="Cancel" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
