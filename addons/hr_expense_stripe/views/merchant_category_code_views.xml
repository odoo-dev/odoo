<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>

        <record id="merchant_category_code_tree_view" model="ir.ui.view">
            <field name="name">merchant.category.code.tree</field>
            <field name="model">merchant.category.code</field>
            <field name="arch" type="xml">
                <list string="Merchant Category Codes">
                    <field name="name"/>
                    <field name="code_min"/>
                    <field name="code_max"/>
                </list>
            </field>
        </record>

        <record id="merchant_category_code_form_view" model="ir.ui.view">
            <field name="name">merchant.category.code.form</field>
            <field name="model">merchant.category.code</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code_min"/>
                            <field name="code_max"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="merchant_category_code_action_window">
            <field name="name">Merchant Category Codes</field>
            <field name="res_model">merchant.category.code</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            name="Merchant Category Codes"
            id="merchant_category_code_menu"
            parent="hr_expense.menu_hr_expense_configuration"
            action="merchant_category_code_action_window"
            groups="hr_expense.group_hr_expense_manager"
        />

    </data>
</odoo>
