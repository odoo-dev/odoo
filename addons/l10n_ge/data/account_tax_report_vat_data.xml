<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="account_report_ge_vat" model="account.report">
        <field name="name">Tax Report</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.ge"/>
        <field name="allow_foreign_vat" eval="True"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="account_report_ge_vat_col_base" model="account.report.column">
                <field name="name">Base</field>
                <field name="expression_label">base</field>
            </record>
            <record id="account_report_ge_vat_col_tax" model="account.report.column">
                <field name="name">Tax</field>
                <field name="expression_label">tax</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_report_ge_vat_part1" model="account.report.line">
                <field name="name">Part I</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="account_report_ge_vat_part1_output" model="account.report.line">
                        <field name="name">Output (taxable supplies)</field>
                        <field name="hierarchy_level">1</field>
                        <field name="children_ids">
                            <record id="account_report_ge_vat_line1" model="account.report.line">
                                <field name="name">1. Standard supply for consideration (18%)</field>
                                <field name="code">ge_1</field>
                                <field name="expression_ids">
                                    <record id="account_report_ge_vat_line1_base" model="account.report.expression">
                                        <field name="label">base</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-1(B)</field>
                                    </record>
                                    <record id="account_report_ge_vat_line1_tax" model="account.report.expression">
                                        <field name="label">tax</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-1(T)</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_part1_exempt" model="account.report.line">
                        <field name="name">Exempt / zero-rated supplies</field>
                        <field name="hierarchy_level">1</field>
                        <field name="children_ids">
                            <record id="account_report_ge_vat_line2" model="account.report.line">
                                <field name="name">2. Exempt with right to deduct</field>
                                <field name="code">ge_2</field>
                                <field name="expression_ids">
                                    <record id="account_report_ge_vat_line2_base" model="account.report.expression">
                                        <field name="label">base</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-2(B)</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_report_ge_vat_line3" model="account.report.line">
                                <field name="name">3. Exempt without right to deduct</field>
                                <field name="code">ge_3</field>
                                <field name="expression_ids">
                                    <record id="account_report_ge_vat_line3_base" model="account.report.expression">
                                        <field name="label">base</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-3(B)</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_report_ge_vat_line4" model="account.report.line">
                                <field name="name">4. Export / re-export (customs value)</field>
                                <field name="code">ge_4</field>
                                <field name="expression_ids">
                                    <record id="account_report_ge_vat_line4_base" model="account.report.expression">
                                        <field name="label">base</field>
                                        <field name="engine">tax_tags</field>
                                        <field name="formula">-4(B)</field>
                                    </record>
                                </field>
                            </record>
                            <record id="account_report_ge_vat_line5_total_sales" model="account.report.line">
                                <field name="name">5. Total sales VAT</field>
                                <field name="hierarchy_level">2</field>
                                <field name="code">ge_5</field>
                                <field name="expression_ids">
                                    <record id="account_report_ge_vat_line5_total_sales_base" model="account.report.expression">
                                        <field name="label">base</field>
                                        <field name="engine">aggregation</field>
                                        <field name="formula">ge_1.base + ge_2.base + ge_3.base + ge_4.base</field>
                                    </record>
                                    <record id="account_report_ge_vat_line5_total_sales_tax" model="account.report.expression">
                                        <field name="label">tax</field>
                                        <field name="engine">aggregation</field>
                                        <field name="formula">ge_1.tax</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_report_ge_vat_part2" model="account.report.line">
                <field name="name">Part II: Reverse charge VAT (output)</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="account_report_ge_vat_line6_rcvat_ser" model="account.report.line">
                        <field name="name">6. Services from non-resident (no PE)</field>
                        <field name="code">ge_6</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line6_rcvat_ser_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">6(B)</field>
                            </record>
                            <record id="account_report_ge_vat_line6_rcvat_ser_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-6(T)</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line7_rcvat_goods" model="account.report.line">
                        <field name="name">7. FIZ goods / customs warehouse (Art. 164)</field>
                        <field name="code">ge_7</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line7_rcvat_goods_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">7(B)</field>
                            </record>
                            <record id="account_report_ge_vat_line7_rcvat_goods_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-7(T)</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line8_total_rcvat" model="account.report.line">
                        <field name="name">8. Total RC VAT charged</field>
                        <field name="hierarchy_level">2</field>
                        <field name="code">ge_8</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line8_total_rcvat_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_6.base + ge_7.base</field>
                            </record>
                            <record id="account_report_ge_vat_line8_total_rcvat_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_6.tax + ge_7.tax</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_report_ge_vat_part3" model="account.report.line">
                <field name="name">Part III: Deductible (input) VAT</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                     <record id="account_report_ge_vat_line9_purchase_vat" model="account.report.line">
                        <field name="name">9. Purchases from Georgian VAT-registered suppliers</field>
                        <field name="code">ge_9</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line9_purchase_vat_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">9(B)</field>
                            </record>
                            <record id="account_report_ge_vat_line9_purchase_vat_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">9(T)</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line10_purchase_nonvat" model="account.report.line">
                        <field name="name">10. Purchases from Georgian non-VAT-registered suppliers</field>
                        <field name="code">ge_10</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line10_purchase_nonvat_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">10(B)</field>
                            </record>
                            <record id="account_report_ge_vat_line10_purchase_nonvat_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">10(T)</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line11_import_vat" model="account.report.line">
                        <field name="name">11. Import VAT</field>
                        <field name="code">ge_11</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line11_import_vat_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">11(B)</field>
                            </record>
                            <record id="account_report_ge_vat_line11_import_vat_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">11(T)</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line12_rcvat_input" model="account.report.line">
                        <field name="name">12. Deductible reverse charge VAT</field>
                        <field name="code">ge_12</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line12_rcvat_input_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">12(B)</field>
                            </record>
                            <record id="account_report_ge_vat_line12_rcvat_input_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">12(T)</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line13_total_input" model="account.report.line">
                        <field name="name">13. Total deductible VAT</field>
                        <field name="hierarchy_level">2</field>
                        <field name="code">ge_13</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line13_total_input_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_9.base + ge_10.base + ge_11.base</field>
                            </record>
                            <record id="account_report_ge_vat_line13_total_input_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_9.tax + ge_10.tax + ge_11.tax</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="account_report_ge_vat_part_net" model="account.report.line">
                <field name="name">Net VAT calculation</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="account_report_ge_vat_line14_total_output" model="account.report.line">
                        <field name="name">14. Total output VAT</field>
                        <field name="hierarchy_level">2</field>
                        <field name="code">ge_14</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line14_total_output_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_5.base + ge_8.base</field>
                            </record>
                            <record id="account_report_ge_vat_line14_total_output_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_5.tax + ge_8.tax</field>
                            </record>
                        </field>
                    </record>
                    <record id="account_report_ge_vat_line15_net_payable" model="account.report.line">
                        <field name="name">15. Net VAT payable to budget</field>
                        <field name="hierarchy_level">2</field>
                        <field name="code">ge_vat_l15</field>
                        <field name="expression_ids">
                            <record id="account_report_ge_vat_line15_net_payable_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_13.base - ge_12.base</field>
                            </record>
                            <record id="account_report_ge_vat_line15_net_payable_tax" model="account.report.expression">
                                <field name="label">tax</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">ge_13.tax - ge_12.tax</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
