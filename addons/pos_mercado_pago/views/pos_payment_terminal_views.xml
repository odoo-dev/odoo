<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_terminal_view_list" model="ir.ui.view">
        <field name="name">pos.payment.terminal.list.inherit.pos_mercado_pago</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="mp_id_point_smart" column_invisible="parent.payment_provider != 'mercado_pago'" placeholder="1494126963" required="parent.payment_provider == 'mercado_pago'"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_terminal_view_form" model="ir.ui.view">
        <field name="name">pos.payment.terminal.form.inherit.pos_mercado_pago</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_form"/>
        <field name="arch" type="xml">
            <group name="settings" position="after">
                <group name="mercado_pago_settings" invisible="payment_provider != 'mercado_pago'">
                    <field name="mp_id_point_smart" placeholder="1494126963" required="payment_provider == 'mercado_pago'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
