<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_mercado_pago" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.mercado_pago</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <page name="terminals" position="attributes">
                <attribute name="invisible" add="payment_provider == 'mercado_pago'" separator=" or "/>
            </page>
            <page name="terminals" position="before">
                <page name="mercado_pago_settings" string="Mercado Pago" invisible="payment_provider != 'mercado_pago'">
                    <separator string="Credentials" style="margin-top: 0.5rem !important;"/>
                    <group>
                        <field name="mp_bearer_token" placeholder="APP_USR-..." invisible="payment_provider != 'mercado_pago'" required="payment_provider == 'mercado_pago'"/>
                        <field name="mp_webhook_secret_key" placeholder="c2f3662..." invisible="payment_provider != 'mercado_pago'" required="payment_provider == 'mercado_pago'"/>
                        <field name="mp_webhook_endpoint" string="Webhook Endpoint" invisible="payment_provider != 'mercado_pago' or not id" required="payment_provider == 'mercado_pago'" widget="CopyClipboardChar"/>
                        <button string="Force PDV" type="object" name="force_pdv" groups="base.group_no_one" class="oe_highlight" invisible="payment_provider != 'mercado_pago'" required="payment_provider == 'mercado_pago'"/>
                    </group>
                    <separator string="Terminals"/>
                    <field name="terminal_ids" widget="pos_payment_terminals"/>
                </page>
            </page>
        </field>
    </record>
</odoo>
