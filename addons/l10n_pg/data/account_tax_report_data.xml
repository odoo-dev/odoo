<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="tax_report_gst" model="account.report">
        <field name="name">GST Tax Return</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.pg"/>
        <field name="column_ids">
            <record id="tax_report_gst_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="tax_report_gst_line_block_1" model="account.report.line">
                <field name="name">Block 1: Calculation of Output Debits</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="tax_report_gst_line_1" model="account.report.line">
                        <field name="name">1. Total Sales</field>
                        <field name="code">G1_10</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_1_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-10</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_2" model="account.report.line">
                        <field name="name">2. Less Exempt Sales</field>
                        <field name="code">G1_20</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_2_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-20</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_3" model="account.report.line">
                        <field name="name">3. Zero Rated Sales</field>
                        <field name="code">G1_30</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_3_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-30</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_4" model="account.report.line">
                        <field name="name">4. Add lines 2 and 3</field>
                        <field name="code">G1_40</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_4_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_20.balance + G1_30.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_5" model="account.report.line">
                        <field name="name">5. Total GST Taxable Sales - Deduct the total in line 4 from line 1</field>
                        <field name="code">G1_50</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_5_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_10.balance - G1_40.balance</field>
                            </record>
                            <!-- Not displayed: same amount as line 5, read per province by the Sales by Province report. -->
                            <record id="tax_report_gst_line_5_tag" model="account.report.expression">
                                <field name="label">taxable_sales</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-50</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_6" model="account.report.line">
                        <field name="name">6. Output Debits - Divide Taxable Sales (line 5) by Eleven</field>
                        <field name="code">G1_60</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_6_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-60</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_7" model="account.report.line">
                        <field name="name">7. Deferred Import Liabilities</field>
                        <field name="code">G1_70</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_7_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-70</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gst_line_block_2" model="account.report.line">
                <field name="name">Block 2: Calculation of Input Credits</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="tax_report_gst_line_8" model="account.report.line">
                        <field name="name">8. GST paid on business inputs bought during the Tax Period</field>
                        <field name="code">G1_80</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_8_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">80</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_9" model="account.report.line">
                        <field name="name">9. Less GST paid exempt sales</field>
                        <field name="code">G1_90</field>
                        <field name="foldability">foldable</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_9_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_NOTE5_5.balance</field>
                            </record>
                        </field>
                        <field name="children_ids">
                            <record id="tax_report_gst_line_note_5" model="account.report.line">
                                <field name="name">Note 5: Calculation of GST paid for Exempt Sales</field>
                                <field name="children_ids">
                                    <record id="tax_report_gst_line_note_5_1" model="account.report.line">
                                        <field name="name">1. GST paid on inputs used for both exempt and taxable sales</field>
                                        <field name="code">G1_NOTE5_1</field>
                                        <field name="expression_ids">
                                            <record id="tax_report_gst_line_note_5_1_external" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">external</field>
                                                <field name="formula">sum</field>
                                                <field name="subformula">editable;rounding=2</field>
                                            </record>
                                        </field>
                                    </record>
                                    <record id="tax_report_gst_line_note_5_2" model="account.report.line">
                                        <field name="name">2. Divide amount in line 1 by total sales (from line 1 on the return form)</field>
                                        <field name="code">G1_NOTE5_2</field>
                                        <field name="expression_ids">
                                            <record id="tax_report_gst_line_note_5_2_formula" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">aggregation</field>
                                                <field name="formula">G1_NOTE5_1.balance / G1_10.balance</field>
                                                <field name="subformula">ignore_zero_division</field>
                                                <field name="figure_type">float</field>
                                            </record>
                                        </field>
                                    </record>
                                    <record id="tax_report_gst_line_note_5_3" model="account.report.line">
                                        <field name="name">3. Multiply amount in line 2 by exempt sales (from line 2 on the return form)</field>
                                        <field name="code">G1_NOTE5_3</field>
                                        <field name="expression_ids">
                                            <record id="tax_report_gst_line_note_5_3_formula" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">aggregation</field>
                                                <field name="formula">G1_NOTE5_2.balance * G1_20.balance</field>
                                            </record>
                                        </field>
                                    </record>
                                    <record id="tax_report_gst_line_note_5_4" model="account.report.line">
                                        <field name="name">4. Add GST paid on inputs used solely for exempt sales</field>
                                        <field name="code">G1_NOTE5_4</field>
                                        <field name="expression_ids">
                                            <record id="tax_report_gst_line_note_5_4_tag" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">tax_tags</field>
                                                <field name="formula">90</field>
                                            </record>
                                        </field>
                                    </record>
                                    <record id="tax_report_gst_line_note_5_5" model="account.report.line">
                                        <field name="name">5. Add lines 3 and 4 = GST Paid for Exempt Sales (transfer this figure to line 9 on the return form)</field>
                                        <field name="code">G1_NOTE5_5</field>
                                        <field name="expression_ids">
                                            <record id="tax_report_gst_line_note_5_5_formula" model="account.report.expression">
                                                <field name="label">balance</field>
                                                <field name="engine">aggregation</field>
                                                <field name="formula">G1_NOTE5_3.balance + G1_NOTE5_4.balance</field>
                                            </record>
                                        </field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_10" model="account.report.line">
                        <field name="name">10. GST paid for private purposes</field>
                        <field name="code">G1_100</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_10_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">100</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_11" model="account.report.line">
                        <field name="name">11. Add lines 9 and 10</field>
                        <field name="code">G1_110</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_11_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_90.balance + G1_100.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_12" model="account.report.line">
                        <field name="name">12. Input Credits (copy to line 14) - Deduct the total in line 11 from line 8</field>
                        <field name="code">G1_120</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_12_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_80.balance - G1_110.balance</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gst_line_block_3" model="account.report.line">
                <field name="name">Block 3: Summary - GST Payable or Refundable</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="tax_report_gst_line_13" model="account.report.line">
                        <field name="name">13. Output Debits (add lines 6 and 7 above and write the amount here)</field>
                        <field name="code">G1_130</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_13_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_60.balance + G1_70.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_14" model="account.report.line">
                        <field name="name">14. Deduct Input Credits (from line 12 above)</field>
                        <field name="code">G1_140</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_14_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_120.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_15" model="account.report.line">
                        <field name="name">15. Goods and Services Tax Payable (remittance enclosed) or Refundable</field>
                        <field name="code">G1_150160</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_15_formula" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">G1_130.balance - G1_140.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="tax_report_gst_line_16" model="account.report.line">
                        <field name="name">16. GST Section 65A Credit Allowable (see note 8 below) - if applicable</field>
                        <field name="code">G1_170</field>
                        <field name="expression_ids">
                            <record id="tax_report_gst_line_16_tag" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">170</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
