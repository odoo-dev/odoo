<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_l10n_pg" model="ir.ui.view">
        <field name="name">account.move.form.l10n_pg</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']" position="after">
                <group string="Sales Listing"
                       name="l10n_pg_sales_listing_group"
                       invisible="country_code != 'PG' or move_type not in ('out_invoice', 'out_refund', 'out_receipt')">
                    <field name="l10n_pg_detail_description" placeholder="e.g. 30-day dry hire of 20-ton excavator"/>
                </group>
                <group string="Supplier Listing"
                       name="l10n_pg_supplier_listing_group"
                       invisible="country_code != 'PG' or move_type not in ('in_invoice', 'in_refund', 'in_receipt')">
                    <field name="l10n_pg_document_reference" placeholder="e.g. Tax Invoice"/>
                    <field name="l10n_pg_detail_description" placeholder="e.g. 30-day dry hire of 20-ton excavator"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
