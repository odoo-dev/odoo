<templates>

    <t t-name="ir.attachment.MediaManagerKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <!-- Add sidebar and upload file zone -->
        <xpath expr="//div[@t-ref='this.rootRef']" position="attributes">
            <attribute name="t-on-dragenter.prevent">this.uploadDragEnter</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_kanban_renderer')]" position="before">
            <div class="media-manager-drop-zone position-absolute"
                 t-att-class="{ 'active': this.state.isDraggingFile}"
                 t-on-dragleave="this.uploadDragLeave"
                 t-on-dragover.prevent="() => {}"
                 t-on-drop.prevent="this.uploadDrop">
                <div>
                    Drop files here<br/><br/>
                    <span class="oi" data-icon="upload"></span>
                </div>
            </div>
            <div class="media-manager-side-panel">
                <input type="file" class="d-none o_file_input"
                       t-ref="this.fileInputRef"
                       t-on-change="this.onFileInputChanged"
                       t-att-accept="this.props.accept"
                       t-att-multiple="this.props.multiUpload and 'multiple'"
                />
                <!-- the url input is displayed above the button of the imported kind of link (see `order`) -->
                <div class="media-manager-side-panel-buttons d-flex flex-column">
                    <button t-if="this.canImport(this.IMAGE_TYPE)" class="btn btn-secondary text-nowrap w-100 mb-2 order-0" t-on-click="this.uploadFileClicked.bind(this)">Upload</button>
                    <div class="col justify-content-end flex-nowrap input-group has-validation"
                         t-att-class="{ 'd-none': !this.state.showUrlInput, 'order-1': this.state.urlImportType === this.IMAGE_TYPE, 'order-3': this.state.urlImportType === this.VIDEO_TYPE }">
                        <input type="text" class="form-control o_input o_we_url_input o_we_transition_ease flex-grow-0 w-auto"
                               name="url" t-att-placeholder="this.urlPlaceholder"
                               t-model.proxy="this.state.urlInput"
                               t-on-input="this.onUrlInputInputed"
                               t-ref="this.urlInputRef"/>
                        <div class="d-flex align-items-center">
                            <span t-if="this.state.urlInput and this.state.isValidatingUrl" class="o_we_url_loading mx-2 oi oi-lg oi-spin" data-icon="autorenew" title="Loading..."/>
                            <span t-elif="this.state.urlInput and this.state.isValidUrl and this.state.isValidMedia" class="o_we_url_success text-success mx-2 oi oi-lg" data-icon="check" title="The URL seems valid."/>
                            <span t-elif="this.state.urlInput and !this.state.isValidUrl" class="o_we_url_error text-danger mx-2 oi oi-lg" data-icon="close_small" title="The URL does not seem to work."/>
                            <span t-elif="this.state.urlInput and this.state.isValidUrl and !this.state.isValidMedia" class="o_we_url_warning text-warning mx-2 oi oi-lg" data-icon="warning" t-att-title="this.urlWarningTitle"/>
                        </div>
                    </div>
                    <button t-if="this.canImport(this.IMAGE_TYPE)" type="button"
                            class="btn btn-import-url text-nowrap w-100 mb-2 order-2"
                            t-att-class="this.isImportingUrl(this.IMAGE_TYPE) ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.importLinkClicked(this.IMAGE_TYPE)">
                        Import image link
                    </button>
                    <button t-if="this.canImport(this.VIDEO_TYPE)" type="button"
                            class="btn btn-import-video-url text-nowrap w-100 mb-2 order-4"
                            t-att-class="this.isImportingUrl(this.VIDEO_TYPE) ? 'btn-primary' : 'btn-secondary'"
                            t-on-click="() => this.importLinkClicked(this.VIDEO_TYPE)">
                        Import video link
                    </button>
                </div>

                <div class="media-manager-side-panel-filters mt-4" t-if="this.props.filters">
                    <h4>Filters :</h4>
                    <a href="#" t-on-click.prevent="() => this.filterRecords()">Reset Filters</a>
                    <t t-foreach="this.props.filters" t-as="filter" t-key="filter.label">
                        <br/><a href="#" t-on-click.prevent="() => this.filterRecords(filter.domain)"><t t-out="filter.label"/></a>
                    </t>
                </div>

                <!-- switches: the media with any of the tags switched on are listed -->
                <div class="media-manager-side-panel-tags d-flex flex-wrap gap-1 mt-4" t-if="this.state.mediaTags.length">
                    <t t-set="activeMediaTagIds" t-value="this.activeMediaTagIds"/>
                    <button t-foreach="this.state.mediaTags" t-as="tag" t-key="tag.id" type="button"
                            t-attf-class="btn btn-sm o_tag_color_{{ tag.color }}"
                            t-att-class="{ 'active': activeMediaTagIds.includes(tag.id) }"
                            t-att-aria-pressed="activeMediaTagIds.includes(tag.id) ? 'true' : 'false'"
                            t-on-click="() => this.toggleMediaTag(tag)">
                        <t t-out="tag.name"/>
                    </button>
                </div>
            </div>
        </xpath>
    </t>

</templates>
