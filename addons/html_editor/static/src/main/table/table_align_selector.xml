<templates xml:space="preserve">
    <t t-name="html_editor.TableAlignSelector">
        <Dropdown state="this.dropdown" menuClass="'o-we-toolbar-dropdown'" menuRef="this.menuRef" focusToggleOnClosed="false">
            <button t-ref="this.tableAlignSelector" class="btn btn-light" t-att-class="{ active: !!this.state.displayName }" t-att-title="this.props.title" name="vertical_align">
                <t t-set="selectedItem" t-value="this.items.find(item => item.mode === this.state.displayName)" />
                <i class="oi oi-fw" t-att-data-icon="selectedItem ? selectedItem.icon : 'vertical_align_top'"/>
            </button>
            <t t-set-slot="content">
                <div data-prevent-closing-overlay="true">
                    <t t-foreach="this.items" t-as="item" t-key="item.mode">
                        <DropdownItem
                            tag="'button'"
                            attrs="{ name: 'vertical_align_' + item.mode }"
                            class="{'dropdown-item_active_noarrow btn btn-light': true, active: item.mode === this.state.displayName }"
                            t-on-pointerdown.prevent="() => {}"
                            onSelected="() => this.onSelected(item)"
                        >
                            <i class="oi oi-fw" t-att-data-icon="item.icon"/>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
