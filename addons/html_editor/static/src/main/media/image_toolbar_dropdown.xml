<templates xml:space="preserve">
    <t t-name="html_editor.ImageToolbarDropdown">
        <Dropdown state="this.dropdown" menuClass="`${this.props.name}_selector`" menuRef="this.menuRef" focusToggleOnClosed="false">
            <button t-custom-ref="imageToolbarBtn" t-att-title="this.props.title" class="btn btn-light">
                <i t-if="this.props.icon.startsWith('fa')" class="fa fa-fw" t-att-class="this.props.icon"/>
                <t t-else="" t-call="{{ this.props.icon }}"/>
                <t t-if="this.state &amp;&amp; this.state.displayName" t-out="this.state.displayName"/>
            </button>
            <t t-set-slot="content">
                <t t-foreach="this.items" t-as="item" t-key="item_index">
                    <DropdownItem class="'user-select-none'" onSelected="() => this.onSelected(item)">
                        <t t-out="item.name"/>
                    </DropdownItem>
                </t>
            </t>
        </Dropdown>
    </t>

    <t t-name="html_editor.ImagePaddingIcon">
        <span class="oi" data-icon="padding"/>
    </t>
</templates>
