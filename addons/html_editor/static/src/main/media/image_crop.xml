<templates xml:space="preserve">
    <t t-name="html_editor.ImageCrop">
        <div
             class="o_we_crop_widget"
             tabindex="-1"
             contenteditable="false"
             t-custom-ref="el"
             t-on-zoom="this.onCropZoom"
        >
            <div class="o_we_cropper_wrapper" t-custom-ref="cropperWrapper">
                <img class="o_we_cropper_img" t-custom-ref="imageRef"/>
                <div class="o_we_crop_buttons text-center mt16 position-fixed o_we_no_overlay" contenteditable="false">
                    <div class="btn-group btn-group-toggle" title="Aspect Ratio" data-bs-toggle="buttons">
                        <t t-foreach="this.aspectRatios" t-as="ratio" t-key="ratio">
                            <t t-set="is_active" t-value="ratio === this.aspectRatio"/>
                            <label t-attf-class="btn #{is_active and 'active' or ''}" t-on-click="() => this.setAspectRatio(ratio)">
                                <input type="radio" /><t t-out="ratio_value.label"/>
                            </label>
                        </t>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" title="Zoom In" t-on-click="() => this.onZoom(0.1)"><i class="oi oi-fw">zoom_in</i></button>
                        <button type="button" title="Zoom Out" t-on-click="() => this.onZoom(-0.1)"><i class="oi oi-fw">zoom_out</i></button>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" title="Rotate Left" t-on-click="() => this.onRotate(-90)"><i class="oi oi-fw">undo</i></button>
                        <button type="button" title="Rotate Right" t-on-click="() => this.onRotate(90)"><i class="oi oi-fw">redo</i></button>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" title="Flip Horizontal" t-on-click="() => this.onFlip('scaleX')"><i class="oi">arrow_range</i></button>
                        <button type="button" title="Flip Vertical" t-on-click="() => this.onFlip('scaleY')"><i class="oi">height</i></button>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" title="Reset Image" t-on-click="this.onReset"><i class="oi">refresh</i> Reset Image</button>
                    </div>
                    <div class="btn-group" role="group">
                        <button type="button" t-on-click="this.save" class="btn btn-primary"><i class="oi" role="presentation">check</i> Apply</button>
                        <button type="button" t-custom-ref="discardButton" t-on-click="this.closeCropper" class="btn btn-danger"><i class="oi" role="presentation">close_small</i> Discard</button>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
