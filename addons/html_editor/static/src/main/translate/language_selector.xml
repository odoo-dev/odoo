<templates xml:space="preserve">
    <t t-name="html_editor.LanguageSelector">
        <t t-if="this.state.languages.length === 1">
            <t t-call="html_editor.translateButton"
                onClick="() => this.onSelected({languageCode: this.state.languages[0][0], languageName: this.state.languages[0][1]})">
            </t>
        </t>
        <Dropdown t-else="" menuRef="this.menuRef">
            <t t-call="html_editor.translateButton" onClick="() => {}">
            </t>
            <t t-set-slot="content">
                <div data-prevent-closing-overlay="true">
                    <t t-foreach="this.state.languages" t-as="language" t-key="language[0]">
                        <DropdownItem class="'user-select-none'" onSelected="() => this.onSelected({languageCode: language[0], languageName: language[1]})">
                            <div class="lang" t-out="language[1]"/>
                        </DropdownItem>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>

    <t t-name="html_editor.translateButton">
        <button class="btn btn-light" name="translate" t-att-title="this.props.title"
            t-att-disabled="this.props.isDisabled" t-on-click="onClick">
            <i class="oi oi-fw" data-icon="translate"/>
        </button>
    </t>

</templates>
