<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_printer_form_star" model="ir.ui.view">
        <field name="name">pos.printer.form.star</field>
        <field name="model">pos.printer</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_printer_form"/>
        <field name="arch" type="xml">
            <field name="printer_type" position="attributes">
                <attribute name="invisible">False</attribute>
            </field>
            <field name="printer_ip" position="after">
                <field name="printer_ip" string="Star Printer IP Address" invisible="printer_type != 'star_epos'" placeholder="10.100.50.87" required="printer_type == 'star_epos'"/>
                <field name="receipt_paper_width" invisible="printer_type != 'star_epos'" required="printer_type == 'star_epos'"/>
            </field>
        </field>
    </record>

</odoo>
