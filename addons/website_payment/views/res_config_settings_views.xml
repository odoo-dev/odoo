<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="website_creation_settings" position="after">
                <setting
                    id="website_payment_settings"
                    class="bg-warning"
                    type="header"
                    noString="1"
                >
                    <span class="d-flex" invisible="active_provider_id">
                        No payment provider defined?
                    </span>
                    <button
                        invisible="not onboarding_payment_module"
                        class="btn btn-link"
                        type="object"
                        name="action_w_payment_start_payment_onboarding"
                    >
                        Configure Stripe
                    </button>
                    <button
                        invisible="onboarding_payment_module"
                        class="btn btn-link"
                        disabled=""
                        string="Configure Stripe"
                    />
                    <span>or</span>
                    <button
                        class="btn btn-link"
                        type="action"
                        name="%(payment.action_payment_provider)d"
                    >
                        View all providers
                    </button>
                </setting>
            </setting>
            <block id="website_info_settings" position="after">
                <block title="Payments" id="div_website_payment">
                    <setting
                        id="website_payment"
                        string="Configure Payments"
                        help="Visa, Mastercard, Maestro, Google Pay, Apple Pay, etc. as well as recurring charges."
                        documentation="/applications/finance/payment_providers.html"
                    >
                        <div class="content-group">
                            <div class="row" invisible="active_provider_id">
                                <div invisible="not onboarding_payment_module" class="oe_inline">
                                    <button
                                        type="object"
                                        name="action_w_payment_start_payment_onboarding"
                                        class="btn-primary"
                                    >
                                        Activate
                                        <field
                                            name="onboarding_payment_module"
                                            nolabel="1"
                                            class="oe_inline"
                                        />
                                    </button>
                                </div>
                                <div
                                    title="Stripe Connect is not available in your country, please use another payment provider."
                                    invisible="onboarding_payment_module"
                                    class="oe_inline"
                                >
                                    <button
                                        string="Activate Stripe" class="btn-primary" disabled=""
                                    />
                                </div>
                                <button
                                    string="Find a provider"
                                    type="action"
                                    name="%(payment.action_payment_provider)d"
                                    class="btn-secondary oe_inline"
                                />
                            </div>
                            <div invisible="not active_provider_id">
                                <button
                                    type="object"
                                    name="action_view_active_provider"
                                    class="btn-primary col-auto"
                                >
                                    Configure
                                    <field
                                        name="active_provider_id"
                                        class="oe_inline"
                                        nolabel="1"
                                        options="{'no_open': True}"
                                    />
                                </button>
                                <button
                                    string="Find a provider"
                                    type="action"
                                    name="%(payment.action_payment_provider)d"
                                    class="btn-secondary col-auto"
                                />
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
