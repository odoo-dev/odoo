<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="portal.Chatter">
    <div
        class="o-mail-Chatter o-portal-Chatter container-fluid px-0"
        t-att-class="{'o-review-Chatter': env.displayRating }"
        t-on-scroll="onScrollDebounced" t-ref="root"
    >
        <div class="row">
            <div
                class="o-mail-Chatter-top col-12"
                t-attf-class="{{ env.displayRating ? 'col-lg-4' + (props.twoColumns ? ' col-xl-3' : '') : '' }}"
                t-ref="top"
            >
                <Composer
                    t-if="state.thread and props.composer and !props.twoColumns"
                    composer="state.thread.composer"
                    mode="'extended'"
                    onPostCallback.bind="onPostCallback"
                    dropzoneRef="rootRef"
                    t-key="props.threadId"
                    type="'message'"
                />
            </div>
            <div class="o-mail-Chatter-content col-12"
                t-attf-class="{{ env.displayRating ? 'col-lg-8 col-xl-8' + (props.twoColumns ? ' offset-xl-1' : '') : '' }}">
                <Composer
                    t-if="state.thread and props.composer and props.twoColumns"
                    composer="state.thread.composer"
                    mode="'extended'"
                    onPostCallback.bind="onPostCallback"
                    dropzoneRef="rootRef"
                    t-key="props.threadId"
                    type="'message'"
                />
                <div
                    t-if="state.thread"
                    t-att-class="{ 'd-none': props.composer and props.twoColumns and env.displayRating and state.thread.isLoaded and state.thread.isEmpty }"
                >
                <!-- TODO Dev in website_slides it's still rendered which display the "This conversation is empty" state; also when logged out sometimes the thread is still rendered even if the thread.isEmpty -->
                    <Thread
                        thread="state.thread"
                        t-key="state.thread.localId"
                        order="'desc'"
                        scrollRef="rootRef"
                        jumpPresent="state.jumpThreadPresent"
                    />
                </div>
            </div>
        </div>
    </div>
</t>

</templates>
