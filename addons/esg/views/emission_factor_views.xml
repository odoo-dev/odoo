<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="emission_factor_form_view" model="ir.ui.view">
        <field name="name">emission.factor.form</field>
        <field name="model">esg.emission.factor</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="emissions_value"/>
                </group>
                <group>
                    <group>
                        <field name="activity_type_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="company_id"/>
                        <field name="valid_from" widget="daterange" options="{'end_date_field': 'valid_to'}"/>
                        <field name="valid_to" invisible="1" required="valid_from"/>
                    </group>
                    <group>
                        <field name="uncertainty"/>
                        <field name="compute_method"/>
                        <field name="uom_id" required="compute_method == 'physically'" invisible="compute_method == 'monetary'"/>
                        <field name="currency_id" required="compute_method == 'monetary'" invisible="compute_method == 'physically'"/>
                        <field name="database_id"/>
                    </group>
                </group>
                <notebook>
                    <page name="gas_emissions" string="Gas Emissions">
                        <field name="emission_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="gas_id"/>
                                <field name="activity_type_id"/>
                                <field name="value"/>
                                <field name="total_value"/>
                                <field name="uom_id" required="compute_method == 'physically'" column_invisible="parent.compute_method == 'monetary'"/>
                                <field name="currency_id" required="compute_method == 'monetary'" column_invisible="parent.compute_method == 'physically'"/>
                            </list>
                        </field>
                    </page>
                    <page name="assignations" string="Assignations">
                        <field name="assignation_ids" nolabel="1">
                            <list>
                                <field name="account_id"/>
                                <field name="vendor_id"/>
                                <field name="product_id"/>
                            </list>
                        </field>
                    </page>
                    <page name="description" string="Description">
                        <field name="description" nolabel="1"/>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="emission_factor_list_view" model="ir.ui.view">
        <field name="name">emission.factor.list</field>
        <field name="model">esg.emission.factor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

