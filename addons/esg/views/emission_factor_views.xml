                <separator/>
                <group string="Group By">
                    <filter name="group_by_parent_id" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_by_scope" context="{'group_by': 'scope'}"/>
                </group>
            </search>
        </field>
    </record> -->

    <record id="action_view_other_emissions" model="ir.actions.server">
        <field name="name">Others Emissions Action</field>
        <field name="model_id" ref="esg.model_esg_emission_factor"/>
        <field name="state">code</field>
        <field name="code">action = model._get_action_view_other_emissions()</field>
    </record>

    <record id="action_view_emission_factor" model="ir.actions.act_window">
        <field name="name">Emission Factors</field>
        <field name="res_model">esg.emission.factor</field>
        <field name="view_mode">list,form</field>
        <!-- <field name="search_view_id" ref="emission_source_search_view"/> -->
        <!-- <field name="context">{'search_default_group_by_parent_id': 1}</field> -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new emission factor
            </p>
        </field>
    </record>

    <record id="action_apply_factors_retroaction" model="ir.actions.server">
        <field name="name">Apply New Factors</field>
        <field name="model_id" ref="esg.model_esg_emission_factor"/>
        <field name="binding_model_id" ref="esg.model_esg_emission_factor"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env['ir.actions.act_window']._for_xml_id('esg.factors_retroaction_wizard_action')</field>
    </record>
</odoo>
