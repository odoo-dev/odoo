<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_actions_esg_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="path">dashboard</field>
        <field name="tag">action_esg_dashboard</field>
    </record>

    <menuitem
        id="esg_main_menu"
        name="ESG"
        sequence="1"
        web_icon=""
    >
        <menuitem
            id="menu_esg_dashboard"
            name="Dashboard"
            sequence="10"
            action="ir_actions_esg_dashboard_action"
        />
        <menuitem
            id="menu_esg_collect"
            name="Collect"
            sequence="20"
        >
            <menuitem
                id="menu_esg_collect_carbon_emissions"
                name="Carbon Emissions"
                sequence="10"
            >
                <menuitem
                    id="menu_esg_emitted_emissions"
                    name="Emitted Emissions"
                    sequence="10"
                    action="action_emitted_emission_report_list_view"
                />
                <menuitem
                    id="menu_esg_other_emissions"
                    name="Other Emissions"
                    sequence="20"
                    action="action_view_other_emissions"
                />
            </menuitem>
        </menuitem>
        <menuitem
            id="menu_esg_measure"
            name="Measure"
            sequence="30"
        >
            <menuitem
                id="menu_esg_environment"
                name="Environment"
                sequence="10"
            >
                <menuitem
                    id="menu_esg_environment_dashboard"
                    name="Dashboard"
                    sequence="10"
                />
                <menuitem
                    id="menu_esg_carbon_analytics"
                    name="Carbon Analytics"
                    sequence="20"
                    action="action_emitted_emission_report_views"
