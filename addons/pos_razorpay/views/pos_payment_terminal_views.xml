<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_terminal_view_list" model="ir.ui.view">
        <field name="name">pos.payment.terminal.list.inherit.pos_razorpay</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="razorpay_username" column_invisible="parent.payment_provider != 'razorpay'" required="parent.payment_provider == 'razorpay'"/>
                <field name="razorpay_tid" column_invisible="parent.payment_provider != 'razorpay'" required="parent.payment_provider == 'razorpay'"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_terminal_view_form" model="ir.ui.view">
        <field name="name">pos.payment.terminal.form.inherit.pos_razorpay</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_form"/>
        <field name="arch" type="xml">
            <group name="settings" position="after">
                <group name="razorpay_settings" invisible="payment_provider != 'razorpay'">
                    <field name="razorpay_username" required="payment_provider == 'razorpay'"/>
                    <field name="razorpay_tid" required="payment_provider == 'razorpay'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
