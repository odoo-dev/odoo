<templates xml:space="preserve">

    <t t-name="web.CustomGroupByItem">
        <Dropdown>
            <button>Custom Group</button>
            <t t-set-slot="content">
                <DropdownItem
                    t-foreach="this.props.fields"
                    t-as="field"
                    t-key="field.name"
                    t-if="field.type !== 'properties' and !field.isProperty"
                    closingMode="'closest'"
                    onSelected="() => this.onSelected(field.name)"
                    t-out="field.string"
                />
            </t>
        </Dropdown>
    </t>

</templates>
