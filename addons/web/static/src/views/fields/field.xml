<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web.Field">
        <div t-att-name="this.props.name" t-att-class="this.computedClassNames()" t-att-style="this.props.style" t-att-data-tooltip-template="this.tooltip and 'web.FieldTooltip'" t-att-data-tooltip-info="this.tooltip" t-ref="this.rootRef">
            <button t-if="this.canMetaEdit()" class="position-absolute top-0 end-100 btn btn-light o-field-edit" style="max-height: 1.5em;" t-on-click="this.onButtonEditClicked"><i class="oi" data-icon="edit"/></button>
            <t t-component="this.field.component" t-props="this.fieldComponentProps"/>
        </div>
    </t>

</templates>
