<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web.Field">
        <div t-att-name="this.props.name" class="position-relative" t-att-class="this.classNames" t-att-style="this.props.style" t-att-data-tooltip-template="this.tooltip and 'web.FieldTooltip'" t-att-data-tooltip-info="this.tooltip" t-ref="this.rootRef">
            <button t-if="this.canMetaEdit()" class="position-absolute top-0 end-100 btn btn-light" style="max-height: 1.5em;"><i class="oi" data-icon="edit" t-on-click="this.onProutClicked"/></button>
            <t t-component="this.field.component" t-props="this.fieldComponentProps"/>
        </div>
    </t>

</templates>
