<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ColorPickerField">
        <div t-if="this.env.isSmall" class="o_colorlist">
            <Dropdown>
                <button t-attf-class="border-0 rounded-circle o_colorlist_toggler o_colorlist_item_color_{{ this.selectedColor }} me-2"/>
                <t t-set-slot="content">
                    <ColorList canToggle="false" colors="this.constructor.RECORD_COLORS" forceExpanded="true" onColorSelected.bind="this.switchColor" selectedColor="this.selectedColor"/>
                </t>
            </Dropdown>
        </div>
        <t t-else="">
            <ColorList canToggle="this.props.canToggle" colors="this.constructor.RECORD_COLORS" forceExpanded="this.isExpanded" onColorSelected.bind="this.switchColor" selectedColor="this.selectedColor"/>
        </t>
    </t>

</templates>
