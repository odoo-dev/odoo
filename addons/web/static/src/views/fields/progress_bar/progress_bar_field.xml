<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ProgressBarField">
        <div class="o_progressbar w-100 d-flex align-items-center" t-ref="numpadDecimal">
            <div class="o_progress align-middle overflow-hidden" aria-valuemin="0" t-att-aria-valuemax="this.maxValue" t-att-aria-valuenow="this.currentValue">
                <div class="h-100" t-att-class="this.progressBarColorClass" t-attf-style="width: min({{ 100 * this.currentValue / this.maxValue }}%, 100%);"/>
            </div>
            <div class="o_progressbar_value d-flex">
                <t t-if="this.props.readonly">
                    <span class="mx-1" t-esc="this.formattedCurrentValue"/>
                </t>
                <t t-else="">
                    <input
                        autocomplete="off"
                        class="o_input h-100 text-center"
                        inputmode="decimal"
                        type="text"
                        t-att-required="!this.props.maxValueField and this.props.required"
                        t-on-blur="() => this.setFocused(false)"
                        t-on-focus="() => this.setFocused(true)"
                        t-ref="currentValue"
                    />
                </t>
                <t t-if="this.props.maxValueField">
                    / <span class="mx-1" t-esc="this.formattedMaxValue"/>
                </t>
                <t t-else="">
                    <span>%</span>
                </t>
            </div>
        </div>
    </t>

</templates>
