<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.PhoneField">
        <div class="o_phone_content w-100">
            <t t-if="props.readonly">
                <a t-if="props.record.data[props.name]" class="o_form_uri" target="_blank" t-att-href="phoneHref" t-esc="props.record.data[props.name]"/>
            </t>
            <t t-else="">
                <t t-set="_inputLinks" t-value="this.props.record.data[this.props.name] ? this.inputLinks : []" />
                <InputBox
                    placeholder="this.props.placeholder"
                    inputLinks="_inputLinks"
                    type="'tel'"
                    id="props.id"
                    input="input"
                />
            </t>
        </div>
    </t>

</templates>
