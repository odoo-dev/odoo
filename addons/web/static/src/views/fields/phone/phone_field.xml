<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.PhoneField">
        <div class="o_input_box">
            <t t-if="this.props.readonly">
                <a t-if="this.props.record.data[this.props.name]" t-att-href="this.phoneHref" class="o_form_uri" t-custom-click.prevent.stop="() => this.onLinkClicked()" t-out="this.props.record.data[this.props.name]"/>
                <t t-foreach="this.inlineButtons" t-as="btn" t-key="btn.name">
                    <button t-attf-class="btn btn-link o_input_box_overlay_end" t-on-click.stop="btn.onSelected" t-att-data-tooltip="btn.name">
                        <i t-attf-class="i fa {{ btn.icon }}" />
                    </button>
                </t>
            </t>
            <t t-else="">
                <input
                    class="o_input"
                    t-att-id="props.id"
                    type="tel"
                    autocomplete="off"
                    t-att-placeholder="props.placeholder"
                    t-custom-ref="input"
                />
            </t>
        </div>
    </t>

    <t t-name="web.FormPhoneField" t-inherit="web.PhoneField" t-inherit-mode="primary">
        <xpath expr="//input" position="after">
            <a
                t-if="props.record.data[props.name]"
                t-att-href="phoneHref"
                target="_blank"
                class="o_phone_form_link ms-3 d-inline-flex align-items-center"
            >
                <i class="fa fa-phone"></i><small class="fw-bold ms-1">Call</small>
            </a>
        </xpath>
    </t>

</templates>
