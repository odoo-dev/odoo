<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.PhoneField">
        <div class="o_phone_content w-100">
            <t t-if="props.readonly">
                <a t-if="props.record.data[props.name]" class="o_form_uri" target="_blank" t-att-href="phoneHref" t-esc="props.record.data[props.name]"/>
                <t t-foreach="this.inlineButtons" t-as="btn" t-key="btn.name">
                    <button class="btn btn-link" t-on-click.stop="btn.onSelected" t-att-data-tooltip="btn.name">
                        <i t-attf-class="i fa {{ btn.icon }}" /> <t t-out="btn.name" />
                    </button>
                </t>
            </t>
            <t t-else="">
                <t t-set="_overlayButtons" t-value="this.props.record.data[this.props.name] ? this.overlayButtons : []" />
                <InputBox
                    placeholder="this.props.placeholder"
                    overlayButtons="_overlayButtons"
                    type="'tel'"
                    id="props.id"
                    input="input"
                />
            </t>
        </div>
    </t>

</templates>
