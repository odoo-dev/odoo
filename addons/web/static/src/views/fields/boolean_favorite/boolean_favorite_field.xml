<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.BooleanFavoriteField">
        <button class="btn o_favorite p-0" t-att-class="{'pe-none' : props.readonly}" t-on-click.prevent.stop="update">
            <i t-att-class="iconClass" role="img" t-att-title="label" t-att-aria-label="label"/>
            <span class="ms-1" t-if="!props.readonly and !props.noLabel" t-esc="label"/>
        </button>
    </t>

</templates>
