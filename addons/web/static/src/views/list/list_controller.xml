<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.ListView">
        <div t-att-class="className" t-ref="root">
            <Layout className="model.useSampleModel ? 'o_view_sample_data' : ''" display="props.display">
                <t t-set-slot="control-panel-buttons">
                    <t t-set="visibleHeaderAlwaysButtons" t-value="visibleHeaderButtons.always or []"/>
                    <t t-set="visibleDefaultButtons" t-value="defaultButtons.filter((button) => button.isDisplayed())"/>
                    <t t-if="env.isSmall">
                        <t t-if="visibleDefaultButtons.length">
                            <t t-call="{{ visibleDefaultButtons[0].template }}"/>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-foreach="visibleDefaultButtons" t-as="button" t-key="button.id">
                            <t t-call="{{ button.template }}"/>
                        </t>
                    </t>
                    <t t-call="{{ props.buttonTemplate }}"/>
                    <t t-if="env.isSmall">
                        <t t-if="visibleDefaultButtons.length">
                            <t t-set="visibleDefaultButtons" t-value="visibleDefaultButtons.slice(1)"/>
                        </t>
                        <t t-elif="visibleHeaderAlwaysButtons.length">
                            <MultiRecordViewButton t-props="multiRecordViewButtonProps(visibleHeaderAlwaysButtons[0])"/>
                            <t t-set="visibleHeaderAlwaysButtons" t-value="visibleHeaderAlwaysButtons.slice(1)"/>
                        </t>
                        <Dropdown t-if="visibleDefaultButtons.length or visibleHeaderAlwaysButtons.length">
                            <button class="btn btn-secondary" title="More">
                                <i class="fa fa-fw fa-ellipsis-v" />
                            </button>
                            <t t-set-slot="content">
                                <t t-foreach="visibleDefaultButtons" t-as="button" t-key="button.id">
                                    <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                        <t t-call="{{ button.template }}"/>
                                    </DropdownItem>
                                </t>
                                <t t-foreach="visibleHeaderAlwaysButtons" t-as="button" t-key="button.id">
                                    <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                        <MultiRecordViewButton t-props="multiRecordViewButtonProps(button)"/>
                                    </DropdownItem>
                                </t>
                            </t>
                        </Dropdown>
                    </t>
                    <t t-else="">
                        <t t-foreach="visibleHeaderAlwaysButtons" t-as="button" t-key="button.id">
                            <MultiRecordViewButton t-props="multiRecordViewButtonProps(button)"/>
                        </t>
                    </t>
                </t>
                <t t-set-slot="control-panel-additional-actions">
                    <t t-set="visibleHeaderSelectionButtons" t-value="visibleHeaderButtons.selection or []"/>
                    <CogMenu t-if="!hasSelectedRecords"/>
                    <CogMenu t-elif="env.isSmall and (props.info.actionMenus orvisibleHeaderSelectionButtons.length)" t-props="actionMenuProps" hasSelectedRecords="hasSelectedRecords">
                        <t t-foreach="visibleHeaderSelectionButtons" t-as="button" t-key="button.id">
                            <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                <MultiRecordViewButton t-props="multiRecordViewButtonProps(button)"/>
                            </DropdownItem>
                        </t>
                    </CogMenu>
                </t>
                <t t-set-slot="control-panel-actions">
                    <div t-if="hasSelectedRecords" class="o_selection_container d-flex gap-1">
                        <SelectionBox root="this.model.root"/>
                        <t t-if="!env.isSmall">
                            <t t-foreach="visibleHeaderButtons.selection or []" t-as="button" t-key="button.id">
                                <MultiRecordViewButton t-props="multiRecordViewButtonProps(button)"/>
                            </t>
                            <t t-if="props.info.actionMenus">
                                <ActionMenus t-props="actionMenuProps"/>
                            </t>
                        </t>
                    </div>
                    <t t-else="">
                        <SearchBar toggler="searchBarToggler" autofocus="firstLoad"/>
                    </t>
                </t>
                <t t-set-slot="control-panel-navigation-additional">
                    <t t-if="!hasSelectedRecords" t-component="searchBarToggler.component" t-props="searchBarToggler.props"/>
                </t>
                <t t-component="props.Renderer" t-if="model.isReady"
                    list="model.root"
                    activeActions="props.archInfo.activeActions"
                    archInfo="props.archInfo"
                    allowSelectors="props.allowSelectors"
                    readonly="props.readonly"
                    editable="editable"
                    onOpenFormView="onOpenFormView"
                    hasOpenFormViewButton="hasOpenFormViewButton"
                    openRecord.bind="openRecord"
                    noContentHelp="props.info.noContentHelp"
                    onAdd.bind="createRecord"
                    optionalActiveFields="optionalActiveFields"
                />
            </Layout>
        </div>
    </t>

    <t t-name="web.ListView.Buttons"/>

    <t t-name="web.ListView.Buttons.Save">
        <button type="button" class="btn btn-primary o_list_button_save" data-hotkey="s" t-on-click.stop="onClickSave">
            Save
        </button>
    </t>

    <t t-name="web.ListView.Buttons.Discard">
        <button type="button" class="btn btn-secondary o_list_button_discard" data-hotkey="j" t-on-click.stop="onClickDiscard" t-on-mousedown="onMouseDownDiscard">
            Discard
        </button>
    </t>

    <t t-name="web.ListView.Buttons.New">
        <button type="button" class="btn btn-primary o_list_button_add" data-hotkey="c" t-on-click="onClickCreate" data-bounce-button="">
            New
        </button>
    </t>

</templates>
