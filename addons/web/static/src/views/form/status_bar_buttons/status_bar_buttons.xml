<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.StatusBarButtons">
        <div class="o_statusbar_buttons d-flex align-items-center align-content-around flex-wrap gap-1">
            <t t-if="this.uiService.isSmall">
                <t t-set="firstSlot" t-value="this.visibleSlotNames[0]" />
                <t t-if="firstSlot" t-call-slot="{{ firstSlot }}" />
                <!--
                    The single actions menu of small screens. It lists the
                    header buttons first, all of them: the one kept outside as
                    the primary button of the record is listed here too, so
                    that the group reads whole and stays on top whatever the
                    record state makes visible. Then come the actions on the
                    record itself, what the form controller puts in `actions`.
                -->
                <Dropdown t-if="this.visibleSlotNames.length > 1 or this.props.slots?.actions">
                    <button class="btn btn-secondary" title="More" aria-label="Actions menu">
                        <i class="oi oi-fw" data-icon="more_vert"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.visibleSlotNames" t-as="slot" t-key="slot">
                            <DropdownItem class="'o-dropdown-item-unstyled-button'">
                                <t t-call-slot="{{ slot }}" />
                            </DropdownItem>
                        </t>
                        <div t-if="this.visibleSlotNames.length and this.props.slots?.actions" role="separator" class="dropdown-divider"/>
                        <t t-call-slot="actions"/>
                    </t>
                </Dropdown>
            </t>
            <t t-else="">
                <t t-foreach="this.visibleSlotNames" t-as="slot" t-key="slot">
                    <t t-call-slot="{{ slot }}" />
                </t>
            </t>
        </div>
    </t>

</templates>
