<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="web.FormDialogLayout">
    <Dialog size="this.info.size" title="this.info.title" withBodyPadding="false" onExpand="this.info.onExpandCallback">
      <div t-att-class="this.root.cssClass" t-ref="this.root.ref">
        <div class="o_form_view_container">
          <main class="o_content" t-attf-class="{{ this.info.cssClass }}">
            <t t-call-slot="default"/>
          </main>
        </div>
      </div>
      <t t-set-slot="footer">
        <t t-call-slot="control-panel-buttons"/>
      </t>
    </Dialog>
  </t>

  <t t-name="web.FormViewDialog">
    <View t-props="this.viewProps"/>
  </t>

  <t t-name="web.FormViewDialog.ToMany.buttons" t-inherit="web.FormView.DialogButtons">
    <xpath expr="//button[hasclass('o_form_button_save')]" position="replace">
      <button class="btn btn-primary o_form_button_save" t-on-click="this.saveButtonClicked" data-hotkey="c">Save</button>
      <button t-if="!this.ui.isSmall" class="btn btn-primary o_form_button_save_new" t-on-click="() => this.saveButtonClicked({saveAndNew: true})" data-hotkey="n">Save &amp; New</button>
    </xpath>
  </t>

  <t t-name="web.FormViewDialog.ToOne.buttons" t-inherit="web.FormView.DialogButtons">
    <xpath expr="//button[hasclass('o_form_button_save')]" position="replace">
      <button class="btn btn-primary o_form_button_save" t-on-click="this.saveButtonClicked" data-hotkey="c">Save</button>
    </xpath>
  </t>

</templates>
