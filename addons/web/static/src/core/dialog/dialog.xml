<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.Dialog">
        <div class="o_dialog" t-att-id="id" t-att-class="{ o_inactive_modal: !this.data.isActive }">
            <div role="dialog" class="modal d-block"
                tabindex="-1"
                t-att-class="{ o_technical_modal: this.props.technical, o_modal_full: this.isFullscreen, o_inactive_modal: !this.data.isActive }"
                t-attf-class="o_modal_design_{{ this.design }}"
                t-ref="modalRef"
                >
                <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable" t-attf-class="modal-{{this.props.size}}">
                    <div class="modal-content" t-att-class="this.props.contentClass" t-att-style="this.contentStyle">
                        <header t-if="this.props.header" class="modal-header">
                            <t t-slot="header" close="this.data.close" isFullscreen="this.isFullscreen">
                                <t t-call="web.Dialog.header">
                                    <t t-set="fullscreen" t-value="this.isFullscreen"/>
                                    <t t-set="onExpand" t-value="this.props.onExpand"/>
                                </t>
                            </t>
                        </header>
                        <main class="modal-body" t-attf-class="{{ this.props.bodyClass }} {{ !this.props.withBodyPadding ? 'p-0': '' }}">
                            <t t-slot="default" close="() => this.data.close()" />
                        </main>
                        <footer t-if="this.props.footer" class="modal-footer d-empty-none justify-content-around justify-content-md-start flex-wrap gap-1 w-100">
                            <t t-slot="footer" close="() => this.data.close()"/>
                        </footer>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="web.Dialog.header">
        <t t-if="fullscreen">
            <button class="btn oi oi-arrow-left oi-large" aria-label="Close" tabindex="-1" t-on-click="dismiss" />
        </t>
        <h4 class="modal-title text-break flex-grow-1" t-att-class="{ 'me-auto': fullscreen, 'fs-5': this.props.size == 'sm' }">
            <t t-esc="this.props.title"/>
        </h4>
        <t t-if="onExpand">
            <button type="button" class="fa fa-expand btn opacity-75 opacity-100-hover o_expand_button" aria-label="Expand" tabindex="-1" t-on-click="onExpand"/>
        </t>
        <t t-if="!fullscreen">
            <button type="button" class="btn-close" t-att-class="{'position-absolute top-0 end-0 mt-1 me-1': design == 'minimal' and !onExpand  }" aria-label="Close" tabindex="-1" t-on-click="dismiss"/>
        </t>
    </t>
</templates>
