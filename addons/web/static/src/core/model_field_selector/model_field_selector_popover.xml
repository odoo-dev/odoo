<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="web.ModelFieldSelectorPopover">
        <div class="o_model_field_selector_popover d-flex flex-column gap-2 gap-lg-0" tabindex="-1" t-ref="this.rootRef" t-on-keydown="this.onInputKeydown">
            <div class="d-flex gap-2 align-items-center flex-wrap p-lg-2">
                <span class="d-block w-100 smaller fw-bold text-center" t-out="this.state.page.title"/>
                <button t-if="this.state.page.previousPage" class="btn btn-secondary d-flex p-2" t-on-click="() => this.goToPreviousPage()" t-att-data-tooltip="this.state.page.previousPageName">
                    <i class="o_model_field_selector_popover_prev_page oi"
                        data-icon="arrow_back"
                        role="img"
                        t-att-aria-label="this.state.page.previousPageName"
                    />
                </button>
                <div t-if="this.props.showSearchInput" class="o_model_field_selector_popover_search flex-grow-1">
                    <input type="text"
                            placeholder='Search for a field'
                            class="o_model_field_selector_input form-control rounded-2 bg-view"
                            t-att-value="this.state.page.query"
                            t-on-input="(ev) => this.debouncedSearchFields(ev.target.value)" />
                </div>
            </div>

            <div class="o_model_field_selector_popover_body d-flex flex-column flex-grow-1 overflow-y-auto">
                <ul class="o_model_field_selector_popover_page dropdown-menu o-dropdown--menu show position-static flex-grow-1 w-100 m-0 border-0 px-lg-2 p-0 shadow-none">
                    <t t-foreach="this.fieldNames" t-as="fieldName" t-key="fieldName">
                        <t t-set="fieldDef" t-value="this.state.page.fieldDefs[fieldName]" />
                        <t t-set="itemName" t-value="fieldDef.record_name ? fieldDef.string + ' (' + fieldDef.record_name + ')' : fieldDef.string"/>
                        <li class="o_model_field_selector_popover_item dropdown-item d-flex p-0" t-att-class="{ 'focus': fieldName === this.state.page.focusedFieldName }" t-att-data-name="fieldName">
                            <button class="o_model_field_selector_popover_item_name btn d-flex flex-fill text-start text-truncate" t-on-click="() => this.selectField(fieldDef)">
                                <span t-out="itemName" class="text-truncate"/>
                                <sup t-if="this.props.isDebugMode" class="top-0 d-print-none flex-shrink-0 text-info p-1 ms-1" t-attf-data-tooltip="{{fieldName}} ({{fieldDef.type}})" data-tooltip-touch-tap-to-show="true" title="">?</sup>
                            </button>
                            <t t-if="this.canFollowRelationFor(fieldDef)">
                                <t t-set="label">Go to <t t-out="itemName"/></t>
                                <button class="o_model_field_selector_popover_item_relation btn btn-light my-1 me-1 px-2 py-0"
                                    t-att-data-tooltip="label"
                                    t-att-aria-label="label"
                                    t-on-click.stop="() => this.followRelation(fieldDef)"
                                >
                                    <i class="oi o_model_field_selector_popover_relation_icon" data-icon="chevron_forward" role="img"/>
                                </button>
                            </t>
                        </li>
                    </t>
                </ul>
            </div>
            <div t-if="this.showDebugInput" class="o_model_field_selector_popover_footer p-lg-2">
                <input type="text" class="o_model_field_selector_debug o_model_field_selector_input form-control rounded-2 bg-view"
                    t-att-value="this.state.page.path"
                    t-on-change="(ev) => this.loadNewPath(ev.target.value)"
                    t-on-keydown="this.onDebugInputKeydown"
                    t-on-input="(ev) => this.props.update(ev.target.value, null, true)"/>
            </div>
        </div>
    </t>

</templates>
