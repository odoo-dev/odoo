<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.actions.server" id="download_contact">
        <field name="name">Download (vCard)</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="binding_view_types">form,list,kanban</field>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_url',
                'url': '/web/partner/vcard?partner_ids=' + ','.join(map(str, records.ids)),
                'target': 'download',
            }
        </field>
    </record>

    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.inherit.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="country_code" invisible="1"/>
                    <field name="additional_identifiers" nolabel="1" colspan="2" widget="json_selection"/>

                    <field name="additional_identifiers" widget="json" invisible="0"/>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
