<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_bank_form_inherit_account" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="MMQR Settings" name="emv_qr_settings" invisible="country_code != 'MM'">
                    <group>
                        <field name="merchant_id" />
                        <field name="terminal_id" />
                        <field name="merchant_name_mm" />
                        <field name="merchant_city_mm" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
