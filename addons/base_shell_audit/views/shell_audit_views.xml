<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shell Audit History - list view -->
    <record model="ir.ui.view" id="shell_audit_history_list_view">
        <field name="model">shell.audit.history</field>
        <field name="arch" type="xml">
            <list string="Shell Audit History" create="0" delete="0">
                <field name="create_date" string="Date"/>
                <field name="overview"/>
                <field name="source" optional="hide" widget="ace" options="{'mode': 'python'}"/>
            </list>
        </field>
    </record>

    <!-- Shell Audit History - form view -->
    <record model="ir.ui.view" id="shell_audit_history_form_view">
        <field name="model">shell.audit.history</field>
        <field name="arch" type="xml">
            <form string="Shell Audit History" create="0">
                <sheet>
                    <group>
                        <field name="create_date" string="Date"/>
                        <field name="comment"/>
                    </group>
                    <group string="Python Source">
                        <group colspan="4">
                            <field name="source" nolabel="1" widget="ace" options="{'mode': 'python'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" nolabel="1">
                                <list create="0" delete="0" edit="0">
                                    <field name="transaction_date"/>
                                    <field name="queries" widget="ace" options="{'mode': 'pgsql'}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record model="ir.actions.act_window" id="shell_audit_history_action">
        <field name="name">Shell Audit History</field>
        <field name="res_model">shell.audit.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu item under Settings > Technical -->
    <menuitem
        id="shell_audit_history_menu"
        parent="base.menu_custom"
        action="shell_audit_history_action"
        groups="base.group_system"
        sequence="120"
    />

</odoo>
