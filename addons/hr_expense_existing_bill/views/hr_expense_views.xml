<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_expense_view_form_inherit_linked_bill" model="ir.ui.view">
            <field name="name">hr.expense.view.form.inherit</field>
            <field name="model">hr.expense</field>
            <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vendor_id']" position="after">
                    <label for="has_existing_bill"/>
                    <div class="d-flex flex-column flex-lg-row">
                        <field name="has_existing_bill"
                               string="Existing Bill"
                               widget="boolean_radio"
                               options="{'no_label_element_id': 'direct_expense', 'yes_label_element_id': 'match_bill', 'first_element': false}"
                               readonly="not is_editable"
                               style="width: 60%"
                               groups="account.group_account_invoice"/>
                        <template id="direct_expense">No (Direct Expense)</template>
                        <template id="match_bill">Yes (Match to Bill)</template>

                        <field name="existing_bill_id"
                               invisible="not has_existing_bill"
                               class="justify-content-end"
                               style="margin-bottom: calc(0.25rem + var(--fieldWidget-margin-bottom))"
                               nolabel="1"
                               placeholder="Select Bill..."
                               context="{'name_as_amount_total': 1, 'list_view_ref': 'hr_expense.view_move_list_expense'}"
                               readonly="not is_editable or state not in ['draft', 'submitted']"
                               options="{'no_create': True}"
                               groups="account.group_account_invoice"/>
                    </div>
                </xpath>
                <xpath expr="//field[@name='account_id']" position="attributes">
                    <attribute name="domain">has_existing_bill and [
                        ('account_type', '=', 'liability_payable'),
                        ('company_ids', 'parent_of', company_id),
                    ] or [
                        ('account_type', 'not in', ('asset_receivable', 'liability_payable', 'asset_cash', 'liability_credit_card')),
                        ('company_ids', 'parent_of', company_id),
                    ]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
