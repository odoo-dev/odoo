<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_expense_existing_bill" model="ir.ui.view">
            <field name="name">account.move.form.inherit.existing.bill</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='alerts']" position="after">
                    <div class="d-flex alert alert-danger w-100 d-flex align-items-center gap-1" invisible="not bill_paid_by_employee" role="alert">
                        <span>This bill was already paid by an employee and the bill has been sent to you. Don't pay the supplier</span>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
