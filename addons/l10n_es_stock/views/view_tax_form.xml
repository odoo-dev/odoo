<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="l10n_es_stock.view_tax_form" model="ir.ui.view">
        <field name="name">l10n_es.stock.account.tax.form</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_include_override']" position="attributes">
                <attribute name="readonly">l10n_es_is_rebu_tax</attribute>
            </xpath>
        </field>
    </record>
</odoo>