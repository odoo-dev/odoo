<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order_extended.WhatsappNumberPopup">
        <div class="self_order_timeout_popup o_dialog" t-att-id="id">
            <div role="dialog" class="modal d-block" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-body p-4 overflow-visible">
                            <div class="position-absolute top-0 start-50 translate-middle px-4 py-3 rounded-4 text-bg-success border border-white border-5">
                                <i class="fa fa-whatsapp fs-1" aria-hidden="true"/>
                            </div>
                            <div class="input-symbol my-3">
                                <div class="popup-input value active form-control form-control-lg text-center">
                                    <span t-if="this.state.buffer || !props.placeholder" class="input-value" t-esc="'+91 ' + this.state.buffer"/>
                                    <span t-else="" class="text-muted" t-esc="props.placeholder"/>
                                </div>
                            </div>
                            <Numpad buttons="props.buttons"/>
                            <div class="d-flex justify-content-center mt-3">
                                <button t-att-disabled="!props.isValid(state.buffer)" class="btn btn-primary btn-lg lh-lg o-default-button me-2" tabindex="1" t-on-click="confirm">
                                    <t t-esc="confirmButtonLabel"/>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
