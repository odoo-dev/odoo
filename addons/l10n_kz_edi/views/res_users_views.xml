<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Per-user ESF credentials. Each user authenticates with their own ЭЦП, so
        the signer IIN and the ESF account password live on res.users (read from
        env.user by the connection test), not on the company.
    -->
    <record id="l10n_kz_edi_view_users_form" model="ir.ui.view">
        <field name="name">l10n_kz_edi.res.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Kazakhstan E-Invoicing" name="l10n_kz_edi">
                    <group>
                        <field name="l10n_kz_edi_signer_iin"/>
                        <field name="l10n_kz_edi_password" password="True"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
