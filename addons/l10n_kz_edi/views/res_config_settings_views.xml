<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.kz.edi</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Kazakhstan E-Invoicing (ЭСФ)" id="l10n_kz_edi_settings" invisible="country_code != 'KZ'">
                    <setting string="ESF Connection" help="Connect to the Kazakhstan Electronic Invoices System." company_dependent="1">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="l10n_kz_edi_environment" class="col-lg-3 o_light_label"/>
                                <field name="l10n_kz_edi_environment"/>
                            </div>
                            <div class="text-muted" invisible="l10n_kz_edi_environment != 'sandbox'">
                                Sandbox: requests are sent to the ESF test servers and are not official.
                            </div>
                            <div class="text-muted" invisible="l10n_kz_edi_environment != 'production'">
                                Production: requests are sent to the official ESF servers.
                            </div>
                            <div class="row mt16">
                                <label for="l10n_kz_edi_vat_certificate_series" class="col-lg-3 o_light_label"/>
                                <field name="l10n_kz_edi_vat_certificate_series"/>
                            </div>
                            <div class="row mt16">
                                <label for="l10n_kz_edi_vat_certificate_num" class="col-lg-3 o_light_label"/>
                                <field name="l10n_kz_edi_vat_certificate_num"/>
                            </div>
                            <div class="text-muted">
                                The VAT payer certificate series and number are sent along with the BIN
                                when validating the enterprise on the ESF.
                            </div>
                            <div class="mt8">
                                <button name="action_l10n_kz_edi_test_connection"
                                        type="object"
                                        string="Test Connection"
                                        class="btn-secondary"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
