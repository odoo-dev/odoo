<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="event_track_location_display" name="Event Location Display">
    <t t-set="no_header" t-value="True"/>
    <t t-set="no_footer" t-value="True"/>
    <t t-set="no_livechat" t-value="True"/>
    <t t-set="no_cookies_bar" t-value="True"/>
    <t t-call="website.layout">
        <div id="wrap">
            <owl-component
                name="website_event_track_location_display.EventTrackLocationDisplay"
                t-att-props="json.dumps({
                    'data': display_data,
                    'refreshUrl': '/event/%s/location-display/%s/content' % (event_id, location_id),
                })"
            />
        </div>
    </t>
</template>

<template id="event_track_location_display_no_cookies_bar" inherit_id="website.cookies_bar">
    <xpath expr="//div[@id='website_cookies_bar']" position="attributes">
        <attribute name="t-if">website.cookies_bar and not no_cookies_bar</attribute>
    </xpath>
</template>

</odoo>
