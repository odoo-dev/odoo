<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="event_track_location_display" name="Event Location Display">
    <t t-set="no_header" t-value="True"/>
    <t t-set="no_footer" t-value="True"/>
    <t t-set="no_livechat" t-value="True"/>
    <t t-set="no_cookies_bar" t-value="True"/>
    <t t-call="website.layout">
        <div id="wrap"
            t-attf-class="o_wevent_location_display vh-100 overflow-hidden d-flex flex-column p-3 p-md-4 p-xl-5 o_cc o_cc5 #{'o_wevent_location_display_has_background' if display_data['backgroundImageUrl'] else ''}"
            t-att-style="'--o-wevent-location-display-background-image: url(%s);' % display_data['backgroundImageUrl'] if display_data['backgroundImageUrl'] else None">
            <owl-component
                name="website_event_track_location_display.EventTrackLocationDisplay"
                t-att-props="json.dumps({
                    'data': display_data,
                    'refreshUrl': '/event/%s/location-display/%s/content' % (event_id, location_id),
                })"
                class="d-flex flex-column flex-grow-1"
            />
        </div>
    </t>
</template>

<template id="event_track_location_display_no_cookies_bar" inherit_id="website.cookies_bar">
    <xpath expr="//div[@id='website_cookies_bar']" position="attributes">
        <attribute name="t-if">website.cookies_bar and not no_cookies_bar</attribute>
    </xpath>
</template>

</odoo>
