<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_pos_stock" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.pos.stock</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting_fiscal']/div" position="inside">
                <setting id="pos_picking_type" title="Operation types show up in the Inventory dashboard." string="Operation Type" help="Used to record product pickings. Products are consumed from its default source location.">
                    <field name="picking_type_id" domain="[('company_id', '=', company_id)]" required="1"/>
                </setting>
                <setting id="ship_later" string="Allow Ship Later" help="Sell products and deliver them later." invisible="is_kiosk">
                    <field name="ship_later"/>
                    <div class="content-group mt16" invisible="not ship_later">
                        <div class="row">
                            <label for="warehouse_id" string="Warehouse" class="col-lg-3 o_light_label"/>
                            <field name="warehouse_id" required="ship_later"/>
                        </div>
                        <div groups="stock.group_adv_location" class="row">
                            <label for="route_id" string="Specific route" class="col-lg-3 o_light_label"/>
                            <field name="route_id"/>
                        </div>
                        <div class="row">
                            <label for="picking_policy" class="col-lg-3 o_light_label"/>
                            <field name="picking_policy" required="ship_later"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="pos_accounting_section" position="after">
                <block title="Inventory" id="pos_inventory_section">
                    <setting id="update_quantities_stock_setting" groups="base.group_no_one" string="Inventory Management" company_dependent="1" help="Update quantities in stock">
                        <field name="update_stock_quantities" colspan="4" widget="radio"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
