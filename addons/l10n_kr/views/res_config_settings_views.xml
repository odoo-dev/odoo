<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_kr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="peppol" position="after">
                <block title="Korean Electronic Invoicing" id="l10n_kr_edi_settings" invisible="country_code != 'KR'">
                    <setting id="l10n_kr_edi_setting"
                             string="Korean e-Invoicing"
                             company_dependent="1"
                             help="Issue e-tax invoices and cash receipts to the National Tax Service through Barobill.">
                        <field name="module_l10n_kr_edi"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
