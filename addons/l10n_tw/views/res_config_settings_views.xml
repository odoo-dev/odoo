<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_tw</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="country_settings_container" position="inside">
                <setting id="l10n_tw_edi_activate_setting"
                         string="eGUI (e-invoices)"
                         help="Issue and submit e-invoices to the Ministry of Finance through ECPay."
                         documentation="/applications/finance/fiscal_localizations/taiwan.html"
                         invisible="country_code != 'TW' or module_l10n_tw_edi_ecpay">
                    <button string="Activate ECPay"
                            type="object"
                            name="action_l10n_tw_activate_edi_ecpay"
                            class="btn btn-primary mt-2"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
