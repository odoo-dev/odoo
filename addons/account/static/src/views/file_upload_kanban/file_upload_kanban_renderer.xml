<templates>

    <t t-name="account.FileUploadKanbanRenderer" t-inherit="web.KanbanRenderer" t-inherit-mode="primary">
        <xpath expr="//div[@t-custom-ref='root']" position="before">
            <UploadDropZone
                visible="this.dropzoneState.visible"
                hideZone="() => dropzoneState.visible = false"
                dropZoneTitle="this.dropZoneTitle"
                dropZoneDescription="this.dropZoneDescription"/>
        </xpath>
        <xpath expr="//div[@t-custom-ref='root']" position="attributes">
            <attribute name="t-on-dragenter.stop.prevent">onDragStart</attribute>
            <attribute name="t-on-paste">onPaste</attribute>
        </xpath>
    </t>

</templates>
