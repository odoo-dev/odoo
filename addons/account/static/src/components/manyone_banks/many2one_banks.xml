<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="account.Many2OneBank" t-inherit="web.Many2One">
        <xpath expr="//t[@t-if='props.readonly']" position="before">
            <t t-if="this.props.value.id">
                <i t-if="this.props.value.allow_out_payment" class="oi me-1 text-success align-self-center" data-icon="security" title="Trusted"/>
                <i t-else="" class="oi me-1 text-danger align-self-center" data-icon="error" title="Untrusted"/>
            </t>
        </xpath>
    </t>
</templates>
