<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="test_tag_owner_view_form" model="ir.ui.view">
        <field name="name">test_tag.owner.view.form</field>
        <field name="model">test_tag.owner</field>
        <field name="arch" type="xml">
            <form string="Test Tag Owner">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tag_ids"
                               widget="many2many_tags"
                               context="{'default_owner_id': id}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="test_tag_item_view_form" model="ir.ui.view">
        <field name="name">test_tag.item.view.form</field>
        <field name="model">test_tag.item</field>
        <field name="arch" type="xml">
            <form string="Test Tag Owner">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="test_tag_owner_action" model="ir.actions.act_window">
        <field name="name">Test Tag Owner</field>
        <field name="res_model">test_tag.owner</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_test_tag_owner"
              name="Test Tag Owner"
              parent="account.menu_finance_configuration"
              action="test_tag_owner_action"
              sequence="100"/>
</odoo>
