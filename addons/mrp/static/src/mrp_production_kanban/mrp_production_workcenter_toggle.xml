<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp.MrpProductionWorkcenterToggle">
        <div class="d-flex align-items-center gap-1">
            <div class="d-flex o_mrp_working_users">
                <img t-foreach="this.workingUsers" t-as="user" t-key="user.id"
                     class="rounded o_avatar o_mrp_working_user"
                     style="width: 20px; height: 20px; object-fit: cover;"
                     t-att-src="'/web/image/res.users/' + user.id + '/avatar_128'"
                     t-att-title="user.name" t-att-alt="user.name"/>
            </div>
            <div t-if="this.isVisible" data-tooltip="Status" class="o_mrp_workcenter_status">
                <Dropdown>
                    <button class="btn btn-link d-flex p-0" t-att-title="this.stateLabels[this.workorders.state]">
                        <span t-attf-class="o_wo_status o_wo_bubble {{this.statusColor}}"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-call="mrp.WorkorderStateDropdownItems"/>
                    </t>
                </Dropdown>
            </div>
        </div>
    </t>
</templates>
