<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="mrp.MrpProductionWorkcenterToggle">
        <div class="d-flex align-items-center gap-1">
            <div class="d-flex o_mrp_working_users">
                <img t-foreach="this.workingUsers" t-as="user" t-key="user.id"
                     class="rounded o_avatar o_mrp_working_user"
                     style="width: 20px; height: 20px; object-fit: cover;"
                     t-att-src="'/web/image/res.users/' + user.id + '/avatar_128'"
                     t-att-title="user.name" t-att-alt="user.name"/>
            </div>
            <div t-if="this.isVisible" data-tooltip="Status" class="o_mrp_workcenter_status">
                <Dropdown>
                    <button class="btn btn-link d-flex p-0" t-att-title="this.stateLabels[this.workorders.state]">
                        <span t-attf-class="o_wo_status o_wo_bubble {{this.statusColor}}"/>
                    </button>
                    <t t-set-slot="content">
                        <DropdownItem class="`d-flex align-items-center`" onSelected="() => this.setState('blocked')">
                            <span class="oi oi-lg text-warning me-2" data-icon="error"/>
                            <span>Blocked</span>
                        </DropdownItem>
                        <DropdownItem class="`d-flex align-items-center`" onSelected="() => this.setState('ready')">
                            <span class="oi oi-lg oi-filled text-muted me-2" data-icon="circle"/>
                            <span>To Do</span>
                        </DropdownItem>
                        <DropdownItem class="`d-flex align-items-center`" onSelected="() => this.setState('progress')">
                            <span class="oi oi-lg oi-filled text-info me-2" data-icon="play_circle"/>
                            <span>In Progress</span>
                        </DropdownItem>
                        <DropdownItem class="`d-flex align-items-center`" onSelected="() => this.setState('cancel')">
                            <span class="oi oi-lg oi-filled text-danger me-2" data-icon="cancel"/>
                            <span>Cancelled</span>
                        </DropdownItem>
                        <DropdownItem class="`d-flex align-items-center`" onSelected="() => this.setState('done')">
                            <span class="oi oi-lg oi-filled text-success me-2" data-icon="check_circle"/>
                            <span>Done</span>
                        </DropdownItem>
                    </t>
                </Dropdown>
            </div>
        </div>
    </t>
</templates>
