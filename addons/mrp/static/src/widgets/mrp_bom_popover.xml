<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mrp.MrpBomPopoverField" t-inherit="stock.popoverButton" t-inherit-mode="extension">
        <xpath expr="//a" position="attributes">
            <attribute name="t-att-title">"Days to prepare estimation"</attribute>
        </xpath>
    </t>
    <div t-name="mrp.bomPopover">
        <table class="table table-sm table-borderless mb-0">
            <tbody>
                <tr>
                    <td colspan="2" class="fw-bolder border-bottom">Days to prepare estimation for "<t t-esc="props.final_product_name"/>"</td>
                </tr>
                <t t-if="props.component">
                    <tr>
                        <td class="fw-bolder">Component</td>
                        <td class="text-end"><a href="#" t-on-click.prevent="() => this.goToAction(props.component_id, 'product.product')"><t t-esc="props.component"/></a></td>
                    </tr>
                    <tr t-if="props.route_name and props.route_detail">
                        <td class="fw-bolder">Route</td>
                        <td class="text-end">
                            <t t-esc="props.route_name"/>:
                            <t t-if="props.route_type === 'manufacture'">
                                <a href="#" t-on-click.prevent="() => this.goToAction(props.route_id, 'mrp.bom')">
                                    <t t-esc="props.route_detail"/>
                                </a>
                            </t>
                            <t t-else="">
                                <t t-esc="props.route_detail"/>
                            </t>
                        </td>
                    </tr>
                </t>
                <t t-if="props.delay">
                    <tr>
                        <td class="fw-bolder">Lead Time</td>
                        <td class="text-end"><t t-esc="props.delay"/></td>
                    </tr>
                </t>
                <t t-else="">
                    <tr>
                        <td>
                            <strong class="fw-bolder">Not Available:</strong> Missing route info for components.
                        </td>
                    </tr>
                    <tr><td><a href="#" t-on-click.prevent="_openBomOverview">Check BoM Overview</a></td></tr>
                </t>
            </tbody>
        </table>
    </div>
</templates>