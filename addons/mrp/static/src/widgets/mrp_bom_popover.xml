<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mrp.MrpBomPopoverField" t-inherit="stock.popoverButton" t-inherit-mode="extension">
        <xpath expr="//a" position="attributes">
            <attribute name="t-att-title">"Days to prepare estimation"</attribute>
        </xpath>
    </t>

    <div t-name="mrp.bomPopover">
        <table class="table table-sm mb-0">
            <tbody>
                <tr>
                    <td class="fw-bolder">Days to prepare estimation :</td>
                    <td>
                        <t t-if="props.estimated_delay or props.delay"><t t-esc="props.estimated_delay || props.delay"/></t>
                        <t t-else=""><span class="text-danger"><t t-esc="props.no_estimated_info"/></span></t>
                    </td>
                </tr>
                <t t-if="props.component">
                    <tr>
                        <td class="fw-bolder">Component</td>
                        <td><a href="#" t-on-click.prevent="() => this.goToAction(props.component_id, 'product.product')"><t t-esc="props.component"/></a></td>
                    </tr>
                    <tr t-if="props.route_name and props.route_detail">
                        <td class="fw-bolder">Route</td>
                        <td>
                            <t t-esc="props.route_name"/>:
                            <t t-if="props.route_type === 'manufacture'">
                                <a href="#" t-on-click.prevent="() => this.goToAction(props.route_id, 'mrp.bom')">
                                    <t t-esc="props.route_detail"/>
                                </a>
                            </t>
                            <t t-else="">
                                <t t-esc="props.route_detail"/>
                            </t>
                        </td>
                    </tr>
                    <tr t-if="props.delay">
                        <td class="fw-bolder">Lead Time</td>
                        <td><t t-esc="props.delay"/></td>
                    </tr>
                </t>
                <tr t-if="props.no_estimated_info">
                    <td class="fw-bolder">Missing route info for components/final product.</td>
                    <td><a href="#" t-on-click.prevent="_openBomOverview">See BoM overview</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</templates>
