<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_section_template_view_list" model="ir.ui.view">
        <field name="name">mrp.section.template.list</field>
        <field name="model">mrp.section.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="line_count" string="Components"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="mrp_section_template_view_form" model="ir.ui.view">
        <field name="name">mrp.section.template.form</field>
        <field name="model">mrp.section.template</field>
        <field name="arch" type="xml">
            <form string="Saved Section">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Section Name..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_qty"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <!-- quantities for one unit of finished product -->
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="company_id" column_invisible="True"/> <!-- needed by the company-dependent domain of product_id -->
                            <field name="product_id"/>
                            <field name="product_qty"/>
                            <field name="uom_id" groups="uom.group_uom" options="{'no_open': True, 'no_create': True}"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mrp_section_template_action" model="ir.actions.act_window">
        <field name="name">Saved Sections</field>
        <field name="res_model">mrp.section.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No saved section yet</p>
            <p>Save a section from its menu on a bill of materials or a manufacturing order, to add it again with its components.</p>
        </field>
    </record>

    <menuitem id="menu_mrp_section_template"
        action="mrp_section_template_action"
        parent="menu_mrp_configuration"
        sequence="110"/>
</odoo>
