<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="kiosk_device_config_view_list" model="ir.ui.view">
        <field name="name">kiosk.device.config.list</field>
        <field name="model">pos.self.device.config</field>
        <field name="arch" type="xml">
            <list string="Device configurations">
                <field name="name"/>
                <field name="is_default"/>
                <field name="timezone" optional="hide"/>
                <field name="language" optional="hide"/>
                <field name="volume" optional="hide"/>
                <field name="brightness" optional="hide"/>
                <field name="version" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kiosk_device_config_view_form" model="ir.ui.view">
        <field name="name">kiosk.device.config.form</field>
        <field name="model">pos.self.device.config</field>
        <field name="arch" type="xml">
            <form string="Device configuration">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_default"/>
                            <field name="admin_pin" password="True"/>
                            <field name="timezone"/>
                            <field name="language"/>
                        </group>
                    </group>

                    <group>
                        <group string="Hardware">
                            <label for="volume"/>
                            <div class="o_input_box" style="max-width: 60px;">
                                <field name="volume"/>
                                <span class="o_input_box_overlay_end o_input_box_overlay_inline">%</span>
                            </div>
                            <label for="brightness"/>
                            <div class="o_input_box" style="max-width: 60px;">
                                <field name="brightness"/>
                                <span class="o_input_box_overlay_end o_input_box_overlay_inline">%</span>
                            </div>
                        </group>
                    </group>
                    <group class="mt-4">
                        <field name="version" readonly="True"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kiosk_device_config" model="ir.actions.act_window">
        <field name="name">Self Device Configurations</field>
        <field name="res_model">pos.self.device.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add device configuration
            </p>
        </field>
    </record>


</odoo>

