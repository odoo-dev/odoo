<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.actions.act_window" id="action_repair_move_lines">
        <field name="name">Inventory Moves</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_id.repair_id', '=', active_id)]</field>
    </record>

    <record id="view_stock_move_operations" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.repair</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations" />
        <field name="arch" type="xml">
            <field name="quantity" position="after">
                <field name="repair_line_type" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operation.list.inherit.repair</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id'][@groups='stock.group_stock_multi_locations']" position="attributes">
		        <attribute name="column_invisible" add="parent.repair_line_type not in ['recycle', 'remove']" separator="and"/>
            </xpath>
        </field>
    </record>

</odoo>
