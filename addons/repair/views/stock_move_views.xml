<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.actions.act_window" id="action_repair_move_lines">
        <field name="name">Inventory Moves</field>
        <field name="res_model">stock.move.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('move_id.repair_id', '=', active_id)]</field>
    </record>

    <record id="view_scrap_move_form" model="ir.ui.view">
        <field name="name">scrap.move.scrap.form.inherit.repair</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_scrap_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_id']" position="after">
                <field name="repair_id" invisible="not repair_id" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
