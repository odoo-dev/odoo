<odoo>
    <data noupdate="1">
        <record id="devdata.demo_call_channel" model="discuss.channel">
            <field name="name">Demo Call Channel</field>
            <field name="channel_type">channel</field>
        </record>
        <record id="devdata.demo_call_channel_member" model="discuss.channel.member">
            <field name="partner_id" eval="ref('devdata.user_demo_dev')"/>
            <field name="channel_id" ref="devdata.demo_call_channel"/>
        </record>
        <record id="devdata.demo_call_start_message" model="mail.message">
            <field name="body">Starting a demo call</field>
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="demo_call_channel"/>
            <field name="author_id" eval="ref('devdata.user_demo_dev')"/>
        </record>
    </data>
</odoo>
