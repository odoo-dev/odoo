<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="livechat_channel_expertise_session_3" model="discuss.channel">
            <field name="channel_type">livechat</field>
            <field name="livechat_channel_id" ref="im_livechat_expertise_channel_data"/>
            <field name="livechat_operator_id" ref="expertise_bot_operator_partner_demo"/>
            <field name="livechat_failure">no_failure</field>
            <field name="name">Visitor #1001, Expertise Odoo</field>
            <field name="anonymous_name">Visitor #1001</field>
            <field name="create_date" eval="DateTime.today() + relativedelta(months=-1)"/>
        </record>
        <record id="livechat_channel_expertise_session_3_member_bot_demo" model="discuss.channel.member">
            <field name="partner_id" ref="expertise_bot_operator_partner_demo"/>
            <field name="channel_id" ref="livechat_channel_expertise_session_3"/>
            <field name="last_interest_dt" eval="DateTime.today() + relativedelta(months=-1)"/>
            <field name="livechat_member_type">bot</field>
            <field name="chatbot_script_id" ref="chatbot_script_expertise_bot_demo"/>
        </record>
        <record id="livechat_channel_expertise_session_3_guest_demo" model="mail.guest">
            <field name="name">Visitor #1001</field>
        </record>
        <record id="livechat_channel_expertise_session_3_member_guest_demo" model="discuss.channel.member">
            <field name="guest_id" ref="livechat_channel_expertise_session_1_guest_demo"/>
            <field name="channel_id" ref="livechat_channel_expertise_session_3"/>
            <field name="livechat_member_type">visitor</field>
        </record>
        <record id="livechat_channel_expertise_session_3_message_1_demo" model="mail.message">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="livechat_channel_expertise_session_3"/>
            <field name="message_type">comment</field>
            <field name="author_id" ref="expertise_bot_operator_partner_demo"/>
            <field name="body">Welcome!</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field eval="DateTime.today() + relativedelta(months=-1, days=-0, minutes=1)" name="date"/>
        </record>
        <record id="livechat_channel_expertise_session_3_message_2_demo" model="mail.message">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="livechat_channel_expertise_session_3"/>
            <field name="message_type">comment</field>
            <field name="author_id" ref="expertise_bot_operator_partner_demo"/>
            <field name="body">What module you are interested?</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field eval="DateTime.today() + relativedelta(months=-1, days=-0, minutes=2)" name="date"/>
        </record>
        <record id="livechat_channel_expertise_session_3_message_3_demo" model="mail.message">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="livechat_channel_expertise_session_3"/>
            <field name="message_type">comment</field>
            <field name="author_guest_id" ref="livechat_channel_chatbot_session_3_guest_demo"/>
            <field name="author_id"/>
            <field name="body">Discuss and Livechat</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field eval="DateTime.today() + relativedelta(months=-1, days=-0, minutes=3)" name="date"/>
        </record>
        <record id="livechat_channel_expertise_session_3_message_4_demo" model="mail.message">
            <field name="model">discuss.channel</field>
            <field name="res_id" ref="livechat_channel_expertise_session_3"/>
            <field name="message_type">comment</field>
            <field name="author_id" ref="expertise_bot_operator_partner_demo"/>
            <field name="body">Hmmm, let me check if I can find someone who knows discuss and livechat well...</field>
            <field name="subtype_id" ref="mail.mt_comment"/>
            <field eval="DateTime.today() + relativedelta(months=-1, days=-0, minutes=4)" name="date"/>
        </record>
        <record id="livechat_channel_expertise_session_3_member_agent_demo" model="discuss.channel.member">
            <field name="partner_id" ref="base.partner_admin"/>
            <field name="channel_id" ref="livechat_channel_expertise_session_3"/>
            <field name="livechat_member_type">agent</field>
            <field name="agent_expertise_ids" eval="[(4, ref('chatbot_script_discuss_expertise_demo')),(4, ref('chatbot_script_livechat_expertise_demo'))]"/>
        </record>
    </data>
</odoo>
