<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="im_livechat.LivechatBrowsingHistory">
        <div class="d-flex flex-column bg-inherit gap-1">
            <div class="d-flex align-items-center justify-content-between pt-3">
                <h6 class="mb-0">Recent page views</h6>
                <button t-if="!this.props.channel.livechat_end_dt" t-on-click="this.requestBrowsingHistory" type="button" title="Refresh recent page views" class="btn btn-sm btn-link" t-att-class="{ 'disabled': this.props.channel.browsingHistoryStatus === 'loading' }">
                    <i class="oi" data-icon="refresh" role="img" aria-hidden="true"/>
                    Refresh
                </button>
            </div>
            <div t-if="this.props.channel.browsingHistoryStatus === 'loading'" class="d-flex align-items-center gap-2 text-muted small">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"/>
                Loading recent page views...
            </div>
            <div t-elif="this.props.channel.browsingHistoryStatus === 'error'" class="d-flex align-items-baseline gap-2 text-muted small">
                <i class="oi text-warning" data-icon="warning" role="img" aria-hidden="true"/>
                Couldn't load recent page views. The visitor may be offline.
            </div>
            <div t-elif="this.props.channel.browsingHistoryStatus === 'unavailable'" class="text-muted small">
                Recent page views are unavailable after the conversation has ended.
            </div>
            <t t-elif="this.props.channel.browsingHistoryStatus === 'ready'">
                <span t-if="this.props.channel.browsingHistory.length === 0" class="text-muted small">
                    No recent page views available.
                </span>
                <t t-else="" t-call="im_livechat.PageViewsList" templateParams="{ pageViews: this.pageViews() }"/>
            </t>
        </div>
    </t>

    <t t-name="im_livechat.PageViewsList">
        <div class="d-flex flex-column o-gap-0_5">
            <a t-foreach="templateParams.pageViews" t-as="visit" t-key="visit_index" t-att-href="visit.url" t-att-title="visit.url" target="_blank" class="btn btn-sm btn-secondary d-flex align-items-center gap-2 px-3 py-1 rounded-0" t-att-class="{ 'o-rounded-top-bubble': visit_first, 'o-rounded-bottom-bubble': visit_last }">
                <i class="oi" data-icon="open_in_new" role="img" aria-label="Opens in a new tab"/>
                <span class="fw-bold text-truncate flex-grow-1 text-start" t-out="visit.title || visit.url"/>
                <span t-if="visit.visitTime" class="small text-muted flex-shrink-0" t-out="visit.visitTime"/>
            </a>
        </div>
    </t>
</templates>
