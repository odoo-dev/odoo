<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_online_payment_self_checkout.ScanningPage" t-inherit="pos_self_checkout.ScanningPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-container')]" position="after">
            <div t-if="this.selectedPaymentIsOnline and !this.state.selection" class="d-flex justify-content-center align-items-center flex-column h-100 px-3 text-center o_self_fade">
                <h1 class="fw-bolder mb-4">Scan the QR code to pay</h1>
                <div class="qr-code d-inline-flex flex-column border rounded-4 p-0 bg-view mb-3">
                    <img class="p-5" t-att-src="this.state.qrImage" />
                </div>
                <h3 t-if="this.selfOrder.onlinePaymentStatus === 'progress'">Payment in progress</h3>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('payment-container')]" position="attributes">
            <attribute name="t-if">!this.selectedPaymentIsOnline and !this.state.selection</attribute>
        </xpath>
    </t>
</templates>
