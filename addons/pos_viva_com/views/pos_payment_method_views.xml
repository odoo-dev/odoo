<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_viva_com" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.viva.com</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <page name="terminals" position="attributes">
                <attribute name="invisible" add="payment_provider == 'viva_com'" separator=" or "/>
            </page>
            <page name="terminals" position="before">
                <page name="viva_com_settings" string="Viva Com" invisible="payment_provider != 'viva_com'">
                    <separator string="Credentials" style="margin-top: 0.5rem !important;"/>
                    <group>
                        <field name="viva_com_merchant_id" invisible="payment_provider != 'viva_com'" required="payment_provider == 'viva_com'"/>
                        <field name="viva_com_api_key" invisible="payment_provider != 'viva_com'" required="payment_provider == 'viva_com'"/>
                        <field name="viva_com_client_id" invisible="payment_provider != 'viva_com'" required="payment_provider == 'viva_com'"/>
                        <field name="viva_com_client_secret" invisible="payment_provider != 'viva_com'" required="payment_provider == 'viva_com'"/>
                        <field name="viva_com_test_mode" invisible="payment_provider != 'viva_com'" required="payment_provider == 'viva_com'"/>
                        <field name="viva_com_webhook_endpoint" invisible="payment_provider != 'viva_com' or not id" required="payment_provider == 'viva_com'" widget="CopyClipboardChar"/>
                    </group>
                    <separator string="Terminals"/>
                    <field name="terminal_ids" widget="pos_payment_terminals"/>
                </page>
            </page>
        </field>
    </record>
</odoo>
