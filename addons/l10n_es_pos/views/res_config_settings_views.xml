<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="pos_config_view_form_inherit_l10n_es_pos" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.l10n_es_pos</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_default_journals']/div" position="inside">
                <div class="row" invisible="country_code != 'ES'">
                    <label string="Simplified Invoice" for="l10n_es_simplified_invoice_journal_id" class="col-lg-3 o_light_label"/>
                    <field name="l10n_es_simplified_invoice_journal_id" context="{'default_company_id': company_id, 'default_type': 'sale', 'default_code': 'SINV'}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
