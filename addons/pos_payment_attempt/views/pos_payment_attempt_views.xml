<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_attempt_list" model="ir.ui.view">
        <field name="name">pos.payment.attempt.list</field>
        <field name="model">pos.payment.attempt</field>
        <field name="arch" type="xml">
            <list string="Terminal Transactions" create="0" edit="0">
                <field name="create_date" string="Started"/>
                <field name="transaction_id"/>
                <field name="pos_order_id"/>
                <field name="payment_method_id"/>
                <field name="amount"/>
                <field name="message" optional="show"/>
                <field name="write_date" string="Last Update" optional="hide"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'success'"
                    decoration-info="state in ('initiated', 'processing')"
                    decoration-warning="state == 'timeout'"
                    decoration-danger="state in ('failed', 'cancelled')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pos_payment_attempt_search" model="ir.ui.view">
        <field name="name">pos.payment.attempt.search</field>
        <field name="model">pos.payment.attempt</field>
        <field name="arch" type="xml">
            <search string="Terminal Transactions">
                <field name="transaction_id"/>
                <field name="pos_order_id"/>
                <field name="payment_method_id"/>
                <filter string="In Progress" name="in_progress" domain="[('state', 'in', ('initiated', 'processing'))]"/>
                <filter string="Successful" name="success" domain="[('state', '=', 'success')]"/>
                <filter string="Not Paid" name="not_paid" domain="[('state', 'in', ('failed', 'cancelled', 'timeout'))]"/>
                <separator/>
                <filter string="Started" name="create_date" date="create_date"/>
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Payment Method" name="group_by_payment_method" context="{'group_by': 'payment_method_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_payment_attempt" model="ir.actions.act_window">
        <field name="name">Terminal Transactions</field>
        <field name="res_model">pos.payment.attempt</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_pos_payment_attempt_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No terminal transactions yet</p>
            <p>Every transaction started on a payment terminal from the Point of Sale is listed here with its status.</p>
        </field>
    </record>

    <menuitem id="menu_pos_payment_attempt" parent="point_of_sale.menu_point_of_sale"
        action="action_pos_payment_attempt" sequence="4" groups="point_of_sale.group_pos_manager"/>
</odoo>
