<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_inherit_payment_attempt" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.payment.attempt</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_payment_attempts" type="object" class="oe_stat_button"
                    icon="payments" invisible="payment_attempt_count == 0">
                    <field name="payment_attempt_count" widget="statinfo" string="Payment Attempts"/>
                </button>
            </div>
            <sheet position="before">
                <div class="alert alert-warning mb-0" role="alert" invisible="open_payment_attempt_count == 0">
                    <field name="open_payment_attempt_count" class="fw-bold"/> payment attempt(s) of this session have no known outcome.
                    Check them in <button name="action_view_payment_attempts" type="object" class="btn btn-link p-0 align-baseline" string="Payment Attempts"/> before closing.
                </div>
            </sheet>
        </field>
    </record>
</odoo>
