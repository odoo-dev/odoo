<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_attempt.PaymentAttemptRecoveryDialog">
        <Dialog title="this.title" size="'lg'" contentClass="'o_pos_payment_attempt_recovery'">
            <p>
                These terminal payments were started on this order, but their outcome never reached the Point of Sale.
                Check them before asking the customer to pay again.
            </p>
            <div class="d-flex flex-column gap-2">
                <div t-foreach="this.state.attempts" t-as="attempt" t-key="attempt.id"
                    class="o_pos_payment_attempt_item card p-3 d-flex flex-row justify-content-between align-items-center gap-3">
                    <div class="d-flex flex-column">
                        <div>
                            <strong t-out="attempt.payment_method_name"/>
                            <span class="ms-2 fw-bolder" t-out="this.formatAmount(attempt.amount)"/>
                            <span class="badge ms-2"
                                t-att-class="this.isPaid(attempt) ? 'text-bg-success' : 'text-bg-warning'"
                                t-out="attempt.state_label"/>
                        </div>
                        <small class="text-muted">
                            <t t-if="attempt.name">Ref. <t t-out="attempt.name"/> · </t>
                            Started <t t-out="this.formatDate(attempt.date_start)"/>
                            <t t-if="attempt.card_no"> · Card ****<t t-out="attempt.card_no"/></t>
                        </small>
                        <small t-if="attempt.error_message" class="text-danger" t-out="attempt.error_message"/>
                    </div>
                    <div class="d-flex gap-2 flex-shrink-0">
                        <button t-if="this.isPaid(attempt)" class="btn btn-primary o_add_as_paid"
                            t-att-disabled="this.state.busy[attempt.id]"
                            t-on-click="() => this.addAsPaid(attempt)">Add as paid</button>
                        <button t-elif="attempt.name" class="btn btn-primary o_check_status"
                            t-att-disabled="this.state.busy[attempt.id]"
                            t-on-click="() => this.checkStatus(attempt)">Check status</button>
                        <button class="btn btn-secondary o_dismiss"
                            t-att-disabled="this.state.busy[attempt.id]"
                            t-on-click="() => this.dismiss(attempt)">
                            <t t-if="this.isPaid(attempt)">Ignore</t>
                            <t t-else="">Not paid, dismiss</t>
                        </button>
                    </div>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="this.props.close">Decide later</button>
            </t>
        </Dialog>
    </t>
</templates>
