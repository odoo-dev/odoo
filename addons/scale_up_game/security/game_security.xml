<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_game_session_own" model="ir.rule">
        <field name="name">Scale-Up session: own sessions</field>
        <field name="model_id" ref="model_scale_up_game_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_game_session_system" model="ir.rule">
        <field name="name">Scale-Up session: administrators see all</field>
        <field name="model_id" ref="model_scale_up_game_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
