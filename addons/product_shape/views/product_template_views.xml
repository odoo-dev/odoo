<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.product.shape</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="group_general" position="inside">
                <field name="shape_type" invisible="type != 'consu'"/>
                <field name="shape_density" invisible="not shape_type"/>
                <field name="shape_dimension_uom_id" invisible="not shape_type" required="shape_type"
                       options="{'no_create': True, 'no_open': True}"/>
            </group>
        </field>
    </record>
</odoo>
