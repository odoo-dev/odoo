<?xml version="1.0" ?>
<odoo><data>

<template id="courses_my">
    <t t-if="channels_my and not search_my and not search_channel_filters">
        <t t-set="channels_continue" t-value="channels_my.filtered(lambda c: not c.completed)"/>
        <t t-set="channels_continue_display" t-value="channels_continue[:3]"/>
        <section t-if="channels_continue_display" class="mb32">
            <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
                <h2 class="h5-fs mb-0">Continue learning</h2>
            </div>
            <div class="d-flex gap-3">
                <div class="row g-3 flex-grow-1">
                    <t t-foreach="channels_continue_display" t-as="channel">
                        <t t-set="continue_card_col_class" t-value="'col-12 col-md-6 col-xxl-4 d-flex' if channel_index == 0 else 'col-12 col-md-6 col-xxl-4 d-none d-md-flex' if channel_index == 1 else 'col-12 col-md-6 col-xxl-4 d-none d-xxl-flex'"/>
                        <div t-att-class="continue_card_col_class">
                            <t t-call="website_slides.course_continue_card"/>
                        </div>
                    </t>
                </div>
                <a href="/slides?my=1" class="o_wslides_continue_learning_view_all card justify-content-center flex-shrink-0 p-3 rounded-4 smaller text-body text-decoration-none">View all</a>
            </div>
        </section>
    </t>
</template>

<template id="courses_filter_sidebar">
    <div class="accordion accordion-flush o_wslides_filter_sidebar">
        <!-- Clear filters -->
        <t t-if="search_price or search_min_rating or search_tags or search_my_filter">
            <div class="py-2 border-bottom mb-2">
                <a t-att-href="slide_query_url(price='', min_rating='', tag='', my_filter='', my=search_my, search=search_term, slide_category=search_slide_category)"
                    class="btn btn-link px-0 d-flex align-items-center py-1 text-decoration-none">
                    <small class="mx-auto"><b>Clear Filters</b></small>
                    <i class="oi oi-close" role="presentation" aria-hidden="true"/>
                </a>
            </div>
        </t>
        <!-- Status (only when My Courses filter is active) -->
        <t t-if="search_my">
            <div class="accordion-item">
                <div class="accordion-header mb-0">
                    <button t-attf-class="accordion-button px-0 bg-transparent shadow-none #{'collapsed' if not search_my_filter else ''}"
                        type="button" data-bs-toggle="collapse" data-bs-target="#o_wslides_filter_status"
                        t-att-aria-expanded="'true' if search_my_filter else 'false'" aria-controls="o_wslides_filter_status">
                        <b>Status</b>
                    </button>
                </div>
                <div id="o_wslides_filter_status" t-attf-class="accordion-collapse collapse #{'show' if search_my_filter else ''}">
                    <div class="mb-3">
                        <t t-foreach="[('in_progress', 'In Progress'), ('not_started', 'Not Started'), ('completed', 'Completed')]" t-as="status_opt">
                            <t t-set="_active_status_filters" t-value="(search_my_filter or '').split(',')"/>
                            <t t-set="_status_is_active" t-value="status_opt[0] in _active_status_filters"/>
                            <t t-set="_new_status_filter" t-value="','.join([f for f in _active_status_filters if f and f != status_opt[0]] + ([] if _status_is_active else [status_opt[0]]))"/>
                            <div t-att-data-post="slide_query_url(my_filter=_new_status_filter, tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                class="post_link form-check mb-1 cursor-pointer">
                                <input class="form-check-input pe-none" type="checkbox"
                                    t-attf-id="o_wslides_filter_status_#{status_opt[0]}"
                                    t-att-checked="_status_is_active"/>
                                <label class="form-check-label w-100 cursor-pointer"
                                    t-attf-for="o_wslides_filter_status_#{status_opt[0]}"
                                    t-out="status_opt[1]"/>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>
        <!-- Price -->
        <div class="accordion-item">
            <div class="accordion-header mb-0">
                <button t-attf-class="accordion-button px-0 bg-transparent shadow-none #{'collapsed' if not search_price else ''}"
                    type="button" data-bs-toggle="collapse" data-bs-target="#o_wslides_filter_price"
                    t-att-aria-expanded="'true' if search_price else 'false'" aria-controls="o_wslides_filter_price">
                    <b>Price</b>
                </button>
            </div>
            <div id="o_wslides_filter_price" t-attf-class="accordion-collapse collapse #{'show' if search_price else ''}">
                <div class="mb-3">
                    <t t-foreach="[('free', 'Free'), ('paid', 'Paid')]" t-as="price_opt">
                        <t t-set="_active_price_filters" t-value="(search_price or '').split(',')"/>
                        <t t-set="_price_is_active" t-value="price_opt[0] in _active_price_filters"/>
                        <t t-set="_new_price_filter" t-value="','.join([f for f in _active_price_filters if f and f != price_opt[0]] + ([] if _price_is_active else [price_opt[0]]))"/>
                        <div t-att-data-post="slide_query_url(price=_new_price_filter, tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                            class="post_link form-check mb-1 cursor-pointer">
                            <input class="form-check-input pe-none" type="checkbox"
                                t-attf-id="o_wslides_filter_price_#{price_opt[0]}"
                                t-att-checked="_price_is_active"/>
                            <label class="form-check-label w-100 cursor-pointer"
                                t-attf-for="o_wslides_filter_price_#{price_opt[0]}"
                                t-out="price_opt[1]"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
        <!-- Rating -->
        <div class="accordion-item">
            <div class="accordion-header mb-0">
                <button t-attf-class="accordion-button px-0 bg-transparent shadow-none #{'collapsed' if not search_min_rating else ''}"
                    type="button" data-bs-toggle="collapse" data-bs-target="#o_wslides_filter_rating"
                    t-att-aria-expanded="'true' if search_min_rating else 'false'" aria-controls="o_wslides_filter_rating">
                    <b>Ratings</b>
                </button>
            </div>
            <div id="o_wslides_filter_rating" t-attf-class="accordion-collapse collapse #{'show' if search_min_rating else ''}">
                <div class="mb-3">
                    <t t-foreach="[(4.5, '4.5'), (4.0, '4.0'), (3.5, '3.5'), (3.0, '3.0')]" t-as="rating_opt">
                        <div t-att-data-post="slide_query_url(min_rating=str(rating_opt[0]), tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                            class="post_link form-check mb-1 cursor-pointer">
                            <input class="form-check-input pe-none" type="radio" name="o_wslides_rating"
                                t-attf-id="o_wslides_filter_rating_#{int(rating_opt[0] * 10)}"
                                t-att-checked="search_min_rating == rating_opt[0]"/>
                            <label class="form-check-label w-100 cursor-pointer"
                                t-attf-for="o_wslides_filter_rating_#{int(rating_opt[0] * 10)}">
                                <t t-foreach="range(int(rating_opt[0]))" t-as="s">
                                    <i class="fa fa-star text-warning" aria-hidden="true"/>
                                </t>
                                <t t-if="rating_opt[0] % 1 != 0">
                                    <i class="fa fa-star-half-o text-warning" aria-hidden="true"/>
                                </t>
                                <t t-out="rating_opt[1]"/> &amp; up
                            </label>
                        </div>
                    </t>
                </div>
            </div>
        </div>
        <!-- Topics -->
        <t t-if="tag_groups">
            <t t-foreach="tag_groups" t-as="tag_group">
                <t t-set="group_frontend_tags" t-value="tag_group.tag_ids.filtered(lambda tag: tag.color)"/>
                <t t-if="group_frontend_tags">
                    <t t-set="group_is_active" t-value="bool(group_frontend_tags.filtered(lambda t: t in search_tags))"/>
                    <div class="accordion-item">
                        <div class="accordion-header mb-0">
                            <button t-attf-class="accordion-button px-0 bg-transparent shadow-none #{'collapsed' if not group_is_active else ''}"
                                type="button" data-bs-toggle="collapse"
                                t-attf-data-bs-target="#o_wslides_filter_topics_#{tag_group.id}"
                                t-att-aria-expanded="'true' if group_is_active else 'false'"
                                t-attf-aria-controls="o_wslides_filter_topics_#{tag_group.id}">
                                <b t-out="tag_group.name"/>
                            </button>
                        </div>
                        <div t-attf-id="o_wslides_filter_topics_#{tag_group.id}"
                            t-attf-class="accordion-collapse collapse #{'show' if group_is_active else ''}">
                            <div class="mb-3">
                                <t t-foreach="group_frontend_tags" t-as="tag">
                                    <div t-att-data-post="slide_query_url(tag=slugify_tags(search_tags.ids, toggle_tag_id=tag.id), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                        class="post_link form-check mb-1 cursor-pointer">
                                        <input class="form-check-input pe-none" type="checkbox"
                                            t-attf-id="o_wslides_sidebar_tag_#{tag.id}"
                                            t-att-checked="tag in search_tags"/>
                                        <label class="form-check-label w-100 cursor-pointer"
                                            t-attf-for="o_wslides_sidebar_tag_#{tag.id}"
                                            t-out="tag.name"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </div>
</template>

<!-- Channels home template -->
<template id='courses_home' name="Odoo Courses Homepage">
    <t t-set="body_classname" t-value="'o_wslides_body'"/>
    <t t-set="is_website_guest" t-value="is_public_user"/>
    <t t-call="website.layout">
        <div id="wrap" class="wrap o_wslides_wrap">
            <div class="oe_structure oe_empty"/>
            <div class="container">
                <t t-call="website_slides.courses_search_bar"/>
                <div class="row">
                    <div class="d-none d-lg-block col-lg-4 col-xl-3">
                        <t t-call="website_slides.courses_filter_sidebar"/>
                    </div>
                    <div t-attf-class="col-12 col-lg-8 col-xl-9 ps-lg-4">
                        <div t-if="invite_error_msg" role="alert" class="o_not_editable alert alert-danger text-center" t-out="invite_error_msg"/>
                        <div class="o_wslides_home_nav">
                            <div class="o_wprofile_email_validation_container">
                                <t t-call="website_profile.email_validation_banner"
                                    redirect_url.f="/slides"
                                    send_alert_classes.f="alert alert-danger alert-dismissable mt-4 mb-0"
                                    done_alert_classes.f="alert alert-success alert-dismissable mt-4 mb-0"
                                    additional_validation_email_message.translate="and join this Community"
                                    additional_validated_email_message.translate="You may now participate in our eLearning."/>
                            </div>
                        </div>
                        <div t-if="is_website_guest" class="alert alert-primary bg-primary-light d-lg-flex align-items-start justify-content-between mb32" role="alert">
                            <div>
                                <h2 class="alert-heading h6-fs">Start learning today!</h2>
                                <small>Create your free account to start learning today.</small>
                            </div>
                            <a href="/web/signup?redirect=/slides" class="btn btn-primary flex-shrink-0 mt-3 mt-lg-0">Create your account</a>
                        </div>
                        <t t-set="search_channel_filters" t-value="search_term or search_slide_category or search_my or search_tags or search_price or search_min_rating or search_my_filter"/>
                        <t t-call="website_slides.courses_my"/>
                        <t t-call="website_slides.courses_catalog"/>
                    </div>
                </div>
            </div>
            <t t-call="website_slides.courses_footer"/>
            <!-- Off canvas filters on mobile -->
            <div id="o_wslides_index_offcanvas" class="o_website_offcanvas offcanvas offcanvas-end d-lg-none p-0 overflow-visible">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title">Filters</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"/>
                </div>
                <div class="offcanvas-body p-0">
                    <div class="accordion accordion-flush">
                        <!-- Status Filter (only when My Courses filter is active) -->
                        <t t-if="search_my">
                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    <button t-attf-class="accordion-button #{'collapsed' if not search_my_filter else ''}" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#o_wslides_mobile_status"
                                        t-att-aria-expanded="'true' if search_my_filter else 'false'" aria-controls="o_wslides_mobile_status">
                                        Status
                                    </button>
                                </h2>
                                <div id="o_wslides_mobile_status" t-attf-class="accordion-collapse collapse #{'show' if search_my_filter else ''}">
                                    <div class="accordion-body pt-0">
                                        <t t-foreach="[('in_progress', 'In Progress'), ('not_started', 'Not Started'), ('completed', 'Completed')]" t-as="status_opt">
                                            <t t-set="_active_status_filters" t-value="(search_my_filter or '').split(',')"/>
                                            <t t-set="_status_is_active" t-value="status_opt[0] in _active_status_filters"/>
                                            <t t-set="_new_status_filter" t-value="','.join([f for f in _active_status_filters if f and f != status_opt[0]] + ([] if _status_is_active else [status_opt[0]]))"/>
                                            <div t-att-data-post="slide_query_url(my_filter=_new_status_filter, tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                                class="post_link form-check mb-1 cursor-pointer">
                                                <input class="form-check-input pe-none" type="checkbox"
                                                    t-attf-id="o_wslides_mobile_filter_status_#{status_opt[0]}"
                                                    t-att-checked="_status_is_active"/>
                                                <label class="form-check-label w-100 cursor-pointer"
                                                    t-attf-for="o_wslides_mobile_filter_status_#{status_opt[0]}"
                                                    t-out="status_opt[1]"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <!-- Price Filter -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button t-attf-class="accordion-button #{'collapsed' if not search_price else ''}" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#o_wslides_mobile_price"
                                    t-att-aria-expanded="'true' if search_price else 'false'" aria-controls="o_wslides_mobile_price">
                                    Price
                                </button>
                            </h2>
                            <div id="o_wslides_mobile_price" t-attf-class="accordion-collapse collapse #{'show' if search_price else ''}">
                                <div class="accordion-body pt-0">
                                    <t t-foreach="[('free', 'Free'), ('paid', 'Paid')]" t-as="price_opt">
                                        <t t-set="_active_price_filters" t-value="(search_price or '').split(',')"/>
                                        <t t-set="_price_is_active" t-value="price_opt[0] in _active_price_filters"/>
                                        <t t-set="_new_price_filter" t-value="','.join([f for f in _active_price_filters if f and f != price_opt[0]] + ([] if _price_is_active else [price_opt[0]]))"/>
                                        <div t-att-data-post="slide_query_url(price=_new_price_filter, tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                            class="post_link form-check mb-1 cursor-pointer">
                                            <input class="form-check-input pe-none" type="checkbox"
                                                t-attf-id="o_wslides_mobile_filter_price_#{price_opt[0]}"
                                                t-att-checked="_price_is_active"/>
                                            <label class="form-check-label w-100 cursor-pointer"
                                                t-attf-for="o_wslides_mobile_filter_price_#{price_opt[0]}"
                                                t-out="price_opt[1]"/>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <!-- Rating Filter -->
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button t-attf-class="accordion-button #{'collapsed' if not search_min_rating else ''}" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#o_wslides_mobile_rating"
                                    t-att-aria-expanded="'true' if search_min_rating else 'false'" aria-controls="o_wslides_mobile_rating">
                                    Ratings
                                </button>
                            </h2>
                            <div id="o_wslides_mobile_rating" t-attf-class="accordion-collapse collapse #{'show' if search_min_rating else ''}">
                                <div class="accordion-body pt-0">
                                    <div t-att-data-post="slide_query_url(min_rating='', tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                        class="post_link form-check mb-1 cursor-pointer">
                                        <input class="form-check-input pe-none" type="radio" name="o_wslides_mobile_rating"
                                            id="o_wslides_mobile_filter_rating_any" t-att-checked="not search_min_rating"/>
                                        <label class="form-check-label w-100 cursor-pointer" for="o_wslides_mobile_filter_rating_any">Any rating</label>
                                    </div>
                                    <div t-att-data-post="slide_query_url(min_rating='4.5', tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                        class="post_link form-check mb-1 cursor-pointer">
                                        <input class="form-check-input pe-none" type="radio" name="o_wslides_mobile_rating"
                                            id="o_wslides_mobile_filter_rating_45" t-att-checked="search_min_rating == 4.5"/>
                                        <label class="form-check-label w-100 cursor-pointer" for="o_wslides_mobile_filter_rating_45"><i class="fa fa-star me-1 text-warning" aria-hidden="true"/>4.5 &amp; up</label>
                                    </div>
                                    <div t-att-data-post="slide_query_url(min_rating='4.0', tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                        class="post_link form-check mb-1 cursor-pointer">
                                        <input class="form-check-input pe-none" type="radio" name="o_wslides_mobile_rating"
                                            id="o_wslides_mobile_filter_rating_40" t-att-checked="search_min_rating == 4.0"/>
                                        <label class="form-check-label w-100 cursor-pointer" for="o_wslides_mobile_filter_rating_40"><i class="fa fa-star me-1 text-warning" aria-hidden="true"/>4.0 &amp; up</label>
                                    </div>
                                    <div t-att-data-post="slide_query_url(min_rating='3.5', tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                        class="post_link form-check mb-1 cursor-pointer">
                                        <input class="form-check-input pe-none" type="radio" name="o_wslides_mobile_rating"
                                            id="o_wslides_mobile_filter_rating_35" t-att-checked="search_min_rating == 3.5"/>
                                        <label class="form-check-label w-100 cursor-pointer" for="o_wslides_mobile_filter_rating_35"><i class="fa fa-star me-1 text-warning" aria-hidden="true"/>3.5 &amp; up</label>
                                    </div>
                                    <div t-att-data-post="slide_query_url(min_rating='3.0', tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                        class="post_link form-check mb-1 cursor-pointer">
                                        <input class="form-check-input pe-none" type="radio" name="o_wslides_mobile_rating"
                                            id="o_wslides_mobile_filter_rating_30" t-att-checked="search_min_rating == 3.0"/>
                                        <label class="form-check-label w-100 cursor-pointer" for="o_wslides_mobile_filter_rating_30"><i class="fa fa-star me-1 text-warning" aria-hidden="true"/>3.0 &amp; up</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Tag Groups Filters -->
                        <div class="accordion-item" t-foreach="tag_groups" t-as="tag_group">
                            <t t-set="group_frontend_tags" t-value="tag_group.tag_ids.filtered('color')"/>
                            <t t-if="group_frontend_tags">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        t-attf-aria-controls="o_wslides_offcanvas_cat_#{tag_group.id}"
                                        t-att-data-bs-target="'.o_wslides_offcanvas_cat_%s' % tag_group.id"
                                        aria-expanded="false"
                                    >
                                        <t t-out="tag_group.name"/>
                                    </button>
                                </h2>
                                <div t-attf-id="o_wslides_offcanvas_cat_#{tag_group.id}" t-attf-class="o_wslides_offcanvas_cat_#{tag_group.id} accordion-collapse collapse">
                                    <div class="accordion-body pt-0">
                                        <ul class="list-group list-group-flush">
                                            <li t-foreach="group_frontend_tags" t-as="tag" class="list-group-item border-0 px-0">
                                                <div t-att-data-post="slide_query_url(tag=slugify_tags(search_tags.ids, toggle_tag_id=tag.id), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                                                    class="post_link text-reset cursor-pointer" t-att-title="tag.name">
                                                    <div class="form-check">
                                                        <input class="form-check-input pe-none" type="checkbox" t-attf-name="#{tag.color}" t-att-checked="tag in search_tags"/>
                                                        <label class="form-check-label" t-attf-for="#{tag.color}" t-out="tag.name"/>
                                                    </div>
                                                </div>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="offcanvas-body flex-grow-0 border-top overflow-hidden">
                    <a t-att-href="slide_query_url(price='', min_rating='', tag='', my_filter='', my=search_my, search=search_term, slide_category=search_slide_category)" class="btn btn-light">Clear Filters</a>
                </div>
            </div>
        </div>
    </t>
</template>

<template id="courses_search_bar">
    <!-- Navbar dynamically composed using displayed channel tag groups. -->
    <div class="d-flex flex-wrap align-items-md-center gap-2 my-4">
        <div class="d-flex flex-column gap-3 flex-grow-1 w-100">
            <div class="d-flex gap-4 align-items-center w-100">
                <h1 class="h4 mb-0 me-auto"><t t-if="search_my">My Courses</t><t t-else="">Courses</t></h1>
                <t t-call="website.website_search_box_input"
                    _form_classes.f="d-none d-md-flex#{' border-end pe-4' if not is_public_user else ''}"
                    search_type.f="slides"
                    placeholder.translate="Search courses..."
                    search="original_search or search_term">
                    <input type="hidden" name="my" t-attf-value="#{1 if search_my else 0}"/>
                    <input t-if="search_slide_category" type="hidden" name="slide_category" t-att-value="search_slide_category" />
                    <input type="hidden" name="prevent_redirect" value="True"/>
                </t>
                <div t-if="not is_public_user" class="position-relative d-flex gap-2 flex-shrink-0">
                    <div class="d-flex gap-2">
                        <t t-call="website_slides.slides_misc_user_image"
                            img_class.f="o_wslides_user_avatar rounded-circle"/>
                        <div class="d-none d-md-block lh-1">
                            <h6 t-out="user.name" class="mb-0 small"/>
                            <small class="text-muted"><t t-out="user.karma"/>XP</small>
                        </div>
                    </div>
                    <a class="stretched-link" t-att-href="'/profile/user/%s' % user.id"><span class="visually-hidden">View</span></a>
                </div>
                <button class="o_not_editable btn btn-light position-relative flex-shrink-0 d-none d-md-inline-block d-lg-none"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#o_wslides_index_offcanvas">
                    <i class="oi" data-icon="tune"/>
                    <span t-if="search_tags or search_my or search_price or search_min_rating"
                        class="position-absolute top-0 start-100 translate-middle border border-light rounded-circle bg-danger p-1"
                    />
                </button>
            </div>
            <div class="d-flex gap-2 d-md-none">
                <!-- Mobile Search -->
                <t t-call="website.website_search_box_input"
                    search_type.f="slides"
                    placeholder.translate="Search courses..."
                    search="original_search or search_term"
                    _form_classes.f="d-md-none flex-grow-1">
                    <input type="hidden" name="my" t-attf-value="#{1 if search_my else 0}"/>
                    <input t-if="search_slide_category" type="hidden" name="slide_category" t-att-value="search_slide_category" />
                    <input type="hidden" name="prevent_redirect" value="True"/>
                </t>
                <!-- Mobile Filter button -->
                <button class="o_not_editable btn btn-light position-relative flex-shrink-0"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#o_wslides_index_offcanvas">
                    <i class="oi" data-icon="tune"/>
                    <span t-if="search_tags or search_my or search_price or search_min_rating"
                        class="position-absolute top-0 start-100 translate-middle border border-light rounded-circle bg-danger p-1"
                    />
                </button>
            </div>
        </div>
    </div>
</template>

<template id="courses_search_tags">
    <t t-if="search_my">
        <span class="align-items-baseline border d-inline-flex ps-2 rounded mb-2">
            <i class="oi me-2 text-muted" data-icon="label"/>
            My Courses
            <span t-att-data-post="slide_query_url(tag=slugify_tags(search_tags.ids), search=search_term, prevent_redirect=True)"
                class="post_link cursor-pointer btn border-0 py-1">×</span>
        </span>
    </t>
    <t t-foreach="[('in_progress', 'In Progress'), ('not_started', 'Not Started'), ('completed', 'Completed')]" t-as="status_opt">
        <t t-if="status_opt[0] in (search_my_filter or '').split(',')">
            <t t-set="_new_status_filter" t-value="','.join([f for f in (search_my_filter or '').split(',') if f and f != status_opt[0]])"/>
            <span class="align-items-baseline border d-inline-flex ps-2 rounded mb-2">
                <i class="oi me-2 text-muted" data-icon="label"/>
                <t t-out="status_opt[1]"/>
                <span t-att-data-post="slide_query_url(my_filter=_new_status_filter, tag=slugify_tags(search_tags.ids), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                    class="post_link cursor-pointer btn border-0 py-1">×</span>
            </span>
        </t>
    </t>
    <t t-if="search_term">
          <span class="align-items-baseline border d-inline-flex ps-2 rounded mb-2">
          <i class="oi me-2 text-muted" data-icon="label"/>
          <t t-out="search_term"/>
          <span t-att-data-post="slide_query_url(tag=slugify_tags(search_tags.ids), my=search_my, slide_category=search_slide_category, prevent_redirect=True)"
                         class="post_link cursor-pointer btn border-0 py-1">×</span>
        </span>
    </t>
    <t t-foreach="search_tags" t-as="tag">
        <span class="align-items-baseline border d-inline-flex ps-2 rounded mb-2">
            <i class="oi me-2 text-muted" data-icon="label"/>
            <t t-out="tag.display_name"/>
            <span t-att-data-post="slide_query_url(tag=slugify_tags(search_tags.ids, tag.id), my=search_my, search=search_term, slide_category=search_slide_category, prevent_redirect=True)"
                         class="post_link cursor-pointer btn border-0 py-1">×</span>
        </span>
    </t>
</template>

<template id="courses_catalog" name="Courses Catalog">
    <div class="o_wslides_home_main pb-5">
        <h2 t-if="not search_channel_filters and channels" class="h5-fs mb-3">All Courses</h2>
        <t t-call="website_slides.courses_search_tags"/>
        <div t-if="not channels and not search_channel_filters" class="text-center">
            <p class="h3">No Course created yet.</p>
            <p groups="website_slides.group_website_slides_officer">Click on "New" in the top-right corner to write your first course.</p>
        </div>
        <div t-elif="search_term and not channels" class="alert alert-info mb-5">
            No course was found matching your search <code><t t-out="search_term"/></code>.
        </div>
        <div t-elif="not channels" class="alert alert-info mb-5">
            No course was found matching your search.
        </div>
        <t t-else="">
            <div t-if="original_search" class="alert alert-warning mb-5">
                No results found for '<span t-out="original_search"/>'. Showing results for '<span t-out="search_term"/>'.
            </div>
            <div class="row g-4 g-lg-3 g-xxl-4 row-cols-1 row-cols-sm-2 row-cols-xl-3">
                <t t-foreach="channels" t-as="channel">
                    <div class="d-flex">
                        <t t-call="website_slides.course_card"/>
                    </div>
                </t>
            </div>
        </t>
        <div class="d-flex justify-content-center py-5 pb-4" t-if="pager">
            <t t-call="website.pager"/>
        </div>
    </div>
</template>

<template id='courses_footer'>
    <section class="s_banner">
        <div class="oe_structure oe_empty" id="oe_structure_website_slides_course_footer_1"/>
    </section>
</template>

<template id="course_progress_bar" name="Course Progress Bar">
    <div t-attf-class="progress #{'rounded-0' if no_roundness else ''}" style="height: .5rem">
        <div class="progress-bar" role="progressbar" t-att-aria-valuenow="channel.completion" aria-valuemin="0" aria-valuemax="100" t-attf-style="width:#{channel.completion}%;" aria-label="Progress bar"/>
    </div>
</template>

<template id="course_progress_stats_label" name="Course Progress Stats Label">
    <small t-attf-class="text-muted text-nowrap mb-0 #{is_homepage_card and 'ms-auto' or ''}">
        <span class="o_wslides_progress_percentage" t-out="channel.completion"/>%<t t-if="channel.total_time"> · <t t-out="time_left" t-options="{'widget': 'duration', 'unit': 'hour', 'round': 'minute', 'format': 'narrow'}"/> left</t>
    </small>
</template>

<template id="course_card_rating" name="Course Card Rating">
    <small class="d-flex align-items-center gap-1 mb-0 flex-shrink-0">
        <i class="fa fa-star text-warning" aria-hidden="true"/>
        <span class="fw-medium" t-out="'%.1f' % channel.rating_avg_stars"/>
    </small>
</template>

<template id="course_card_meta_row" name="Course Card Meta Row">
    <t t-if="course_in_progress" t-set="time_left" t-value="channel.total_time * (1 - channel.completion / 100.0) if channel.total_time else 0"/>
    <div class="d-flex align-items-center justify-content-between gap-2 mt-auto w-100">
        <t t-if="channel.rating_count">
            <t t-call="website_slides.course_card_rating"/>
        </t>
        <div t-if="course_in_progress or (channel.is_member and not channel.completed and not channel.completion) or not channel.is_member"
            class="d-flex align-items-center gap-2 flex-shrink-0">
            <t t-if="course_in_progress">
                <t t-call="website_slides.course_progress_stats_label" is_homepage_card="True"/>
            </t>
            <t t-elif="channel.is_member and not channel.completed and not channel.completion">
                <small class="text-muted text-nowrap mb-0">Not started yet</small>
            </t>
            <t t-if="not channel.is_member">
                <t t-if="channel.enroll == 'payment'">
                    <span class="fw-bold mb-0" t-out="channel.product_id.list_price" t-options="{'widget': 'monetary', 'display_currency': channel.currency_id}"/>
                </t>
                <span t-else="" class="fw-bold mb-0">Free</span>
            </t>
        </div>
    </div>
</template>

<template id="course_continue_card" name="Course Continue Card">
    <t t-set="time_left" t-value="channel.total_time * (1 - channel.completion / 100.0) if channel.total_time else 0"/>
    <div class="card w-100 rounded-4 border">
        <div class="card-body p-3 d-flex flex-column gap-3">
            <div class="d-flex gap-3 align-items-start">
                <a t-attf-href="/slides/#{slug(channel)}" class="flex-shrink-0" t-att-title="channel.name">
                    <div t-field="channel.image_1920"
                        class="o_wslides_continue_card_image rounded overflow-hidden o_avatar"
                        style="--Avatar-size: 3rem;"
                        t-options="{'widget': 'image', 'preview_image': 'image_128', 'class': 'object-fit-cover'}"/>
                </a>
                <div class="flex-grow-1">
                    <a t-attf-href="/slides/#{slug(channel)}" t-att-title="channel.name"
                        class="o_line_clamp h6 align-self-center small text-decoration-none" t-field="channel.name"/>
                    <div t-if="not channel.completed" class="d-flex flex-column gap-2">
                        <t t-call="website_slides.course_progress_bar"/>
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <t t-call="website_slides.course_progress_stats_label"/>
                            <a class="small" t-attf-href="/slides/#{slug(channel)}">
                                <i class="oi" data-icon="east" aria-hidden="true"/>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

<template id="course_card_status_badge" name="Course Card Status Badge">
    <t t-if="channel.is_member">
        <span t-if="channel.completed" class="badge rounded bg-success position-absolute bottom-0 m-2">
            <i class="oi" data-icon="check" aria-hidden="true"/> Completed
        </span>
        <span t-elif="channel.completion and not channel.completed" class="badge rounded bg-info position-absolute bottom-0 m-2">
            In progress
        </span>
        <span t-else="" class="badge rounded bg-light position-absolute bottom-0 m-2">
            <i class="oi" data-icon="check" aria-hidden="true"/> Enrolled
        </span>
    </t>
</template>

<template id='course_card' name="Course Card">
    <t t-set="course_in_progress" t-value="channel.is_member and channel.completion and not channel.completed"/>
    <t t-set="badge_offset" t-value="3"/>
    <div class="card w-100 h-100 rounded-4 text-decoration-none d-flex flex-column" t-att-data-publish="channel.website_published and 'on' or 'off'">
        <t t-if="not channel.website_published" t-call="website.unpublished_badge"/>
        <a t-attf-href="/slides/#{slug(channel)}" t-title="channel.name" class="m-2 mb-0 position-relative d-block">
            <div t-field="channel.image_1920" t-options="{'widget': 'image', 'preview_image': 'image_512', 'class': 'rounded'}" class="o_wslides_background_image ratio ratio-16x9"/>
            <t t-call="website_slides.course_card_status_badge"/>
            <t t-if="channel.partner_has_new_content" t-call="website_slides.course_card_information"/>
        </a>
        <div class="card-body d-flex flex-column flex-grow-1">
            <a t-attf-href="/slides/#{slug(channel)}" t-title="channel.name" class="o_line_clamp card-title h6" t-field="channel.name"/>
            <div class="d-flex gap-3 mb-2 small text-muted">
                <span t-if="channel.total_time">
                    <i class="oi" data-icon="schedule" aria-hidden="true"/>
                    <t t-out="channel.total_time" t-options="{'widget': 'duration', 'unit': 'hour', 'round': 'minute', 'format': 'narrow'}"/>
                </span>
                <span>
                    <i class="oi" data-icon="book" aria-hidden="true"/>
                    <t t-out="channel.total_slides"/> lessons
                </span>
            </div>
            <div class="card-text d-flex flex-column flex-grow-1 mt-1">
                <small class="o_line_clamp text-muted" t-field="channel.description_short" name="o_wslides_course_description"/>
                <t t-call="website_slides.course_card_meta_row"/>
            </div>
        </div>
        <div class="p-3 pt-0">
            <a t-attf-href="/slides/#{slug(channel)}" class="btn btn-primary w-100">
                <t t-if="channel.is_member and channel.completed">
                    Review course
                </t>
                <t t-elif="course_in_progress">
                    Continue
                </t>
                <t t-elif="channel.is_member and not channel.completion">
                    Start course
                </t>
                <t t-else="">
                    Enroll Now
                </t>
            </a>
        </div>
    </div>
</template>

<template id="course_card_information" name='Course Information'>
    <t id="course_card_information_content"/>
</template>

<template id="course_card_information_badge" inherit_id="website_slides.course_card_information"
    active="True" name='New Content Badge'>
    <xpath expr="//t[@id='course_card_information_content']" position="inside">
        <span class="position-absolute top-0 end-0 badge rounded bg-dark m-2">Updated</span>
    </xpath>
</template>


<template id='slides_misc_user_image' name="User Avatar">
    <img t-attf-class="o_avatar {{img_class or 'rounded-circle'}}"
        t-att-style="img_style if img_style else ''"
        t-att-src="'/profile/avatar/%s?field=avatar_128' % user.id"
        t-att-alt="user.name"/>
</template>
</data></odoo>
