<?xml version="1.0" ?>
<odoo><data>
    <!--Access Denied - Profile Page-->
    <template id="profile_access_denied" inherit_id="website_profile.profile_access_denied">
        <xpath expr="//div[@id='profile_access_denied_return_link_container']" position="inside">
            <t t-if="request.params.get('channel_id')">
                <p><a t-attf-href="/slides/course-#{request.params.get('channel_id')}" class="o_translate_inline">Return to the course.</a></p>
            </t>
        </xpath>
    </template>

    <template id="user_profile_content" inherit_id="website_profile.user_profile_content">
        <xpath expr="//div[@id='profile_about_badge']" position="before">
            <t t-if="channel">
                <div class="mb32">
                    <h5>Completed Courses</h5>
                    <t t-if="courses_completed" t-call="website_slides.display_course" courses="courses_completed"/>
                    <div t-elif="env.user == user" class="alert alert-light mb-0" role="status">
                        Finish every lesson in a course to see it land here.
                        <a href="/slides/" class="d-block"><i class="oi me-1" data-icon="east"/>Start Learning</a>
                    </div>
                    <div t-else="" class="alert alert-light mb-0" role="status">This user has not completed any courses yet.</div>
                </div>
                <div class="mb32">
                    <h5>Ongoing Courses</h5>
                    <t t-if="courses_ongoing" t-call="website_slides.display_course" courses="courses_ongoing"/>
                    <t t-else="">
                        <div t-if="env.user == user" class="alert alert-light mb-0" role="status">
                            Enroll in a course to see it land here.
                            <a href="/slides/" class="d-block"><i class="oi me-1" data-icon="east"/>Start Learning</a>
                        </div>
                        <div t-else="" class="alert alert-light mb-0" role="status">This user has not enrolled in any courses yet.</div>
                    </t>
                </div>
            </t>
        </xpath>
    </template>

    <template id="display_course">
        <div class="list-group">
            <a t-foreach="courses" t-as="course"
                t-attf-href="/slides/#{slug(course.channel_id)}"
                class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3 o_wprofile_slides_course_card_body">
                <h6 class="mb-0 flex-grow-1" t-field="course.channel_id.name"/>
                <div class="d-flex align-items-center gap-2 flex-shrink-0" style="width: 8rem">
                    <t t-if="course.completion">
                        <div class="progress flex-grow-1 mb-0" style="height:0.5em">
                            <div class="progress-bar bg-primary" t-att-style="'width: '+ str(course.completion)+'%'"/>
                        </div>
                        <small class="text-nowrap mb-0"><span t-out="course.completion"/> %</small>
                    </t>
                    <t t-else="">
                        <small class="flex-grow-1 text-muted text-end">Not started yet</small>
                    </t>
                </div>
            </a>
        </div>
    </template>
</data></odoo>
