<?xml version="1.0" ?>
<odoo><data>

<!-- Slide: main template: detailed view -->
<template id="slide_main" name="Slide Detailed View">
    <t t-set="body_classname" t-value="'o_wslides_body'"/>
    <t t-call="website.layout">
        <div id="wrap" class="wrap o_wslides_wrap">
            <t t-set="channel" t-value="slide.channel_id"/>
            <t t-set="_slide_ids" t-value="channel.slide_content_ids.ids"/>
            <t t-set="_slide_num" t-value="_slide_ids.index(slide.id) + 1"/>
            <t t-set="_slide_total" t-value="len(_slide_ids)"/>
            <div class="o_wslides_lesson_header sticky-top position-lg-relative">
                <!-- Mobile sticky topbar (offset accounted for by JS interaction) -->
                <div class="d-lg-none o_wslides_lesson_mobile_topbar bg-white border-bottom shadow-sm">
                    <div class="d-flex align-items-center gap-2 p-3">
                        <a t-att-href="'/slides/%s' % slug(channel)" class="btn btn-light flex-shrink-0" aria-label="Back to course">
                            <i class="oi" data-icon="chevron_left" role="img"/>
                        </a>
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="fw-semibold text-truncate small" t-out="channel.name"/>
                            <div class="text-muted small">Lesson <t t-out="_slide_num"/> of <t t-out="_slide_total"/> · <span class="o_wslides_progress_percentage" t-out="channel.completion"/>%</div>
                        </div>
                    </div>
                    <t t-call="website_slides.course_progress_bar" no_roundness="True"/>
                </div>
                <!-- Desktop breadcrumb nav -->
                <div class="position-relative mt-3 mb-4 d-none d-lg-block">
                    <t t-call="website_slides.course_nav" channel="slide.channel_id"/>
                </div>
            </div>
            <div class="o_wslides_lesson_main mt-4 mt-lg-0">
                <div class="container">
                    <div class="row">
                        <t t-set="can_access_channel" t-value="slide.channel_id.is_member or slide.channel_id.can_publish"/>
                        <div class="o_wslides_lesson_aside col-lg-4 col-xl-3 d-none d-lg-block">
                        <h1 class="h5 d-none d-lg-block mx-2" t-field="slide.channel_id.name"/>
                        <t t-if="slide.channel_id.channel_type == 'training'" t-call="website_slides.slide_aside_training"/>
                        <t t-if="slide.channel_id.channel_type == 'documentation'" t-call="website_slides.slide_aside_documentation"/>
                    </div>
                    <div class="o_wslides_lesson_content col-lg-8 col-xl-9 ps-lg-5">
                        <t t-call="website_slides.slide_content_detailed"/>
                    </div>
                </div>
                </div>
                <!-- Mobile bottom nav bar (outside container for full-bleed, like the sticky progress bar) -->
                <div class="o_wslides_sticky_bottom_bar d-lg-none sticky-bottom mt-auto bg-body border-top">
                    <div class="d-flex align-items-center gap-2 p-3">
                        <a t-attf-class="btn btn-light flex-shrink-0 #{'disabled' if not previous_slide else ''}"
                           t-att-href="'/slides/slide/%s' % slug(previous_slide) if previous_slide else '#'"
                           t-att-aria-disabled="'true' if not previous_slide else None"
                           aria-label="Previous">
                            <i class="oi" data-icon="chevron_left" role="img"/>
                        </a>
                        <div class="flex-grow-1 overflow-hidden">
                            <t t-if="next_slide">
                                <small class="text-muted d-block">Next lesson</small>
                                <small class="d-block text-truncate fw-medium" t-out="next_slide.name"/>
                            </t>
                        </div>
                        <a t-attf-class="btn btn-primary flex-shrink-0 #{'disabled' if not next_slide else ''}"
                           t-att-href="'/slides/slide/%s' % slug(next_slide) if next_slide else '#'"
                           t-att-aria-disabled="'true' if not next_slide else None"
                           aria-label="Next">
                            Next <i class="oi ms-1" data-icon="arrow_right" role="img"/>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </t>
</template>

<!-- Slide: sidebar documentation mode -->
<template id="slide_aside_documentation" name="Slide: Sidebar in Documentation">
    <div class="o_wslides_lesson_aside_doc position-relative bg-white pb-1 my-3 border-bottom">
        <ul class="nav nav-tabs nav-fill" role="tablist">
            <li class="nav-item" role="presentation"><a aria-controls="related" href="#related" class="nav-link rounded-0 border-top-0 border-start-0 py-2 active" data-bs-toggle="tab" role="tab">Related</a></li>
            <li class="nav-item" role="presentation"><a aria-controls="most_viewed" href="#most_viewed" class="nav-link rounded-0 border-top-0 border-end-0 py-2" data-bs-toggle="tab" role="tab">Most Viewed</a></li>
        </ul>
        <div class="tab-content">
            <div role="tabpanel" id="related" class="tab-pane active bg-100">
                <ul class="list-group list-group-flush">
                    <t t-set="related_slides_list" t-value="list(related_slides)"/>
                    <t t-if="not related_slides_list">
                        No presentation available.
                    </t>
                    <t t-else="" t-foreach="related_slides_list" t-as="aside_slide">
                        <t t-call="website_slides.slide_aside_card"/>
                    </t>
                </ul>
            </div>
            <div role="tabpanel" id="most_viewed" class="tab-pane bg-100">
                <ul class="list-group list-group-flush">
                    <t t-set="most_viewed_slides_list" t-value="list(most_viewed_slides)"/>
                    <t t-if="not list(most_viewed_slides_list)">
                        No presentation available.
                    </t>
                    <t t-else="" t-foreach="most_viewed_slides_list" t-as="aside_slide">
                        <t t-call="website_slides.slide_aside_card"/>
                    </t>
                </ul>
            </div>
        </div>
    </div>
</template>

<!-- Slide sub-template: display an item in a list of related slides (Related, Most Viewed, ...) -->
<template id="slide_aside_card" name="Related Slide">
    <a class="list-group-item list-group-item-action d-flex align-items-start px-2" t-att-href="'/slides/slide/%s' % (slug(aside_slide))">
        <div class="me-1 border o_wslides_background_image_aside_card" t-attf-style="background-image: url(#{website.image_url(aside_slide, 'image_256')});"/>
        <div class="overflow-hidden d-flex flex-column justify-content-start">
            <h6 t-out="aside_slide.name" class="o_line_clamp mb-1" style="line-height: 1.15"/>
            <small class="text-600">
                <t t-out="aside_slide.total_views"/> Views • <timeago class="timeago" t-att-datetime="aside_slide.create_date"></timeago>
            </small>
        </div>
    </a>
</template>

<!-- Slide: sidebar training mode -->
<template id="slide_aside_training" name="Slide: Sidebar in Training">
    <t t-set="channel" t-value="slide.channel_id"/>
    <t t-set="sidebar_fullscreen" t-value="sidebar_fullscreen or False"/>
    <div class="mx-2 o_wslides_channel_completion_progressbar flex-column gap-2">
        <div class="d-flex gap-2 justify-content-between ">
            <h2 class="h6 small">Course content</h2>
            <small><span class="o_wslides_progress_percentage" t-out="channel.completion"/>%</small>
        </div>
        <t t-call="website_slides.course_progress_bar"/>
    </div>
    <t t-call="website_slides.slide_lesson_aside_enroll_alert"/>
    <div t-attf-class="o_wslides_lesson_aside_list position-relative mt-3 #{'flex-grow-1 overflow-hidden d-flex flex-column' if sidebar_fullscreen else ''}">
        <ul t-attf-class="list-unstyled my-0 #{'pb-2 overflow-auto flex-grow-1' if sidebar_fullscreen else 'pb-3 collapse d-lg-block'}"
            t-att-id="'collapse_slide_aside' if not sidebar_fullscreen else None">
            <t t-set="i" t-value="0"/>
            <t t-if="category.get('slides')" t-foreach="category_data" t-as="category">
                <t t-call="website_slides.slide_aside_training_category"
                    category_slide_ids="category['slides']"/>
            </t>
        </ul>
    </div>
</template>

<template id="slide_aside_training_category" name="Category item for the slide detailed view list">
    <t t-set="sidebar_fullscreen" t-value="sidebar_fullscreen or False"/>
    <t t-set="category_collapsed" t-value="category and category.get('is_collapsed')"/>
    <t t-if="category" t-set="category" t-value="category.get('category')"/>
    <li t-attf-class="o_wslides_fs_sidebar_section #{'mb-3' if not category_last else ''}">
        <a t-attf-href="#collapse-#{category.id if category else 0}" t-attf-id="category-collapse-#{category.id if category else 0}"
            data-bs-toggle="collapse" role="button" t-att-aria-expanded="'true' if category_collapsed else 'false'"
            t-attf-class="o_wslides_lesson_aside_list_link d-flex px-2 pb-2 text-uppercase text-decoration-none small #{'text-muted' if not sidebar_fullscreen else ''}"
            t-att-aria-controls="('collapse-%s') % (category.id if category else 0)">
            <t t-if="category">
                <small class="fw-semibold" t-field="category.name"/>
            </t>
            <t t-else="">
                <small class="fw-semibold">Uncategorized</small>
            </t>
            <div class="flex-grow-1"/>
            <i class="oi oi-fw" data-icon="arrow_left" role="img"/>
            <i class="oi oi-fw" data-icon="arrow_drop_down" role="img"/>
        </a>
        <ul t-attf-class="collapse #{'show' if category_collapsed else ''} p-0 m-0 list-unstyled #{'o_wslides_fs_sidebar_section_slides position-relative pb-1' if sidebar_fullscreen else ''}" t-att-id="('collapse-%s') % (category.id if category else 0)" >
            <t t-set="is_member" t-value="slide.channel_id.is_member"/>
            <t t-set="can_access_channel" t-value="is_member or slide.channel_id.can_publish"/>
            <t t-foreach="category_slide_ids" t-as="aside_slide">
                <t t-set="slide_completed" t-value="channel_progress[aside_slide.id].get('completed')"/>
                <t t-set="can_access" t-value="aside_slide.is_preview or can_access_channel"/>
                <t t-if="sidebar_fullscreen">
                    <t t-set="is_member_or_invited" t-value="is_member or slide.channel_id.is_member_invited"/>
                    <li t-attf-class="o_wslides_fs_sidebar_list_item #{'active' if aside_slide == slide else ''}"
                        t-att-data-id="aside_slide.id"
                        t-att-data-can-access="can_access"
                        t-att-data-name="aside_slide.name"
                        t-att-data-category="aside_slide.slide_category"
                        t-att-data-video-source-type="aside_slide.video_source_type"
                        t-att-data-slug="slug(aside_slide)"
                        t-att-data-has-question="True if aside_slide.question_ids else None"
                        t-att-data-completed="slide_completed"
                        t-att-data-embed-code="aside_slide.embed_code_external if aside_slide.slide_category in ['video', 'document', 'infographic'] else False"
                        t-att-data-can-self-mark-completed="aside_slide.can_self_mark_completed"
                        t-att-data-can-self-mark-uncompleted="aside_slide.can_self_mark_uncompleted"
                        t-att-data-is-member="is_member"
                        t-att-data-is-member-or-invited="is_member_or_invited"
                        t-att-data-session-answers="session_answers"
                        t-att-data-website-share-url="aside_slide.website_share_url"
                        t-att-data-email-sharing="bool(slide.channel_id.share_slide_template_id)">
                        <div class="o_wslides_lesson_aside_list_link d-flex p-2 w-100">
                            <a t-if="can_access" class="d-flex text-decoration-none text-reset mw-100 overflow-hidden" href="#">
                                <div class="o_wslides_lesson_link_name o_wslides_fs_slide_name small text-truncate" t-att-title="aside_slide.name">
                                    <i class="oi oi-fw" t-attf-data-icon="#{aside_slide.slide_icon_class}" role="img"/>
                                    <span t-out="aside_slide.name"/>
                                </div>
                            </a>
                            <span t-else="" t-attf-class="d-flex mw-100 overflow-hidden #{'text-muted' if not sidebar_fullscreen else ''}">
                                <div class="o_wslides_lesson_link_name small text-truncate" t-att-title="aside_slide.name">
                                    <i class="oi oi-fw" t-attf-data-icon="#{aside_slide.slide_icon_class}" role="img"/>
                                    <span t-out="aside_slide.name"/>
                                </div>
                            </span>
                            <t t-call="website_slides.slide_sidebar_done_button"
                                slide="aside_slide"
                                slide_completed="slide_completed"/>
                        </div>
                        <ul t-if="aside_slide.sudo().slide_resource_ids or aside_slide.question_ids" class="o_wslides_lesson_aside_list_links list-group mb-1 list-unstyled fw-light small">
                            <t t-foreach="aside_slide.slide_resource_ids" t-as="resource">
                                <li t-attf-class="ps-3 p-1 small#{' text-muted' if not can_access_channel and not sidebar_fullscreen else ''}">
                                    <t t-if="can_access_channel">
                                        <a t-if="resource.resource_type == 'url'" t-att-href="resource.link" target="_blank" t-attf-class="text-decoration-none #{'text-muted' if not sidebar_fullscreen else 'text-reset'}">
                                            <i class="oi me-1" data-icon="link"/><span t-field="resource.name"/>
                                        </a>
                                        <a t-else="" t-att-href="resource.download_url" t-attf-class="text-decoration-none #{'text-muted' if not sidebar_fullscreen else 'text-reset'}">
                                            <i class="oi me-1" data-icon="download"/><span t-field="resource.name"/>
                                        </a>
                                    </t>
                                    <t t-else="">
                                        <i class="oi me-1" t-attf-data-icon="#{resource.resource_type == 'url' and 'link' or 'download'}"/>
                                        <span t-field="resource.name"/>
                                    </t>
                                </li>
                            </t>
                            <li t-if="aside_slide.question_ids and aside_slide.slide_category != 'quiz'" class="o_wslides_fs_sidebar_list_item ps-3"
                                t-att-data-id="aside_slide.id"
                                t-att-data-can-access="can_access"
                                t-att-data-video-source-type="aside_slide.video_source_type"
                                t-att-data-name="aside_slide.name"
                                t-att-data-category="aside_slide.slide_category"
                                t-att-data-slug="slug(aside_slide)"
                                t-att-data-has-question="True if aside_slide.question_ids else None"
                                t-att-data-is-quiz="True"
                                t-att-data-completed="slide_completed"
                                t-att-data-can-self-mark-completed="aside_slide.can_self_mark_completed"
                                t-att-data-can-self-mark-uncompleted="aside_slide.can_self_mark_uncompleted"
                                t-att-data-is-member="is_member"
                                t-att-data-is-member-or-invited="is_member_or_invited"
                                t-att-data-session-answers="session_answers"
                                t-att-data-website-share-url="aside_slide.website_share_url">
                                <a t-if="can_access" t-attf-class="o_wslides_lesson_aside_list_link o_wslides_fs_slide_quiz o_wslides_fs_slide_name text-decoration-none small #{'text-600' if not sidebar_fullscreen else 'text-reset'}" href="#">
                                    <i class="oi oi-filled text-warning me-1" data-icon="flag"/> Quiz
                                </a>
                                <span t-else="" class="o_wslides_lesson_aside_list_link text-decoration-none small text-muted">
                                    <i class="oi oi-filled text-warning me-1" data-icon="flag"/> Quiz
                                </span>
                            </li>
                        </ul>
                    </li>
                </t>
                <t t-else="">
                <li>
                    <div t-att-class="'o_wslides_lesson_aside_list_link d-flex p-2 %s%s' % (('bg-primary-subtle text-primary-emphasis rounded active' if aside_slide == slide else ''), 'text-muted' if not can_access else '')"
                        t-att-data-id="aside_slide.id"
                        t-att-data-completed="slide_completed">
                        <a t-att-href="'/slides/slide/%s' % (slug(aside_slide)) if can_access else '#'"
                            t-attf-class="d-flex text-decoration-none mw-100 overflow-hidden #{'text-muted' if not can_access else 'text-reset'}">
                            <div class="o_wslides_lesson_link_name small text-truncate" t-att-title="aside_slide.name">
                                <i class="oi oi-fw" t-attf-data-icon="#{aside_slide.slide_icon_class}" role="img"/>
                                <span t-out="aside_slide.name"/>
                            </div>
                        </a>
                        <t t-call="website_slides.slide_sidebar_done_button"
                            slide="aside_slide"
                            slide_completed="channel_progress[aside_slide.id].get('completed')"
                            />
                    </div>
                    <ul t-if="aside_slide.sudo().slide_resource_ids or aside_slide.question_ids" class="o_wslides_lesson_aside_list_links list-group mb-1 list-unstyled fw-light">
                        <t t-foreach="aside_slide.slide_resource_ids" t-as="resource">
                            <li t-attf-class="ps-3 p-1 small#{' text-muted' if not can_access_channel else ''}">
                                <t t-if="can_access_channel">
                                    <a t-if="resource.resource_type == 'url'" t-att-href="resource.link" target="new" class="text-decoration-none text-muted">
                                        <i class="oi me-1" data-icon="link"/><span t-field="resource.name"/>
                                    </a>
                                    <a t-else="" t-att-href="resource.download_url" class="text-decoration-none text-muted">
                                        <i class="oi me-1" data-icon="download"/><span t-field="resource.name"/>
                                    </a>
                                </t>
                                <t t-else="">
                                    <i class="oi me-1" t-attf-data-icon="#{resource.resource_type == 'url' and 'link' or 'download'}"/>
                                    <span t-field="resource.name"/>
                                </t>
                            </li>
                        </t>
                        <li t-if="aside_slide.question_ids and aside_slide.slide_category != 'quiz'" class="ps-3">
                            <a t-if="can_access" t-att-href="'/slides/slide/%s#lessonQuiz' % (slug(aside_slide))"
                                class="o_wslides_lesson_aside_list_link text-decoration-none small text-600">
                                <i class="oi oi-filled text-warning" data-icon="flag"/> Quiz
                            </a>
                            <span t-else="" class="o_wslides_lesson_aside_list_link text-decoration-none small text-600 text-muted">
                                <i class="oi oi-filled text-warning" data-icon="flag"/> Quiz
                            </span>
                        </li>
                    </ul>
                </li>
                </t>
            </t>
        </ul>
    </li>
</template>

<!-- Slide: all its content, not fullscreen mode -->
<template id="slide_content_detailed" name="Slide: Detailed Content">
    <div class="d-flex gap-3 align-items-start">
        <t t-set="slide_completed" t-value="channel_progress[slide.id].get('completed')"/>
        <h1 class="mb-0 h5" t-field="slide.name"/>
        <div class="d-flex flex-shrink-0 gap-2 ms-auto">
            <a class="btn btn-light" role="button" t-att-href="'/slides/slide/%s?fullscreen=1' % (slug(slide))" aria-label="Fullscreen">
                <i class="oi me-1" data-icon="fullscreen"/>
                <span class="d-none d-xl-inline-block">Fullscreen</span>
            </a>
            <a class="o_wslides_share btn btn-light" role="button" t-att-data-name="slide.name"
               t-att-data-id="slide.id" t-att-data-url="slide.website_share_url" t-att-data-category="slide.slide_category"
               t-att-data-email-sharing="bool(slide.channel_id.share_slide_template_id)"
               t-att-data-embed-code="slide.embed_code_external if slide.slide_category in ['video', 'document'] else False"
               aria-label="Share">
                <i class="oi me-1" data-icon="family_history"/>
                Share
            </a>
        </div>
    </div>
    <div t-if="slide.tag_ids" class="mt-2">
        <t t-foreach="slide.tag_ids" t-as="tag">
            <a t-att-href="'/slides/%s/tag/%s' % (slug(slide.channel_id), slug(tag))" class="badge text-bg-info" t-out="tag.name"/>
        </t>
    </div>
    <div class="oe_structure oe_empty mt-3" id="oe_structure_website_slides_lesson_top_1" data-editor-message.translate="Drag blocks here to add them on all lessons"/>
    <div t-if="slide.slide_category == 'infographic'" class="o_wslides_lesson_content_type" t-field='slide.image_1920' t-options="{'widget': 'image', 'style': 'width: 100%;'}"/>
    <div t-else="" class="o_wslides_lesson_content_type">
        <div t-if="slide.slide_category == 'document'" class="ratio ratio-4x3 embed-responsive-item mb8" style="height: 600px;">
            <t t-out="slide.embed_code"/>
        </div>
        <div t-if="slide.slide_category == 'video'" class="ratio ratio-16x9 embed-responsive-item mb8">
            <t t-out="slide.embed_code"/>
        </div>
        <div t-if="slide.slide_category == 'article'">
            <div t-if="is_html_empty(slide.html_content)" class="alert alert-info o_not_editable">
                Click on the "Edit" button in the top corner of the screen to edit your slide content.
            </div>
            <div class="bg-white p-3">
                <div t-field="slide.html_content" placeholder="Add your content here..."/>
            </div>
        </div>
        <div t-if="slide.slide_category == 'quiz' and slide.question_ids" class="o_wslides_js_quiz_container row" t-att-data-slide-id="slide.id" id="quiz_container">
            <t t-call="website_slides.lesson_content_quiz"/>
        </div>
    </div>

    <div class="mt-3 mb-5 position-relative">
        <div class="d-none d-lg-flex justify-content-between">
            <a t-attf-class="o_wslides_nav_button btn btn-link text-decoration-none #{'disabled' if not previous_slide else ''}"
                role="button" t-att-aria-disabled="'true' if not previous_slide else None" aria-label="Previous"
                t-att-href="'/slides/slide/%s' % (slug(previous_slide)) if previous_slide else '#'">
                <i class="oi me-1" data-icon="chevron_left"/> <span class="d-none d-sm-inline-block">Previous</span>
            </a>
            <a t-attf-class="o_wslides_nav_button btn btn-primary #{'disabled' if not next_slide else ''}"
                role="button" t-att-aria-disabled="'true' if not next_slide else None" aria-label="Next"
                t-att-href="'/slides/slide/%s' % (slug(next_slide)) if next_slide else '#'">
                Next<i class="oi ms-1" data-icon="arrow_right"/>
            </a>
        </div>
        <t t-set="show_quiz_tab" t-value="slide.slide_category not in ('quiz', 'certification') and slide.question_ids"/>
        <ul class="nav nav-underline o_wslides_nav_underline o_wslides_lesson_nav mt-4 border-bottom" role="tablist">
            <li class="nav-item" role="presentation">
                <a href="#about" aria-controls="about" t-att-class="'nav-link active' if not comments else 'nav-link'" role="tab" data-bs-toggle="tab">
                    <i class="oi" data-icon="home"/> About
                </a>
            </li>
            <li class="nav-item" role="presentation">
                <a href="#discuss" aria-controls="discuss" t-att-class="'nav-link active' if comments else 'nav-link'" role="tab" data-bs-toggle="tab">
                    <i class="oi oi-filled" data-icon="forum"/> Comments <t t-if="slide.channel_id.allow_comment">(<span t-out="slide.comments_count"/>)</t>
                </a>
            </li>
            <li class="nav-item" role="presentation" t-if="show_quiz_tab">
                <a href="#quiz" aria-controls="quiz" class="nav-link" role="tab" data-bs-toggle="tab">
                    <i class="oi oi-filled text-warning" data-icon="flag"/> Quiz
                </a>
            </li>
        </ul>
        <div class="tab-content mt-3">
            <div role="tabpanel" t-att-class="not comments and 'tab-pane fade in show active' or 'tab-pane fade'" id="about">
                <div t-field="slide.description"/>
                <div t-if="slide.channel_id.allow_comment" class="d-flex">
                    <span class="text-muted fw-bold me-3">Rating</span>
                    <div class="text-muted border-start ps-3">
                        <div class="o_wslides_js_slide_like me-2">
                            <span t-attf-class="o_wslides_js_slide_like_up #{'disabled' if not slide.channel_id.can_vote else ''}" tabindex="0" data-bs-toggle="popover" t-att-data-slide-id="slide.id" t-att-data-user-vote="slide.user_vote">
                                <i t-attf-class="oi oi-1x #{'oi-filled' if slide.user_vote == 1 else ''}" data-icon="thumb_up" role="img" aria-label="Likes" title="Like"/>
                                <span t-field="slide.likes" t-options="{'format_decimalized_number': True}"/>
                            </span>
                            <span t-attf-class="o_wslides_js_slide_like_down ms-3 #{'disabled' if not slide.channel_id.can_vote else ''}" tabindex="0" data-bs-toggle="popover" t-att-data-slide-id="slide.id" t-att-data-user-vote="slide.user_vote">
                                <i t-attf-class="oi oi-1x #{'oi-filled' if slide.user_vote == -1 else ''}" data-icon="thumb_down" role="img" aria-label="Dislikes" title="Dislike"/>
                                <span t-field="slide.dislikes" t-options="{'format_decimalized_number': True}"/>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div role="tabpanel" t-att-class="comments and 'tab-pane fade in show active' or 'tab-pane fade'" id="discuss">
                <t t-set="enable_slide_comments" t-value="0"/>
                <p t-if="not slide.channel_id.allow_comment">
                    Commenting is not enabled on this course.
                </p>
                <t t-elif="not slide.comments_count">
                    <p t-if="not can_access_channel">
                        There are no comments for now.
                        <t t-if="slide.channel_id.enroll != 'invite'">
                            <div class="o_wslides_js_course_join o_wslides_no_access_comments d-inline">
                                <t t-if="slide.channel_id.enroll == 'public'" t-call="website_slides.join_course_link"/>
                            </div>
                            to be the first to leave a comment.
                        </t>
                    </p>
                    <p t-elif="not slide.channel_id.can_comment">
                        There are no comments for now. Earn more Karma to be the first to leave a comment.
                    </p>
                    <t t-else="" t-set="enable_slide_comments" t-value="1"/>
                </t>
                <t t-else="">
                    <t t-set="enable_slide_comments" t-value="1"/>
                    <t t-if="not slide.channel_id.can_comment and can_access_channel"><p>Earn more Karma to leave a comment.</p></t>
                </t>
                <t t-if="enable_slide_comments" t-call="portal.message_thread"
                    object="slide"
                    hide_header="True"
                    disable_composer="not (slide.channel_id.can_comment and slide.channel_id.allow_comment)"
                    display_rating="False"/>
            </div>
            <div role="tabpanel" class="tab-pane fade" id="quiz" t-if="show_quiz_tab">
                <div class="o_wslides_js_quiz_container row" t-att-data-slide-id="slide.id" id="quiz_container">
                    <t t-call="website_slides.lesson_content_quiz"/>
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3 mb-3">
        <t t-if="slide.sudo().slide_resource_ids">
            <t t-set="can_access_channel" t-value="slide.channel_id.is_member or slide.channel_id.can_publish"/>
            <t t-if="can_access_channel">
                <t t-set="links" t-value="slide.slide_resource_ids.filtered(lambda res: res.resource_type == 'url')"/>
                <div class="row mb-4 mt-4" t-if="links">
                    <span class="text-muted fw-bold col-4 col-md-3">External sources</span>
                    <div class="text-muted me-auto border-start ps-3 col-8 col-md-9">
                        <t t-foreach="links" t-as="link">
                            <a t-att-href="link.link" t-out="link.name"/><br />
                        </t>
                    </div>
                </div>
                <t t-set="files" t-value="slide.slide_resource_ids.filtered(lambda res: res.resource_type == 'file' and res.data)"/>
                <div class="row mb-4 o_wslides_js_course_join" t-if="files">
                    <span class="text-muted fw-bold col-4 col-md-3">
                        Additional Resources
                    </span>
                    <div class="text-muted me-auto border-start ps-3 col-8 col-md-9">
                        <t t-foreach="slide.slide_resource_ids" t-as="resource" t-if="resource.resource_type == 'file' and resource.data">
                            <a t-att-href="resource.download_url" t-out="resource.name"/><br />
                        </t>
                    </div>
                </div>
            </t>
            <t t-else="">
                <span t-if="slide.is_preview" class="text-muted fw-bold me-3">
                    Additional Resources
                </span>
                <div class="o_wslides_js_course_join o_wslides_no_access">
                    <div t-if="slide.channel_id.enroll == 'invite' and not slide.channel_id.is_member_invited">
                        <span>Content only accessible to course attendees.</span>
                    </div>
                    <div t-else="" class="text-muted me-auto border-start ps-3">
                        <t t-call="website_slides.join_course_link" for_resources="1"/>
                    </div>
                </div>
            </t>
        </t>
    </div>
</template>

<!-- Slide sub-tempalte: render a quiz serverside. Should be sync with JS qweb template "slide.slide.quiz" -->
<template id="lesson_content_quiz" name="Lesson: Quiz specific content">
    <t t-set="slide_completed" t-value="channel_progress[slide.id].get('completed')"/>
    <div class="o_wslides_js_lesson_quiz col" id="lessonQuiz"
        t-att-data-id="slide.id"
        t-att-data-name="slide.name"
        t-att-data-slide-category="slide.slide_category"
        t-att-data-is-member="slide.channel_id.is_member"
        t-att-data-is-member-or-invited="slide.channel_id.is_member or slide.channel_id.is_member_invited"
        t-att-data-can-self-mark-completed="slide.can_self_mark_completed"
        t-att-data-can-self-mark-uncompleted="slide.can_self_mark_uncompleted"
        t-att-data-completed="slide_completed"
        t-att-data-quiz-attempts-count="quiz_attempts_count"
        t-att-data-quiz-karma-max="quiz_karma_max"
        t-att-data-quiz-karma-gain="quiz_karma_gain"
        t-att-data-quiz-karma-won="quiz_karma_won"
        t-att-data-has-next="1 if next_slide else 0"
        t-att-data-next-slide-url="'/slides/slide/%s' % (slug(next_slide)) if next_slide else None"
        t-att-data-channel-id="slide.channel_id.id"
        t-att-data-channel-enroll="slide.channel_id.enroll"
        t-att-data-channel-requested-access="slide.channel_id.has_requested_access"
        t-att-data-channel-can-upload="slide.channel_id.can_upload"
        t-att-data-signup-allowed="signup_allowed"
        t-att-data-session-answers="session_answers">
        <t t-foreach="slide_questions" t-as="question">
            <t t-call="website_slides.lesson_content_quiz_question"/>
        </t>
        <div class="o_wslides_js_lesson_quiz_validation pt-3"/>
    </div>
</template>

<template id="lesson_content_quiz_question" name="Lesson: Quiz question template">
    <div t-att-class="'o_wslides_js_lesson_quiz_question mt-3 %s' % ('completed-disabled' if slide_completed else ('disabled' if not (slide.channel_id.is_member or slide.is_preview) else ''))"
         t-att-data-question-id="question['id']" t-att-data-title="question['question']" >
        <div class="row d-flex mb-2 mx-0">
            <div class="h4">
                <small class="text-muted">
                    <i class="o_wslides_js_quiz_icon o_wslides_js_quiz_sequence_handler oi me-1 text-muted" data-icon="menu" t-if="slide.channel_id.can_upload and not slide_completed"/>
                    <t t-if="question_index != NoneType"><span class="o_wslides_quiz_question_sequence" t-out="question_index+1"/>.</t>
                    <t t-else=""><span class="o_wslides_quiz_question_sequence" t-out="question['sequence']"/>.</t>
                </small>
                <span t-out="question['question']"/>
            </div>
            <div class="ms-auto o_wslides_js_quiz_edit_del" t-if="slide.channel_id.can_upload and not slide_completed">
                <i class="o_wslides_js_quiz_icon o_wslides_js_quiz_edit_question oi p-1 text-muted" data-icon="edit_square"/>
                <i class="o_wslides_js_quiz_icon o_wslides_js_quiz_delete_question oi oi-filled p-1 text-muted" data-icon="delete"/>
            </div>
        </div>
        <div class="list-group">
            <t t-foreach="question['answer_ids']" t-as="answer">
                <a t-att-data-answer-id="answer['id']" href="#"
                    t-att-data-text="answer['text_value']" t-att-data-is-correct="answer['is_correct']" t-att-data-comment="answer['comment']"
                    t-att-class="'o_wslides_quiz_answer list-group-item list-group-item-action d-flex align-items-center %s' % ('list-group-item-success' if slide_completed and answer['is_correct'] else '')">
                    <label class="my-0 d-flex align-items-center justify-content-center me-2">
                        <input type="radio"
                            t-att-name="question['id']"
                            t-att-value="answer['id']"
                            class="d-none"
                            t-att-disabled="True if not slide.channel_id.is_member or slide_completed else ''"/>
                        <i t-att-class="'oi oi-filled text-400 %s' % ('d-none' if slide_completed and answer['is_correct'] else '')" data-icon="circle"/>
                        <i class="oi oi-filled text-danger d-none" data-icon="cancel"></i>
                        <i t-att-class="'oi oi-filled text-success %s' % ('d-none' if not (slide_completed and answer['is_correct']) else '')" data-icon="check_circle"></i>
                    </label>
                    <span t-out="answer['text_value']"/>
                </a>
                <t t-if="slide_completed and answer['is_correct']" t-set="correct_answer_comment" t-value="answer['comment']"/>
            </t>
            <div t-attf-class="o_wslides_quiz_answer_info list-group-item list-group-item-info #{'' if correct_answer_comment else 'd-none'}">
                <i class="oi" data-icon="info"/>
                <span class="o_wslides_quiz_answer_comment ms-1">
                    <t t-if="correct_answer_comment" t-out="correct_answer_comment"/>
                </span>
            </div>
        </div>
    </div>
</template>

<template id="lesson_content_quiz_add_buttons" name="Lesson: Quiz Add Buttons template">
    <div class="o_wslides_js_lesson_quiz_new_question mt-3">
        <a t-attf-class="o_wslides_js_quiz_add o_wslides_js_quiz_add_quiz btn btn-light border #{'d-none ' if slide.question_ids else ''}" role="button">
            <i class="oi me-2" data-icon="add"/>
            <span>Add Quiz</span>
        </a>
        <a t-attf-class="o_wslides_js_quiz_add o_wslides_js_quiz_add_question btn btn-light border ms-3 #{'' if slide.question_ids else 'd-none '}" role="button">
            <i class="oi me-2" data-icon="add"/>
            <span>Add Question</span>
        </a>
    </div>
</template>

</data></odoo>
