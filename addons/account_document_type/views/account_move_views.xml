<!--                    domain="[('id', 'in', l10n_latam_available_document_type_ids)]" options="{'no_open': True, 'no_create': True}"/>-->
                <field name="document_number"
                       invisible="not documents_enabled"
                       readonly="not is_document_number_editable"
                       required="is_document_number_editable"/>
            </div>

            <!-- on these documents we use document_number to set name -->
            <field name="name" position="attributes">
                <attribute name="readonly">documents_enabled or state != 'draft'</attribute>
<!--                <attribute name="force_save">1</attribute>-->
            </field>

        </field>
    </record>

