<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_in_hsn_entity_view_form" model="ir.ui.view">
        <field name="name">l10n_in.hsn.entity.view.form</field>
        <field name="model">l10n_in.hsn.entity</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="hsn_code"/>
                        <field name="price_per_unit"/>
                        <field name="tax_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="l10n_in_hsn_entity_view_tree" model="ir.ui.view">
        <field name="name">l10n_in.hsn.entity.view.tree</field>
        <field name="model">l10n_in.hsn.entity</field>
        <field name="arch" type="xml">
            <list string="">
                <field name="hsn_code"/>
                <field name="price_per_unit"/>
                <field name="tax_id"/>
            </list>
        </field>
    </record>

    <record id="l10n_in_hsn_entity_action" model="ir.actions.act_window">
        <field name="name">hsn Entity</field>
        <field name="res_model">l10n_in.hsn.entity</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_l10n_in_hsn_entity"
        name="HSN Entity"
        parent="account.menu_finance_configuration"
        action="l10n_in_hsn_entity_action"
    />

</odoo>