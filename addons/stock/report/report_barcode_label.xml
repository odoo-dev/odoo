<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Name + barcode labels (4x7 PDF and ZPL) for any record having a `barcode` field.
        To print labels for a new model, add a template calling `stock.report_barcode_label_pdf`
        or `stock.report_barcode_label_zpl`, and an `ir.actions.report` using it
        (the report name must be unique per model as the report is found by its name).
        Set `name_as_barcode` to print the record name as barcode when it has none.
    -->

    <template id="report_barcode_label_pdf">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-call="web.html_container">
                    <t t-foreach="range(0, len(docs), 28)" t-as="page_start">
                        <div class="o_label_sheet" style="padding: 14mm 3mm">
                            <table class="my-0 table table-sm table-borderless">
                                <tr t-foreach="range(page_start, page_start + 28, 4)" t-as="row_start">
                                    <t t-foreach="range(row_start, row_start + 4)" t-as="index">
                                        <t t-set="doc" t-value="index &lt; len(docs) and docs[index]"/>
                                        <!-- empty cells fill the last page -->
                                        <td t-att-style="not doc and 'visibility:hidden;'">
                                            <div class="o_label_full o_label_4x7">
                                                <t t-if="doc">
                                                    <t t-set="label" t-value="{'barcode_value': doc.barcode or (name_as_barcode and doc.name) or ''}"/>
                                                    <t t-call="product.report_label_contour_marks"/>
                                                    <div class="o_label_centering_table">
                                                        <div class="o_label_centered_content">
                                                            <div class="o_label_name" t-out="doc.display_name"/>
                                                            <div class="o_label_content">
                                                                <div class="o_label_barcode_block">
                                                                    <t t-call="product.report_label_barcode"
                                                                       barcode_size="'width:100%;height:8mm'"/>
                                                                    <div class="o_label_barcode_text" t-out="doc.barcode"/>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </td>
                                    </t>
                                </tr>
                            </table>
                        </div>
                    </t>
                </t>
            </div>
        </t>
    </template>

    <!-- values are encoded for ^FH (e.g. `"` becomes `_22`) -->
    <template id="report_barcode_label_zpl">
        <t t-set="zpl_translate" t-value="{ord(char): '_%02X' % ord(char) for char in '_^~&lt;&gt;&amp;&quot;\''}"/>
        <t t-foreach="docs" t-as="doc">
            <t t-set="name" t-value="doc.display_name.translate(zpl_translate)"/>
            <t t-set="barcode_value" t-value="(doc.barcode or (name_as_barcode and doc.name) or '').translate(zpl_translate)"/>
            <t t-set="barcode_text" t-value="(doc.barcode or '').translate(zpl_translate)"/>
            <t t-translation="off">
^XA^CI28
^PW376
^LL297
^FO5,60^A0N,30,24^FB366,1,0,C^FH^FD<t t-out="name"/>^FS
                <t t-if="barcode_value">
^FO5,100^BY3^BCN,110,N,N,N^FH^FD<t t-out="barcode_value"/>^FS
                    <t t-if="barcode_text">
^FO5,215^A0N,22,17^FB366,1,0,C^FH^FD<t t-out="barcode_text"/>^FS
                    </t>
                </t>
^XZ
            </t>
        </t>
    </template>

    <template id="report_location_barcode_label_pdf">
        <t t-set="name_as_barcode" t-value="True"/>
        <t t-call="stock.report_barcode_label_pdf"/>
    </template>

    <template id="report_location_barcode_label_zpl">
        <t t-set="name_as_barcode" t-value="True"/>
        <t t-call="stock.report_barcode_label_zpl"/>
    </template>

    <template id="report_picking_type_barcode_label_pdf">
        <t t-call="stock.report_barcode_label_pdf"/>
    </template>

    <template id="report_picking_type_barcode_label_zpl">
        <t t-call="stock.report_barcode_label_zpl"/>
    </template>

    <template id="report_package_type_barcode_label_pdf">
        <t t-call="stock.report_barcode_label_pdf"/>
    </template>

    <template id="report_package_type_barcode_label_zpl">
        <t t-call="stock.report_barcode_label_zpl"/>
    </template>
</odoo>
