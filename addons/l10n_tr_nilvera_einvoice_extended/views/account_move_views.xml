<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_form_view_l10n_tr_nilvera_extended" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit.l10n.tr.nilvera.extended</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting_info_group']/field[@name='invoice_incoterm_id']" position="attributes">
                <attribute name="required" add="l10n_tr_gib_invoice_scenario == 'IHRACAT'" separator=" or "/>
            </xpath>

            <xpath expr="//div[@name='journal_div']" position="after">
                <div class="o_td_label" invisible="country_code != 'TR' or move_type != 'out_invoice' or l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive']">
                     <label for="l10n_tr_gib_invoice_scenario"/>
                </div>
                <div class="d-flex" invisible="country_code != 'TR' or move_type != 'out_invoice' or l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive']">
                     <field name="l10n_tr_gib_invoice_scenario" 
                            invisible="l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive']" 
                            readonly="state in ['cancel', 'posted']"/>                     
                     <span class="o_form_label mx-3 oe_edit_only" invisible="l10n_tr_gib_invoice_scenario == 'IHRACAT' or l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive']">is</span>
                     <field name="l10n_tr_gib_invoice_type" 
                            invisible="l10n_tr_gib_invoice_scenario == 'IHRACAT' and l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive']"
                            required="l10n_tr_gib_invoice_scenario not in ['IHRACAT']"
                            readonly="state in ['cancel', 'posted']"/>
                </div>
                <field name="l10n_tr_exemption_code_id"
                        invisible="not l10n_tr_exemption_code_domain_list or l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive']"
                        readonly="state in ['cancel', 'posted']"/>
                <field name="l10n_tr_shipping_type"
                        invisible="not l10n_tr_exemption_code_domain_list or l10n_tr_nilvera_customer_status not in ['einvoice', 'earchive'] or l10n_tr_gib_invoice_scenario != 'IHRACAT'"
                        readonly="state in ['cancel', 'posted']"/>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='tax_ids']" position="after">
                <field name="l10n_tr_gibp_number" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
