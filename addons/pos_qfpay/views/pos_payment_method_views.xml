<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos_qfpay</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <page name="terminals" position="attributes">
                <attribute name="invisible" add="payment_provider == 'qfpay'" separator=" or "/>
            </page>
            <page name="terminals" position="before">
                <page name="qfpay_settings" string="QFPay" invisible="payment_provider != 'qfpay'">
                    <separator string="Credentials" style="margin-top: 0.5rem !important;"/>
                    <group>
                        <field name="qfpay_payment_type"
                            invisible="payment_provider != 'qfpay'"
                            required="payment_provider == 'qfpay'"/>
                        <field name="qfpay_notification_key"
                            invisible="payment_provider != 'qfpay'"
                            required="payment_provider == 'qfpay'"/>
                    </group>
                    <separator string="Terminals"/>
                    <field name="terminal_ids" widget="pos_payment_terminals"/>
                </page>
            </page>
        </field>
    </record>
</odoo>
