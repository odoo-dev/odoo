<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_terminal_view_list" model="ir.ui.view">
        <field name="name">pos.payment.terminal.list.inherit.pos_qfpay</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="qfpay_terminal_ip_address" column_invisible="parent.payment_provider != 'qfpay'" required="parent.payment_provider == 'qfpay'"/>
                <field name="qfpay_pos_key" column_invisible="parent.payment_provider != 'qfpay'" required="parent.payment_provider == 'qfpay'"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_terminal_view_form" model="ir.ui.view">
        <field name="name">pos.payment.terminal.form.inherit.pos_qfpay</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_form"/>
        <field name="arch" type="xml">
            <group name="settings" position="after">
                <group name="qfpay_settings" invisible="payment_provider != 'qfpay'">
                    <field name="qfpay_terminal_ip_address" required="payment_provider == 'qfpay'"/>
                    <field name="qfpay_pos_key" required="payment_provider == 'qfpay'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
