<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <record id="test_tax_tag_hupo" model="account.report">
        <field name="name">VAT Return Test Hupo</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.be"/>
        <field name="allow_foreign_vat" eval="True"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="test_tax_tag_hupo_column" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="test_tax_tag_hupo_line_1_1" model="account.report.line">
                <field name="name">First Line (no groupby)</field>
                <field name="code">hupo_47</field>
                <field name="expression_ids">
                    <record id="test_tax_tag_hupo_line_1_1_expr_1" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">47</field>
                    </record>
                </field>
            </record>
            <record id="test_tax_tag_hupo_line_1_2" model="account.report.line">
                <field name="name">Second Line (groupby account)</field>
                <field name="code">hupo_49</field>
                <field name="groupby">account_id</field>
                <field name="foldable">True</field>
                <field name="expression_ids">
                    <record id="test_tax_tag_hupo_line_1_2_expr_1" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">49</field>
                    </record>
                </field>
            </record>
            <record id="test_tax_tag_hupo_line_1_3" model="account.report.line">
                <field name="name">Third Line (groupby account)</field>
                <field name="code">hupo_87</field>
                <field name="groupby">account_id</field>
                <field name="foldable">True</field>
                <field name="expression_ids">
                    <record id="test_tax_tag_hupo_line_1_3_expr_1" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">87</field>
                    </record>
                </field>
            </record>
            <record id="test_tax_tag_hupo_line_1_4" model="account.report.line">
                <field name="name">Fourth Line (groupby partner, aml)</field>
                <field name="code">hupo_57</field>
                <field name="groupby">partner_id, id</field>
                <field name="foldable">True</field>
                <field name="expression_ids">
                    <record id="test_tax_tag_hupo_line_1_4_expr_1" model="account.report.expression">
                        <field name="label">balance</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">57</field>
                    </record>
                </field>
            </record>
