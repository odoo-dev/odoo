<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_auto_checks_the_polish_invoice_status" model="ir.cron">
            <field name="name">Polish eInvoice: automatically check the status of the invoice in ksef</field>
            <field name="model_id" ref="l10n_pl_edi.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_checks_the_polish_invoice_status()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
        <record id="cron_auto_fetch_polish_invoices" model="ir.cron">
            <field name="name">Polish eInvoice: automatically fetch the invoices from ksef</field>
            <field name="model_id" ref="l10n_pl_edi.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model._cron_fetch_polish_invoices()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(minutes=5)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>
    </data>
</odoo>