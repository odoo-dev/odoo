<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="web_core.NotificationContainer">
    <div class="wcore_notification_container position-fixed">
        <t t-foreach="this.props.notifications()" t-as="notification" t-key="notification.id">
            <Notification t-props="notification"/>
        </t>
    </div>
</t>

</templates>
