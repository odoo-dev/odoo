<?xml version="1.0" encoding="utf-8" ?>
<templates>

    <t t-name="web_hierarchy.HierarchyCard" t-inherit="web.CardRenderer">
        <xpath expr="article" position="attributes">
            <attribute name="t-att-data-node-id">this.props.node.id</attribute>
            <attribute name="t-custom-click.synthetic">this.onGlobalClick</attribute>
        </xpath>

        <xpath expr="article" position="inside">
            <button
                t-if="this.props.node.nodes.length or this.props.node.canShowChildNodes"
                name="hierarchy_search_subsidiaries"
                class="o_hierarchy_node_button btn btn-secondary d-grid m-2 mt-0"
                t-att-title="!this.props.node.nodes.length ? 'Unfold' : 'Fold'"
                t-on-click.synthetic="this.onClickArrowDown"
            >
                <t t-if="!this.props.node.nodes.length">
                    <span style="grid-column: 2;">
                        <i class="oi oi-fw" data-icon="arrow_right"/>
                        <t t-out="this.props.node.childResIds.length + ' ' + (this.env.config.getDisplayName() || 'Unfold')"/>
                    </span>
                </t>
                <t t-else="">
                    <span style="grid-column: 2;">
                        <i class="oi oi-fw" data-icon="arrow_drop_down"/>
                        <t t-out="this.props.node.childResIds.length + ' ' + (this.env.config.getDisplayName() || 'Fold')"/>
                    </span>
                </t>
            </button>
        </xpath>
    </t>

</templates>
