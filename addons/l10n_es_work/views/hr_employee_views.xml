<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_inherit_l10n_es_work" model="ir.ui.view">
        <field name="name">view.employee.form.inherit.l10n.es.work</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='wage']" position="after">
                <field name="l10n_es_irpf_rate" string="IRPF Holding Rate"/>
            </xpath>
        </field>
    </record>
</odoo>