<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_inherit_l10n_es_work" model="ir.ui.view">
        <field name="name">view.move.form.inherit.l10n_es.work</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']" position="before">
                <field name="l10n_es_show_irpf_rate" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='partner_id']" position="after">
                <field name="l10n_es_irpf_rate"
                       column_invisible="not parent.l10n_es_show_irpf_rate"
                       invisible="l10n_es_irpf_rate == 0"/>
            </xpath>
        </field>
    </record>
</odoo>