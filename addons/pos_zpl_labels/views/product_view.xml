<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_zpl" model="ir.ui.view">
        <field name="name">product.template.form.zpl</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='to_weight']" position="after">
                <field name="to_print_label" invisible="type == 'service'" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
