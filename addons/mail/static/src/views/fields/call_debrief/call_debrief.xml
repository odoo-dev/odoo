<templates>
    <t t-name="mail.CallDebrief">
        <div t-if="this.ui.error" class="text-danger" t-out="this.ui.error"/>
        <div t-else="" class="o-CallDebrief">
            <CallDebriefTimeline
                t-if="this.hasTimeline"
                totalDuration="this.callDurationSeconds"
                mediaSegments="this.media.mediaSegments"
                onSeek="(options) => this.setPlaybackTime(options)"
                currentTime="this.playback.currentTime"
            />
            <CallDebriefMediaControls
                t-if="this.hasMedia"
                isPlaying="this.playback.isPlaying"
                volume="this.volume()"
                isMuted="this.isMuted()"
                playbackRate="this.playback.playbackRate"
                playbackRates="this.playbackRates"
                currentTime="this.playback.currentTime"
                totalDuration="this.callDurationSeconds"
                media="this.media.currentSegment"
                feedback="this.ui.feedback"
                onTogglePlay="() => this.togglePlay()"
                onPlay="() => this.play()"
                onPause="() => this.pause()"
                onSeek="(delta) => this.seekRelative(delta)"
                onSetPlaybackRate="(ev) => this.setPlaybackRate(ev)"
                onSetVolume="(ev) => this.setVolume(ev)"
                onToggleMute="() => this.toggleMute()"
            />
            <div class="o-CallDebrief-media-container" t-att-class="{ 'o-CallDebrief-media-container--no-video': !this.hasVideo }">
                <div t-if="this.hasVideo" class="o-CallDebrief-video">
                    <video t-if="this.media.currentSegment and this.media.currentSegment.type === 'video'"
                        t-key="this.media.currentSegment.id"
                        t-ref="this.mediaPlayer"
                        t-att-src="this.media.currentSegment.mediaUrl"
                        style="width: 100%; height: 100%; object-fit: contain;"
                        t-on-loadeddata="this._onMediaLoaded"
                        t-on-timeupdate="this.onTimeUpdate"
                        t-on-play="() => this.playback.isPlaying = true"
                        t-on-pause="() => this.playback.isPlaying = false"
                        t-on-ended="this.onMediaEnded"
                        t-on-error="this.onMediaError"
                    />
                </div>
                <audio t-if="this.media.currentSegment and this.media.currentSegment.type === 'audio'"
                    t-key="this.media.currentSegment.id"
                    t-ref="this.mediaPlayer"
                    t-att-src="this.media.currentSegment.mediaUrl"
                    class="d-none"
                    t-on-loadeddata="this._onMediaLoaded"
                    t-on-timeupdate="this.onTimeUpdate"
                    t-on-play="() => this.playback.isPlaying = true"
                    t-on-pause="() => this.playback.isPlaying = false"
                    t-on-ended="this.onMediaEnded"
                    t-on-error="this.onMediaError"
                />
            </div>
        </div>
    </t>
</templates>
