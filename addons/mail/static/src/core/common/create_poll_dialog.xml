<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="mail.CreatePollDialog">
    <Dialog size="'md'" title.translate="Create Poll">
        <div class="w-100 mb-3">
            <label class="w-100">
                <span class="d-inline-block mb-2 fw-bold">Question</span>
                <input type="text" name="poll_question" t-model.proxy="this.state.question" class="form-control rounded o-py-1_5" placeholder="What question do you want to ask?" t-ref="this.questionRef"/>
                <div t-if="this.questionMissing" class="text-danger form-text ms-1">The question cannot be empty.</div>
            </label>
        </div>
        <div class="mb-3">
            <span class="mb-2 d-inline-block fw-bold">Options</span>
            <CreatePollOptionDialog t-foreach="this.state.options" t-as="option" t-key="option_index" model="option" deletable="this.state.options.length > 2" onClickRemove="() => this.onClickRemoveOption(option_index)"/>
            <button class="btn btn-link align-self-end" t-on-click="this.onClickAddOption"><i class="oi me-1" data-icon="add"/> Add another option</button>
            <div t-if="this.optionsMissing" class="text-danger form-text ms-1">At least two options are required</div>
        </div>
        <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-start gap-3">
            <label class="d-flex align-items-center">
                <span class="fw-bold me-2">Allow multiple options</span>
                <input class="form-check-input mt-0" type="checkbox" name="poll_allow_multiple_options" t-model.proxy="this.state.allowMultipleOptions"/>
            </label>
            <div class="d-flex align-items-start">
                <span class="fw-bold me-2 pt-2">Duration</span>
                <div class="d-flex flex-column align-items-start">
                    <Dropdown noClasses="true">
                        <button type="button" class="form-select text-start" style="width: fit-content;" name="poll_duration" t-ref="this.durationRef" t-on-click.capture="this.onClickDuration" t-out="this.durationLabel(this.state.duration)"/>
                        <t t-set-slot="content">
                            <DropdownItem t-foreach="this.durationOptions" t-as="option" t-key="option.value" class="{ 'active': this.state.duration === option.value }" onSelected="() => this.onSelectDuration(option.value)">
                                <t t-out="option.label"/>
                            </DropdownItem>
                            <DropdownItem class="{ 'active': this.state.duration === 'custom' }" onSelected="() => this.onSelectDuration('custom')">
                                <t t-out="this.durationLabel('custom')"/>
                            </DropdownItem>
                        </t>
                    </Dropdown>
                    <div t-if="this.state.endDateInvalid" class="text-danger form-text">Choose an end time in the future.</div>
                </div>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary me-2" t-on-click="this.onClickSubmit">Post</button>
            <button class="btn btn-secondary me-2" t-on-click="this.props.close">Discard</button>
        </t>
    </Dialog>
</t>
</templates>
