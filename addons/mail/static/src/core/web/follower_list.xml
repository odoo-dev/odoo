<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mail.FollowerList">
        <div t-if="this.canSearchFollowers" class="px-2 pt-2 pb-1">
            <SearchInput
                search="this.search"
                placeholder="this.inputPlaceholder"
                onClear="() => this.clearSearch()"
            />
        </div>
        <DropdownItem t-if="this.props.thread.selfFollower" class="'d-flex px-1 o-mail-FollowerList-unfollow'" onSelected="() => this.onClickUnfollow()">
            <span class="o-mail-FollowerList-unfollowBtn text-danger d-flex align-items-center flex-grow-1 px-3 fw-bold">
                Unfollow
            </span>
            <span class="o-mail-Follower-action btn btn-icon rounded-0 p-0 opacity-50 opacity-100-hover me-1" title="Edit Notification Preferences" t-on-click.stop="(ev) => this.onClickEdit(ev)">
                <i class="fa fa-fw fa-bell"/>
            </span>
        </DropdownItem>
        <DropdownItem t-else="" class="'o-mail-FollowerList-followBtn text-success'" onSelected="() => this.onClickFollow()">
            Follow
        </DropdownItem>
        <div role="separator" class="dropdown-divider opacity-50"/>
        <t t-if="this.props.thread.hasWriteAccess">
            <DropdownItem onSelected="() => this.onClickAddFollowers()" tag="'a'">
                Add Followers
            </DropdownItem>
            <div t-if="this.props.thread.followers.length > 0" role="separator" class="dropdown-divider opacity-50"/>
        </t>
        <div t-custom-ref="follower-list" t-if="this.props.thread.followers.length > 0" class="d-flex flex-column gap-1">
            <t t-foreach="this.props.thread.followers" t-as="follower" t-key="follower.id">
                <div t-att-data-follower-id="follower.id" class="w-100">
                    <Follower follower="follower" onFollowerChanged="this.props.onFollowerChanged" close="this.props.dropdown.close"/>
                </div>
            </t>
            <span t-if="this.showLoadMoreFollowers" class="btn btn-link" t-on-click="() => this.onLoadMoreFollowers()">Load more</span>
        </div>
        <div t-elif="this.isSearchingFollowers and this.props.thread.followers.length === 0" class="dropdown-item disabled">
            No matching followers
        </div>
        <div t-elif="this.showNoFollowers and !this.props.thread.hasWriteAccess" class="dropdown-item disabled">
            No Followers
        </div>
    </t>

</templates>
