<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="discuss.PermissionDialog">
        <div role="dialog" class="modal d-block" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered modal-md">
                <div class="modal-content o-bg-body">
                    <header class="modal-header border-0">
                        <button type="button" class="btn-close" aria-label="Close" t-on-click="props.close"/>
                    </header>
                    <main class="modal-body text-center pt-0 pb-4">
                        <h5 class="fw-medium fs-2 mb-2" t-out="permissionPrompt"/>
                        <small class="text-muted" t-out="permissionNote"/>
                    </main>
                    <footer class="modal-footer border-0 justify-content-center gap-2 pt-0">
                        <button class="btn btn-primary px-4" t-on-click="onClickPrimary" t-out="primaryActionText"/>
                        <button class="btn btn-outline-primary px-4" t-on-click="onClickSecondary" t-out="secondaryActionText"/>
                    </footer>
                </div>
            </div>
        </div>
    </t>

</templates>
