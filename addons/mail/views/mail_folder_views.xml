<?xml version="1.0"?>
<odoo>
    <data>

        <record id="view_mail_folder_list" model="ir.ui.view">
            <field name="name">mail.folder.list</field>
            <field name="model">mail.folder</field>
            <field name="arch" type="xml">
                <list string="Mail Folders">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="mail_folder_action" model="ir.actions.act_window">
            <field name="name">Mail Folders</field>
            <field name="res_model">mail.folder</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_mail_folder_list"/>
            <field name="target">new</field>
        </record>

    </data>
</odoo>
