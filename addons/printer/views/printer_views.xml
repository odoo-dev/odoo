<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record  id="printer_view_form" model="ir.ui.view">
        <field name="name">printer.form</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <form string="Printer">
                <sheet>
                    <h1>
                        <field name="name" placeholder="e.g. Zebra ZD421"/>
                    </h1>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="ip_address" required="1"/>
                            <field name="report_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="use_lna"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="manage_printer_client_device_action" model="ir.actions.act_window">
        <field name="name">Client Devices</field>
        <field name="res_model">printer.client.device</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No Device configured!
            </p>
        </field>
    </record>

    <record id="printer_client_device_view_list" model="ir.ui.view">
        <field name="name">printer.client.device.list</field>
        <field name="model">printer.client.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="proxy_id"/>
                <field name="ip_address"/>
                <field name="port"/>
                <field name="proxy_status"/>
            </list>
        </field>
    </record>

   <record id="printer_client_device_view_form" model="ir.ui.view">
        <field name="name">printer.client.device.form</field>
        <field name="model">printer.client.device</field>
        <field name="arch" type="xml">
            <form string="Printer Client Device">

                <header>
                    <button
                        name="%(action_proxy_discovery)d"
                        type="action"
                        string="Refresh"
                        class="btn-primary"
                        icon="fa-refresh"
                    />
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="proxy_id"/>
                            <field name="device_uuid" readonly="1"/>
                            <field name="proxy_status"/>
                        </group>

                        <group>
                            <field name="ip_address"/>
                            <field name="port"/>
                            <field string="Last Status Updated" name="write_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Printers">
                            <field name="printer_list">
                                <list editable="bottom" create="false">
                                    <field name="name"/>
                                    <field name="ip_address"/>
                                    <field name="report_ids" widget="many2many_tags"/>
                                    <field name="type"/>
                                    <field name="use_lna"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical Information">
                            <group>
                                <field name="host_name"/>
                                <field name="os"/>
                                <field name="os_version"/>
                                <field name="proxy_version"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="manage_printers_action" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="path">printers</field>
        <field name="res_model">printer.printer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No printer configured!
            </p>
            <p>Click "New" to configure a printer.</p>
        </field>
    </record>

    <record id="printer_view_list" model="ir.ui.view">
        <field name="name">printer.printer.view.list</field>
        <field name="model">printer.printer</field>
        <field name="arch" type="xml">
            <list default_order="name">
                <field name="name"/>
                <field name="ip_address" required="1"/>
                <field name="report_ids" widget="many2many_tags"/>
                <field name="type"/>
                <field name="use_lna"/>
            </list>
        </field>
    </record>

    <record id="action_reset_linked_printers" model="ir.actions.client">
        <field name="name">reset.linked.printers</field>
        <field name="path">reset-printers</field>
        <field name="tag">reset_linked_printers</field>
    </record>


    <record id="action_proxy_discovery" model="ir.actions.client">
        <field name="name">proxy.discovery</field>
        <field name="path">proxy-discovery</field>
        <field name="tag">proxy_discovery</field>
    </record>

    <menuitem
        id="menu_printer_root"
        name="Printer"
        action="manage_printer_client_device_action"
        sequence="90"
    />

    <menuitem
        id="menu_discover_printer_proxy"
        name="Discover Printer Proxy"
        parent="menu_printer_root"
        action="action_proxy_discovery"
        sequence="10"
    />
</odoo>
