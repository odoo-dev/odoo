<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.printer</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//setting[@id='inter_company']" position="after">
                    <setting string="Manage Printers"
                            help="Manage all your printers here"
                            id="manage_printer_setting"
                            company_dependent="1">
                        <div class="content-group">
                            <button name="open_manage_printer"
                                    icon="oi-arrow-right"
                                    type="object"
                                    string="Manage Printer"
                                    class="oe_link"/>
                            <br/>
                            <button name="open_reset_printer"
                                    icon="oi-arrow-right"
                                    type="object"
                                    string="Reset Linked Printer"
                                    class="oe_link p-0"/>
                        </div>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
