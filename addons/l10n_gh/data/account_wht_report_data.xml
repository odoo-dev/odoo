<?xml version="1.0" encoding="utf-8"?>
<odoo auto_sequence="1">
    <!-- Source: GRA Withholding Tax page (resident and non-resident rate tables); GRA Practice Note DT/2016/001; GRA form DT 110 layout. Report is registered under the generic tax report for Ghana. -->
    <record id="tax_report_gh_wht" model="account.report">
        <field name="name">Withholding Tax Report</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.gh"/>
        <field name="allow_foreign_vat" eval="False"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="tax_report_gh_wht_col_base" model="account.report.column">
                <field name="name">Payment Base</field>
                <field name="expression_label">base</field>
            </record>
            <record id="tax_report_gh_wht_col_tax" model="account.report.column">
                <field name="name">Tax Withheld</field>
                <field name="expression_label">tax</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="tax_report_gh_wht_sec_withheld" model="account.report.line">
                <field name="name">A. TAX WITHHELD ON PAYMENTS TO SUPPLIERS</field>
                <field name="hierarchy_level">0</field>
            </record>
            <record id="tax_report_gh_wht_sec_res" model="account.report.line">
                <field name="name">Resident payees</field>
                <field name="hierarchy_level">1</field>
            </record>
            <record id="tax_report_gh_wht_line_r_goods" model="account.report.line">
                <field name="name">Supply of Goods 3%</field>
                <field name="code">GH_WHT_01</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_r_goods_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Resident - Supply of Goods Base</field>
                    </record>
                    <record id="tax_report_gh_wht_r_goods_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Resident - Supply of Goods Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_line_r_works" model="account.report.line">
                <field name="name">Supply of Works 5%</field>
                <field name="code">GH_WHT_02</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_r_works_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Resident - Supply of Works Base</field>
                    </record>
                    <record id="tax_report_gh_wht_r_works_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Resident - Supply of Works Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_line_r_services" model="account.report.line">
                <field name="name">Supply of Services 7.5%</field>
                <field name="code">GH_WHT_03</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_r_services_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Resident - Supply of Services Base</field>
                    </record>
                    <record id="tax_report_gh_wht_r_services_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Resident - Supply of Services Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_total_res" model="account.report.line">
                <field name="name">Total - resident payees</field>
                <field name="code">GH_WHT_06</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_total_res_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_01.base + GH_WHT_02.base + GH_WHT_03.base</field>
                    </record>
                    <record id="tax_report_gh_wht_total_res_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_01.tax + GH_WHT_02.tax + GH_WHT_03.tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_sec_non" model="account.report.line">
                <field name="name">Non-resident payees</field>
                <field name="hierarchy_level">1</field>
            </record>
            <record id="tax_report_gh_wht_line_n_gws" model="account.report.line">
                <field name="name">Goods, Works or Any Services (incl. Management and Technical Fees) 20%</field>
                <field name="code">GH_WHT_08</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_n_gws_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Non-resident - Goods, Works or Any Services Base</field>
                    </record>
                    <record id="tax_report_gh_wht_n_gws_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Non-resident - Goods, Works or Any Services Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_total_non" model="account.report.line">
                <field name="name">Total - non-resident payees</field>
                <field name="code">GH_WHT_13</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_total_non_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_08.base</field>
                    </record>
                    <record id="tax_report_gh_wht_total_non_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_08.tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_total_withheld" model="account.report.line">
                <field name="name">Total tax withheld (to remit to GRA)</field>
                <field name="code">GH_WHT_14</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_total_withheld_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_06.base + GH_WHT_13.base</field>
                    </record>
                    <record id="tax_report_gh_wht_total_withheld_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_06.tax + GH_WHT_13.tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_sec_credit" model="account.report.line">
                <field name="name">B. WITHHOLDING TAX CREDITS (TAX WITHHELD BY OUR CUSTOMERS)</field>
                <field name="hierarchy_level">0</field>
            </record>
            <record id="tax_report_gh_wht_line_c_goods" model="account.report.line">
                <field name="name">Sale of Goods 3%</field>
                <field name="code">GH_WHT_15</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_c_goods_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Credit - Sale of Goods Base</field>
                    </record>
                    <record id="tax_report_gh_wht_c_goods_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Credit - Sale of Goods Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_line_c_works" model="account.report.line">
                <field name="name">Sale of Works 5%</field>
                <field name="code">GH_WHT_16</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_c_works_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Credit - Sale of Works Base</field>
                    </record>
                    <record id="tax_report_gh_wht_c_works_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Credit - Sale of Works Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_line_c_services" model="account.report.line">
                <field name="name">Sale of Services 7.5%</field>
                <field name="code">GH_WHT_17</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_c_services_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">-WHT Credit - Sale of Services Base</field>
                    </record>
                    <record id="tax_report_gh_wht_c_services_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">tax_tags</field>
                        <field name="formula">WHT Credit - Sale of Services Tax</field>
                    </record>
                </field>
            </record>
            <record id="tax_report_gh_wht_total_credit" model="account.report.line">
                <field name="name">Total withholding tax credits</field>
                <field name="code">GH_WHT_18</field>
                <field name="expression_ids">
                    <record id="tax_report_gh_wht_total_credit_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_15.base + GH_WHT_16.base + GH_WHT_17.base</field>
                    </record>
                    <record id="tax_report_gh_wht_total_credit_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">GH_WHT_15.tax + GH_WHT_16.tax + GH_WHT_17.tax</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
