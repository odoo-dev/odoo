<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order_secure.LandingPage" t-inherit="pos_self_order.LandingPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pos_landing_footer')]" position="before">
            <div t-if="this.selfOrder.isSessionExpired" id="pos-session-expired-banner" class="pos-session-expired-banner">
                <span class="pos-session-expired-icon">⏱️</span>
                <span>Your session has expired. Please <strong>scan the QR code again</strong> to continue ordering.</span>
            </div>
        </xpath>
    </t>
</templates>
