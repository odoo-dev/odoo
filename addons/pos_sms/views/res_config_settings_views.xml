<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_sms_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.sms.pos</field>
        <field name="model">pos.config</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_sms']" position="inside">
                <div class="content-group mt16" invisible="not module_pos_sms">
                    <div class="row">
                        <label string="Receipt template" for="sms_receipt_template_id" class="col-lg-3 o_light_label"/>
                        <field name="sms_receipt_template_id" required="module_pos_sms"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
