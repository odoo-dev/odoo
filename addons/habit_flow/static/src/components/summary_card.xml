<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="habit_flow.SummaryCard">
        <section class="o_hf_summary_card">
            <header>
                <div class="d-flex align-items-center gap-3">
                    <span class="o_hf_summary_icon">
                        <i t-att-class="'fa ' + this.props.icon"/>
                    </span>
                    <h2 t-out="this.props.title"/>
                </div>
            </header>
            <div class="o_hf_summary_body">
                <t t-call-slot="default"/>
            </div>
        </section>
    </t>

</templates>
