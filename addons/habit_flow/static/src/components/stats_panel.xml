<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="habit_flow.StatsPanel">
        <div class="o_hf_stats_stack">
            <SummaryCard title="'Today Summary'" icon="'fa-calendar-check-o'">
                <div class="o_hf_today_grid">
                    <div>
                        <span>Active Habits</span>
                        <strong class="text-primary" t-out="this.props.stats.activeHabitCount"/>
                    </div>
                    <div>
                        <span>Completed Today</span>
                        <strong class="text-success" t-out="this.props.stats.completedTodayCount"/>
                    </div>
                    <div>
                        <span>Pending</span>
                        <strong class="text-warning" t-out="this.props.stats.pendingTodayCount"/>
                    </div>
                    <div>
                        <span>Completion %</span>
                        <div class="o_hf_completion_pair">
                            <strong class="text-info" t-out="this.props.stats.todayCompletionPercentage + '%'"/>
                            <div class="o_hf_ring" t-att-style="'--hf-progress: ' + this.props.stats.todayCompletionPercentage + '%'"/>
                        </div>
                    </div>
                </div>
            </SummaryCard>

            <SummaryCard title="'Streak Summary'" icon="'fa-fire'">
                <div class="o_hf_streak_grid">
                    <div>
                        <span>Longest Current Streak</span>
                        <strong><t t-out="this.props.stats.longestCurrentStreak"/> <small>days</small></strong>
                    </div>
                    <div>
                        <span>Active Streaks</span>
                        <strong><t t-out="this.props.stats.activeStreakCount"/> <small>habits</small></strong>
                    </div>
                    <div>
                        <span>Best Habit</span>
                        <t t-if="this.props.bestHabit">
                            <strong class="o_hf_best_habit">
                                <span t-out="this.props.bestHabit.habit.icon"/>
                                <span t-out="this.props.bestHabit.habit.name"/>
                            </strong>
                            <small><t t-out="this.props.bestHabit.metrics.bestStreak"/> days</small>
                        </t>
                        <t t-else="">
                            <strong>—</strong>
                            <small>No habits yet</small>
                        </t>
                    </div>
                </div>
            </SummaryCard>
        </div>
    </t>

</templates>
