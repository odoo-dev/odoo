<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

<t t-name="web_client.ListView">
    <ControlPanel/>
    <main>
        <div class="px-3">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <t t-foreach="this.columns" t-as="column" t-key="column.id">
                            <th><t t-out="column.title"/></th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="this.records" t-as="record" t-key="record.id">
                        <tr class="cursor-pointer" t-on-click="() => this.view.openRecord(record.id)">
                            <t t-foreach="this.columns" t-as="column" t-key="column.id">
                                <td>
                                    <div class="text-truncate" style="width: 200px;" t-out="record[column.fieldName]"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </main>
</t>

</templates>
