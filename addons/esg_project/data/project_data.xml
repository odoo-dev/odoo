<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="esg_project_stage_0" model="project.task.type">
            <field name="sequence">10</field>
            <field name="name">Ideas 🌱</field>
        </record>

        <record id="esg_project_stage_1" model="project.task.type">
            <field name="sequence">20</field>
            <field name="name">In Progress 🌳</field>
        </record>

        <record id="esg_project_stage_2" model="project.task.type">
            <field name="sequence">30</field>
            <field name="name">Done 🌳🌲</field>
        </record>

        <record id="esg_project_project_0" model="project.project">
            <field name="name">Carbon Reduction</field>
            <field name="type_ids" eval="[(4, ref('esg_project_stage_0')), (4, ref('esg_project_stage_1')), (4, ref('esg_project_stage_2'))]"/>
        </record>

        <record id="esg_project_task_0" model="project.task">
            <field name="name">Bus Transportation</field>
            <field name="project_id" ref="esg_project_project_0"/>
            <field name="stage_id" ref="esg_project_stage_0"/>
        </record>
    </data>
</odoo>
