<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_operations" model="ir.ui.view">
        <field name="name">stock.move.operations.form.inherit.product.shape</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='product_qty']//field[@name='product_id']" position="after">
                <field name="shape_type" invisible="1"/> <!-- read as parent.shape_type by the size columns of the move lines -->
                <field name="shape_dimension_uom_id" string="Size Unit" invisible="not shape_type"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit.product.shape</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="before">
                <field name="shape_height" column_invisible="parent.shape_type in (False, 'square', 'round', 'hexagonal', 'octagonal')"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
                <field name="shape_length" column_invisible="parent.shape_type in (False, 'ring')"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
                <field name="shape_width" column_invisible="not parent.shape_type"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
                <field name="shape_inner_diameter" column_invisible="parent.shape_type != 'ring'"
                       readonly="lot_id or (state == 'done' and is_locked)"/>
                <field name="shape_pcs" column_invisible="not parent.shape_type"
                       readonly="state == 'done' and is_locked"/>
            </field>
            <field name="lot_name" position="attributes">
                <!-- the lot of the pieces is named after their size -->
                <attribute name="readonly">parent.shape_type</attribute>
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>
</odoo>
