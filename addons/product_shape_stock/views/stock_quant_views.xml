<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.inherit.product.shape</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <field name="inventory_quantity_auto_apply" position="after">
                <field name="shape_type" column_invisible="True"/> <!-- hides the pieces of products without a shape -->
                <field name="shape_pcs" optional="show" invisible="not shape_type"/>
                <field name="shape_weight" optional="show" invisible="not shape_type"/>
            </field>
        </field>
    </record>

    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.inherit.product.shape</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <field name="lot_id" position="after">
                <field name="shape_type" column_invisible="True"/> <!-- hides the pieces of products without a shape -->
                <field name="shape_pcs" optional="show" invisible="not shape_type or not lot_id"/>
            </field>
            <field name="quantity" position="after">
                <field name="shape_weight" optional="show" invisible="not shape_type"/>
            </field>
            <field name="inventory_quantity" position="before">
                <field name="inventory_shape_pcs" optional="show" invisible="not shape_type or not lot_id"/>
            </field>
        </field>
    </record>
</odoo>
