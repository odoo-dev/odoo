<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_inherit_pos_online_payment" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.pos.online.payment</field>
        <field name="model">pos.config</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fast_payment_method_ids']" position="attributes">
                <attribute name="domain">[('id', 'in', payment_method_ids), ('payment_provider', '=', False), ('type', '!=', 'pay_later'), ('type', '!=', 'online')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
