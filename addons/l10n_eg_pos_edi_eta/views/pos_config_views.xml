<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.l10n_eg_pos_edi_eta.form.view</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div invisible="country_code != 'EG'">
                    <hr />
                    <h3 class="ms-2">ETA Configuration</h3>
                    <div class="text-muted ms-3">
                        Connect PoS device to Egyptian Tax Authority
                    </div>
                    <div class="row mt16 o_settings_container" id="l10n_eg_pos_eta_config">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">POS Serial Number</span>
                                <div class="text-muted">
                                    Serial number of the POS system used for authentication
                                </div>
                                <field name="l10n_eg_pos_serial" required="country_code == 'EG'"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">POS Version</span>
                                <div class="text-muted">
                                    Version of the POS system used for authentication
                                </div>
                                <field name="l10n_eg_pos_version" required="country_code == 'EG'" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Model Framework</span>
                                <div class="text-muted">
                                    Model Framework of the POS system used for authentication
                                </div>
                                <field name="l10n_eg_pos_model_framework"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">POS Authentication</span>
                                <div class="text-muted">
                                    Client ID/Secret of the POS system
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="l10n_eg_pos_client_id" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_eg_pos_client_id" help="Client ID of the POS device"/>
                                    </div>
                                    <div class="row">
                                        <label for="l10n_eg_pos_client_secret" class="col-lg-4 o_light_label"/>
                                        <field name="l10n_eg_pos_client_secret" help="Secret Key of the POS device"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Authentication Status</span>
                                <div role="alert" class="alert alert-info"
                                        invisible="l10n_eg_production_env">
                                    <i class="fa fa-info-circle mr-1"/>
                                    You are currently using the eReceipts integration in pre-production,
                                    which does not handle device activation. For the sake of testing,
                                    device activation merely simulates the actual process.
                                </div>
                                <div class="text-muted">
                                    Client ID/Secret of the POS system
                                </div>
                                <button name="l10n_eg_pos_action_authenticate_device" type="object"
                                        invisible="l10n_eg_pos_client_authenticated"
                                        string="Authenticate" class="btn-info"/>
                                <span invisible="not l10n_eg_pos_client_authenticated">
                                    <i class="fa fa-check text-success mr-2"/>
                                    Authenticated (<button name="l10n_eg_pos_action_authenticate_device" type="object"
                                        confirm="Device has already been activated, are you sure?"
                                        string="Update" class="btn-link"/>)
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
