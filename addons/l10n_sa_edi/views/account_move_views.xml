<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="name">account.view.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="ZATCA" name="l10n_sa_edi_zatca_page">
                        <field name="l10n_sa_edi_log_ids">
                            <list>
                                <field name="create_date" />
                                <field name="state" />
                                <field name="attachment_id" />
                            </list>
                        </field>
                    </page>
                    <page string="ZATCATEST" name="l10n_sa_edi_zatca_page">
                        <field name="l10n_sa_edi_document_id"/>
                    </page>
                </notebook>
            </field>
        </record>
    </data>
</odoo>
