<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_az_eqf" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_az</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="l10n_az_eqf_location_code" invisible="country_code != 'AZ'"/>
            </xpath>
        </field>
    </record>
</odoo>
