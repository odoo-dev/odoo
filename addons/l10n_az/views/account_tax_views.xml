<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_inherit_l10n_az_eqf" model="ir.ui.view">
        <field name="name">account.tax.form.inherit.l10n_az</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_type']" position="after">
                <field name="l10n_az_eqf_vat_type" invisible="country_code != 'AZ'"/>
            </xpath>
        </field>
    </record>
</odoo>
