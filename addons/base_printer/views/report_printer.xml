<odoo>
    <record id="action_report_printer" model="ir.actions.act_window">
        <field name="name">report printer</field>
        <field name="res_model">report.printer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p><p>
                Create a new report printer
            </p>
        </field>
    </record>
    <menuitem
            id="report_printer"
            name="Printer"
            parent="base.reporting_menuitem"
            action="action_report_printer"
            sequence="4"
            groups="base.group_no_one"
            />

    <record id="report_printer_form_view" model="ir.ui.view">
        <field name="name">report.printer.form</field>
        <field name="model">report.printer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="report_printer_list_view" model="ir.ui.view">
        <field name="name">report.printer.list</field>
        <field name="model">report.printer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>
</odoo>
