<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="marketplace_location_list" model="ir.ui.view">
        <field name="name">marketplace.location.list</field>
        <field name="model">marketplace.location</field>
        <field name="arch" type="xml">
            <list string="Marketplace Location" editable="bottom">
                <field name="name"/>
                <field name="matched_location_id"/>
                <field name="marketplace_account_id"/>
                <field name="marketplace_location_identifier" optional="hide" groups="base.group_no_one"/>
            </list>
        </field>
    </record>
    <record id="action_marketplace_location" model="ir.actions.act_window">
        <field name="name">Marketplace Locations</field>
        <field name="res_model">marketplace.location</field>
        <field name="view_mode">list</field>
        <field name="context">{'group_by': 'marketplace_account_id', 'create': False}</field>
    </record>
</odoo>
