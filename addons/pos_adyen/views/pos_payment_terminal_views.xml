<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_terminal_view_list" model="ir.ui.view">
        <field name="name">pos.payment.terminal.list.inherit.pos_adyen</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="adyen_terminal_identifier" column_invisible="parent.payment_provider != 'adyen'" required="parent.payment_provider == 'adyen'"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_terminal_view_form" model="ir.ui.view">
        <field name="name">pos.payment.terminal.form.inherit.pos_adyen</field>
        <field name="model">pos.payment.terminal</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_terminal_view_form"/>
        <field name="arch" type="xml">
            <group name="settings" position="after">
                <group name="adyen_settings" invisible="payment_provider != 'adyen'">
                    <field name="adyen_terminal_identifier" required="payment_provider == 'adyen'"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
