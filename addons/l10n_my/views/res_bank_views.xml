<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_bank_form_inherit_account" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='proxy_type']" position="after">
                <field name="acquirer_id" invisible="country_code != 'MY'" />
            </xpath>
            <field name="proxy_value" position="attributes">
                <attribute name="invisible">country_code == 'MY'</attribute>
            </field>
            <xpath expr="//field[@name='proxy_value']" position="after">
                <field name="proxy_value" string="QR ID" invisible="country_code != 'MY'" />
                <field name="rrn" invisible="country_code != 'MY'"/>
            </xpath>
        </field>
    </record>

</odoo>
