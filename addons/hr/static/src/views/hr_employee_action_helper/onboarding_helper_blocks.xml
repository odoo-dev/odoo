<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <t t-name="hr.OnboardingIconCard">
        <div t-attf-class="o_hr_onboarding_icon {{archClass || ''}} o_hr_onboarding_icon_{{module}} d-flex flex-column align-items-center justify-content-center">
            <img t-attf-src="/{{module}}/static/description/icon.png" t-att-width="size" t-att-height="size"/>
            <span t-if="label" class="text-center text-nowrap small" t-out="label"/>
        </div>
    </t>

    <t t-name="hr.OnboardingHelperBlocks">
        <div class="o_hr_onboarding_blocks container-fluid d-flex flex-column align-items-center justify-content-center">
                <t t-call="hr.OnboardingIconCard" module="'hr_recruitment'" label="'Recruitment'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'sign'" label="'Sign'" size="40" archClass="'o_hr_onboarding_icon--inner'"/>
            <t t-call="hr.OnboardingIconCard" module="'hr_referral'" label="'Employee Referral'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'ai'" label="'AI'" size="40" archClass="'o_hr_onboarding_icon--inner'"/>
            <t t-call="hr.OnboardingIconCard" module="'planning'" label="'Planning'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'fleet'" label="'Fleet'" size="40" archClass="'o_hr_onboarding_icon--inner'"/>
            <t t-call="hr.OnboardingIconCard" module="'hr_payroll'" label="'Payroll'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'hr_holidays'" label="'Time Off'" size="40" archClass="'o_hr_onboarding_icon--inner'"/>
            <t t-call="hr.OnboardingIconCard" module="'lunch'" label="'Lunch'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'hr_appraisal'" label="'Appraisals'" size="40" archClass="'o_hr_onboarding_icon--inner'"/>
            <t t-call="hr.OnboardingIconCard" module="'website_slides'" label="'eLearning'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'documents'" label="'Documents'" size="40" archClass="'o_hr_onboarding_icon--inner'"/>
            <t t-call="hr.OnboardingIconCard" module="'hr_skills'" label="'Skills'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'board'" label="'Dashboards'" size="40"/>
            <t t-call="hr.OnboardingIconCard" module="'hr'" size="80"/>
        </div>
    </t>
</odoo>
