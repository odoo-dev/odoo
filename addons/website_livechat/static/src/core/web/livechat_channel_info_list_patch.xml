<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website_livechat.LivechatChannelInfoList" t-inherit="im_livechat.LivechatChannelInfoList" t-inherit-mode="extension">
        <xpath expr="//t[@t-name='extra_infos']" position="inside">
            <t t-set="visitor" t-value="this.props.thread.livechat_visitor_id"/>
            <div t-if="visitor" class="d-flex flex-column bg-inherit gap-1">
                <h6 class="pt-3 mb-1">Tracked page views</h6>
                <div t-if="visitor.website_id">
                    <i class="me-1 oi" data-icon="public" aria-label="Website"/>
                    <span t-out="visitor.website_id.name"/>
                </div>
                <div t-if="visitor.last_track_ids.length" class="d-flex flex-column o-gap-0_5">
                    <a
                        t-foreach="visitor.last_track_ids"
                        t-as="track"
                        t-key="track.id"
                        t-att-href="track.page_id.url"
                        t-att-title="track.page_id.url"
                        target="_blank"
                        class="btn btn-sm btn-secondary d-flex flex-column align-items-start px-3 py-1 rounded-0"
                        t-att-class="{
                            'o-rounded-top-bubble': track_first,
                            'o-rounded-bottom-bubble': track_last,
                        }"
                    >
                        <div class="d-flex align-items-center w-100 gap-2">
                            <i class="oi opacity-75" data-icon="open_in_new"/>
                            <span class="fw-bold text-truncate flex-grow-1 text-start" t-out="track.page_id.name"/>
                            <span class="small text-muted flex-shrink-0" t-out="this.formatVisitTime(track.visit_datetime)"/>
                        </div>
                        <span class="text-muted smaller text-truncate w-100 text-start ps-4" t-out="track.page_id.url"/>
                    </a>
                </div>
                <span t-else="" class="text-muted small">No tracked page views yet.</span>
            </div>
            <div t-if="!this.props.thread.channel.livechat_end_dt and this.recentConversations.length" class="d-flex flex-column bg-inherit gap-1">
                <h6 class="pt-3">Recent conversations</h6>
                <div class="btn btn-group o-rounded-bubble d-flex flex-column w-100 p-0 m-0" style="gap: 1px;">
                    <a
                        t-foreach="this.recentConversations" t-as="channel" t-key="channel.localId"
                        class="o-livechat-LivechatChannelInfoList-recentConversation btn btn-sm btn-secondary btn-group-item d-flex flex-column w-100 m-0 px-3 py-1"
                        t-attf-href="/odoo/discuss?active_id=discuss.channel_{{channel.id}}"
                        target="_blank"
                        t-att-class="{
                            'o-rounded-top-bubble': channel_first,
                            'o-rounded-bottom-bubble': channel_last,
                            'rounded-top-0': !channel_first,
                            'rounded-bottom-0 border-bottom': !channel_last,
                        }"
                    >
                        <div class="d-flex align-items-center">
                            <i class="oi me-2 o-mt-0_5 opacity-75" data-icon="open_in_new"/>
                            <span>
                                <t t-if="channel.livechat_end_dt" t-out="this.CLOSED_ON_TEXT(channel)"/>
                                <t t-else="">Conversation ongoing</t>
                            </span>
                        </div>
                        <span t-if="channel.description" class="text-start text-muted smaller text-truncate" t-out="channel.description"/>
                    </a>
                </div>
            </div>
        </xpath>
    </t>
</templates>
