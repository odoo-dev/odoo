<?xml version="1.0"?>
<odoo>

    <!-- Top-level Menu -->
    <menuitem id="data_generator_root_menu"
              name="Data Generator (for pdf)"
              sequence="1"/>

    <!-- Action (run the action_generate_mass_data of SaleMassGenerator model) -->
    <record id="data_generator_action" model="ir.actions.server">
        <field name="name">Data Generator</field>
        <field name="model_id" ref="model_sale_mass_generator"/>
        <field name="binding_model_id" ref="model_sale_mass_generator"/>
        <field name="state">code</field>
        <field name="code">
            action = env['sale.mass.generator'].action_generate_mass_data()
        </field>
    </record>

    <!-- Child Menu with Action -->
    <menuitem id="data_generator_menu"
              name="generator"
              parent="data_generator_root_menu"
              action="data_generator_action"
              sequence="10"/>

</odoo>
