<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

    <t t-name="pos_self_order.FloorScreen" t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('button-table-selector')]" position="before">
            <button t-if="!this.ui.isSmall" class="qr-order-button btn btn-secondary btn-lg" t-on-click="() => this.pos.redirectToQrForm()">
                Get QR Codes
            </button>
        </xpath>
    </t>

    <t t-name="pos_self_order.floor_screen_element" t-inherit="pos_restaurant.floor_screen_element" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('table-timer-badge')]" position="after">
            <t t-set="joinRequests" t-value="this.pos.getTableJoinRequests(table)"/>
            <button t-if="joinRequests.length"
                    class="o_table_join_requests_badge btn btn-warning d-flex align-items-center gap-1 position-absolute top-0 start-0 rounded-3 smaller fw-bolder z-2 badge"
                    t-att-style="tableContentStyle"
                    title="Join requests"
                    t-on-click.stop="() => this.pos.openTableJoinRequests(table)">
                <i class="oi" data-icon="person_add" aria-hidden="true"/>
                <t t-out="joinRequests.length"/>
            </button>
        </xpath>
    </t>

</templates>
