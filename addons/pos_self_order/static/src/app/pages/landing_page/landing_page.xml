<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.LandingPage" t-inherit="pos_self.LandingPage" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('page-body')]" position="after">
            <div class="o_pos_landing_footer position-absolute bottom-0 end-0 d-flex w-100 ">
                <div class="container o_self_container py-3">
                    <div  class="row justify-content-center g-2 g-md-3">
                        <t t-if="this.showMyOrderBtn()">
                            <div class="col-12 col-md-6 col-lg-6 col-kiosk-p-12">
                                <a type="button"
                                t-on-click="this.clickMyOrder"
                                class="btn btn-lg btn-secondary w-100 "
                                style="border-color: #714B67">
                                    <t t-if="this.draftOrder.length > 0">
                                        My Order
                                    </t>
                                    <t t-else="">
                                        My Orders
                                    </t>
                                </a>
                            </div>
                        </t>

                        <t t-foreach="this.selfOrder.models['pos_self_order.custom_link'].getAll()" t-as="link" t-key="link.id">
                            <div class="col-12 col-md-6 col-lg-6 col-kiosk-p-12"  t-if="!this.hideBtn(link)">
                                <a type="button"
                                    t-on-click="(event) => this.clickCustomLink(link)"
                                    t-attf-class="btn btn-lg btn-{{link.style}} w-100">
                                    <t t-out="link.name"/>
                                </a>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
