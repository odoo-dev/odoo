<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.StandNumberPage">
        <div class="self_order_stand_number d-flex flex-column align-items-center flex-grow-1 bg-secondary overflow-y-auto text-center o-so-fade">
            <div class="container-small d-flex flex-column my-auto">
                <h1 class="mb-4 m-0">Please take a tracker and input <br/> the number shown on it</h1>
                <div class="d-flex flex-column gap-4">
                    <div class="input-number form-control form-control-l mx-auto rounded-4 bg-white text-center py-2 py-md-3">
                        <span t-attf-class="display-1 fw-bolder {{ state.standNumber ? 'text-primary' : 'opacity-0' }}" t-esc="state.standNumber || '_ _'"/>
                    </div>
                    <div class="d-inline-block justify-content-around align-items-center my-auto">
                        <Numpad buttons="[1, 2, 3, 4, 5, 6, 7, 8, 9, { value: '', disabled: true }, '0', { value: 'Backspace', text: '⌫' }]" onClick="numberClick.bind(this)" class="'numpad-so rounded-4'"/>
                    </div>
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-between p-2 p-md-4 gap-2 gap-md-3 bg-view border-top shadow-lg text-center">
            <button class="btn btn-secondary btn-lg" t-on-click="() => this.router.back()">Back</button>
            <button class="btn btn-primary btn-lg" t-att-disabled="!state.standNumber" t-on-click="confirm">Pay</button>
        </div>
    </t>
</templates>
