<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.CancelPopup">
        <div class="self_order_cancel_popup o_dialog" t-att-id="id">
            <div role="dialog" class="modal d-block" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                        <div class="modal-body p-5 overflow-visible">
                            <div class="position-absolute top-0 start-50 translate-middle px-4 py-3 rounded-4 text-bg-danger border border-white border-5">
                                <i class="fa fa-exclamation-triangle" aria-hidden="true"/>
                            </div>
                            <div class="mt-3 pb-5 text-center">
                                <h2>Are you sure you want to cancel this order? </h2>
                                <span t-if="selfOrder.config.self_ordering_mode === 'kiosk'" class="text-muted">All the items will be removed from the cart.</span>
                                <span t-else="" class="text-muted">Any items already sent will not be cancelled</span>
                            </div>
                            <div class="d-grid d-md-flex justify-content-md-center gap-2">
                                <button type="button" class="btn btn-secondary btn-lg popup_button" t-on-click="() => this.props.close()">Discard</button>
                                <button type="button" class="btn btn-primary btn-lg popup_button" t-on-click="() => this.confirm()">Cancel Order</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
