<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.ComboSelection">
        <div t-if="!props.comboState.selectedProduct" class="self_order_attribute_selection p-2 p-md-4 flex-grow-1">
            <h2 class="attribute_name mb-3 px-3 pt-3">Select <strong t-esc="props.combo.name" /></h2>
            <div class="combo-list align-items-center justify-content-start">
                <div class="combo-list-products mx-n2 ">
                    <div class="o-so-products-row d-flex flex-wrap g-3">
                        <t t-foreach="props.combo.combo_item_ids" t-as="line" t-key="line.id" t-if="line.product_id">
                            <t t-set="product" t-value="line.product_id"/>
                            <t t-set="isOutOfStock" t-value="!product.self_order_available"/>
                            <article
                                t-attf-for="{{ props.combo.id }}_{{ line.id }}"
                                t-on-click="() => this.productClicked(line)"
                                class="self_order_product_card mb-2 mb-sm-3 user-select-none"
                                role="button"
                                >
                                    <div class="d-flex flex-row-reverse flex-md-column align-items-center align-items-md-center gap-2 py-2 ps-3 pe-2 p-md-2 rounded-4 text-bg-light">
                                    <div class="ratio ratio-1x1 w-25 w-sm-50 w-md-100 rounded-4 overflow-hidden" t-att-class="{'d-none d-md-block': !product.image_128}">
                                        <div class="placeholder-glow">
                                            <div class="placeholder w-100 h-100 bg-300 rounded"/>
                                        </div>
                                        <img class="o_self_order_item_card_image w-100 rounded"
                                            t-attf-src="/web/image/product.product/{{ product.id }}/image_512"
                                            alt="Product image"
                                            loading="lazy"
                                            onerror="this.remove()"/>
                                    </div>
                                    <div class="product-infos d-flex flex-column justify-content-between flex-grow-1 w-100 px-2 my-0 my-md-3 text-start text-md-center fw-bold lh-1 overflow-hidden">
                                        <span t-esc="product.display_name"/>
                                        <div class="d-flex justify-content-start justify-content-md-center gap-3">
                                            <span t-if="line.extra_price" class="badge rounded-pill my-2 lh-sm text-bg-primary" t-att-class="isOutOfStock ? 'text-bg-secondary' : 'text-bg-primary'">
                                                + <t t-out="selfOrder.formatMonetary(line.extra_price)"/>
                                            </span>
                                            <span t-if="isOutOfStock" class="badge rounded-pill my-2 lh-sm text-bg-danger">
                                                Out of stock
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </t>
                    </div>
                </div>
            </div>
        </div>
        <t t-else="">
            <AttributeSelection productTemplate="props.comboState.selectedProduct.product_tmpl_id" />
        </t>
    </t>
</templates>
