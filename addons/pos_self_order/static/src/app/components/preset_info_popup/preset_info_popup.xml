<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_self_order.PresetInfoPopup">
        <Dialog header="false"
            contentClass="'w-100 m-0 position-absolute self_order_pills_selection_popup_dialog preset_info_popup_dialog'"
            bodyClass="'p-4 pb-3 m-0'"
            title="this.props.title">
            <div class="select_popup_preset_info w-100 d-flex flex-column h-100 overflow-hidden">
                <div class="d-flex justify-content-between align-items-center px-2 mt-2 mb-4">
                    <h2 class="mb-0">We need more info</h2>
                    <button class="btn-close" aria-label="close" t-on-click="this.close"/>
                </div>
                <div class="d-flex flex-column gap-3 overflow-y-auto overflow-x-hidden flex-grow-1">
                    <input t-if="this.preset.needsName || this.preset.needsPartner"
                        t-ref="this.autofocusRef"
                        type="text"
                        class="form-control form-control-lg"
                        placeholder="Name"
                        t-model.proxy="this.state.name"/>
                    <input t-if="this.preset.needsEmail || this.preset.needsPartner"
                        type="text"
                        class="form-control form-control-lg"
                        placeholder="Email"
                        t-model.proxy="this.state.email"/>
                    <t t-if="this.preset.needsName || this.preset.needsPartner">
                        <div class="d-flex gap-3">
                            <SelectMenu
                                choices="this.phoneCountryChoices"
                                value="this.state.phoneCountryId"
                                onSelect.bind="this.setPhoneCountry"
                                togglerClass="'form-control-lg fs-3 d-flex justify-content-center align-items-center'"
                                position="'bottom-start'"
                                searchPlaceholder.translate="Search country..."
                                required="true">
                                <span class="d-flex align-items-center gap-1">
                                    <t t-out="this.flagEmoji(this.selectedCountry?.code || '')"/>
                                    <span>+<t t-out="this.phoneCode"/></span>
                                </span>
                                <t t-set-slot="choice" t-slot-scope="choice">
                                    <span class="d-flex align-items-center gap-1">
                                        <t t-out="this.flagEmoji(choice.data.country.code)"/>
                                        <span>+<t t-out="choice.data.country.phone_code"/></span>
                                        <span class="text-truncate" t-out="choice.data.country.name"/>
                                    </span>
                                </t>
                            </SelectMenu>
                            <input type="tel"
                                class="form-control form-control-lg"
                                placeholder="Phone"
                                t-on-input="this.onPhoneInput" />
                        </div>
                        <p t-if="!this.checkPhoneFormat()" class="text-danger">Enter a valid phone number</p>
                    </t>
                    <t t-if="this.preset.needsPartner">
                        <t t-set="addressInput" t-value="this.selfOrder.getAddressInput()"/>
                        <t t-if="addressInput" t-component="addressInput.Component" state="this.state"/>
                        <input t-else=""
                            type="text"
                            class="form-control form-control-lg"
                            placeholder="Address"
                            t-model.proxy="this.state.street"/>
                        <t t-if="this.state.validationError">
                            <p class="text-danger mb-0" t-out="this.state.validationError.message"/>
                            <div t-if="this.state.validationError.type === 'delivery' and this.otherPresets.length" class="d-flex gap-2 flex-wrap justify-content-center">
                                <button t-foreach="this.otherPresets" t-as="altPreset" t-key="altPreset.id"
                                    type="button"
                                    class="btn btn-light btn-sm"
                                    t-on-click="() => this.selectPreset(altPreset)"
                                    t-out="altPreset.name"
                                />
                            </div>
                        </t>
                    </t>
                </div>
                <div class="w-100 d-flex mt-3">
                    <button class="btn btn-secondary flex-grow-1 me-1"
                        t-on-click="this.props.close">
                        Cancel
                    </button>
                    <button class="btn btn-primary flex-grow-1 ms-1"
                        t-on-click="this.setInformations"
                        t-att-disabled="!this.validSelection || this.state.isSubmitting">
                        <t t-if="this.state.isSubmitting">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true" />
                            Validating...
                        </t>
                        <t t-else="">
                            Continue
                        </t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
