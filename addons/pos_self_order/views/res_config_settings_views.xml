<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_menu" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.pos_self_order</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Self Ordering" name="self_ordering">
                    <div class="row mt16 o_settings_container">
                        <setting id="self_ordering_activation" string="QR menu &amp; Kiosk activation" help="Let your customers order using their mobile or a kiosk.">
                            <div class="content-group row">
                                <label for="self_ordering_mode" class="col-lg-4" string="Self Ordering"/>
                                <field name="self_ordering_mode"/>
                            </div>
                            <div class="d-flex flex-column align-items-start w-50" invisible="self_ordering_mode == 'nothing'">
                                <button class="btn-link p-0" icon="east" name="preview_self_order_app" type="object" string="Preview Web interface"/>
                                <button class="btn-link p-0" icon="east" name="custom_link_action" type="object" string="Home buttons"/>
                                <button class="btn-link p-0" icon="east" name="generate_qr_codes_page" type="object" string="Print QR Codes" invisible="not self_ordering_mode in ['consultation', 'mobile']"/>
                                <button class="btn-link p-0" icon="east" name="generate_qr_codes_zip" type="object" string="Download QR Codes" invisible="not self_ordering_mode in ['consultation', 'mobile']"/>
                                <button class="btn-link p-0" icon="east" name="get_pos_qr_stands" type="object" string="Free Metal / Wood Stands" invisible="not self_ordering_mode in ['consultation', 'mobile']"/>
                                <button groups="base.group_no_one" class="btn-link p-0" icon="east" name="update_access_tokens" type="object" string="Reset QR Codes" invisible="not self_ordering_mode in ['consultation', 'mobile']"/>
                            </div>
                            <div class="content-group row mt-4" invisible="not self_ordering_mode in ['kiosk', 'mobile']">
                                <label for="self_ordering_service_mode" class="col-lg-4" string="Service at" />
                                <field name="self_ordering_service_mode" readonly="not module_pos_restaurant and self_ordering_mode != 'kiosk'" />
                            </div>
                            <div class="content-group row" groups="base.group_no_one" invisible="self_ordering_mode == 'nothing'">
                                <label for="self_ordering_default_user_id" class="col-lg-4" string="Default User"/>
                                <field name="self_ordering_default_user_id" />
                            </div>
                            <div id="self-payment-after" class="content-group row" invisible="not self_ordering_mode in ['kiosk', 'mobile']">
                                <label string="Pay after" for="self_ordering_pay_after" class="col-lg-4"/>
                                <field name="self_ordering_pay_after" readonly="self_ordering_mode == 'kiosk' or (self_ordering_service_mode == 'counter' and self_ordering_mode == 'mobile')" widget="upgrade_selection"/>
                            </div>
                        </setting>
                        <setting string="Splash screens" help="Personalize your splash screen by adding one or multiple media items to create a slideshow" invisible="self_ordering_mode == 'nothing'">
                            <field name="self_ordering_image_home_ids" class="w-100" widget="many2many_binary" />
                        </setting>
                        <setting string="Language" help="Available interface languages" invisible="self_ordering_mode == 'nothing'">
                            <div class="content-group mt-3">
                                <div class="row">
                                    <label for="self_ordering_default_language_id" class="col-lg-3" string="Default"/>
                                    <field name="self_ordering_default_language_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="self_ordering_available_language_ids" class="col-lg-3" string="Available"/>
                                    <field name="self_ordering_available_language_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Background" help="Personalize the Interface" invisible="self_ordering_mode == 'nothing'">
                            <field name="self_ordering_image_background_ids"
                                   class="w-100" widget="many2many_binary"
                                   options="{'accepted_file_extensions': 'image/*', 'number_of_files': 1}" />
                            <div class="py-2 d-flex align-items-center">
                                <label for="self_ordering_primary_color" class="mx-2" string="Color"/>
                                <field name="self_ordering_primary_color" widget="color"/>
                            </div>
                        </setting>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
