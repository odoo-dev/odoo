<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.pos_qlub</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="qlub_pos_name"
                    invisible="use_payment_terminal != 'qlub'"
                    required="use_payment_terminal == 'qlub'"/>
                <field name="qlub_key"
                    invisible="use_payment_terminal != 'qlub'"
                    required="use_payment_terminal == 'qlub'"/>
                <field name="qlub_location"
                    invisible="use_payment_terminal != 'qlub'"
                    required="use_payment_terminal == 'qlub'"/>
                <field name="qlub_terminal"
                    invisible="use_payment_terminal != 'qlub'"
                    required="use_payment_terminal == 'qlub'"/>
                <field name="qlub_test_mode"
                    invisible="use_payment_terminal != 'qlub'"
                    required="use_payment_terminal == 'qlub'"/>
            </xpath>
        </field>
    </record>
</odoo>
