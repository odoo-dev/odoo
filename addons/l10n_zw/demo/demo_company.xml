<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_demo_company_zw" model="res.partner" forcecreate="1">
        <field name="name">ZW Company</field>
        <field name="vat"/>
        <field name="street">5th Floor, Samora Machel Avenue</field>
        <field name="city">Harare</field>
        <field name="country_id" ref="base.zw"/>
        <field name="zip"/>
        <field name="phone">+263 77 123 4567</field>
        <field name="email">info@company.zwexample.com</field>
        <field name="website">www.zwexample.com</field>
    </record>

    <record id="base.demo_company_zw" model="res.company" forcecreate="1">
        <field name="name">ZW Company</field>
        <field name="partner_id" ref="base.partner_demo_company_zw"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('base.demo_company_zw')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('base.demo_company_zw'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>zw</value>
        <value model="res.company" eval="obj().env.ref('base.demo_company_zw')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
