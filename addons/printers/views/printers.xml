<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_printers_tree" model="ir.ui.view">
        <field name="name">printers.list</field>
        <field name="model">printers.printer</field>
        <field name="arch" type="xml">
            <list string="Printers" sample="1">
                <field name="name"/>
                <field name="ip"/>
                <field name="printer_type"/>
                <field name="report_ids"  widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_printers_form" model="ir.ui.view">
        <field name="name">printers.form</field>
        <field name="model">printers.printer</field>
        <field name="arch" type="xml">
            <form string="Printer">
                <sheet>
                    <div class="oe_title mb-2">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Printer 1"/></h1>
                    </div>
                    <group>
                        <field name="printer_type"/>
                    </group>
                    <group>
                        <field name="ip"/>
                    </group>
                    <group>
                        <field name="report_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_printers_view" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">printers.printer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem 
        id="menu_printers"
        name="Printers"
        parent="base.reporting_menuitem"
        sequence="4"
        action="action_printers_view"
    />
</odoo>