<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="hr_work_entry.ResourcePopover" t-inherit="resource.ResourceCalendarAttendancePopover" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_calendar_popover')]" position="attributes">
            <attribute name="class" add="o_calendar_color" separator=" "/>
            <attribute name="t-attf-style">--o-calendar-color: var(--o-colors-#{currentRecord.record.data.color})</attribute>
        </xpath>
    </t>
</templates>
