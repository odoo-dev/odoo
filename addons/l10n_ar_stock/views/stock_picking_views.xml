<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="stock_picking_form_inherit_l10n_ar_stock" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit.l10n_ar_stock</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <field name="origin" position="after">
                    <field name="l10n_ar_delivery_guide_number"
                           string="Delivery Guide Number"
                           invisible="country_code != 'AR'"
                           readonly="state == 'done' or picking_type_code != 'incoming'"/>
                </field>
                <xpath expr="//header//button[@name='action_cancel']" position="after">
                    <button name="l10n_ar_action_create_delivery_guide"
                            type="object"
                            string="Generate Delivery Guide"
                            invisible="country_code != 'AR' or not l10n_ar_allow_generate_delivery_guide"/>
                    <button name="l10n_ar_action_send_delivery_guide"
                            type="object"
                            class="btn-primary"
                            string="Send Delivery Guide"
                            invisible="country_code != 'AR' or not l10n_ar_allow_send_delivery_guide or l10n_ar_cot_number"/>
                    <button name="l10n_ar_action_generate_cot"
                            type="object"
                            string="Generate COT"
                            invisible="country_code != 'AR' or picking_type_code != 'outgoing' or not l10n_ar_delivery_guide_number or l10n_ar_cot_number"/>
                    <button name="l10n_ar_action_send_delivery_guide"
                            type="object"
                            class="btn-primary"
                            string="Send COT and Delivery Guide"
                            invisible="country_code != 'AR' or not l10n_ar_allow_send_delivery_guide or not l10n_ar_cot_number"/>
                </xpath>
                <xpath expr="//header" position="after">
                    <div class="alert alert-warning" role="alert" invisible="not l10n_ar_cot_error">
                        <field name="l10n_ar_cot_error"/>
                        <button name="l10n_ar_action_generate_cot"
                                type="object"
                                class="oe_link"
                                string="Retry"/>
                    </div>
                </xpath>
                <page name="extra" position="after">
                    <page string="COT" name="l10n_ar_cot" invisible="country_code != 'AR' or picking_type_code != 'outgoing'">
                        <group>
                            <group string="COT Information" name="l10n_ar_cot_information">
                                <field name="l10n_ar_cot_departure_date" readonly="l10n_ar_cot_number"/>
                                <field name="l10n_ar_cot_carrier_id" readonly="l10n_ar_cot_number"/>
                                <field name="l10n_ar_cot_license_plate" readonly="l10n_ar_cot_number"/>
                                <field name="l10n_ar_cot_non_finished_product" readonly="l10n_ar_cot_number"/>
                                <field name="l10n_ar_cot_amount" readonly="l10n_ar_cot_number"/>
                            </group>
                            <group string="ARBA" name="l10n_ar_cot_arba">
                                <field name="l10n_ar_cot_number"/>
                            </group>
                        </group>
                    </page>
                </page>
            </field>
        </record>
    </data>
</odoo>
