<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_ar_stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="operations_setting_container" position="after">
                <block title="Argentina Delivery Guide" name="l10n_ar_delivery_guide_setting_container" invisible="country_code != 'AR'">
                    <setting string="ARBA/COT (Electronic Delivery Guide)" company_dependent="1"
                             help="Configure ARBA COT credentials to generate Certificates of Transport. The connection uses the company's CUIT as the username and the CIT as the password.">
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="l10n_ar_arba_cit" class="o_light_label col-lg-4" string="CIT"/>
                                <field name="l10n_ar_arba_cit" password="True" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="l10n_ar_arba_cot_environment" class="o_light_label col-lg-4" string="Environment"/>
                                <field name="l10n_ar_arba_cot_environment" widget="radio" class="col-lg-8"/>
                            </div>
                            <div class="text-muted">
                                The Demo environment does not require credentials, as the COT will not be sent to ARBA. Use it solely for testing workflows.
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
