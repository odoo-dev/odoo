<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.l10n_ar_stock</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="l10n_ar_arba_code" invisible="'AR' not in fiscal_country_codes or type != 'consu'"/>
            </field>
        </field>
    </record>

    <record id="uom_uom_view_form" model="ir.ui.view">
        <field name="name">uom.uom.view.form.inherit.l10n_ar_stock</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_form"/>
        <field name="arch" type="xml">
            <div name="relative_factor" position="after">
                <field name="l10n_ar_arba_unit_code" invisible="'AR' not in fiscal_country_codes"/>
            </div>
        </field>
    </record>
</odoo>
