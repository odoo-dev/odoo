                                            <tns:Naziv t-out="porez['naziv']"/>
                                            <tns:Stopa t-out="porez['stopa']"/>
                                            <tns:Osnovica t-out="porez['osnovica']"/>
                                            <tns:Iznos t-out="porez['iznos']"/>
                                        </tns:Porez>
                                    </t>
                                </tns:OstaliPor>
                            </t>
                            <t t-if="iznos_oslobodjen_pdv">
                                <tns:IznosOslobPdv t-out="iznos_oslobodjen_pdv"/>
                            </t>
                            <t t-if="iznos_marza">
                                <tns:IznosMarza t-out="iznos_marza"/>
                            </t>
                            <t t-if="iznos_ne_podl_opor">
                                <tns:IznosNePodlOpor t-out="iznos_ne_podl_opor"/>
                            </t>
                            <t t-if="naknade_items">
                                <tns:Naknade>
                                    <t t-foreach="naknade_items" t-as="naknada">
                                        <tns:Naknada>
                                            <tns:NazivN t-out="naknada['naziv']"/>
                                            <tns:IznosN t-out="naknada['iznos']"/>
                                        </tns:Naknada>
                                    </t>
                                </tns:Naknade>
                            </t>
                            <tns:IznosUkupno t-out="iznos_ukupno"/>
                            <tns:NacinPlac t-out="nacin_plac"/>
                            <tns:OibOper t-out="oib_oper"/>
                            <tns:ZastKod t-out="zast_kod"/>
                            <tns:NakDost t-out="nak_dost"/>
                            <t t-if="paragon_br_rac">
                                <tns:ParagonBrRac t-out="paragon_br_rac"/>
                            </t>
                            <t t-if="spec_namj">
                                <tns:SpecNamj t-out="spec_namj"/>
                            </t>
                            <t t-if="recipient_oib">
                                <tns:OibPrimatelja t-out="recipient_oib"/>
                            </t>
                            
                            <tns:PromijenjeniNacinPlac t-out="changed_payment_method"/>
                            <t t-if="change_oib">
                                <t t-if="changed_recipient_oib">
                                    <tns:PromijenjeniOibPrimatelja t-out="changed_recipient_oib"/>
                                </t>
                                <t t-else="">
                                    <tns:PromijenjeniOibPrimatelja/>
                                </t>
                            </t>
                        </tns:Racun>
                    </tns:PromijeniNacPlacZahtjev>
                </soapenv:Body>
            </soapenv:Envelope>
        </template>

