        <!-- Rendered alone first, then C14N'd and signed to produce SignatureValue -->
        <template id="template_invoice_fiscalization_signed_info" name="XML-DSig SignedInfo">
            <SignedInfo xmlns="http://www.w3.org/2000/09/xmldsig#">
                <CanonicalizationMethod Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                <SignatureMethod Algorithm="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"/>
                <Reference t-attf-URI="##{element_id}">
                    <Transforms>
                        <Transform Algorithm="http://www.w3.org/2000/09/xmldsig#enveloped-signature"/>
                        <Transform Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                    </Transforms>
                    <DigestMethod Algorithm="http://www.w3.org/2001/04/xmlenc#sha256"/>
                    <DigestValue>
                        <t t-out="digest_value"/>
                    </DigestValue>
                </Reference>
            </SignedInfo>
        </template>

        <template id="template_invoice_fiscalization_digital_signature" name="Digital signature template">
            <Signature xmlns="http://www.w3.org/2000/09/xmldsig#">
                <SignedInfo>
                    <CanonicalizationMethod Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                    <SignatureMethod Algorithm="http://www.w3.org/2001/04/xmldsig-more#rsa-sha256"/>
                    <Reference t-attf-URI="##{element_id}">
                        <Transforms>
                            <Transform Algorithm="http://www.w3.org/2000/09/xmldsig#enveloped-signature"/>
                            <Transform Algorithm="http://www.w3.org/2001/10/xml-exc-c14n#"/>
                        </Transforms>
                        <DigestMethod Algorithm="http://www.w3.org/2001/04/xmlenc#sha256"/>
                        <DigestValue>
                            <t t-out="digest_value"/>
                        </DigestValue>
                    </Reference>
                </SignedInfo>
                <SignatureValue>
                    <t t-out="signature_value"/>
                </SignatureValue>
                <KeyInfo>
                    <X509Data>
                        <X509Certificate>
                            <t t-out="certificate"/>
                        </X509Certificate>
                        <X509IssuerSerial>
                            <X509IssuerName>
                                <t t-out="issuer_name"/>
                            </X509IssuerName>
                            <X509SerialNumber>
                                <t t-out="serial_number"/>
                            </X509SerialNumber>
                        </X509IssuerSerial>
                    </X509Data>
                </KeyInfo>
            </Signature>
        </template>
    </data>
</odoo>
