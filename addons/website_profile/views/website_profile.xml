<?xml version="1.0" encoding="utf-8"?>
<odoo><data>
    <!-- Sub nav -->
    <template id="user_profile_sub_nav" name="User profile subnav">
        <div class="o_wprofile_all_users_nav">
            <div class="container mt-3 mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb flex-nowrap bg-transparent mb-0 ps-0 py-0 overflow-hidden">
                        <li t-if="url_from" class="breadcrumb-item flex-shrink-0">
                            <a t-att-href="url_from" class="text-nowrap">
                                <i class="oi small" data-icon="chevron_backward"/>
                                <t t-out="url_from_label"/>
                            </a>
                        </li>
                        <li t-attf-class="breadcrumb-item text-truncate #{'active' if not view_user else 'flex-shrink-0'}" t-att-aria-current="'page' if not view_user else None">
                            <t t-if="not view_user">
                                <span class="text-truncate d-block">Users</span>
                            </t>
                            <t t-else="">
                                <a href="/profile/users" class="text-truncate d-block">Users</a>
                            </t>
                        </li>
                        <li t-if="view_user" class="breadcrumb-item text-truncate active" aria-current="page">
                            <span class="text-truncate d-block" t-out="view_user" t-att-title="view_user"/>
                        </li>
                    </ol>
                </nav>
            </div>
        </div>
    </template>

    <!--
    Single User Profile Page
    -->

    <!-- Profile Page -->
    <template id="user_profile_main" name="Profile Page">
        <t t-set="body_classname" t-value="'o_wprofile_body'"/>
        <t t-call="website.layout">
            <div id="wrap" class="o_wprofile_wrap mt-0">
                <t t-call="website_profile.user_profile_header"/>
                <t t-call="website_profile.user_profile_content"/>
            </div>
        </t>
    </template>

    <template id="user_profile_header" name="Profile Page Header">
        <div>
            <t t-set="view_user"><t t-out="user.name"/></t>
            <t t-call="website_profile.user_profile_sub_nav" view_user="view_user"/>
        </div>
    </template>

    <template id="user_profile_content" name="Profile Page Content">
        <div class="container">
            <div class="row">
                <!-- ========== PROFILE CONTENT ========== -->
                <div class="col-12 col-md-8 col-lg-9 position-relative">
                    <!-- Profile Header -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-start justify-content-between mb-4">
                        <div class="d-flex gap-3">
                            <div t-field="user.image_1024" t-options="{'widget': 'image', 'preview_image': 'avatar_1024', 'width': '80px', 'height': '80px', 'class': 'rounded'}"/>
                            <div>
                                <h1 class="h3">
                                    <span t-field="user.name"/><small t-if="user.karma == 0"> (not verified)</small>
                                </h1>
                                <div class="d-flex flex-wrap gap-3">
                                    <div t-if="user.partner_id.parent_name">
                                        <i class="oi oi-fw me-1" data-icon="business"/><span t-field="user.partner_id.parent_name"/>
                                    </div>
                                    <div t-if="user.city or user.country_id">
                                        <i class="oi oi-fw me-1" data-icon="location_on"/>
                                        <span t-field="user.city"/><span class="text-nowrap ms-1" t-if="user.country_id">(<span t-field="user.country_id"/>)</span>
                                    </div>
                                    <div t-if="user.website">
                                        <i class="oi oi-fw me-1" data-icon="public"/><a t-att-href="user.website" target="_blank"><span t-field="user.website"/></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <a class="btn o_wprofile_editor btn-primary mt-3 mt-lg-0" t-if="(env.user == user and user.karma != 0) or env.user._is_admin()"
                            t-att-data-user-id="user.id" t-att-data-can-edit-country="'true' if user.partner_id._can_edit_country() else None"><i class="oi oi-filled me-1" data-icon="edit"/> Edit profile</a>
                    </div>

                    <!-- Profile Tabs -->
                    <ul class="nav nav-underline o_wprofile_nav_tabs border-bottom" role="tablist" id="profile_extra_info_tablist">
                        <li class="nav-item">
                            <a role="tab" aria-controls="about" href="#profile_tab_content_about" t-attf-class="nav-link #{'active' if not active_tab or active_tab == 'about' else ''}" data-bs-toggle="tab">About</a>
                        </li>
                    </ul>

                    <!-- Profile Content -->
                    <div class="tab-content py-4 o_wprofile_tabs_content mb-4" id="profile_extra_info_tabcontent">
                        <div role="tabpanel" t-attf-class="tab-pane #{ 'show active' if not active_tab or active_tab == 'about' else '' }" id="profile_tab_content_about">
                            <div class="o_wprofile_email_validation_container">
                                <t t-call="website_profile.email_validation_banner"
                                    redirect_url="'/profile/user/%s' % user.id"
                                    additional_validation_email_message.translate=""/>
                            </div>
                            <!-- Biography -->
                            <div t-if="user.partner_id.website_description" class="mb32">
                                <h5>Biography</h5>
                                <div class="text-muted" t-field="user.partner_id.website_description"/>
                            </div>
                            <!-- Badges -->
                            <div id="profile_about_badge" class="mb32">
                                <h5>Badges</h5>
                                <t t-call="website_profile.user_badges"/>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- ========== SIDEBAR ========== -->
                <div class="col-12 col-md-4 col-lg-3 mt-3 mt-md-0">
                    <div class="o_wprofile_sidebar border rounded p-3">
                        <div class="o_wprofile_sidebar_top d-flex justify-content-end">
                            <button class="btn btn-sm d-md-none bg-white border" type="button" data-bs-toggle="collapse" data-bs-target="#o_wprofile_sidebar_collapse" aria-expanded="false" aria-controls="o_wprofile_sidebar_collapse">More info</button>
                        </div>
                        <div class="collapse d-md-block" id="o_wprofile_sidebar_collapse">
                            <t t-set="next_rank_id" t-value="user._get_next_rank()"/>
                            <t t-if="next_rank_id or user.rank_id" t-call="website_profile.profile_next_rank_card"/>
                            <hr t-if="next_rank_id or user.rank_id"/>
                            <div class="row row-cols-2 gy-3" name="user_profile_sidebar_info">
                                <small class="text-muted">Joined</small>
                                <small class="fw-medium text-end" t-field="user.create_date" t-options='{"format": "d MMM Y"}'/>
                                <t t-if="user.badge_ids">
                                    <small class="text-muted">Badges</small>
                                    <small class="fw-medium text-end" t-out="len(user.badge_ids.filtered(lambda b: b.badge_id.website_published))"/>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="profile_next_rank_card" name="Profile Next Rank Card">
        <t t-set="next_rank_id" t-value="next_rank_id or user._get_next_rank()"/>
        <t t-if="next_rank_id and user.rank_id">
            <t t-if="(next_rank_id.karma_min - user.rank_id.karma_min) > 0">
                <t t-set="user_points" t-value="int(100*(user.karma - user.rank_id.karma_min)/(next_rank_id.karma_min - user.rank_id.karma_min))"/>
            </t>
            <t t-else="">
                <t t-set="user_points" t-value="0"/>
            </t>
        </t>
        <t t-elif="user.rank_id">
            <t t-set="user_points" t-value="100"/>
        </t>
        <t t-else="">
            <t t-set="user_points" t-value="0"/>
        </t>
        <t t-set="karma_value" t-value="next_rank_id.karma_min - user.karma if next_rank_id else user.karma"/>
        <div class="o_wprofile_rank_progress">
            <t t-if="user.rank_id">
                <small class="text-muted">Current rank</small>
                <div class="d-flex align-items-center gap-2 mt-1 mb-3">
                    <div class="rounded-circle overflow-hidden flex-shrink-0">
                        <div t-field="user.rank_id.image_1920"
                            t-options="{'widget': 'image', 'preview_image': 'image_128', 'width': '24px', 'height': '24px', 'class': 'object-fit-cover'}"/>
                    </div>
                    <a class="text-decoration-none" t-attf-href="/profile/ranks_badges" t-field="user.rank_id.name"/>
                </div>
            </t>
            <t t-if="next_rank_id and user.rank_id">
                <small class="text-muted">Next rank</small>
                <div class="d-flex gap-2 mt-1 mb-3">
                    <div class="rounded-circle overflow-hidden flex-shrink-0">
                        <div t-field="next_rank_id.image_1920"
                            t-options="{'widget': 'image', 'preview_image': 'image_128', 'width': '40px', 'height': '40px', 'class': 'object-fit-cover'}"/>
                    </div>
                    <div class="lh-sm small">
                        <b t-field="next_rank_id.name"/>
                        <div>
                            <span class="text-muted">
                                <span class="fw-bold text-primary" t-out="karma_value" t-options="{'widget': 'integer', 'format_decimalized_number': True, 'precision_digits': 2}"/> xp
                                to level up
                            </span>
                        </div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <div class="progress flex-grow-1"
                        style="height: .5rem;"
                        role="progressbar"
                        t-att-aria-valuenow="user_points"
                        aria-valuemin="0"
                        aria-valuemax="100"
                        data-bs-toggle="tooltip"
                        data-bs-delay="0"
                        t-attf-title="{{ '%s/%s xp' % (user.karma, next_rank_id.karma_min)}}">
                        <div class="progress-bar rounded-pill bg-primary" t-attf-style="width: #{user_points}%;"/>
                    </div>
                    <small><t t-out="user_points"/>%</small>
                </div>
            </t>
            <t t-elif="user.rank_id">
                <p class="small text-muted mb-0">Maximum rank reached.</p>
            </t>
        </div>
    </template>

    <template id="user_badges" name="User Bagdes">
        <div t-if="user.badge_ids" class="row mx-n1">
            <t t-foreach="user.badge_ids" t-as="badge">
                <t t-if="badge.badge_id.website_published">
                    <div class="col px-1 mb-2 col-xl-4">
                        <div class="card">
                            <div class="card-body p-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="flex-shrink-0">
                                        <div t-if="badge.badge_id.image_1920 and badge.badge_id.level" t-field="badge.badge_id.image_1920"
                                            t-options="{'widget': 'image', 'preview_image': 'image_128', 'class': 'rounded-circle object-fit-cover', 'style': 'height: 38px; width: 38px'}"/>
                                        <img t-else=""
                                            width="38" height="38"
                                            t-attf-src="/website_profile/static/src/img/badge_#{badge.badge_id.level}.svg"
                                            class="object-fit-cover"
                                            t-att-alt="badge.badge_id.name"/>
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <h6 class="mb-0 text-truncate" t-field="badge.badge_id.name"/>
                                        <small class="text-muted text-truncate d-block">
                                            Earned <span t-field="badge.create_date" t-options="{'widget': 'date'}"/>
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </div>
         <div class="mb-3" t-elif="env.user == user">
            <p class="text-muted mb-2">Badges are your collection of achievements. Wear them proudly!</p>
            <a t-if="not user.badge_ids and badge_category" t-attf-href="/profile/ranks_badges?badge_category=#{badge_category}"
                class="btn btn-link px-0"><i class="oi me-1" data-icon="east"/>Get Badges</a>
            <a t-else="" t-attf-href="/profile/ranks_badges"
                class="btn btn-link px-0"><i class="oi me-1" data-icon="east"/>Get Badges</a>
        </div>
        <div t-else="" class="mb-3">
            <p class="text-muted mb-0">No badges yet!</p>
        </div>
        <div t-if="env.user.id != user.id" class="text-end">
            <a t-if="not user.badge_ids and badge_category" t-attf-href="/profile/ranks_badges?badge_category=#{badge_category}"
                class="btn btn-link btn-sm px-0"><i class="oi me-1" data-icon="east"/>All Badges</a>
            <a t-else="" t-attf-href="/profile/ranks_badges"
                class="btn btn-link btn-sm px-0"><i class="oi me-1" data-icon="east"/>All Badges</a>
        </div>
    </template>

    <!-- About Ranks and badges Page -->
    <template id="rank_badge_main" name="Ranks Page">
        <t t-call="website.layout">
            <div class="container mb32 mt48">
                <nav t-if="url_from" aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb flex-nowrap bg-transparent mb-0 ps-0 py-0 overflow-hidden">
                        <li class="breadcrumb-item flex-shrink-0">
                            <a t-att-href="url_from" class="text-nowrap" t-out="url_from_label"/>
                        </li>
                        <li class="breadcrumb-item text-truncate active" aria-current="page">
                            <span class="text-truncate d-block">Badges</span>
                        </li>
                    </ol>
                </nav>
                <h1 class="h4">Ranks and Badges</h1>
                <div t-if="ranks" class="row justify-content-between mt-5">
                    <div class="col-12 col-md-6">
                        <h2 class="h5-fs">Ranks</h2>
                        <p>Keep learning with <t t-out="website.company_id.name"/>. Collect points on the forum or on the eLearning platform. Those points will make you reach new ranks.</p>
                        <h3 class="h6-fs">How do I earn badges?</h3>
                        <p>When you finish a course or reach milestones, you're awarded badges.</p>
                        <h3 class="h6-fs">How do I score more points?</h3>
                        <p>You can score more points by answering quizzes at the end of each course content. Points can also be earned on the forum.</p>
                    </div>
                    <div class="col-12 col-md-5 col-lg-4">
                        <div class="card">
                            <div class="card-header">Ranks</div>
                            <ul class="list-group list-group-flush">
                                <t t-foreach="ranks" t-as="rank">
                                    <li t-attf-class="list-group-item">
                                        <div class="d-flex align-items-center">
                                            <div t-field="rank.image_1920"
                                                t-options="{'widget': 'image', 'preview_image': 'image_128', 'class': 'me-2 o_image_40_cover'}"/>
                                            <div class="flex-grow-1">
                                                <h3 class="h6-fs mb-0" t-field="rank.name"/>
                                                <small class="text-muted"><span t-field="rank.karma_min"/> point<span t-if="rank.karma_min">s</span></small>
                                            </div>
                                        </div>
                                    </li>
                                </t>
                            </ul>
                        </div>
                    </div>
                </div>
                <t t-call="website_profile.badge_content"/>
            </div>
        </t>
    </template>

    <template id="badge_content" name="Badges Page content">
        <div id="website_profile_badges">
            <div class="row">
                <div class="col-12 col-lg-6">
                    <h2 class="h5-fs">Badges</h2>
                    <p>Besides gaining reputation with your questions and answers, you receive badges for being especially helpful. Badges appear on your profile page, and your posts.</p>
                </div>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-3">
                <div t-foreach="badges" t-as="badge">
                    <t t-set="badge_unlocked" t-value="bool(badge.stat_my)"/>
                    <div t-attf-class="card h-100 #{'' if badge_unlocked or request.env.user._is_public() else ' opacity-50'}">
                        <div class="card-body d-flex gap-3 p-3">
                            <div class="flex-shrink-0">
                                <img t-if="not badge.image_1920 and badge.level"
                                    t-attf-src="/website_profile/static/src/img/badge_#{badge.level}.svg"
                                    class="rounded-circle o_image_40_cover"
                                    t-att-alt="badge.name"/>
                                <div t-else="" t-field="badge.image_1920"
                                    t-options="{'widget': 'image', 'preview_image': 'image_128', 'class': 'rounded-circle o_image_40_cover'}"/>
                            </div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-1">
                                    <a t-if="badge_url" t-att-href="badge_url" class="text-decoration-none text-reset">
                                        <h6 t-field="badge.name" class="mb-0"/>
                                    </a>
                                    <h6 t-else="" t-field="badge.name" class="mb-0"/>
                                </div>
                                <div class="text-muted small" t-field="badge.description"/>
                                <div class="small">
                                    <t t-out="badge.granted_users_count"/> <span class="text-muted">awarded users</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!--Access Denied - Profile Page-->
    <template id="profile_access_denied" name="Access Denied - Profile Page">
        <t t-call="website.layout">
            <div class="container mb32 mt48">
                <h1 class="mt32" t-out="denial_reason"/>
                <div id="profile_access_denied_return_link_container">
                    <p><a class="o_translate_inline" t-attf-href="/">Return to the website.</a></p>
                </div>
            </div>
        </t>
    </template>

    <!--
    All Users Page
    -->
    <template id="users_page_main" name="Users Page">
        <t t-set="body_classname" t-value="'o_wprofile_body'"/>
        <t t-call="website.layout">
            <div class="h-100 d-flex flex-column">
                <div id="wrap" class="o_wprofile_wrap mt-0 pb-5 ">
                    <t t-call="website_profile.users_page_header"/>
                    <t t-if="users or search">
                        <t t-call="website_profile.users_page_content"/>
                    </t>
                </div>
                <t t-if="not users and not search">
                    <h2 class="text-black m-auto">No Leaderboard Yet :(</h2>
                </t>
            </div>
        </t>
    </template>

    <template id="users_page_header" name="Users Page Header">
        <div class="o_wprofile_all_users_header">
            <t t-call="website_profile.user_profile_sub_nav"/>
            <div class="container">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
                    <h1 class="h4">Leaderboard</h1>
                    <div class="d-flex gap-3 align-items-center justify-content-between">
                        <div class="d-flex flex-row align-items-center justify-content-end">
                            <t t-call="website.website_search_box_input"
                                action.f="/profile/users"
                                placeholder.translate="Search users"
                                search="search"
                                _form_classes.f="d-none d-lg-flex">
                                <input t-if="group_by" type="hidden" name="group_by" t-att-value="group_by"/>
                            </t>
                            <!-- Mobile Search button -->
                            <t t-call="website.website_search_box_input"
                                action.f="/profile/users"
                                placeholder.translate="Search users"
                                search="search"
                                _simple_button_layout="True"
                                _simple_button_classes.f="btn-light"
                                _form_classes.f="d-lg-none">
                                <input t-if="group_by" type="hidden" name="group_by" t-att-value="group_by"/>
                            </t>
                        </div>
                        <div class="btn-group">
                            <a t-attf-class="btn btn-light #{ 'active' if group_by == 'week' else ''}"
                                t-att-href="'/profile/users?' + keep_query('search', group_by='week')">Week</a>
                            <a t-attf-class="btn btn-light #{ 'active' if group_by == 'month' else ''}"
                                t-att-href="'/profile/users?' + keep_query('search', group_by='month')">Month</a>
                            <a t-attf-class="btn btn-light #{ 'active' if group_by == 'all' else ''}"
                                t-att-href="'/profile/users?' + keep_query('search')">All time</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template id="users_page_content">
        <div class="container mb32">
            <div class="row">
                <div class="col-12 col-xl-9">
                    <div class="d-none d-lg-flex row mb-4">
                        <a class="col-md-4 d-flex flex-grow-1 text-decoration-none text-reset"
                            t-foreach="top3_users" t-as="user"
                            t-attf-href="/profile/user/#{user['id']}">
                            <t t-call="website_profile.top3_user_card"/>
                        </a>
                    </div>
                    <div class="list-group" t-if="users">
                        <a t-foreach="users" t-as="user"
                            t-attf-href="/profile/user/#{user['id']}"
                            t-attf-class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 #{user['id'] == user_id.id and 'bg-primary-light' or ''}">
                            <t t-call="website_profile.all_user_card"/>
                        </a>
                        <t t-if="my_user">
                            <t t-set="user" t-value="my_user"/>
                            <a t-attf-href="/profile/user/#{user['id']}"
                                class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3 border-top bg-primary-light">
                                <t t-call="website_profile.all_user_card"/>
                            </a>
                        </t>
                    </div>
                    <t t-if='search and not users'>
                        <div class='alert alert-warning'>No user found for <strong><t t-out="search"/></strong>. Try another search.</div>
                    </t>
                    <div class="d-flex justify-content-center">
                        <t t-call="website.pager"/>
                    </div>
                </div>
                <div class="col-12 col-xl-3 mt-4 mt-xl-0" t-if="challenges or achievements">
                    <t t-if="challenges" t-call="website_profile.leaderboard_badges_card"/>
                    <t t-if="achievements" t-call="website_profile.leaderboard_achievements_card"/>
                </div>
            </div>
        </div>
    </template>

    <template id="leaderboard_badges_card" name="Leaderboard Badges Card">
        <div class="border rounded p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 mb-0">Badges</h2>
                <a href="/profile/ranks_badges" class="small">View all</a>
            </div>
            <t t-foreach="challenges" t-as="challenge">
                <t t-set="challenge_done" t-value="challenge in challenges_done if challenges_done else False"/>
                <div t-attf-class="d-flex align-items-center gap-2 #{'opacity-50' if challenge_done else ''}">
                    <div t-if="challenge.reward_id.image_1920" class="flex-shrink-0 align-self-baseline" t-field="challenge.reward_id.image_1920"
                        t-options="{'widget': 'image', 'preview_image': 'image_128', 'style': 'height: 32px; width: 32px', 'class': 'object-fit-cover'}"/>
                    <img t-else="" t-attf-src="/website_profile/static/src/img/badge_#{challenge.reward_id.level}.svg" t-att-alt="challenge.reward_id.name" style="height: 32px; width: 32px" class="flex-shrink-0"/>
                    <div class="flex-grow-1 lh-sm">
                        <div t-out="challenge.reward_id.name"/>
                        <small class="text-muted" t-out="challenge.reward_id.description"/>
                    </div>
                    <i t-if="challenge_done" class="fa fa-check text-success" aria-label="Done" title="Done" role="img"/>
                </div>
            </t>
        </div>
    </template>

    <template id="leaderboard_achievements_card" name="Leaderboard Latest Achievements Card">
        <div class="border rounded p-3 mb-3">
            <h2 class="h6 mb-3">Latest achievements</h2>
            <t t-foreach="achievements" t-as="achievement">
                <div t-attf-class="d-flex align-items-center gap-2 #{'' if achievement_last else 'mb-3'}">
                    <img class="o_avatar rounded-circle flex-shrink-0" style="--Avatar-size: 2rem;"
                        t-att-src="'/profile/avatar/%s?field=avatar_128' % achievement.user_id.id"
                        t-att-alt="achievement.user_id.name"/>
                    <div class="small lh-sm">
                        <div t-out="achievement.user_id.name"/>
                        <span class="text-muted" t-out="achievement.badge_id.name"/>
                    </div>
                </div>
            </t>
        </div>
    </template>

    <template id="top3_user_card" name="Top 3 User Card">
        <div class="card flex-grow-1 text-center">
            <div class="card-body">
                <div class="d-inline-block position-relative mb-3">
                    <img class="rounded-circle img-fluid"
                        style="width: 80px; height: 80px; object-fit: cover;"
                         t-att-src="'/profile/avatar/%s?field=avatar_256%s' % (user['id'], '&amp;res_model=%s&amp;res_id=%s' % (record._name, record.id) if record else '')"/>
                    <div class="position-absolute rounded-pill bottom-0 end-0 me-n3" style="width: 2rem; height: 2rem;">
                        <img t-attf-src="/website_profile/static/src/img/rank_#{user_index + 1}.svg" alt="User rank"/>
                    </div>
                </div>
                <h2 class="mb-0 h6" t-out="user['name']"></h2>
                <small class="text-muted" t-out="user['rank']"/>
            </div>
            <div class="o_wprofile_top3_card_footer card-footer d-flex gap-2 p-3">
                <div class="flex-grow-1">
                    <b t-out="user['karma']"/> <small class="d-block text-muted">XP</small>
                    <t t-if="group_by and user.get('karma_gain')">
                        <span t-attf-class="badge mt-1 #{'text-bg-success' if user['karma_gain'] > 0 else 'text-bg-warning'}">
                            <t t-if="user['karma_gain'] > 0">+ </t><t t-out="user['karma_gain']"/> XP
                            <t t-if="group_by == 'week'">this week</t>
                            <t t-elif="group_by == 'month'">this month</t>
                        </span>
                    </t>
                </div>
                <div class="flex-grow-1"><b t-out="user['badge_count']"/> <small class="d-block text-muted">Badges</small></div>
            </div>
        </div>
    </template>

    <template id="all_user_card" name="All User Card">
        <span class="text-muted text-center flex-shrink-0" style="min-width: 4ch;">
            <span t-out="user['position']"/>
        </span>
        <img class="object-fit-cover rounded-circle o_wprofile_img_small flex-shrink-0 d-none d-sm-block"
            width="32" height="32"
            t-att-src="'/profile/avatar/%s?field=avatar_128%s' % (user['id'], '&amp;res_model=%s&amp;res_id=%s' % (record._name, record.id) if record else '')"/>
        <div class="flex-grow-1 lh-1">
            <h6 class="mb-0 small" t-out="user['name']"/>
            <small class="text-muted" t-out="user['rank']"/>
        </div>
        <div class="d-flex align-items-center gap-3 ms-auto flex-shrink-0 small text-nowrap">
            <div class="text-end">
                <b t-out="user['karma']"/> <span class="text-muted">XP</span>
                <div t-if="group_by and user.get('karma_gain')" class="mt-1">
                    <span t-attf-class="badge #{'text-bg-success' if user['karma_gain'] > 0 else 'text-bg-warning'}">
                        <t t-if="user['karma_gain'] > 0">+ </t><t t-out="user['karma_gain']"/> XP
                    </span>
                    <span class="text-muted ps-1">
                        <t t-if="group_by == 'week'">this week</t>
                        <t t-elif="group_by == 'month'">this month</t>
                    </span>
                </div>
            </div>
            <div class="all_user_badge_count text-end">
                <b t-out="user['badge_count']"/> <span class="text-muted">Badges</span>
            </div>
        </div>
    </template>

    <!-- Custom Pager: lighter than existing one, no box around number, first / end displayed -->
    <template id="pager_nobox" name="Pager (not box display)">
        <ul t-if="pager['page_count'] > 1" t-attf-class="o_wprofile_pager fw-bold pagination m-0">
            <li t-attf-class="page-item o_wprofile_pager_arrow #{'disabled' if pager['page']['num'] == 1 else ''}">
                <a t-att-href=" pager['page_first']['url'] if pager['page']['num'] != 1 else None" class="page-link"><i class="oi" data-icon="skip_previous"/></a>
            </li>
            <li t-attf-class="page-item o_wprofile_pager_arrow #{'disabled' if pager['page']['num'] == 1 else ''}">
                <a t-att-href=" pager['page_previous']['url'] if pager['page']['num'] != 1 else None" class="page-link"><i class="oi" data-icon="arrow_left"/></a>
            </li>
            <t t-foreach="pager['pages']" t-as="page">
                <li t-attf-class="page-item #{'active disabled bg-primary rounded-circle' if page['num'] == pager['page']['num'] else ''}"> <a t-att-href="page['url']" class="page-link" t-out="page['num']"/></li>
            </t>
            <li t-attf-class="page-item o_wprofile_pager_arrow #{'disabled' if pager['page']['num'] == pager['page_count'] else ''}">
                <a t-att-href="pager['page_next']['url'] if pager['page']['num'] != pager['page_count'] else None" class="page-link"><i class="oi" data-icon="arrow_right"/></a>
            </li>
            <li t-attf-class="page-item o_wprofile_pager_arrow #{'disabled' if pager['page']['num'] == pager['page_count'] else ''}">
                <a t-att-href=" pager['page_last']['url'] if pager['page']['num'] != pager['page_count'] else None" class="page-link"><i class="oi" data-icon="skip_next"/></a>
            </li>
        </ul>
    </template>

    <template id="email_validation_banner">
        <t t-set="send_alert_classes" t-value="send_alert_classes if send_alert_classes else 'alert alert-danger alert-dismissable'"/>
        <t t-set="done_alert_classes" t-value="done_alert_classes if done_alert_classes else 'alert alert-success alert-dismissable'"/>
        <t t-set="my_account_redirect" t-value="'/my/account?redirect='+redirect_url"/>
        <t t-set="user" t-value="env.user"/>

        <div t-if="not is_public_user and not user.email" t-att-class="send_alert_classes" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            Your account does not have an email set up. Please set it up on <a class="alert-link" t-att-href="my_account_redirect">your account settings</a>.
        </div>
        <div t-elif="not validation_email_sent and not is_public_user and user.karma == 0" t-att-class="send_alert_classes" role="alert">
            <button type="button" class="btn-close validation_email_close" data-bs-dismiss="alert" aria-label="Close"/>
            Your Account has not yet been verified.<br/>
            Click <a class="send_validation_email alert-link" href="#" t-att-data-redirect_url="redirect_url"><u>here</u></a> to receive a verification email<t t-out="additional_validation_email_message"/>!
        </div>
        <div t-elif="validation_email_sent and not validation_email_done" t-att-class="done_alert_classes">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            Verification Email sent to <t t-out="user.email"/>!<br/>
            Did not receive it? <a class="alert-link" t-att-href="my_account_redirect"><u>Correct your email address</u></a> 
            or <a class="send_validation_email alert-link" href="#" t-att-data-redirect_url="redirect_url"><u>Send Again</u></a>.
        </div>
        <div t-if="validation_email_done" t-att-class="done_alert_classes" role="status">
            <button type="button" class="btn-close validated_email_close" data-bs-dismiss="alert" aria-label="Close"/>
            <span id="email_validated_message">Congratulations! Your email has just been validated.</span>
            <span t-out="additional_validated_email_message"/>
        </div>
    </template>

</data></odoo>
