<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="spreadsheet_date_filter_month" model="spreadsheet.date.filter">
            <field name="name">Month</field>
            <field name="category">month</field>
            <field name="sequence">90</field>
            <field name="from_pattern">now =1d =0H =0M =0S</field>
            <field name="to_pattern">now +1m =1d =0H =0M =0S -1S </field>
            <field name="offset_next">+1m</field>
            <field name="offset_previous">-1m</field>
        </record>

        <record id="spreadsheet_date_filter_quarter" model="spreadsheet.date.filter">
            <field name="name">Quarter</field>
            <field name="category">month</field>
            <field name="sequence">110</field>
            <field name="from_pattern">now =1d =0H =0M =0S</field>
            <field name="to_pattern">now +1m =1d =0H =0M =0S -1S </field>
            <field name="offset_next">+1m</field>
            <field name="offset_previous">-1m</field>
        </record>

        <record id="spreadsheet_date_filter_year" model="spreadsheet.date.filter">
            <field name="name">Year</field>
            <field name="category">year</field>
            <field name="sequence">150</field>
            <field name="from_pattern">now =1d =0H =0M =0S</field>
            <field name="to_pattern">now +1m =1d =0H =0M =0S -1S </field>
            <field name="offset_next">+1m</field>
            <field name="offset_previous">-1m</field>
        </record>

        <record id="spreadsheet_date_filter_today" model="spreadsheet.date.filter">
            <field name="name">Today</field>
            <field name="category">day</field>
            <field name="sequence">10</field>
            <field name="from_pattern">now =0H =0M =0S</field>
            <field name="to_pattern">now =23H =59M =59S</field>
            <field name="offset_next">+1d</field>
            <field name="offset_previous">-1d</field>
        </record>

        <record id="spreadsheet_date_filter_yesterday" model="spreadsheet.date.filter">
            <field name="name">Yesterday</field>
            <field name="category">day</field>
            <field name="sequence">20</field>
            <field name="from_pattern">now -1d =0H =0M =0S</field>
            <field name="to_pattern">now -1d =23H =59M =59S</field>
            <field name="offset_next">+1d</field>
            <field name="offset_previous">-1d</field>
        </record>

        <record id="spreadsheet_date_filter_last_7_days" model="spreadsheet.date.filter">
            <field name="name">Last 7 Days</field>
            <field name="category">custom</field>
            <field name="sequence">30</field>
            <field name="from_pattern">now -7d =0H =0M =0S</field>
            <field name="to_pattern">now -1d =23H =59M =59S</field>
            <field name="offset_next">+7d</field>
            <field name="offset_previous">-7d</field>
        </record>

        <record id="spreadsheet_date_filter_last_30_days" model="spreadsheet.date.filter">
            <field name="name">Last 30 Days</field>
            <field name="category">custom</field>
            <field name="sequence">40</field>
            <field name="from_pattern">now -29d =0H =0M =0S</field>
            <field name="to_pattern">now =23H =59M =59S</field>
            <field name="offset_next">+30d</field>
            <field name="offset_previous">-30d</field>
        </record>

        <record id="spreadsheet_date_filter_last_90_days" model="spreadsheet.date.filter">
            <field name="name">Last 90 Days</field>
            <field name="category">custom</field>
            <field name="sequence">50</field>
            <field name="from_pattern">now -89d =0H =0M =0S</field>
            <field name="to_pattern">now =23H =59M =59S</field>
            <field name="offset_next">+90d</field>
            <field name="offset_previous">-90d</field>
        </record>

        <record id="spreadsheet_date_filter_month_to_date" model="spreadsheet.date.filter">
            <field name="name">Month to Date</field>
            <field name="category">month</field>
            <field name="sequence">60</field>
            <field name="from_pattern">now =1d =0H =0M =0S</field>
            <field name="to_pattern">now =23H =59M =59S</field>
            <field name="navigation_mode">month</field>
            <field name="offset_next">+1m</field>
            <field name="offset_previous">-1m</field>
        </record>

        <record id="spreadsheet_date_filter_last_month" model="spreadsheet.date.filter">
            <field name="name">Last Month</field>
            <field name="category">month</field>
            <field name="sequence">70</field>
            <field name="from_pattern">now -1m =1d =0H =0M =0S</field>
            <field name="to_pattern">now =1d =0H =0M =0S -1S</field>
            <field name="offset_next">+1m</field>
            <field name="offset_previous">-1m</field>
        </record>

