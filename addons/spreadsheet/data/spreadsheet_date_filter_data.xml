            <field name="category">year</field>
            <field name="sequence">120</field>
            <field name="from_pattern">now =1m =1d =0H =0M =0S</field>
            <field name="to_pattern">now =23H =59M =59S</field>
            <field name="navigation_mode">year</field>
            <field name="offset_next">+1y</field>
            <field name="offset_previous">-1y</field>
        </record>

        <record id="spreadsheet_date_filter_last_12_months" model="spreadsheet.date.filter">
            <field name="name">Last 12 Months</field>
            <field name="category">year</field>
            <field name="sequence">130</field>
            <field name="from_pattern">now -12m =1d =0H =0M =0S</field>
            <field name="to_pattern">now =1d =0H =0M =0S -1S</field>
            <field name="offset_next">+12m</field>
            <field name="offset_previous">-12m</field>
        </record>
    </data>
</odoo>
