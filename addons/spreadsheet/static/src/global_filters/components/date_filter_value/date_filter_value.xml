<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="spreadsheet.DateFilterValue">
        <Dropdown navigationOptions="{ 'shouldFocusChildInput': false }">
            <t t-if="props.displayAsButton">
                <button class="btn btn-secondary">
                    <i class="fa fa-calendar me-2"/>
                    <span class="o-date-filter-value" t-esc="inputValue"/>
                </button>
            </t>
            <t t-else="">
                <input class="o_input w-100 o-date-filter-input" readonly="true" t-att-value="inputValue"/>
            </t>
            <t t-set-slot="content">
                <t t-foreach="dateOptions" t-as="option" t-key="option.id">
                    <DropdownItem tag="'div'"
                                  class="{ 'selected': isSelected(option), 'd-flex justify-content-between o-date-filter-value': true }"
                                  closingMode="'none'"
                                  attrs="{ 'data-id': option.id }"
                                  onSelected="() => this.update(option)">

                        <div class="o-date-option-label" t-esc="option.label"/>
                        <t t-if="option.type === 'range'">
                            <div class="d-flex flex-row">
                                <DateTimeInput type="'date'" value="dateFrom()" onChange="(dateFrom) => this.setDateFrom(dateFrom)" />
                                <span class="d-flex align-items-center">to</span>
                                <DateTimeInput type="'date'" value="dateTo()" onChange="(dateTo) => this.setDateTo(dateTo)" />
                            </div>
                        </t>
                        <t t-elif="isMonthQuarterYear(option)">
                            <div class="d-flex justify-content-between">
                                <button class="btn-previous fa fa-caret-left" t-on-click="() => this.selectPreviousFromDropdown(option.type)" />
                                <input class="o_input" type="text" t-att-value="getDescription(option.type)" readonly="true"/>
                                <button class="btn-next fa fa-caret-right" t-on-click="() => this.selectNextFromDropdown(option.type)" />
                            </div>
                        </t>
                    </DropdownItem>
                    <div class="dropdown-divider" t-if="option.separator"/>
                </t>
            </t>
        </Dropdown>
        <t t-if="props.displayAsButton">
            <button class="btn btn-secondary ms-1 btn-previous-date" t-on-click="this.selectPreviousFromButton" t-att-disabled="this.props.value === undefined">
                <i class="fa fa-caret-left"/>
            </button>
            <button class="btn btn-secondary ms-1 btn-next-date" t-on-click="this.selectNextFromButton" t-att-disabled="this.props.value === undefined">
                <i class="fa fa-caret-right"/>
            </button>
        </t>
    </t>
</templates>
