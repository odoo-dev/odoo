<?xml version="1.0" encoding="utf-8"?>
<templates>

  <t t-name="spreadsheet.ShareButton">
    <Dropdown
      menuClass="'spreadsheet_share_dropdown d-flex flex-column h-auto'"
      position="'bottom-end'"
      onOpened.bind="this.onOpened"
      disabled="!this.props.model"
    >
      <button t-att-class="this.togglerClass">
        <i class="oi" data-icon="share"/>
        Share
      </button>
      <t t-set-slot="content">
        <t>
          <div class="d-flex px-3">
            <div class="align-self-center d-flex justify-content-center align-items-center flex-shrink-0">
              <i class="oi oi-2x" data-icon="public" title="Share to web"></i>
            </div>
            <div class="flex-grow-1 px-3">
              <div class="lead">Spreadsheet published</div>
              <div>Frozen version - Anyone can view</div>
            </div>
          </div>
          <div class=" px-3 o_field_widget o_readonly_modifier o_field_CopyClipboardChar">
            <div t-if="this.state.url" class="d-grid rounded-2 overflow-hidden">
              <span t-out="this.state.url"/>
              <CopyButton className="'o_btn_char_copy btn-sm'" content="this.state.url" successText="this.copiedText" icon="'assignment'"/>
            </div>
            <div t-else="" class="o_loading_state d-flex align-items-center justify-content-center">
              <i class="oi oi-spin px-2" data-icon="autorenew"/><span>Generating sharing link</span>
            </div>
          </div>
        </t>
      </t>
    </Dropdown>
  </t>
</templates>
