<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_date_filter_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.date.filter.view.form</field>
        <field name="model">spreadsheet.date.filter</field>
        <field name="arch" type="xml">
            <form string="Date Filter">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="navigation_mode" />
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Main period">
                            <label for="from_pattern" string="Patterns"/>
                            <div class="o_row">
                                <field name="from_pattern" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="to_pattern" nolabel="1"/>
                            </div>
                            <label for="from_preview" string="Preview"/>
                            <div class="o_row">
                                <field name="from_preview" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="to_preview" nolabel="1"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <group string="Previous comparison period">
                            <field name="offset_previous" />
                            <label for="offset_previous_from_preview" string="Preview"/>
                            <div class="o_row">
                                <field name="offset_previous_from_preview" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="offset_previous_to_preview" nolabel="1"/>
                            </div>
                        </group>
                        <group string="Next comparison period">
                            <field name="offset_next" />
                            <label for="offset_next_from_preview" string="Preview"/>
                            <div class="o_row">
                                <field name="offset_next_from_preview" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="offset_next_to_preview" nolabel="1"/>
                            </div>
                        </group>
                    </group>
                    <!-- <group>
                        <group string="Previous period">
                            <label for="previous_from_pattern" string="Patterns"/>
                            <div class="o_row">
                                <field name="previous_from_pattern" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="previous_to_pattern" nolabel="1"/>
                            </div>
                            <label for="previous_from_preview" string="Preview"/>
                            <div class="o_row">
                                <field name="previous_from_preview" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="previous_to_preview" nolabel="1"/>
                            </div>
                        </group>
                        <group string="Next period">
                            <label for="next_from_pattern" string="Patterns"/>
                            <div class="o_row">
                                <field name="next_from_pattern" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="next_to_pattern" nolabel="1"/>
                            </div>
                            <label for="next_from_preview" string="Preview"/>
                            <div class="o_row">
                                <field name="next_from_preview" nolabel="1"/>
                                <i class="fa fa-long-arrow-right mx-2"/>
                                <field name="next_to_preview" nolabel="1"/>
                            </div>
                        </group>
                    </group> -->
                </sheet>
            </form>
        </field>
    </record>

    <record id="spreadsheet_date_filter_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.date.filter.view.list</field>
        <field name="model">spreadsheet.date.filter</field>
        <field name="arch" type="xml">
            <list string="Date Filters">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="spreadsheet_date_filter_action" model="ir.actions.act_window">
        <field name="name">Date Filters</field>
        <field name="res_model">spreadsheet.date.filter</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="domain">[('active', 'in', [True, False])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new date filter
            </p>
        </field>
    </record>

    <!-- Technical / Spreadsheet -->
    <menuitem id="menu_technical_spreadsheet"
        name="Spreadsheet"
        sequence="5"
        parent="base.menu_custom"/>

    <menuitem id="menu_technical_spreadsheet_date_filter"
        name="Date Filters"
        parent="menu_technical_spreadsheet" sequence="20"
        action="spreadsheet_date_filter_action"/>
</odoo>
