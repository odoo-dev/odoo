<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="spreadsheet_date_filter_view_form" model="ir.ui.view">
        <field name="name">spreadsheet.date.filter.view.form</field>
        <field name="model">spreadsheet.date.filter</field>
        <field name="arch" type="xml">
            <form string="Date Filter">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Patterns">
                            <field name="from_pattern"/>
                            <field name="from_preview" readonly="1" force_save="1"/>
                            <field name="to_pattern"/>
                            <field name="to_preview" readonly="1" force_save="1"/>
                            <field name="next_from_pattern"/>
                            <field name="next_from_preview" readonly="1" force_save="1"/>
                            <field name="next_to_pattern"/>
                            <field name="next_to_preview" readonly="1" force_save="1"/>
                            <field name="previous_from_pattern"/>
                            <field name="previous_from_preview" readonly="1" force_save="1"/>
                            <field name="previous_to_pattern"/>
                            <field name="previous_to_preview" readonly="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="spreadsheet_date_filter_view_list" model="ir.ui.view">
        <field name="name">spreadsheet.date.filter.view.list</field>
        <field name="model">spreadsheet.date.filter</field>
        <field name="arch" type="xml">
            <list string="Date Filters">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="spreadsheet_date_filter_action" model="ir.actions.act_window">
        <field name="name">Date Filters</field>
        <field name="res_model">spreadsheet.date.filter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new date filter
            </p>
        </field>
    </record>

    <!-- Technical / Spreadsheet -->
    <menuitem id="menu_technical_spreadsheet"
        name="Spreadsheet"
        sequence="5"
        parent="base.menu_custom"/>

    <menuitem id="menu_technical_spreadsheet_date_filter"
        name="Date Filters"
        parent="menu_technical_spreadsheet" sequence="20"
        action="spreadsheet_date_filter_action"/>
</odoo>
