<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherited_model_action" model="ir.actions.act_window">
        <field name="name">inherited.model.action</field>
        <field name="res_model">inherited.model</field>
        <field name="view_mode">list,form</field>
    </record>

        <record id="model_name_view_form" model="ir.ui.view">
        <field name="name">inherited_model.view.form</field>
        <field name="model">inherited.model</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <group name="name" string="string">
                            <field name="name" />
                            <field name="description"/>
                            <field name="child_model_field"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
