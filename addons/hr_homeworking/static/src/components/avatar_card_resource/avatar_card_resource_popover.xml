<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="resource_mail.AvatarCardResourcePopover" t-inherit-mode="extension">
        <xpath expr="//span[@name='icon'][hasclass('o_employee_presence_status')]" position="inside">
            <i t-if="employee?.hr_icon_display === 'presence_home'" class="oi oi-fw text-success me-1" data-icon="home" title="At Home - Present" role="img" aria-label="At Home"/>
            <i t-if="employee?.hr_icon_display === 'presence_office'" class="oi oi-fw oi-filled text-success me-1" data-icon="business" title="At Office - Present" role="img" aria-label="At Office"/>
            <i t-if="employee?.hr_icon_display === 'presence_other'" class="oi oi-fw text-success me-1" data-icon="location_on" title="Present" role="img" aria-label="At Other"/>
        </xpath>
    </t>
</templates>
