<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_demo_company_ao" model="res.partner" forcecreate="1">
        <field name="name">AO Company</field>
        <field name="street">Rua Rainha Ginga 12</field>
        <field name="city">Luanda</field>
        <field name="country_id" ref="base.ao"/>
        <field name="phone">+244 923 123 456</field>
        <field name="email">info@example.ao</field>
        <field name="website">www.example.ao</field>
    </record>

    <record id="base.demo_company_ao" model="res.company" forcecreate="1">
        <field name="name">AO Company</field>
        <field name="partner_id" ref="base.partner_demo_company_ao"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('base.demo_company_ao')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('base.demo_company_ao'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>ao</value>
        <value model="res.company" eval="obj().env.ref('base.demo_company_ao')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>
