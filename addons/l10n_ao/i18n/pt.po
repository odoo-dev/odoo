#. module: l10n_ao
#: model:account.report.line,name:l10n_ao.l10n_ao_tax_report_q09_1
msgid "1. Supplies of goods and services on which VAT was charged"
msgstr "1. Transmissões de bens e prestações de serviços em que liquidou imposto"

#. module: l10n_ao
#: model:account.report.line,name:l10n_ao.l10n_ao_tax_report_q09_4
msgid "4. Operations on which the VAT was withheld by the customer (art. 21 CIVA)"
