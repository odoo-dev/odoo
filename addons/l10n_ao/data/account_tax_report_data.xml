<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Declaração Periódica do IVA, Modelo 7 (Decreto Executivo n.º 134/19; filling instructions:
        Despacho n.º 1339/19 of the AGT). Line codes follow the "campo" numbers of Quadro 09 to 12, as published in the Diário da República (I Série n.º 78 of 10/06/2019).
        Sub-fields 1.1/2.1 (Cabinda), 1.2/2.2 (5%) and 1.3/2.3 (7%) were added by the AGT to the
        electronic form in 2026; field 1/2 is kept for the 14% operations only.
    -->
    <record id="l10n_ao_tax_report" model="account.report">
        <field name="name">VAT Return (Modelo 7)</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.ao"/>
        <field name="allow_foreign_vat" eval="True"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="l10n_ao_tax_report_balance" model="account.report.column">
                <field name="name">Balance</field>
                <field name="expression_label">balance</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_ao_tax_report_q09" model="account.report.line">
                <field name="name">Table 09 - Assessment of the tax for the period</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_ao_tax_report_q09_1" model="account.report.line">
                        <field name="name">1. Supplies of goods and services on which VAT was charged</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c1" model="account.report.line">
                                <field name="name">Field 1 - Taxable base (14%)</field>
                                <field name="code">AO_C1</field>
                                <field name="tax_tags_formula">-1</field>
                            </record>
                            <record id="l10n_ao_tax_report_c2" model="account.report.line">
                                <field name="name">Field 2 - VAT charged (14%)</field>
                                <field name="code">AO_C2</field>
                                <field name="tax_tags_formula">-2</field>
                            </record>
                            <record id="l10n_ao_tax_report_c1_1" model="account.report.line">
                                <field name="name">Field 1.1 - Taxable base - Cabinda province reduced rate</field>
                                <field name="code">AO_C1_1</field>
                                <field name="tax_tags_formula">-1.1</field>
                            </record>
                            <record id="l10n_ao_tax_report_c2_1" model="account.report.line">
                                <field name="name">Field 2.1 - VAT charged - Cabinda province reduced rate</field>
                                <field name="code">AO_C2_1</field>
                                <field name="tax_tags_formula">-2.1</field>
                            </record>
                            <record id="l10n_ao_tax_report_c1_2" model="account.report.line">
                                <field name="name">Field 1.2 - Taxable base - reduced rate of 5%</field>
                                <field name="code">AO_C1_2</field>
                                <field name="tax_tags_formula">-1.2</field>
                            </record>
                            <record id="l10n_ao_tax_report_c2_2" model="account.report.line">
                                <field name="name">Field 2.2 - VAT charged - reduced rate of 5%</field>
                                <field name="code">AO_C2_2</field>
                                <field name="tax_tags_formula">-2.2</field>
                            </record>
                            <record id="l10n_ao_tax_report_c1_3" model="account.report.line">
                                <field name="name">Field 1.3 - Taxable base - reduced rate of 7%</field>
                                <field name="code">AO_C1_3</field>
                                <field name="tax_tags_formula">-1.3</field>
                            </record>
                            <record id="l10n_ao_tax_report_c2_3" model="account.report.line">
                                <field name="name">Field 2.3 - VAT charged - reduced rate of 7%</field>
                                <field name="code">AO_C2_3</field>
                                <field name="tax_tags_formula">-2.3</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_4" model="account.report.line">
                        <field name="name">4. Operations on which the VAT was withheld by the customer (art. 21 CIVA)</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c8" model="account.report.line">
                                <field name="name">Field 8 - Taxable base</field>
                                <field name="code">AO_C8</field>
                                <field name="tax_tags_formula">-8</field>
                            </record>
                            <record id="l10n_ao_tax_report_c9" model="account.report.line">
                                <field name="name">Field 9 - VAT withheld, in favour of the taxpayer</field>
                                <field name="code">AO_C9</field>
                                <field name="tax_tags_formula">9</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_5" model="account.report.line">
                        <field name="name">5. Supplies of goods and services on which no VAT was charged</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c10" model="account.report.line">
                                <field name="name">Field 10 - Exempt with right of deduction</field>
                                <field name="code">AO_C10</field>
                                <field name="tax_tags_formula">-10</field>
                            </record>
                            <record id="l10n_ao_tax_report_c11" model="account.report.line">
                                <field name="name">Field 11 - Exempt without right of deduction (art. 12 CIVA, excluding paragraph a))</field>
                                <field name="code">AO_C11</field>
                                <field name="tax_tags_formula">-11</field>
                            </record>
                            <record id="l10n_ao_tax_report_c12" model="account.report.line">
                                <field name="name">Field 12 - Not taxed (art. 10 CIVA)</field>
                                <field name="code">AO_C12</field>
                                <field name="tax_tags_formula">-12</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_rc" model="account.report.line">
                        <field name="name">6. Acquisitions of services from a supplier without seat, permanent establishment or domicile in Angola, VAT assessed by the declarant (art. 29 CIVA)</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c13" model="account.report.line">
                                <field name="name">Field 13 - Taxable base</field>
                                <field name="code">AO_C13</field>
                                <field name="tax_tags_formula">13</field>
                            </record>
                            <record id="l10n_ao_tax_report_c14" model="account.report.line">
                                <field name="name">Field 14 - VAT deductible, in favour of the taxpayer</field>
                                <field name="code">AO_C14</field>
                                <field name="tax_tags_formula">14</field>
                            </record>
                            <record id="l10n_ao_tax_report_c15" model="account.report.line">
                                <field name="name">Field 15 - VAT self-assessed, in favour of the State</field>
                                <field name="code">AO_C15</field>
                                <field name="tax_tags_formula">-15</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_6" model="account.report.line">
                        <field name="name">7. Acquisitions of goods and services by the taxpayer</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c16" model="account.report.line">
                                <field name="name">Field 16 - Fixed assets and investments - taxable base</field>
                                <field name="code">AO_C16</field>
                                <field name="tax_tags_formula">16</field>
                            </record>
                            <record id="l10n_ao_tax_report_c17" model="account.report.line">
                                <field name="name">Field 17 - Fixed assets and investments - deductible VAT</field>
                                <field name="code">AO_C17</field>
                                <field name="tax_tags_formula">17</field>
                            </record>
                            <record id="l10n_ao_tax_report_c18" model="account.report.line">
                                <field name="name">Field 18 - Inventories - taxable base</field>
                                <field name="code">AO_C18</field>
                                <field name="tax_tags_formula">18</field>
                            </record>
                            <record id="l10n_ao_tax_report_c19" model="account.report.line">
                                <field name="name">Field 19 - Inventories - deductible VAT</field>
                                <field name="code">AO_C19</field>
                                <field name="tax_tags_formula">19</field>
                            </record>
                            <record id="l10n_ao_tax_report_c20" model="account.report.line">
                                <field name="name">Field 20 - Other consumer goods - taxable base</field>
                                <field name="code">AO_C20</field>
                                <field name="tax_tags_formula">20</field>
                            </record>
                            <record id="l10n_ao_tax_report_c21" model="account.report.line">
                                <field name="name">Field 21 - Other consumer goods - deductible VAT</field>
                                <field name="code">AO_C21</field>
                                <field name="tax_tags_formula">21</field>
                            </record>
                            <record id="l10n_ao_tax_report_c22" model="account.report.line">
                                <field name="name">Field 22 - Services - taxable base</field>
                                <field name="code">AO_C22</field>
                                <field name="tax_tags_formula">22</field>
                            </record>
                            <record id="l10n_ao_tax_report_c23" model="account.report.line">
                                <field name="name">Field 23 - Services - deductible VAT</field>
                                <field name="code">AO_C23</field>
                                <field name="tax_tags_formula">23</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_7" model="account.report.line">
                        <field name="name">8. Deductible VAT on imports of goods by the taxpayer</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c24" model="account.report.line">
                                <field name="name">Field 24 - Taxable base</field>
                                <field name="code">AO_C24</field>
                                <field name="tax_tags_formula">24</field>
                            </record>
                            <record id="l10n_ao_tax_report_c25" model="account.report.line">
                                <field name="name">Field 25 - Deductible VAT</field>
                                <field name="code">AO_C25</field>
                                <field name="tax_tags_formula">25</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_8" model="account.report.line">
                        <field name="name">9. Adjustments of withheld VAT</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c26" model="account.report.line">
                                <field name="name">Field 26 - In favour of the taxpayer</field>
                                <field name="code">AO_C26</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c26_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">external</field>
                                        <field name="formula">sum</field>
                                        <field name="subformula">editable;rounding=2</field>
                                    </record>
                                </field>
                            </record>
                            <record id="l10n_ao_tax_report_c27" model="account.report.line">
                                <field name="name">Field 27 - In favour of the State</field>
                                <field name="code">AO_C27</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c27_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">external</field>
                                        <field name="formula">sum</field>
                                        <field name="subformula">editable;rounding=2</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_9" model="account.report.line">
                        <field name="name">10. Monthly or annual adjustments made by the taxpayer</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c28" model="account.report.line">
                                <field name="name">Field 28 - In favour of the taxpayer</field>
                                <field name="code">AO_C28</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c28_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">external</field>
                                        <field name="formula">sum</field>
                                        <field name="subformula">editable;rounding=2</field>
                                    </record>
                                </field>
                            </record>
                            <record id="l10n_ao_tax_report_c29" model="account.report.line">
                                <field name="name">Field 29 - In favour of the State</field>
                                <field name="code">AO_C29</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c29_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">external</field>
                                        <field name="formula">sum</field>
                                        <field name="subformula">editable;rounding=2</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_totals" model="account.report.line">
                        <field name="name">Totals</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c31" model="account.report.line">
                                <field name="name">Field 31 - Total taxable base</field>
                                <field name="code">AO_C31</field>
                                <field name="aggregation_formula">AO_C1.balance + AO_C1_1.balance + AO_C1_2.balance + AO_C1_3.balance + AO_C8.balance + AO_C10.balance + AO_C11.balance + AO_C12.balance + AO_C13.balance + AO_C16.balance + AO_C18.balance + AO_C20.balance + AO_C22.balance + AO_C24.balance</field>
                            </record>
                            <record id="l10n_ao_tax_report_c32" model="account.report.line">
                                <field name="name">Field 32 - Total VAT in favour of the taxpayer</field>
                                <field name="code">AO_C32</field>
                                <field name="aggregation_formula">AO_C9.balance + AO_C14.balance + AO_C17.balance + AO_C19.balance + AO_C21.balance + AO_C23.balance + AO_C25.balance + AO_C26.balance + AO_C28.balance</field>
                            </record>
                            <record id="l10n_ao_tax_report_c33" model="account.report.line">
                                <field name="name">Field 33 - Total VAT in favour of the State</field>
                                <field name="code">AO_C33</field>
                                <field name="aggregation_formula">AO_C2.balance + AO_C2_1.balance + AO_C2_2.balance + AO_C2_3.balance + AO_C15.balance + AO_C27.balance + AO_C29.balance</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_q09_result" model="account.report.line">
                        <field name="name">Assessment of the period</field>
                        <field name="children_ids">
                            <record id="l10n_ao_tax_report_c34" model="account.report.line">
                                <field name="name">Field 34 - VAT credit of the period (32 - 33)</field>
                                <field name="code">AO_C34</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c34_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">aggregation</field>
                                        <field name="formula">AO_C32.balance - AO_C33.balance</field>
                                        <field name="subformula">if_above(AOA(0))</field>
                                    </record>
                                </field>
                            </record>
                            <record id="l10n_ao_tax_report_c35" model="account.report.line">
                                <field name="name">Field 35 - VAT due for the period (33 - 32)</field>
                                <field name="code">AO_C35</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c35_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">aggregation</field>
                                        <field name="formula">AO_C33.balance - AO_C32.balance</field>
                                        <field name="subformula">if_above(AOA(0))</field>
                                    </record>
                                </field>
                            </record>
                            <record id="l10n_ao_tax_report_c36" model="account.report.line">
                                <field name="name">Field 36 - Credit carried forward from previous periods</field>
                                <field name="code">AO_C36</field>
                                <field name="expression_ids">
                                    <record id="l10n_ao_tax_report_c36_balance" model="account.report.expression">
                                        <field name="label">balance</field>
                                        <field name="engine">external</field>
                                        <field name="formula">sum</field>
                                        <field name="subformula">editable;rounding=2</field>
                                    </record>
                                </field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_ao_tax_report_q10" model="account.report.line">
                <field name="name">Table 10 - VAT payable to the State</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_ao_tax_report_c37" model="account.report.line">
                        <field name="name">Field 37 - VAT payable (35 - 36)</field>
                        <field name="code">AO_C37</field>
                        <field name="expression_ids">
                            <record id="l10n_ao_tax_report_c37_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">AO_C33.balance - AO_C32.balance - AO_C36.balance</field>
                                <field name="subformula">if_above(AOA(0))</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_ao_tax_report_q11" model="account.report.line">
                <field name="name">Table 11 - VAT recoverable</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_ao_tax_report_c38" model="account.report.line">
                        <field name="name">Field 38 - VAT credit (34 + 36, less the part of 36 used in field 37)</field>
                        <field name="code">AO_C38</field>
                        <field name="expression_ids">
                            <record id="l10n_ao_tax_report_c38_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">AO_C32.balance + AO_C36.balance - AO_C33.balance</field>
                                <field name="subformula">if_above(AOA(0))</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_c39" model="account.report.line">
                        <field name="name">Field 39 - Credit carried forward to the next period (38 - 40)</field>
                        <field name="code">AO_C39</field>
                        <field name="expression_ids">
                            <record id="l10n_ao_tax_report_c39_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">AO_C38.balance - AO_C40.balance</field>
                                <field name="subformula">if_above(AOA(0))</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_ao_tax_report_c40" model="account.report.line">
                        <field name="name">Field 40 - Refund requested</field>
                        <field name="code">AO_C40</field>
                        <field name="expression_ids">
                            <record id="l10n_ao_tax_report_c40_balance" model="account.report.expression">
                                <field name="label">balance</field>
                                <field name="engine">external</field>
                                <field name="formula">sum</field>
                                <field name="subformula">editable;rounding=2</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_ao_tax_report_q12" model="account.report.line">
                <field name="name">Table 12 - Breakdown of Table 09</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_ao_tax_report_c45" model="account.report.line">
                        <field name="name">Field 45 - Operations intended for export</field>
                        <field name="code">AO_C45</field>
                        <field name="tax_tags_formula">-45</field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
