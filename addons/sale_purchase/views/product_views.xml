<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.view.form.inherit.sale.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='service_tracking']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//field[@name='service_tracking']" position="after">
                <field name="display_service_tracking" invisible="type != 'service'" required="type == 'service'"/>
            </xpath>
        </field>
    </record>

</odoo>
