<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="base.partner_demo_company_na" model="res.partner" forcecreate="1">
        <field name="name">NA Company</field>
        <field name="vat"/>
        <field name="street">Independence Avenue 1</field>
        <field name="city">Windhoek</field>
        <field name="country_id" ref="base.na"/>
        <field name="zip">10001</field>
        <field name="phone">+264 61 123 4567</field>
        <field name="email">info@company.naexample.com</field>
        <field name="website">www.naexample.com</field>
    </record>

    <record id="base.demo_company_na" model="res.company" forcecreate="1">
        <field name="name">NA Company</field>
        <field name="partner_id" ref="base.partner_demo_company_na"/>
    </record>

    <function model="res.company" name="_onchange_country_id">
        <value eval="[ref('base.demo_company_na')]"/>
    </function>

    <function model="res.users" name="write">
        <value eval="[ref('base.user_root'), ref('base.user_admin'), ref('base.user_demo')]"/>
        <value eval="{'company_ids': [(4, ref('base.demo_company_na'))]}"/>
    </function>

    <function model="account.chart.template" name="try_loading">
        <value eval="[]"/>
        <value>na</value>
        <value model="res.company" eval="obj().env.ref('base.demo_company_na')"/>
        <value name="install_demo" eval="True"/>
    </function>
</odoo>