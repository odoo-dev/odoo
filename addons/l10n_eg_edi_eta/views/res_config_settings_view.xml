<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.l10n_eg_edi_eta</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block" position="after">
                <block title="Egypt E-Invoicing (ETA)" name="egyption_eta_edi" invisible="country_code != 'EG'">
                    <field name="country_code" invisible="1"/>
                    <setting string="ETA Credentials" company_dependent="1">
                        <div class="content-group">
                            <div class="row">
                                <label for="l10n_eg_client_identifier" class="col-lg-4 o_light_label"/>
                                <field name="l10n_eg_client_identifier" string="Client ID" help="The client ID retrieved from the ETA e-invoicing portal"/>
                            </div>
                            <div class="row">
                                <label for="l10n_eg_client_secret" class="col-lg-4 o_light_label"/>
                                <field name="l10n_eg_client_secret" string="Secret Key" password="True" help="The secret key provided by the ETA. You can input client secret 1 or 2"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="l10n_eg_edi_demo" company_dependent="1" help="Activate this mode to test the electronic invoicing flows with internal validations only">
                        <field name="l10n_eg_edi_demo_mode" string="Demo Mode"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
