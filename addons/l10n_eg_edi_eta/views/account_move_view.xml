<odoo>
    <data>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">view_move_form_inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority" eval="40"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="ETA" name="page_eta_e_invoice" invisible="country_code != 'EG'">
                        <field name="l10n_eg_eta_submission_ids">
                            <list name="l10n_eg_edi_eta_submissions" string="ETA Submissions" default_order="create_date desc" create="0" delete="0" edit="0" no_open="1">
                                <field name="l10n_eg_eta_submission_date"/>
                                <field name="l10n_eg_eta_error_message" column_invisible="1"/>
                                <field name="l10n_eg_eta_submission_state" widget="eta_submission_status"/>
                                <field name="l10n_eg_eta_json_filename"/>
                                <field name="l10n_eg_eta_document_uuid" optional="hide"/>
                                <field name="l10n_eg_eta_document_longid" optional="hide"/>
                                <field name="l10n_eg_eta_submission_id" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

        <record id="l10n_eg_edi_view_out_invoice_tree_inherit" model="ir.ui.view">
            <field name="name">l10n_eg_edi.view.out.invoice.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_send_and_print']" position="after">
                    <button name="action_get_l10n_eg_invoice_pdf" type="object" string="ETA: Fetch Invoice PDF" groups="account.group_account_basic"/>
                </xpath>
                <field name="status_in_payment" position="after">
                    <field
                        name="l10n_eg_edi_submission_state"
                        widget="badge"
                        optional="hide"
                        decoration-info="l10n_eg_edi_submission_state == 'to_send'"
                        decoration-success="l10n_eg_edi_submission_state in ['sent', 'test']"
                        decoration-warning="l10n_eg_edi_submission_state == 'rejected'"
                        decoration-danger="l10n_eg_edi_submission_state == 'cancelled'"
                    />
                    <field name="l10n_eg_edi_error_message" optional="hide"/>
                </field>
            </field>
        </record>

        <record id="l10n_eg_edi_view_account_invoice_filter" model="ir.ui.view">
            <field name="name">l10n_eg_edi.view.account.invoice.filter</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='group_by_company']" position="after">
                    <filter name="eg_submission_state" string="ETA State" context="{'group_by': 'l10n_eg_edi_submission_state'}" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
