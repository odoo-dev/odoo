<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="website_slides.SlideUnsubscribeDialog" t-inherit-mode="extension">
        <xpath expr="//p[last()]" position="after">
            <t t-if="this.props.enroll === 'payment'">
                <div class="alert alert-warning d-flex gap-2" role="alert">
                    <i class="oi lh-base" data-icon="warning"/>
                    <div><span class="fw-semibold">This course is paid.</span> Leaving the course and re-enrolling afterwards means that you'll be charged again.</div>
                </div>
            </t>
        </xpath>
    </t>

</templates>
