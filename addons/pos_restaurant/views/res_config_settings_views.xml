<?xml version="1.0"?>
<odoo>
    <record id="pos_config_view_form_inherit_pos_restaurant" model="ir.ui.view">
        <field name="name">pos.config.form.view.inherit.pos_restaurant</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='is_restaurant']" position="inside">
                <div class="content-group mt16" invisible="not module_pos_restaurant">
                    <div class="row">
                        <label string="Floors" for="floor_ids" class="o_light_label me-2"/>
                        <field name="floor_ids" widget="many2many_tags" readonly="has_active_session"/>
                    </div>
                    <div>
                        <button name="%(pos_restaurant.action_restaurant_floor_form)d" icon="east" type="action" string="Floors" class="btn-link"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@name='interface_general']/div" position="inside">
                <setting invisible="not module_pos_restaurant" help="Select the table first or after registering the order">
                    <field name="default_screen" widget="radio"/>
                </setting>
            </xpath>
            <xpath expr="//page[@name='devices_printers']/div" position="inside">
                <setting string="Automatic course allocation" help="Assign categories to default course" id="use_course_allocation" invisible="not module_pos_restaurant">
                    <field name="use_course_allocation"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
