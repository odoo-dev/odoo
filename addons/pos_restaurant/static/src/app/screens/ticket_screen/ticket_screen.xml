<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
         <xpath expr="//div[@id='order-tags']" position="after">
            <t t-set="tableTag" t-value="this.getTableTag(order)"/>
            <div t-if="tableTag" class="badge rounded ms-1" t-att="this.getColorListAttrs(1)" style="font-size: 0.75rem !important;">
                Table <t t-out="tableTag" />
            </div>
        </xpath>
    </t>

</templates>
