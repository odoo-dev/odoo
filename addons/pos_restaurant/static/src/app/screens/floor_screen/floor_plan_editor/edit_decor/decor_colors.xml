<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant.floor_editor.decor_colors">
        <t t-if="this.colorTokens.length">
            <div class="fs-4 fw-bold d-flex justify-content-between align-items-center mt-3 mb-2">
                <span>Colors</span>
                <button t-if="this.hasCustomColors" class="btn btn-link btn-sm p-0 o_fp_reset_colors" t-on-click="() => this.resetColors()">Reset</button>
            </div>
            <div class="d-flex flex-wrap gap-2 pt-1">
                <t t-foreach="this.colorTokens" t-as="item" t-key="item.token">
                    <label class="rounded-circle o_fp_color_item o_fp_color_picker m-0" t-attf-style="background-color: {{item.value}}">
                        <input type="color" t-att-value="item.value"
                               t-on-input="(e) => this.setTokenColor(item.token, e.target.value, true)"
                               t-on-change="(e) => this.setTokenColor(item.token, e.target.value)"/>
                    </label>
                </t>
            </div>
        </t>
    </t>
</templates>