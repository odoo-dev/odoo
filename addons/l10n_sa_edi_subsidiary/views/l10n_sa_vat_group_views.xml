<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_sa_vat_group_view_form" model="ir.ui.view">
            <field name="name">l10n_sa.vat.group.form</field>
            <field name="model">l10n_sa.vat.group</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field class="text-break" name="name" placeholder="Vat Group Name"/>
                            </h1>
                        </div>
                        <group>
                            <group name="left">
                                <field name="vat"/>
                                <field name="address"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Companies" name="companies">
                                <field name="partner_ids" widget="many2many">
                                    <list>
                                        <field name="name"/>
                                        <field name="vat"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="l10n_sa_vat_group_view_tree" model="ir.ui.view">
            <field name="name">l10n_sa.vat.group.list</field>
            <field name="model">l10n_sa.vat.group</field>
            <field name="arch" type="xml">
                <list edit="false">
                    <field name="name"/>
                    <field name="vat"/>
                    <field name="address"/>
                </list>
            </field>
        </record>

        <record id="action_l10n_sa_vat_group_tree" model="ir.actions.act_window">
            <field name="name">VAT Groups</field>
            <field name="res_model">l10n_sa.vat.group</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('l10n_sa_vat_group_view_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('l10n_sa_vat_group_view_form')})]"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new VAT group
                </p>
            </field>
        </record>

        <menuitem id="menu_action_l10n_sa_vat_group" parent="account.account_account_menu" action="action_l10n_sa_vat_group_tree" name="Vat Groups" sequence="40" groups="account.group_account_manager"/>
    </data>
</odoo>
