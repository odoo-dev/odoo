<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_discount.pos_session_sales_details_discounts_section" inherit_id="point_of_sale.pos_session_sales_details_discounts_section">
        <xpath expr="//div[@id='discounts']" position="inside">
            <t t-if="global_discount_number">
                <div class="row">
                    <div class="col-12">
                        <strong>Number of global discounts</strong>: <t t-out="global_discount_number"/>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <strong>Amount of global discounts</strong>:
                        <t t-set="amount" t-value="global_discount_amount"/>
                        <t t-call="point_of_sale.format_currency" />
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
