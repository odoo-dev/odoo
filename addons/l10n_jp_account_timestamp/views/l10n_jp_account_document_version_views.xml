<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_jp_account_document_version_view_list" model="ir.ui.view">
        <field name="name">l10n.jp.account.document.version.list</field>
        <field name="model">l10n_jp.account.document.version</field>
        <field name="arch" type="xml">
            <list delete="0" decoration-danger="state in ('error', 'unverified', 'reconcile')">
                <field name="name"/>
                <field name="move_id"/>
                <field name="state" widget="badge"/>
                <field name="timestamped_at" optional="show"/>
                <field name="received_at" optional="show"/>
                <field name="create_date" string="Uploaded On" optional="show"/>
                <field name="previous_version_id" optional="hide"/>
                <field name="last_error" optional="hide"/>
                <field name="retry_at" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="l10n_jp_account_document_version_view_form" model="ir.ui.view">
        <field name="name">l10n.jp.account.document.version.form</field>
        <field name="model">l10n_jp.account.document.version</field>
        <field name="arch" type="xml">
            <form delete="0" duplicate="0">
                <header>
                    <button name="action_prepare_document" type="object" string="Prepare PDF" class="btn-primary"
                            invisible="not id or state not in ('queued', 'error') or normalized_digest" groups="account.group_account_manager"/>
                    <button name="action_check_integrity" type="object" string="Check Integrity"
                            invisible="not normalized_digest" groups="account.group_account_manager"/>
                    <button name="action_queue_timestamp" type="object" string="Queue Timestamp"
                            invisible="not normalized_digest or state not in ('prepared', 'error') or timestamp_file"
                            groups="account.group_account_manager"/>
                    <button name="action_retry_timestamp_verification" type="object" string="Retry Verification"
                            invisible="state != 'unverified' or not timestamp_response_token"
                            groups="account.group_account_manager"/>
                    <field name="timestamp_response_token" invisible="1"/>
                    <button name="action_set_main_document" type="object" string="Use as Main Document" invisible="not id" groups="account.group_account_manager"/>
                    <button name="action_create_replacement" type="object" string="Add Replacement" invisible="not id" groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,prepared,timestamp_pending,timestamped"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="id" placeholder="For example: Invoice XYZ.pdf"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="state != 'queued'">
                        <strong>The scan is waiting for PDF preparation.</strong>
                        The scheduled action prepares active scans, or you can click Prepare PDF now.
                        OCR and bill data entry remain separate.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'prepared'">
                        <strong>PDF preparation complete.</strong>
                        Preview or download it below. The fingerprint is available in Document Details.
                    </div>
                    <div class="text-muted mb-3" invisible="state == 'timestamped'">
                        PDF preparation and timestamp verification are separate steps. A timestamp is complete only after its signed PDF is verified.
                    </div>
                    <div class="alert alert-info" role="status" invisible="state not in ('timestamp_queued', 'timestamp_pending')">
                        The timestamp request is queued or processing. Its fixed PDF revision is retained while Odoo retrieves the existing outcome.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'reconcile'">
                        The provider or billing outcome needs reconciliation. Odoo will not issue a second paid timestamp automatically.
                    </div>
                    <group>
                        <group string="Uploaded Document">
                            <field name="source_file" filename="name" readonly="id"/>
                            <field name="source_attachment_id" readonly="id" options="{'no_create': True}"
                                   domain="[('res_model', '=', 'account.move'), ('res_id', '=', move_id), ('type', '=', 'binary')]"/>
                            <field name="previous_version_id" readonly="id" invisible="not previous_version_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Accounting and Receipt">
                            <field name="timestamp_mode" string="Timestamp Mode" invisible="not timestamp_mode"/>
                            <field name="move_id" readonly="id" options="{'no_create': True}"/>
                            <field name="received_at" readonly="id" help="When the company received the paper document, not the upload time."/>
                            <field name="create_date" string="Uploaded On" invisible="not id"/>
                            <field name="company_id" readonly="1" invisible="not id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1" readonly="1"/>
                        </group>
                    </group>
                    <group string="Action Required" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                        <field name="retry_at" invisible="not retry_at"/>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="state != 'error'">
                        Temporary file I/O failures are retried automatically at Next Retry.
                        Review the error before preparing or queuing again. If the source scan is invalid, add a replacement instead of editing this evidence.
                    </div>
                    <notebook invisible="not id">
                        <page name="timestamped_pdf" string="Timestamped PDF" invisible="not timestamp_file">
                            <field name="timestamped_at"/>
                            <field name="timestamp_filename" invisible="1"/>
                            <field name="timestamp_file" filename="timestamp_filename" readonly="1"/>
                            <field name="timestamp_file" widget="pdf_viewer" readonly="1"/>
                        </page>
                        <page name="document_preview" string="PDF Preview" invisible="not normalized_digest">
                            <field name="prepared_file" string="Converted PDF" readonly="1" invisible="not prepared_file"/>
                            <field name="prepared_file" widget="pdf_viewer" readonly="1" invisible="not prepared_file"/>
                            <field name="source_file" widget="pdf_viewer" readonly="1" invisible="prepared_file"/>
                        </page>
                        <page name="document_details" string="Document Details">
                            <group>
                                <field name="source_checksum"/>
                                <field name="normalized_digest" invisible="state != 'prepared'"/>
                                <field name="timestamp_digest" invisible="not timestamp_nonce"/>
                                <field name="timestamp_nonce" invisible="not timestamp_nonce"/>
                                <field name="timestamp_policy" invisible="not timestamp_nonce"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="l10n_jp_account_document_version_view_search" model="ir.ui.view">
        <field name="name">l10n.jp.account.document.version.search</field>
        <field name="model">l10n_jp.account.document.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="move_id"/>
                <filter name="to_prepare" string="To Prepare" domain="[('state', '=', 'queued')]"/>
                <filter name="prepared" string="PDF Prepared" domain="[('state', '=', 'prepared')]"/>
                <filter name="timestamped" string="Timestamped" domain="[('state', '=', 'timestamped')]"/>
                <filter name="timestamp_pending" string="Timestamp Processing" domain="[('state', 'in', ('timestamp_queued', 'timestamp_pending'))]"/>
                <filter name="needs_attention" string="Needs Attention" domain="[('state', 'in', ('error', 'unverified', 'reconcile'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_move" string="Accounting Entry" context="{'group_by': 'move_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
    <record id="l10n_jp_account_document_version_action" model="ir.actions.act_window">
        <field name="name">Japan Scanned Documents</field>
        <field name="res_model">l10n_jp.account.document.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="l10n_jp_account_document_version_view_search"/>
    </record>
    <menuitem id="l10n_jp_account_document_version_menu" name="Japan Scanned Documents"
              parent="account.menu_finance_entries" action="l10n_jp_account_document_version_action"
              groups="account.group_account_manager" sequence="90"/>
</odoo>
