<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.jp.account.timestamp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="account_digitalization" position="inside">
                <setting id="l10n_jp_timestamp_setting" string="Scanned Document Timestamping"
                         help="Timestamp scanned documents for all Japanese companies in this database through IAP."
                         groups="base.group_system" invisible="company_country_code != 'JP'">
                    <field name="l10n_jp_timestamp_enabled"/>
                    <div class="content-group" invisible="not l10n_jp_timestamp_enabled">
                        <label for="l10n_jp_timestamp_mode" class="me-3"/>
                        <field name="l10n_jp_timestamp_mode" widget="radio" options="{'horizontal': True}"/>
                        <div class="mt8" invisible="l10n_jp_timestamp_mode != 'production'">
                            <button name="%(iap.iap_account_action)d" type="action" string="Manage IAP Credits" class="btn-link"/>
                        </div>
                    </div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
