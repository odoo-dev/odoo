<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_delivery" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.delivery</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='ship_later']" position="after">
                <setting id="pos_delivery_management" string="POS Delivery Management" help="Allow eCommerce pickups, split deliveries and returns from POS interface.">
                    <field name="pos_iface_pos_delivery"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
