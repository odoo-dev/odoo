<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="l10n_in_pos.productHsnDialog">
        <Dialog size="'md'" title.translate="Product HSN/SAC code is missing">
            <div>
                <p>
                    The HSN/SAC code is mandatory for taxable products in India. <br/>
                    Please set the HSN/SAC code for your products to comply with tax regulations.
                </p>
                
            </div>
            <t t-set-slot="footer">
                <div class="modal-footer-right d-flex gap-2">
                    <button class="button icon btn btn-lg btn-primary" t-on-click="redirect">
                            Go to Products
                    </button>
                    <button class="button btn btn-secondary" t-on-click="onClose">
                            Ok
                    </button>
                </div>
            </t>
        </Dialog>
    </t>

</templates>
