<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="CustomerDisplay"  t-inherit="point_of_sale.CustomerDisplay" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_customer_display_logo')]" position="after">
            <div t-if="order.screenName == 'PaymentScreen'">
                <img t-att-src="order.upiQrCode" alt="QR Code" height="300"/>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('o_customer_display_logo')]" position="attributes">
            <attribute name="class" add="position-fixed top-0 mt-2" separator=" "/>
        </xpath>
    </t>
</templates>
