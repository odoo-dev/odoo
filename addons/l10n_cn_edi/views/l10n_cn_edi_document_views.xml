<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_cn_edi_document_view_list" model="ir.ui.view">
        <field name="name">l10n_cn_edi.document.view.list</field>
        <field name="model">l10n_cn_edi.document</field>
        <field name="arch" type="xml">
            <list string="E-Fapiao Red Forms" create="0" edit="0" decoration-danger="state == 'failed'" decoration-success="state == 'red_form_confirmed'" decoration-warning="state == 'red_form_pending'">
                <field name="create_date" string="Created On"/>
                <field name="move_id"/>
                <field name="red_form_number"/>
                <field name="red_form_uuid"/>
                <field name="amount_untaxed"/>
                <field name="bureau_state"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="l10n_cn_edi_document_view_form" model="ir.ui.view">
        <field name="name">l10n_cn_edi.document.view.form</field>
        <field name="model">l10n_cn_edi.document</field>
        <field name="arch" type="xml">
            <form string="E-Fapiao Red Form" create="0" edit="0">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group string="Related Record">
                            <field name="move_id"/>
                        </group>
                        <group string="Tax Bureau Data">
                            <field name="red_form_uuid"/>
                            <field name="red_form_number"/>
                            <field name="red_fapiao_no"/>
                            <field name="bureau_state"/>
                            <field name="amount_untaxed"/>
                            <field name="amount_tax"/>
                        </group>
                    </group>
                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_cn_edi_document_action" model="ir.actions.act_window">
        <field name="name">E-Fapiao Red Forms</field>
        <field name="res_model">l10n_cn_edi.document</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No red forms yet.
            </p>
        </field>
    </record>

    <menuitem id="l10n_cn_edi_document_menu"
              name="E-Fapiao Red Forms"
              action="l10n_cn_edi_document_action"
              parent="account.menu_finance_configuration"
              sequence="100"/>
</odoo>
