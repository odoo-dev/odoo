<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_tax_form_inherit_l10n_lv" model="ir.ui.view">
            <field name="name">account.tax.form.inherit.l10n_lv</field>
            <field name="model">account.tax</field>
            <field name="inherit_id" ref="account.view_tax_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='tax_scope']" position="after">
                    <field name="l10n_lv_transaction_type"
                           attrs="{'invisible': [('country_code', '!=', 'LV')]}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
