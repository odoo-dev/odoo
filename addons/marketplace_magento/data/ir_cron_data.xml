<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_marketplace_pull_products" model="ir.cron">
        <field name="name">Magento: Pull Product Catalog</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model.search([('channel_code', '=', 'magento')])._pull_products()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">1000</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_marketplace_pull_locations" model="ir.cron">
        <field name="name">Magento: Pull Stock Locations</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model.search([('channel_code', '=', 'magento')])._pull_locations()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(weeks=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">1000</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_marketplace_push_inventory" model="ir.cron">
        <field name="name">Magento: Push Inventory</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model.search([('channel_code', '=', 'magento', 'push_inventory', '=', True)])._push_inventory()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">1000</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_marketplace_pull_orders" model="ir.cron">
        <field name="name">Magento: Pull Sale Orders</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model.search([('channel_code', '=', 'magento')])._pull_orders()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">1000</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_marketplace_push_deliveries" model="ir.cron">
        <field name="name">Magento: Push Deliveries</field>
        <field name="model_id" ref="model_marketplace_account"/>
        <field name="state">code</field>
        <field name="code">model.search([('channel_code', '=', 'magento')])._push_deliveries()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=40)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="priority">1000</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
