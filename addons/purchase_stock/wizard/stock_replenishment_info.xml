<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="product_supplierinfo_replenishment_tree_view" model="ir.ui.view">
        <field name="name">product.supplierinfo.replenishment.list.view</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_tree_view"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <field name="delay" position="after">
                <field name="show_set_supplier_button" column_invisible="True"/>
                <field name="last_purchase_date" width="auto"/>
                <button name="action_set_supplier" type="object" string="Set as Supplier" class="btn btn-link"
                        invisible="not show_set_supplier_button"/>
            </field>
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-bf">parent.supplierinfo_id == id</attribute>
            </xpath>
            <field name="sequence" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </field>
            <field name="min_qty" position="attributes">
                <attribute name="decoration-danger">min_qty &gt; parent.qty_to_order</attribute>
            </field>
            <field name="company_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
            <field name="uom_id" position="attributes">
                <attribute name="widget"/>
            </field>
            <field name="delay" position="attributes">
                <attribute name="string">Delivery Time</attribute>
                <attribute name="optional">show</attribute>
                <attribute name="width">auto</attribute>
            </field>
        </field>
    </record>

    <record id="product_supplierinfo_replenishment_kanban_view" model="ir.ui.view">
        <field name="name">product.supplierinfo.replenishment.kanban.view</field>
        <field name="model">product.supplierinfo</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="0" delete="0" default_order="sequence, id">
                <field name="sequence"/>
                <field name="partner_id"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="min_qty"/>
                <field name="uom_id"/>
                <field name="delay"/>
                <field name="last_purchase_date"/>
                <field name="show_set_supplier_button"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <div class="fw-bold flex-grow-1 text-break" style="min-width: 0;">
                                <field name="partner_id"/>
                            </div>
                            <span class="badge text-bg-primary flex-shrink-0"
                                invisible="parent.supplierinfo_id != id">Selected</span>
                        </div>
                        <div class="text-muted mt-1">
                            Unit Price:
                            <field name="price" widget="monetary" class="fw-bold text-nowrap"/>
                        </div>
                        <div class="text-danger" invisible="min_qty &lt;= parent.qty_to_order">
                            Minimum Quantity:
                            <span class="text-nowrap">
                                <field name="min_qty"/>
                                <field name="uom_id" groups="uom.group_uom" class="ms-1"/>
                            </span>
                        </div>
                        <div class="text-muted" invisible="min_qty &gt; parent.qty_to_order">
                            Minimum Quantity:
                            <span class="text-nowrap">
                                <field name="min_qty"/>
                                <field name="uom_id" groups="uom.group_uom" class="ms-1"/>
                            </span>
                        </div>
                        <div class="text-muted">
                            Delivery Time:
                            <field name="delay"/> days
                        </div>
                        <div class="text-muted" invisible="not last_purchase_date">
                            Last Purchase:
                            <field name="last_purchase_date"/>
                        </div>
                        <button name="action_set_supplier" type="object" string="Set as Supplier"
                            class="btn btn-secondary btn-sm mt-2"
                            invisible="not show_set_supplier_button"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_stock_replenishment_info_stock_purchase_inherit" model="ir.ui.view">
        <field name="name">stock.replenishment.information.purchase.stock.inherit</field>
        <field name="model">stock.replenishment.info</field>
        <field name="inherit_id" ref="stock.view_stock_replenishment_info"/>
        <field name="arch" type="xml">
            <xpath expr="//page" position="before">
                <page string="Vendors" name="page_vendors" invisible="not show_vendor_tab">
                    <field name="supplierinfo_id" invisible="1"/>
                    <field name="supplierinfo_ids" readonly="1" mode="list,kanban" context="{'list_view_ref': 'purchase_stock.product_supplierinfo_replenishment_tree_view', 'kanban_view_ref': 'purchase_stock.product_supplierinfo_replenishment_kanban_view', 'stock_replenishment_info_id': id, 'orderpoint_id': orderpoint_id}"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
