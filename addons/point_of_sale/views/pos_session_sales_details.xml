<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="pos_session_sales_details">
            <div class="page">
                <t t-call="point_of_sale.pos_session_sales_details_header" />
                <t t-call="point_of_sale.pos_session_sales_details_bar" />
                <t t-call="point_of_sale.pos_session_sales_details_sales_section" />
                <t t-call="point_of_sale.pos_session_sales_details_taxes_section" />
                <t t-call="point_of_sale.pos_session_sales_details_refunds_section" />
                <t t-call="point_of_sale.pos_session_sales_details_refunds_taxes_section" />
                <t t-call="point_of_sale.pos_session_sales_details_payments_section" />
                <t t-call="point_of_sale.pos_session_sales_details_discounts_section" />
                <t t-call="point_of_sale.pos_session_sales_details_invoices_section" />
                <t t-call="point_of_sale.pos_session_sales_details_session_control" />
                <div id="end_report" style="page-break-after: always;"/>
            </div>
        </template>

        <template id="pos_session_sales_details_header">
            <div class="bg-secondary p-3" id="header">
                <div class="row">
                    <div class="col-3 d-flex flex-column justify-content-center">
                        <br />
                        <br />
                        <div class="text-start" style="font-size:0.85rem;">
                            <span t-out="company_name" />
                            <address class="mb-0 text-muted" t-out="company_address" />
                        </div>
                    </div>
                    <div class="col-6 text-center">
                        <h2 t-if="state == 'multiple'">Sales Details</h2>
                        <h2 t-if="state == 'closed' or state == 'opened'" id="daily_report_title">
                            Daily Sales Report <t t-if="state == 'closed'">Z</t><t t-else="">X</t>
                        </h2>
                        <t t-if="session_name">
                            Session ID: <span t-out="session_name" />
                        </t>
                        <div t-if="state == 'opened'">
                            Opening Date: <t t-out="date_start" />
                        </div>
                        <div t-if="date_start and date_stop" style="white-space: nowrap;">
                            <t t-if="state == 'multiple'">Period: </t>
                            <t t-elif="state == 'closed'">Session: </t>
                            <span t-out="date_start" /> - <span t-out="date_stop" />
                        </div>
                    </div>
                </div>
            </div>
        </template>

        <template id="pos_session_sales_details_bar">
            <div class="row">
                <div class="col-12 text-end mt-2">
                    <span class="badge bg-light text-dark border border-dark p-2">
                        <strong> As of <span t-out="current_timestamp" /></strong>
                    </span>
                </div>
            </div>
            <div class="text-center mb-4" style="break-inside: avoid;">
                <t t-if="state == 'multiple' and len(config_names)">
                    <strong>Config names: </strong>
                    <t t-foreach="config_names" t-as="name">
                        <t t-out="name"/>
                        <t t-if="not name_last">, </t>
                    </t>
                </t>
            </div>
        </template>

        <template id="pos_session_sales_details_sales_section">
            <div t-if="len(products)" id="sales">
                <h6 class="bg-secondary p-1 fw-bold">Sales</h6>
                <div class="oe_structure" />
                <table class="table table-sm table-borderless">
                    <tbody>
                        <tr t-foreach="products" t-as="category" class="border-bottom border-secondary">
                            <td class="ps-2 fw-bold">
                                <span t-out="category['name']" />
                            </td>
                            <td colspan="2"/>
                            <td class="text-end fw-bold">
                                <span t-out="category['qty']" />
                            </td>
                            <td class="text-end fw-bold">
                                <t t-set="amount" t-value="category['total']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                            <tr t-foreach="category['products']" t-as="sales_line" class="border-bottom border-secondary">
                                <td class="ps-5">
                                    <span t-out="sales_line['product_name']" />
                                    <span t-if="sales_line['combo_products_label']" t-out="sales_line['combo_products_label']" />
                                </td>
                                <td />
                                <td class="text-end">
                                    <t t-if="sales_line['barcode']">
                                        <img t-att-src="'/report/barcode/Code128/'+sales_line['barcode']" style="width:230px; height:23px" alt="Barcode" />
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-out="sales_line['quantity']" />
                                    <t t-if="sales_line['uom'] != 'Units'">
                                        <span t-out="sales_line['uom']" />
                                    </t>
                                </td>
                                <td class="text-end">
                                    <t t-set="amount" t-value="sales_line['base_amount']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                    <t t-if='sales_line["discount"] != 0'>
                                        Disc: <span t-out='sales_line["discount"]' />%
                                    </t>
                                </td>
                            </tr>
                        </tr>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td colspan="2"/>
                            <td class="text-end">
                                <strong>
                                    <span t-out="products_info['qty']" />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="products_info['total']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </template>

        <template id="pos_session_sales_details_taxes_section">
            <div class="oe_structure" />
            <div t-if="len(taxes)" id="taxe_sales" style="page-break-inside: avoid;">
                <h6 class="bg-secondary p-1 fw-bold w-50 ms-auto">Taxes on sales</h6>
                <table class="table table-sm table-borderless w-50 ms-auto">
                    <tbody>
                        <tr t-foreach='taxes' t-as='tax' class="border-bottom border-secondary">
                            <td class="ps-2 fw-bold">
                                <span t-out="tax['name']" />
                            </td>
                            <td class="text-end">
                                <t t-set="amount" t-value="tax['tax_amount']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                            <td class="text-end">
                                <t t-set="amount" t-value="tax['base_amount']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="taxes_info['tax_amount']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="taxes_info['base_amount']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="oe_structure" />
            </div>
        </template>

        <template id="pos_session_sales_details_refunds_section">
            <div t-if="len(refund_products)" id="refunds">
                <h6 class="bg-secondary p-1 fw-bold">Refunds</h6>
                <table class="table table-sm table-borderless">
                    <tbody>
                        <tr t-foreach="refund_products" t-as="refund_category"
                            class="border-bottom border-secondary">
                            <td class="ps-2 fw-bold">
                                <span t-out="refund_category['name']" />
                            </td>
                            <td colspan="2" />
                            <td class="text-end fw-bold">
                                <span t-out="refund_category['qty']" />
                            </td>
                            <td class="text-end fw-bold">
                                <t t-set="amount" t-value="refund_category['total']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                            <tr t-foreach="refund_category['products']" t-as="refund_line" class="border-bottom border-secondary">
                                <td class="ps-5">
                                    <span t-out="refund_line['product_name']" />
                                    <span t-if="refund_line['combo_products_label']" t-out="refund_line['combo_products_label']" />
                                </td>
                                <td />
                                <td class="text-end">
                                    <t t-if="refund_line['barcode']">
                                        <img t-att-src="'/report/barcode/Code128/'+refund_line['barcode']" style="width:230px; height:23px" alt="Barcode" />
                                    </t>
                                </td>
                                <td class="text-end">
                                    <span t-out="refund_line['quantity']" />
                                    <t t-if='refund_line["uom"] != "Units"'>
                                        <span t-out='refund_line["uom"]' />
                                    </t>
                                </td>
                                <td class="text-end">
                                    <t t-set="amount" t-value="refund_line['base_amount']"/> 
                                    <t t-call="point_of_sale.format_currency" />
                                    <t t-if='refund_line["discount"] != 0'>
                                        Disc: <span t-out='refund_line["discount"]' />%
                                    </t>
                                </td>
                            </tr>
                        </tr>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td colspan="2" />
                            <td class="text-end">
                                <strong>
                                    <span t-out="refund_info['qty']" />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="refund_info['total']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="oe_structure" />
            </div>
        </template>

        <template id="pos_session_sales_details_refunds_taxes_section">
            <div t-if="len(refund_taxes)" id="taxe_refunds" style="page-break-inside: avoid;">
                <h6 class="bg-secondary p-1 fw-bold w-50 ms-auto">Taxes on refunds</h6>
                <table class="table table-sm table-borderless w-50 ms-auto">
                    <tbody>
                        <tr t-foreach='refund_taxes' t-as='refund_tax' class="border-bottom border-secondary">
                            <td class="ps-2 fw-bold">
                                <span t-out="refund_tax['name']" />
                            </td>
                            <td class="text-end">
                                <t t-set="amount" t-value="refund_tax['tax_amount']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                            <td class="text-end">
                                <t t-set="amount" t-value="refund_tax['base_amount']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="refund_taxes_info['tax_amount']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="refund_taxes_info['base_amount']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="oe_structure" />
            </div>
        </template>

        <template id="pos_session_sales_details_payments_section">
            <div class="oe_structure" />
            <div t-if="len(payments)" id="payments" style="page-break-inside: avoid;">
                <t t-if="payments" id="other_payments">
                    <h6 class="bg-secondary p-1 fw-bold w-50 ms-auto">Payments</h6>
                    <table class="table table-sm table-borderless w-50 ms-auto">
                        <tbody>
                            <tr t-foreach='payments' t-as='payment_item'>
                                <td class="ps-2 fw-bold">
                                    <span t-out="payment_item['name']" />
                                </td>
                                <td class="text-end">
                                    <t t-set="amount" t-value="payment_item['total']"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-sm table-borderless w-50 ms-auto border-top">
                        <tr class="fs-5">
                            <th class="ps-2 fw-bolder">Total</th>
                            <th class="text-end fw-bolder">
                                <t t-set="amount" t-value="currency['total_paid']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </th>
                        </tr>
                        <tr t-if="show_payment_per_method" t-foreach="payments_per_method" t-as="payment_method">
                            <td class="ps-2 fw-bold">
                                <t t-out="payment_method['name']" />
                            </td>
                            <td class="text-end">
                                <t t-set="amount" t-value="payment_method['total']"/>
                                <t t-call="point_of_sale.format_currency" />
                            </td>
                        </tr>
                    </table>
                    <div class="oe_structure" />
                </t>
            </div>
        </template>

        <template id="pos_session_sales_details_discounts_section">
            <div id="discounts" class="mb-2" style="break-inside: avoid; page-break-inside: avoid;">
                <h6 class="bg-secondary p-1 fw-bold">Discounts</h6>
                <div class="row">
                    <div class="col-12">
                        <strong>Number of discounts</strong>: <span t-out="discount_number" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <strong>Amount of discounts</strong>: 
                        <t t-set="amount" t-value="discount_amount"/>
                        <t t-call="point_of_sale.format_currency" />
                    </div>
                </div>
            </div>
        </template>

        <template id="pos_session_sales_details_invoices_section">
            <div t-if="invoiceTotal" id="invoices">
                <h6 class="bg-secondary p-1 fw-bold">Invoices</h6>
                <table class="table table-sm table-borderless">
                    <tbody>
                        <t t-foreach="invoiceList" t-as="invoice_session">
                            <t t-if="invoice_session['invoices']">
                                <tr t-foreach='invoice_session["invoices"]' t-as='invoice_item'>
                                    <td class="ps-2 fw-bold">
                                        <span t-out="invoice_item['name']" />
                                    </td>
                                    <td>
                                        <span t-out="invoice_item['order_ref']" />
                                    </td>
                                    <td class="text-end">
                                        <t t-set="amount" t-value="invoice_item['total']"/>
                                        <t t-call="point_of_sale.format_currency" />
                                    </td>
                                </tr>
                            </t>
                        </t>
                        <tr>
                            <td>
                                <strong>Total</strong>
                            </td>
                            <td />
                            <td class="text-end">
                                <strong>
                                    <t t-set="amount" t-value="invoiceTotal"/>
                                    <t t-call="point_of_sale.format_currency" />
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </template>

        <template id="pos_session_sales_details_session_control">
            <t id="closing_session">
                <h6 class="bg-secondary p-1 fw-bold">Session Control</h6>
                <div class="oe_structure" />
                <div style="break-inside: avoid;">
                    <t t-if="cash_rounding_total">
                        <strong>Cash Rounding: 
                            <t t-set="amount" t-value="cash_rounding_total"/>
                            <t t-call="point_of_sale.format_currency" />
                        </strong>
                        <br/>
                    </t>
                    <strong>Total: 
                        <t t-set="amount" t-value="currency['total_paid']"/>
                        <t t-call="point_of_sale.format_currency" />
                    </strong>
                    <br />
                    <strong>Number of transactions: <span t-out="nbr_orders" /></strong>
                </div>
                <br />
                <div class="oe_structure" />
                <table class="table table-sm table-borderless">
                    <thead>
                        <tr>
                            <th class="text-start">Name</th>
                            <th />
                            <th class="text-end">Expected</th>
                            <th t-if="(state == 'closed' or state == 'multiple') and len(payments)" class="text-end">
                                Counted
                            </th>
                            <th t-if="(state == 'closed' or state == 'multiple') and len(payments)" class="text-end">
                                Difference
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="payments" t-as="payment_method">
                            <t t-if="payment_method['count']">
                                <tr>
                                    <td>
                                        <strong>
                                            <span t-out="payment_method['name']" />
                                        </strong>
                                    </td>
                                    <td />
                                    <td class="text-end">
                                        <t t-set="amount" t-value="payment_method['final_count']"/>
                                        <t t-call="point_of_sale.format_currency" />
                                    </td>
                                    <td t-if="(state == 'closed' or state == 'multiple') and len(payments)" class="text-end">
                                        <t t-set="amount" t-value="payment_method['money_counted']"/>
                                        <t t-call="point_of_sale.format_currency" />
                                    </td>
                                    <td t-if="(state == 'closed' or state == 'multiple') and len(payments)" class="text-end">
                                        <t t-set="amount" t-value="payment_method['money_difference']"/>
                                        <t t-call="point_of_sale.format_currency" />
                                    </td>
                                </tr>
                                <tr t-if="(state == 'closed' or state == 'multiple') and len(payments)" t-foreach="payment_method['cash_moves']" t-as="cash_move">
                                    <td />
                                    <td>
                                        <span t-out="cash_move['name']" />
                                    </td>
                                    <td class="text-end">
                                        <t t-set="amount" t-value="cash_move['amount']"/>
                                        <t t-call="point_of_sale.format_currency" />
                                    </td>
                                    <td colspan="2"/>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>
                <div class="oe_structure" />
                <div t-if="opening_note or closing_note" class="mt-4" style="break-inside: avoid;">
                    <span t-if="opening_note" id="opening_note">
                        <strong>Opening of session note:</strong>
                        <span t-out="opening_note" />
                    </span>
                    <br />
                    <span t-if="closing_note" id="closing_note">
                        <strong>End of session note:</strong>
                        <span t-out="closing_note" />
                    </span>
                </div>
            </t>
        </template>

        <template id="format_currency">
            <t t-if="amount or amount == 0">
                <span t-if="not currency['position']" t-out="currency['symbol']"/>
                <span t-out="amount"/>
                <span t-if="currency['position']" t-out="currency['symbol']"/>
            </t>
        </template>
    </data>
</odoo>