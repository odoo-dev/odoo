<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The terminals of a payment method, the provider modules add the columns of their settings -->
    <record id="pos_payment_terminal_view_list" model="ir.ui.view">
        <field name="name">pos.payment.terminal.list</field>
        <field name="model">pos.payment.terminal</field>
        <field name="arch" type="xml">
            <list editable="bottom" open_form_view="True">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="pos_payment_terminal_view_form" model="ir.ui.view">
        <field name="name">pos.payment.terminal.form</field>
        <field name="model">pos.payment.terminal</field>
        <field name="arch" type="xml">
            <!-- The terminals are added from their payment method -->
            <form string="Payment Terminal" create="0">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Counter"/></h1>
                    </div>
                    <!-- The provider modules add their terminal settings -->
                    <group name="settings">
                        <field name="payment_method_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
