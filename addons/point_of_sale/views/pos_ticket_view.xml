<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- This is the "validation" screen. Recap the ticket info, warn the user to check/set his address and eventually set localization fields if needed. -->
    <template id="ticket_validation_screen">
        <t t-call="portal.portal_layout" no_breadcrumbs="True">
            <div class="row justify-content-md-center o_customer_address_fill">
                <form method="post" target="_self" t-att-action="'/pos/ticket/validate'" onsubmit="this.querySelector('#get_my_invoice > button').setAttribute('disabled', 'disabled')" class="address_autoformat">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="access_token" t-att-value="access_token"/>
                    <div class="col-12 col-md-6 mt-4 offset-md-3">
                        <div class="row">
                            <h2>Invoicing confirmation</h2>
                            <hr class="mt-1 mb-0"/>
                        </div>
                        <div class="row">
                            <h4 class="mt-2"><t t-out="pos_order.pos_reference"/></h4>
                        </div>
                        <div class="row">
                            <div class="col-12 fw-bold">
                                Products:
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <ul>
                                    <t t-foreach="pos_order.lines" t-as="order_line">
                                        <li><t t-out="int(order_line.qty)"/> <t t-out="order_line.full_product_name"/> for <t t-out="format_amount(env, order_line.price_subtotal_incl, order_line.currency_id)"/></li>
                                    </t>
                                </ul>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <strong>Amounting to:</strong> <t t-out="format_amount(env, pos_order.amount_total, pos_order.currency_id)"/>
                            </div>
                        </div>
                        <t t-if="user_is_connected">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <h4>Billing address:</h4>
                                </div>
                            </div>
                            <div t-if="error_message" class="alert alert-danger" role="alert">
                                <div class="col-lg-12">
                                    <t t-foreach="error_message" t-as="err"><t t-out="err"/><br /></t>
                                </div>
                            </div>
                            <t t-if="not partner_address">
                                Your address is missing or incomplete. <br/>
                                Please make sure to <a t-att-href="address_url">fill all relevant information</a> before continuing.
                            </t>
                            <t t-else="">
                                <div class="row">
                                    <div class="col-12">
                                        <t t-out="partner.name"/>
                                        <t t-if="partner.company_name">
                                            , <t t-out="partner.company_name"/>
                                        </t><br />
                                        <t id="partner_vat" t-if="partner.vat">
                                            <t t-out="partner.vat" /><br />
                                        </t>
                                        <t t-out="partner_address"/> <a role="button" t-att-href="address_url" class="btn btn-sm btn-link"><i class="oi oi-filled" data-icon="edit"/> Edit</a>
                                    </div>
                                </div>
                            </t>
                            <t t-if="partner_required_fields">
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h4>Additional required user information:</h4>
                                        <t t-set="required_fields" t-value="partner_required_fields"/>
                                        <t t-set="field_prefix" t-value="'partner_'"/>
                                        <t t-call="account.portal_invoice_required_fields_form"/>
                                    </div>
                                </div>
                            </t>
                            <t t-if="invoice_required_fields">
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <h4>Additional required invoicing information:</h4>
                                        <t t-set="required_fields" t-value="invoice_required_fields"/>
                                        <t t-set="field_prefix" t-value="'invoice_'"/>
                                        <t t-call="account.portal_invoice_required_fields_form"/>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="row mt-4">
                                <div class="col-12" id="get_info_div">
                                    <h4>Please enter your billing information <small class="text-muted">or</small> <a role="button" t-att-href="'/web/login?redirect=/pos/ticket/validate?access_token=%s' % access_token" style="margin-top: -11px"> Sign in</a>:</h4>
                                </div>
                            </div>
                            <div class="row portal_details">
                                <div class="col-lg-12">
                                    <div class="row">
                                        <t t-call="portal.address_form_fields"/>
                                        <t t-if="partner_required_fields">
                                            <t t-set="required_fields" t-value="partner_required_fields"/>
                                            <t t-set="field_prefix" t-value="'partner_'"/>
                                            <t t-call="account.portal_invoice_required_fields_form"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <t t-if="invoice_required_fields">
                                <div class="row mt-4">
                                    <div class="col-12">
                                        <div class="row">
                                            <h4>Additional required information:</h4>
                                            <t t-set="required_fields" t-value="invoice_required_fields"/>
                                            <t t-set="field_prefix" t-value="'invoice_'"/>
                                            <t t-call="account.portal_invoice_required_fields_form"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                        <div class="row mt-4">
                            <div class="col-12 col-md-4" id="get_my_invoice">
                                <t t-if="user_is_connected and not partner_address">
                                    <button class="btn btn-primary btn-lg lh-lg w-100" disabled="True">Get my invoice</button>
                                </t>
                                <t t-else="">
                                    <button class="btn btn-primary btn-lg lh-lg w-100">Get my invoice</button>
                                </t>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="ticket_request_with_code" name="Invoice Request">
        <t t-call="portal.portal_layout" no_breadcrumbs="True">
            <div class="row justify-content-md-center">
                <form method="post" target="_self" t-att-action="'/pos/ticket'">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-12 col-md-6 mt-4 offset-md-3">
                        <div class="row">
                            <div t-if="banner_error" class="alert alert-danger" role="alert">
                                <div class="col-lg-12">
                                    <t t-out="banner_error"/>
                                </div>
                            </div>
                            <h2>Invoice Request</h2>
                            <hr class="mt-1 mb-0"/>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="row">
                                        <div t-attf-class="col-12 mb-6 col-xl-8">
                                            <label class="col-form-label" for="pos_reference">Ticket Nr</label>
                                            <input type="text" name="pos_reference" placeholder="0014-001-00001"
                                                   t-attf-class="form-control #{errors.get('pos_reference') and 'is-invalid' or ''}"
                                                   t-att-value="form_values.get('pos_reference')"/>
                                            <label class="col-form-label" for="date_order">Date</label>
                                            <input type="date" name="date_order"
                                                   t-attf-class="form-control #{errors.get('date_order') and 'is-invalid' or ''}"
                                                   t-att-value="form_values.get('date_order')"/>
                                            <label class="col-form-label" for="ticket_code">Unique code</label>
                                            <input type="text" name="ticket_code" placeholder="qx9h1"
                                                   t-attf-class="form-control #{errors.get('ticket_code') and 'is-invalid' or ''}"
                                                   t-att-value="form_values.get('ticket_code')"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-4">
                                <div class="col-12">
                                    <button class="btn btn-primary">Request Invoice</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="ticket_action_selector" name="Ticket Action Selection">
        <t t-call="portal.portal_layout" no_breadcrumbs="True">
            <div class="o_action_selector_page d-flex align-items-center py-5 px-3">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-6">

                            <div class="text-center o_action_header mb-4">
                                <!-- <div class="o_action_brand mb-3">
                                    <i class="fa fa-check-circle fa-2x text-success"/>
                                </div> -->
                                <p class="o_action_greeting text-muted mb-1" t-if="pos_order.partner_id">
                                    Welcome back, <strong t-out="pos_order.partner_id.name"/>
                                </p>
                                <h2 class="o_action_title fw-semibold mb-2">How can we help you?</h2>
                                <p class="text-muted o_action_order_ref">
                                    Order <strong t-out="pos_order.name"/>
                                </p>
                            </div>

                            <form method="get" action="/pos/ticket/action_selector">
                                <input type="hidden" name="access_token" t-att-value="access_token"/>

                                <div class="row g-4 mt-1">
                                    <div class="col-12 col-md-6">
                                        <button type="submit"
                                                name="action"
                                                value="invoice"
                                                class="w-100 border-0 bg-transparent p-0 o_action_btn">
                                            <div class="card h-100 o_action_card o_card_invoice">
                                                <div class="card-body text-center p-4">
                                                    <div class="o_action_icon_wrapper mb-3">
                                                        <i class="oi oi-fw oi-3x" data-icon="download"/>
                                                        <!-- <i class="fa fa-file-invoice fa-3x"/> -->
                                                    </div>
                                                    <h5 class="card-title fw-semibold mb-2">Get Invoice</h5>
                                                    <p class="text-muted mb-0 small">
                                                        Download or receive your invoice by email
                                                    </p>
                                                </div>
                                            </div>
                                        </button>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <button type="submit"
                                                name="action"
                                                value="feedback"
                                                class="w-100 border-0 bg-transparent p-0 o_action_btn">
                                            <div class="card h-100 o_action_card o_card_feedback">
                                                <div class="card-body text-center p-4">
                                                    <div class="o_action_icon_wrapper mb-3">
                                                        <i class="oi oi-fw oi-3x" data-icon="star_half"/>
                                                    </div>
                                                    <h5 class="card-title fw-semibold mb-2">Share Feedback</h5>
                                                    <p class="text-muted mb-0 small">
                                                        Rate your experience and help us improve
                                                    </p>
                                                </div>
                                            </div>
                                        </button>
                                    </div>
                                </div>
                            </form>

                        </div>
                    </div>
                </div>
            </div>

        </t>
    </template>
    <template id="ticket_feedback_demo" name="POS Ticket Feedback">
        <t t-call="portal.portal_layout" no_breadcrumbs="True">

            <div class="o_feedback_page d-flex align-items-center py-5 px-3">
                <div class="container">
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-6 col-lg-5">

                            <div class="o_feedback_card">
                                <div class="text-center mb-4">
                                    <div class="o_feedback_icon mb-3">
                                        <i class="oi oi-filled oi-2x" data-icon="favorite"/>
                                    </div>
                                    <h2 class="o_feedback_title fw-bold mb-1">We'd love your feedback</h2>
                                    <p class="text-muted mb-0">
                                        How was your experience with us?
                                    </p>
                                </div>

                                <form method="post" action="/pos/ticket/feedback" class="text-center">
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="access_token"
                                        t-att-value="access_token"/>

                                    <div class="o_star_rating mb-4">
                                        <input type="radio" id="star5" name="rating" value="5" checked="1" class="o_star_input"/>
                                        <label for="star5" class="o_star_label">&#9733;</label>

                                        <input type="radio" id="star4" name="rating" value="4" class="o_star_input"/>
                                        <label for="star4" class="o_star_label">&#9733;</label>

                                        <input type="radio" id="star3" name="rating" value="3" class="o_star_input"/>
                                        <label for="star3" class="o_star_label">&#9733;</label>

                                        <input type="radio" id="star2" name="rating" value="2" class="o_star_input"/>
                                        <label for="star2" class="o_star_label">&#9733;</label>

                                        <input type="radio" id="star1" name="rating" value="1" class="o_star_input"/>
                                        <label for="star1" class="o_star_label">&#9733;</label>
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label fw-semibold small text-muted text-uppercase">Tell us more</label>
                                        <textarea name="feedback"
                                                rows="4"
                                                required="1"
                                                placeholder="What did you enjoy? What could we do better?"
                                                class="form-control o_feedback_textarea"></textarea>
                                    </div>

                                    <button type="submit" class="btn o_feedback_submit w-100">
                                        <i class="oi oi-filled me-2" data-icon="send" />
                                        Submit Feedback
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </t>
    </template>
<template id="ticket_feedback_thankyou" name="Feedback Submitted">
    <t t-call="portal.portal_layout" no_breadcrumbs="True">

        <div class="o_thankyou_page d-flex align-items-center py-5 px-3">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-12 col-md-6 col-lg-5">

                        <div class="o_thankyou_card text-center">
                            <div class="o_thankyou_check mb-3">
                                <i class="oi oi-filled oi-3x" data-icon="check"/>
                            </div>
                            <h2 class="o_thankyou_title fw-bold mb-2">Thank you!</h2>
                            <p class="text-muted o_thankyou_message mb-4 mx-auto">
                                Your feedback has been received. We truly appreciate you taking the time to share your thoughts with us.
                            </p>
                            <div class="d-flex flex-column gap-3">
                                <a t-if="access_token"
                                   t-att-href="'/pos/ticket/action_selector?access_token=%s' % access_token"
                                   class="btn o_btn_primary text-white">
                                    <i class="oi oi-arrow-left me-2"/>
                                    Actions
                                </a>
                                <a href="/"
                                   class="btn o_btn_secondary">
                                    Done
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </t>
</template>

</odoo>
