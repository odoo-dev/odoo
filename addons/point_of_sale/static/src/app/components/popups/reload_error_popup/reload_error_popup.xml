<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

  <t t-name="point_of_sale.ReloadErrorPopup">
  <Dialog size="'md'" title="props.title">
    <p t-out="props.body" class="text-prewrap"/>
    <t t-set-slot="footer">
      <button class="button btn btn-primary" t-on-click="_confirm">OK</button>
      <button class="button btn btn-secondary" t-on-click="_reload">Reload Data</button>
    </t>
  </Dialog>
</t>


</templates>
