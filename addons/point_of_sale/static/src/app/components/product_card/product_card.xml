<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.ProductCard">
        <article tabindex="0"
            t-on-mousedown="onMouseDown"
            t-on-touchstart="onTouchStart"
            t-on-mouseup="longPressHandlers.onMouseUp"
            t-on-touchend="longPressHandlers.onTouchEnd"
            t-att-class="containerClasses"
            t-attf-class="{{props.class}} product position-relative btn btn-light d-flex align-items-stretch p-0 rounded-3 text-start cursor-pointer"
            t-on-keypress="(event) => event.code === 'Space' ? props.onClick(event) : ()=>{}"
            t-on-click.stop="props.onClick"
            t-att-data-product-id="product.id"
            t-attf-aria-labelledby="article_product_{{product.id}}">
            <div t-if="productImage" class="product-img ratio ratio-4x3 rounded-top rounded-3">
                <img class="w-100 object-fit-cover bg-200 pe-none"
                    t-att-src="productImage"
                    t-att-alt="product.display_name"
                    draggable="false" />
            </div>
            <div class="product-content h-100 px-2 rounded-bottom-3 flex-shrink-1" t-att-class="productContentClasses">
                <div class="overflow-hidden lh-sm product-name"
                    t-att-class="productNameClasses"
                    t-attf-id="article_product_{{props.productId}}"
                    t-esc="product.display_name" />
                <span t-if="cartQty !== 0"
                    t-out="cartQty"
                    class="product-cart-qty position-absolute bottom-0 end-0 m-1 px-2 rounded bg-black text-white fs-5 fw-bolder"
                    t-att-class="{'text-danger': cartQty lt 0}" />
            </div>
            <span t-if="props.extraPrice"
                style="font-size: 0.75rem;"
                class="price-extra px-2 py-0 rounded-pill text-bg-info position-absolute top-0 end-0 mt-1 me-1"
                t-esc="props.extraPrice" />

            <!-- Ripple effect on long press for product info -->
            <div class="ripple-container position-absolute start-0 w-100 pe-none overflow-hidden">
                <div class="ripple bg-dark" t-att-style="this.state.longPressStyle" />
            </div>

            <!-- Custom slots used in combo configurator -->
            <t t-slot="footer" />
        </article>
    </t>
</templates>
