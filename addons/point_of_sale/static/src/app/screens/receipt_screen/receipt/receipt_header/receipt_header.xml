<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.ReceiptHeader">
        <img t-attf-src="/web/image?model=res.company&amp;id={{order.company.id}}&amp;field=logo" alt="Logo" class="pos-receipt-logo"/>
        <br/>
        <div class="d-flex flex-column">
            <div class="pos-receipt-contact align-items-center">
                <div t-esc="order.pos_reference" />
                <div id="order-date" t-esc="order.formatDateOrTime('date_order')" />
                <div t-if="order.config.receipt_header" style="white-space:pre-line" t-esc="order.config.receipt_header" />
                <div t-if="order?.getCashierName() and order.preset_id?.identification === 'name'" class="cashier">
                    <div>--------------------------------</div>
                    <div>Served by: <t t-esc="order.getCashierName()" /></div>
                </div>
            </div>
            <div t-if="order.preset_id?.identification !== 'none'" class="preset d-flex flex-column align-items-left">
                <t t-if="order.preset_id?.identification === 'name'">
                    Takeout for: <t t-esc="order.floatingOrderName" />
                </t>
                <t t-if="order.presetTime">
                    Preset: <t t-esc="order.presetTime" /> <br/>
                </t>
                <t t-if="order.preset_id?.identification === 'address'">
                    <span t-esc="order.partner_id?.name"/>
                    <span t-foreach="partnerAddress" t-as="line" t-key="line_index">
                        <t t-esc="line"/>
                    </span>
                </t>
            </div>
        </div>
        <br />
    </t>
</templates>
