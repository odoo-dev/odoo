<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="point_of_sale.TicketScreen">
        <div class="ticket-screen screen h-100 bg-100" t-att-class="{'loading-orders': this.pos.loadingOrderState}">
            <div class="screen-full-width d-flex w-100 h-100">
                <t t-set="usePreset" t-value="this.pos.config.use_presets and this.pos.models['pos.preset'].length > 1" />
                <div t-if="!this.ui.isSmall || this.pos.ticket_screen_mobile_pane === 'left'" class="rightpane pane-border d-flex flex-column flex-grow-1 w-100 h-100 h-lg-100 pe-lg-0 bg-view border-end overflow-y-auto">
                    <div class="controls d-flex flex-column gap-2 p-2 border-bottom bg-view" t-if="usePreset">
                        <div class="filter-buttons buttons d-flex gap-1 overflow-auto">
                            <button t-foreach="this.pos.models['pos.preset'].getAll()" t-as="preset" t-key="preset.id"
                                class="btn btn-lg btn-secondary text-nowrap" t-on-click="() => this.onPresetSelected(preset)"
                                t-att-class="{'active': this.state.selectedPreset === preset}">
                                <t t-out="preset.name"/>
                            </button>
                        </div>
                    </div>
                    <div class="orders overflow-hidden flex-grow-1 rounded-bottom-3 bg-view">
                        <View t-props="this.orderKanbanViewProps" />
                    </div>
                    <div class="switchpane d-flex gap-2 m-2" t-if="this.ui.isSmall">
                        <t t-set="_selectedSyncedOrder" t-value="this.getSelectedOrder()" />
                        <button class="btn-switchpane load-order-button primary btn btn-primary btn-lg lh-lg w-50 py-3"
                            t-att-disabled="!_selectedSyncedOrder"
                            t-if="!this.isOrderSynced"
                            t-on-click="() => this.setOrder(_selectedSyncedOrder)">
                            <span class="d-block">Load Order</span>
                        </button>
                        <button class="btn-switchpane btn btn-lg lh-lg py-3 btn-secondary review-button" t-att-class="this.isOrderSynced ? 'w-100 btn-primary' : 'w-50 btn-secondary'" t-on-click="this.switchPane">
                            <span class="d-block">Review</span>
                        </button>
                    </div>
                </div>
                <!-- Hide the cart pane if no orders to list after having a search term -->
                <div t-if="(!this.ui.isSmall || this.pos.ticket_screen_mobile_pane === 'right')" class="leftpane d-flex flex-column flex-grow-1 gap-2 w-100 h-100 h-lg-100 bg-view">
                    <t t-set="_selectedSyncedOrder" t-value="this.getSelectedOrder()" />
                    <t t-set="_selectedOrderlineId" t-value="this.getSelectedOrderlineId()" />
                    <t t-if="_selectedSyncedOrder?.getOrderlines()?.length and !this.pos.scanning" >
                        <div t-if="this.isOrderSynced" t-att-class="{ 'highlight text-danger': !this.getHasItemsToRefund() }" class="py-2 px-3 rounded-3 bg-view text-center">
                            Select the product(s) to refund and set the quantity
                        </div>
                        <OrderDisplay order="_selectedSyncedOrder" t-if="_selectedSyncedOrder" t-slot-scope="scope">
                            <t t-set="line" t-value="scope.line" />
                            <t t-set="qty" t-value="line.order_id?.uiState?.lineToRefund?.[line.uuid]?.qty" />
                            <Orderline line="line" t-on-click="() => this.onClickOrderline(line)" toRefund="qty" class="{'selected': line.id === _selectedOrderlineId}">
                                <t t-set="toRefundDetail" t-value="line.order_id?.uiState?.lineToRefund?.[line.uuid]" />
                                <li t-if="!this.pos.isProductQtyZero(line.refundedQty)"
                                    class="info refund-note mt-1">
                                    <strong t-out="this.env.utils.formatProductQty(line.refundedQty, false)" />
                                    <span> Refunded</span>
                                </li>
                            </Orderline>
                        </OrderDisplay>
                        <div class="pads">
                            <t t-if="this.isOrderSynced">
                                <div class="control-buttons d-flex gap-2 pb-2">
                                    <button class="edit-order-payment control-button btn btn-secondary btn-lg lh-lg flex-grow-1 flex-shrink-1" t-on-click="() => this.pos.showOrderDetails(_selectedSyncedOrder)">
                                        <i class="fa fa-pencil-square-o me-1" /> Details
                                    </button>
                                    <InvoiceButton
                                        onInvoiceOrder.bind="this.onInvoiceOrder"
                                        order="_selectedSyncedOrder" />
                                    <button class="control-button btn btn-secondary btn-lg lh-lg flex-grow-1 flex-shrink-1" t-on-click="() => this.doPrint.call(_selectedSyncedOrder)">
                                        <i t-attf-class="fa {{this.doPrint.status === 'loading' ? 'fa-fw fa-spin fa-circle-o-notch' : 'fa-print'}} me-1" />Print Receipt
                                    </button>
                                </div>
                                <div class="subpads d-flex flex-column">
                                    <Numpad class="'pb-2'" buttons="this.getNumpadButtons()"/>
                                        <ActionpadWidget
                                            partner="this.getSelectedOrder()?.getPartner()"
                                            buttonClasses="this.buttonClasses"
                                            actionName.translate="Refund"
                                            actionToTrigger.bind="this.onDoRefund"
                                        />
                                </div>
                            </t>
                            <div t-else="" class="pads d-flex gap-2 m-2 mt-0" >
                                <BackButton t-if="this.ui.isSmall" onClick="() => this.pos.onClickBackButton()"/>
                                <button class="button btn btn-secondary btn-lg d-flex flex-row align-items-center justify-content-center"
                                    t-on-click="() => this.onClickReprintAll(_selectedSyncedOrder)"
                                    t-if="this.pos.ticketPrinter.hasPreparationPrinters and _selectedSyncedOrder.uiState.lastPrints.length">
                                    <i class="fa fa-cutlery" aria-hidden="true"/>
                                </button>
                                <button class="button validation load-order-button w-100 btn btn-lg btn-primary py-3"
                                    t-att-disabled="!_selectedSyncedOrder"
                                    t-on-click="() => this.setOrder(_selectedSyncedOrder)">
                                    <span class="d-block">Load Order</span>
                                </button>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <BarcodeVideoScanner t-if="this.pos.scanning" onError.bind="()=>{}" onResult.bind="this.onClickScanOrder" facingMode="'environment'"/>
                        <CenteredIcon t-if="!this.pos.scanning" icon="'fa-shopping-cart fa-4x'" text.translate="Select an order or scan QR code" class="'bg-100 h-100 rounded'"/>
                        <BackButton t-if="this.ui.isSmall" onClick="() => this.pos.onClickBackButton()"/>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
