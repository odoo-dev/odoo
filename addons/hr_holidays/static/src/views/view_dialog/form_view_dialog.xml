<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="hr_holidays.FormViewDialog.Buttons.Save">
        <button
            class="btn btn-primary o_form_button_save"
            t-on-click="saveButtonClicked"
            data-hotkey="q">
            <span t-if="this.record.isNew">Submit Request</span>
            <span t-else="">Save</span>
        </button>
    </t>

    <t t-name="hr_holidays.FormViewDialog.Buttons.Discard">
        <button type="button"
                class="btn btn-secondary o_form_button_cancel"
                data-hotkey="j"
                t-on-click.stop="discard">
            Discard
        </button>
    </t>

    <t t-name="hr_holidays.FormViewDialog.Buttons.Approve">
        <button
            t-attf-class="btn #{canSave ? 'btn-secondary': 'btn-primary'}"
            t-on-click="() => this.onClick('action_approve')"
            data-hotkey="x">Approve</button>
    </t>

    <t t-name="hr_holidays.FormViewDialog.Buttons.Validate">
        <button
            t-attf-class="btn #{canSave ? 'btn-secondary': 'btn-primary'}"
            t-on-click="() => this.onClick('action_approve')"
            data-hotkey="x">Validate</button>
    </t>

    <t t-name="hr_holidays.FormViewDialog.Buttons.Refuse">
        <button
            t-attf-class="btn #{(canValidate or canApprove) ? 'btn-secondary' : 'btn-primary'}"
            t-on-click="() =>this.onClick('action_refuse')"
            data-hotkey="x">Refuse</button>
    </t>

    <t t-name="hr_holidays.FormViewDialog.Buttons.DeleteTimeOff">
        <button class="btn btn-danger" t-on-click="deleteRecord" data-hotkey="v">
            Delete Time Off
        </button>
    </t>

    <t t-name="hr_holidays.FormViewDialog.Buttons.CancelTimeOff">
        <button class="btn btn-danger" t-on-click="cancelRecord" data-hotkey="x">
            Cancel Time Off
        </button>
    </t>

</templates>
