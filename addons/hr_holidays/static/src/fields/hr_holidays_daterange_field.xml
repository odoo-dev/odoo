<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_holidays.HrHolidaysDateRangeField"
       t-inherit="web.DateTimeField"
       t-inherit-mode="extension">

        <!-- Insert Start Period next to Start Date -->
        <xpath expr="//*[@t-ref='start-date']" position="after">
            <select t-if="props.startPeriodField"
                    t-on-change="onChangeStartPeriod"
                    class="o_input ms-2">
                <option value="am" t-att-selected="startPeriod == 'am'">Morning</option>
                <option value="pm" t-att-selected="startPeriod == 'pm'">Afternoon</option>
            </select>
        </xpath>

        <!-- Insert End Period next to End Date -->
        <xpath expr="//*[@t-ref='end-date']" position="after">
            <select t-if="props.endPeriodField"
                    t-on-change="onChangeEndPeriod"
                    class="o_input ms-2">
                <option value="am" t-att-selected="endPeriod == 'am'">Morning</option>
                <option value="pm" t-att-selected="endPeriod == 'pm'">Afternoon</option>
            </select>
        </xpath>

    </t>
</templates>

