<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_document_type_form" model="ir.ui.view">
        <field name="name">l10n_cl.document.type.form</field>
        <field name="model">l10n_cl.document.type</field>
        <field name="arch" type="xml">
            <form string="Document Type">
                <group>
                    <field name='code'/>
                    <field name="name"/>
                    <field name='doc_code_prefix'/>
                    <field name='report_name'/>
                    <field name="move_domain" widget="domain" options="{'model': 'account.move'}"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_document_type_tree" model="ir.ui.view">
        <field name="name">l10n_cl.document.type.list</field>
        <field name="model">l10n_cl.document.type</field>
        <field name="arch" type="xml">
            <list string="Document Type" decoration-muted="(not active)" create="0" edit="0">
                <field name="code"/>
                <field name="name"/>
                <field name="doc_code_prefix"/>
                <field name='report_name'/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_document_type">
        <field name="name">Document Types</field>
        <field name="res_model">l10n_cl.document.type</field>
        <field name="domain">['|', ('active', '=', True), ('active', '=', False)]</field>
        <field name="context">{"search_default_active":1}</field>
    </record>

    <menuitem action="action_document_type" id="menu_document_type" sequence="20" parent="account.account_account_menu"/>

</odoo>
