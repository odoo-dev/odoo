<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_neoleap" model="payment.provider">
        <field name="code">neoleap</field>
        <field name="name">NeoLeap</field>
        <field name="module_id" ref="base.module_payment_neoleap"/>
        <field name="image_128" type="base64" file="payment_neoleap/static/description/icon.png"/>
        <field name="state">disabled</field>
        <field name="capture_manually">False</field>
        <field name="payment_method_ids"
               eval="[Command.set([
                            ref('payment.payment_method_card'),
                            ref('payment.payment_method_mada'),
                     ])]"
        />
        <field name="redirect_form_view_id" ref="redirect_form"/>
    </record>
</odoo>
