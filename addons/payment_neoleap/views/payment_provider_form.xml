<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_neoleap" model="ir.ui.view">
        <field name="name">NeoLeap Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group name="neoleap_credentials" string="NeoLeap Credentials" invisible="code != 'neoleap'">
                    <field name="neoleap_tranportal_id" required="code == 'neoleap' and state != 'disabled'"/>
                    <field name="neoleap_password" required="code == 'neoleap' and state != 'disabled'" password="True"/>
                    <field name="neoleap_resource_key" required="code == 'neoleap' and state != 'disabled'" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>
