                                <field name="label">base</field>
                                <field name="engine">aggregation</field>
                                <field name="formula">uz_9.base + uz_10.base + uz_11.base</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_vat12_uz_9" model="account.report.line">
                        <field name="name">040 Zero-rated turnover</field>
                        <field name="name@uz">Nol stavka boʻyicha soliqqa tortiladigan aylanma</field>
                        <field name="name@ru">Реализация товаров (услуг), облагаемых по нулевой ставке</field>
                        <field name="code">uz_9</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_vat12_uz_9_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-9(B)</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_vat12_uz_10" model="account.report.line">
                        <field name="name">041 Export turnover</field>
                        <field name="name@uz">Eksport aylanmasi</field>
                        <field name="name@ru">Экспорт товаров (услуг)</field>
                        <field name="code">uz_10</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_vat12_uz_10_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-3(B)</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_vat12_uz_11" model="account.report.line">
                        <field name="name">0478 0% VAT - agriculture</field>
                        <field name="name@uz">QQS 0% - qishloq xoʻjaligi mahsulotlari</field>
                        <field name="name@ru">0% НДС - сельхозпродукция</field>
                        <field name="code">uz_11</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_vat12_uz_11_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-11(B)</field>
                            </record>
                        </field>
                    </record>
