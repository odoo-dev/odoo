<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_uz_tax_report_turnover" model="account.report">
        <field name="name">Turnover Tax Report - Form 10104_26</field>
        <field name="name@uz">Aylanmadan olinadigan soliq hisoboti - 10104_26 shakli</field>
        <field name="name@ru">Отчет по налогу с оборота - Форма 10104_26</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>
        <field name="country_id" ref="base.uz"/>
        <field name="availability_condition">country</field>
        <field name="column_ids">
            <record id="l10n_uz_tr_turnover_column_base" model="account.report.column">
                <field name="name">Taxable Turnover excl. VAT</field>
                <field name="name@uz">QQSsiz soliq solinadigan aylanma</field>
                <field name="name@ru">Облагаемый оборот без НДС</field>
                <field name="expression_label">base</field>
            </record>
            <record id="l10n_uz_tr_turnover_column_tax" model="account.report.column">
                <field name="name">Tax Amount</field>
                <field name="name@uz">Soliq summasi</field>
                <field name="name@ru">Сумма налога</field>
                <field name="expression_label">tax</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="l10n_uz_tr_turnover_uz_sv001" model="account.report.line">
                <field name="name">Total income</field>
                <field name="name@uz">Jami daromad</field>
                <field name="name@ru">Общая сумма дохода</field>
                <field name="code">uz_sv001</field>
                <field name="expression_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv001_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">uz_sv1.base + uz_sv2.base + uz_sv3.base + uz_sv4.base + uz_sv5.base + uz_sv6.base</field>
                    </record>
                </field>
            </record>
            <record id="l10n_uz_tr_turnover_uz_sv002" model="account.report.line">
                <field name="name">Other income</field>
                <field name="name@uz">Boshqa daromadlar</field>
                <field name="name@ru">Прочие доходы</field>
                <field name="code">uz_sv002</field>
                <field name="expression_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv002_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">domain</field>
                        <field name="formula">[('account_id.account_type', '=', 'income_other')]</field>
                        <field name="subformula">-sum</field>
                    </record>
                </field>
            </record>
            <record id="l10n_uz_tr_turnover_uz_sv003" model="account.report.line">
                <field name="name">Total taxable income</field>
                <field name="name@uz">Soliq solinadigan jami daromad</field>
                <field name="name@ru">Совокупный налогооблагаемый доход</field>
                <field name="code">uz_sv003</field>
                <field name="expression_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv003_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">uz_sv001.base + uz_sv002.base - uz_sv7.base</field>
                    </record>
                </field>
            </record>
            <record id="l10n_uz_tr_turnover_uz_sv004" model="account.report.line">
                <field name="name">Rate</field>
                <field name="name@uz">Soliq stavkasi</field>
                <field name="name@ru">Ставка</field>
                <field name="code">uz_sv004</field>
                <field name="expression_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv004_base" model="account.report.expression">
                        <field name="label">base</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">4</field>
                        <field name="subformula" eval="False"/>
                        <field name="figure_type">percentage</field>
                    </record>
                </field>
            </record>
            <record id="l10n_uz_tr_turnover_uz_sv005" model="account.report.line">
                <field name="name">Tax payable</field>
                <field name="name@uz">To'lanadigan soliq summasi</field>
                <field name="name@ru">Сумма налога к уплате</field>
                <field name="code">uz_sv005</field>
                <field name="expression_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv005_tax" model="account.report.expression">
                        <field name="label">tax</field>
                        <field name="engine">aggregation</field>
                        <field name="formula">uz_sv003.base * uz_sv004.base / 100</field>
                    </record>
                </field>
            </record>
            <record id="l10n_uz_tr_turnover_title_attachment_1" model="account.report.line">
                <field name="name">Attachment 1 - Total Income</field>
                <field name="name@uz">1-ILOVA — «Jami daromad»</field>
                <field name="name@ru">ПРИЛОЖЕНИЕ №1 — «Общий доход»</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv1" model="account.report.line">
                        <field name="name">0101 Sales via electronic invoices</field>
                        <field name="name@uz">EHF orqali olingan daromad</field>
                        <field name="name@ru">Доход от электронных счетов-фактур</field>
                        <field name="code">uz_sv1</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv1_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-SV1</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_turnover_uz_sv2" model="account.report.line">
                        <field name="name">0102 Sales via online cash registers</field>
                        <field name="name@uz">Onlayn-NKM orqali olingan daromad</field>
                        <field name="name@ru">Доход от онлайн-ККМ</field>
                        <field name="code">uz_sv2</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv2_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-SV2</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_turnover_uz_sv3" model="account.report.line">
                        <field name="name">0103 Export sales</field>
                        <field name="name@uz">Eksportdan olingan daromad</field>
                        <field name="name@ru">Доходы от экспорта</field>
                        <field name="code">uz_sv3</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv3_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-SV3</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_turnover_uz_sv4" model="account.report.line">
                        <field name="name">0104 Sales via online marketplaces</field>
                        <field name="name@uz">Onlayn savdo maydonchalari orqali savdo</field>
                        <field name="name@ru">Доход от реализации товаров (услуг) через Marketplace</field>
                        <field name="code">uz_sv4</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv4_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-SV4</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_turnover_uz_sv5" model="account.report.line">
                        <field name="name">0105 Other taxable sales</field>
                        <field name="name@uz">Boshqa daromadlar</field>
                        <field name="name@ru">Прочие доходы</field>
                        <field name="code">uz_sv5</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv5_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-SV5</field>
                            </record>
                        </field>
                    </record>
                    <record id="l10n_uz_tr_turnover_uz_sv6" model="account.report.line">
                        <field name="name">0301-0306 Deemed-sale income</field>
                        <field name="name@uz">Realizatsiya sifatida qaraladigan daromadlar</field>
                        <field name="name@ru">Доходы, рассматриваемые в качестве реализации</field>
                        <field name="code">uz_sv6</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv6_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">tax_tags</field>
                                <field name="formula">-SV6</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
            <record id="l10n_uz_tr_turnover_title_attachment_2" model="account.report.line">
                <field name="name">Attachment 2 - Reductions of Taxable Base</field>
                <field name="name@uz">2-ILOVA — «Soliq bazasini kamaytirish»</field>
                <field name="name@ru">ПРИЛОЖЕНИЕ №2 — «Уменьшение налоговой базы»</field>
                <field name="hierarchy_level">0</field>
                <field name="children_ids">
                    <record id="l10n_uz_tr_turnover_uz_sv7" model="account.report.line">
                        <field name="name">Deductions and benefits, reducing the taxable base</field>
                        <field name="name@uz">Soliq bazasini kamaytiradigan chegirmalar va imtiyozlar</field>
                        <field name="name@ru">Вычеты и льготы, уменьшающие налоговую базу</field>
                        <field name="code">uz_sv7</field>
                        <field name="expression_ids">
                            <record id="l10n_uz_tr_turnover_uz_sv7_base" model="account.report.expression">
                                <field name="label">base</field>
                                <field name="engine">external</field>
                                <field name="formula">sum</field>
                                <field name="subformula">editable;rounding=2</field>
                            </record>
                        </field>
                    </record>
                </field>
            </record>
        </field>
    </record>
</odoo>
