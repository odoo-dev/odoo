<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_stripe" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.stripe</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <page name="terminals" position="attributes">
                <attribute name="invisible" add="payment_provider == 'stripe'" separator=" or "/>
            </page>
            <page name="terminals" position="before">
                <page name="stripe_settings" string="Stripe" invisible="payment_provider != 'stripe'">
                    <group>
                        <div colspan="2" class="mt16" invisible="payment_provider != 'stripe'" required="payment_provider == 'stripe'">
                            <button name="action_stripe_key" type="object" icon="east" string="Don't forget to complete Stripe connect before using this payment method." class="btn-link"/>
                        </div>
                    </group>
                    <separator string="Terminals"/>
                    <field name="terminal_ids" widget="pos_payment_terminals"/>
                </page>
            </page>
        </field>
    </record>
</odoo>
