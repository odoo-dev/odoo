<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="website.Configurator.SkipButton">
        <div class="container-fluid py-2 pb-md-3 text-end pe-lg-5">
            <button class="btn btn-link btn-lg" t-on-click="this.props.skip">Skip and start from scratch</button>
        </div>
    </t>

    <t t-name="website.Configurator.WelcomeScreen">
        <div class="o_configurator_screen h-100 d-flex flex-column o_welcome_screen">
            <div class="o_configurator_screen_content d-flex h-100">
                <div class="container align-self-center o_configurator_show">
                    <div class="display-2 mb-2">Ready to build the <br class="d-none d-lg-inline"/>
                    <b>perfect website?</b>
                </div>
                <div class="h1 fw-light mb-4 text-600">We'll set you up and running in <b>4 steps</b>
                </div>
                <button class="o_configurator_show btn btn-primary btn-lg px-4 py-2" t-on-click="this.goToDescription">Let's do it</button>
            </div>
        </div>
        <SkipButton skip="this.props.skip"/>
    </div>
</t>

<t t-name="website.Configurator.DescriptionScreen">
    <div class="o_configurator_screen h-100 d-flex flex-column o_description_screen"
         t-on-focusin="this.onConfiguratorScreenFocusin">
        <div class="o_configurator_screen_content d-flex h-100 flex-grow-1">
            <div class="container align-self-center">
                <div class="o_configurator_typing_text d-inline d-md-block mb-md-2 mb-lg-4 o_configurator_show">
                    <span>I want </span>
                    <div t-attf-class="dropdown o_configurator_type_dd d-inline-block {{this.state.selectedType ? 'o_step_completed' : 'o_step_todo show'}}"
                         t-on-focusout="this.onDropdownFocusout">
                        <button id="selectTypeToggle"
                                class="o_btn_reset w-100 px-2"
                                data-bs-toggle="dropdown"
                                aria-haspopup="true"
                                aria-expanded="true"
                                aria-label="What type of website?"
                                aria-controls="selectTypeMenu">
                            <span class="d-flex align-items-center">
                                <i class="text-primary" t-if="this.state.selectedType">
                                    <t t-out="this.state.getSelectedType(this.state.selectedType).label"/>
                                </i>
                                <i class="fa fa-angle-down ms-auto ps-2" role="img"/>
                            </span>
                        </button>
                        <div id="selectTypeMenu"
                             t-attf-class="dropdown-menu border-0 shadow-lg {{this.state.selectedType ? 'o_step_completed' : 'o_step_todo show'}}"
                             role="menu"
                             aria-labelledby="selectTypeToggle">
                            <t t-foreach="this.state.getWebsiteTypes()" t-as="type" t-key="type.name">
                                <button t-att-title="type.name"
                                        t-on-click="() => this.selectWebsiteType(type.id)"
                                        class="dropdown-item o_change_website_type"
                                        role="menuitem"
                                        t-custom-ref="{{type.id === 1 ? 'autofocus' : type.name}}">
                                    <t t-out="type.label"/>
                                </button>
                            </t>
                        </div>
                    </div>
                    <span t-if="this.state.selectedType" class="me-2 o_configurator_show"> for my</span>
                </div>
                <div t-if="this.state.selectedType" class="o_configurator_typing_text d-inline d-md-flex align-items-center o_configurator_industry mb-md-2 mb-lg-4 o_configurator_show">
                    <!-- Use t-set in order to be able to translate, if put in the attribute directly then export POT file will not exist this text-->
                    <label class="o_configurator_industry_wrapper me-2" t-custom-ref="industrySelection">
                        <AutoComplete
                            placeholder.translate="Restaurant, Hair Salon, Clothing Store,..."
                            value="this.state.selectedIndustry?.label ?? ''"
                            sources="this.sources"
                            onInput.bind="this.onAutocompleteInput"
                            inputDebounceDelay="100"
                            menuPositionOptions="{ position: 'bottom-fit' }"
                            menuCssClass="'custom-ui-autocomplete shadow-lg border-0 o_configurator_show_fast o_configurator_industry_dropdown'"
                            selectOnBlur="true"
                            autoSelect="true"
                        />
                    </label>
                    <span> business</span>
                    <span t-if="this.state.selectedIndustry" class="o_configurator_show">,</span>
                </div>
                <div t-if="this.state.selectedType and this.state.selectedIndustry" class="o_configurator_typing_text d-inline d-md-block mb-md-2 mb-lg-4 o_configurator_show">
                    <span>with a </span>
                    <div t-attf-class="dropdown d-inline-block o_configurator_purpose_dd {{this.state.selectedPositioning ? 'o_step_completed' : 'o_step_todo'}}"
                         t-on-focusout="this.onDropdownFocusout">
                        <button id="selectPurposeToggle"
                                class="o_btn_reset w-100 px-2"
                                data-bs-toggle="dropdown"
                                aria-haspopup="true"
                                aria-expanded="true"
                                aria-label="What positioning?"
                                aria-controls="selectPurposeMenu">
                            <span class="d-flex align-items-center">
                                <t t-if="this.state.selectedPositioning">
                                    <t t-out="this.state.selectedPositioning"/>
                                </t>
                                <i class="fa fa-angle-down ms-auto ps-2" role="img"/>
                            </span>
                        </button>
                        <div id="selectPurposeMenu" class="dropdown-menu border-0 shadow-lg show" role="menu" aria-labelledby="selectPurposeToggle">
                            <t t-if="this.state.positioningsLoading">
                                <div class="dropdown-item text-muted"><i class="fa fa-spinner fa-spin me-2" role="img"/>Analyzing trends...</div>
                            </t>
                            <t t-else="">
                                <t t-foreach="this.state.positionings" t-as="positioning" t-key="positioning_index">
                                    <button t-on-click="() => this.selectPositioning(positioning)"
                                            class="dropdown-item o_change_website_purpose"
                                            role="menuitem"
                                            t-custom-ref="{{positioning_index === 0 ? 'purposeSelection' : positioning}}">
                                        <t t-out="positioning"/>
                                    </button>
                                </t>
                            </t>
                        </div>
                    </div>
                    <span> positioning</span>
                </div>
            </div>
        </div>
        <SkipButton skip="this.props.skip"/>
    </div>
</t>

<t t-name="website.Configurator.PaletteSelectionScreen">
    <div class="o_configurator_screen h-100 d-flex flex-column o_palette_selection_screen">
        <div class="o_configurator_screen_content container palette_selection d-flex flex-grow-1 h-100">
            <div class="o_content_container d-flex flex-column w-100 h-auto align-self-md-center o_configurator_show">
                <div class="o_palettes_container w-100 o_configurator_show_fast">
                    <input type="file" class="logo_selection_input" t-on-change="this.changeLogo" style="display:none" name="logo_selection" t-custom-ref="logoSelectionInput" accept="image/*"/>
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div>
                            <h1 class="mb-0"><b>Choose</b> your Style</h1>
                            <p class="text-muted mb-0 o_configurator_show" t-if="this.state.styleRecommendationLoading">Thinking<span class="o_thinking_dots"/></p>
                            <p class="text-muted mb-0 o_configurator_show_fast" t-if="!this.state.styleRecommendationLoading and this.state.styleRecommendation" t-out="this.state.styleRecommendation"/>
                        </div>
                        <t t-if="this.state.logo">
                            <div class="d-flex align-items-center gap-3">
                                <img t-att-src="this.state.logo" alt="Logo" style="max-height: 60px; cursor: pointer;" t-on-click="this.uploadLogo"/>
                                <div class="d-flex flex-column">
                                    <a href="#" class="small" t-on-click.prevent="this.uploadLogo">Change</a>
                                    <a href="#" class="small" t-on-click.prevent="this.removeLogo">Remove</a>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <button class="btn o_btn_reset bg-100 rounded-3 border d-flex align-items-center gap-3 p-3" t-on-click="this.uploadLogo">
                                <i class="fa fa-cloud-upload fa-3x text-muted"/>
                                <h4 class="text-start lh-sm mb-0">Upload<br/>your <b>Logo</b></h4>
                            </button>
                        </t>
                    </div>
                    <div class="row g-3">
                        <t t-foreach="this.recommendedFontCombos" t-as="combo" t-key="'rec_' + combo_index">
                            <div class="o_palette_card_container col-md-3 col-6">
                                <button t-attf-class="palette_card o_btn_reset w-100 rounded overflow-hidden d-flex align-items-center p-3 {{this.state.getSelectedPaletteName() == combo.palette and this.state.selectedHeadingsFont == combo.headingsFont ? 'selected' : ''}} {{this.state.aiRecommendedHeadingsFont == combo.headingsFont and this.state.aiRecommendedPalette == combo.palette ? 'ai_recommended' : ''}}"
                                     t-on-click="() => this.selectPalette(combo.palette, combo.headingsFont, combo.bodyFont)" t-attf-style="background-color: {{combo.bgColor}}">
                                    <div class="flex-grow-1 text-start pe-2 overflow-hidden">
                                        <h2 class="fw-bold text-truncate mb-0" t-attf-style="font-family: '{{combo.headingsFont}}', sans-serif; color: {{combo.textColor}}; line-height: 1.2;" t-out="combo.label"/>
                                        <div class="text-truncate" t-attf-style="font-family: '{{combo.bodyFont}}', sans-serif; color: {{combo.textColor}}; margin: 0; font-size: 12px; line-height: 1.3;" t-out="combo.description"/>
                                    </div>
                                    <div class="d-flex gap-1 flex-shrink-0">
                                        <div t-attf-style="background-color: {{combo.colors.color1}}; width: 26px; height: 26px; border-radius: 4px;"/>
                                        <div t-attf-style="background-color: {{combo.colors.color2}}; width: 26px; height: 26px; border-radius: 4px;"/>
                                    </div>
                                </button>
                            </div>
                        </t>
                        <t t-foreach="this.paletteFontCombos" t-as="combo" t-key="combo_index">
                            <div class="o_palette_card_container col-md-3 col-6">
                                <button t-attf-class="palette_card o_btn_reset w-100 rounded overflow-hidden d-flex align-items-center p-3 {{this.state.getSelectedPaletteName() == combo.palette and this.state.selectedHeadingsFont == combo.headingsFont ? 'selected' : ''}} {{this.state.aiRecommendedHeadingsFont == combo.headingsFont and this.state.aiRecommendedPalette == combo.palette ? 'ai_recommended' : ''}}"
                                     t-on-click="() => this.selectPalette(combo.palette, combo.headingsFont, combo.bodyFont)" t-attf-style="background-color: {{combo.bgColor}}">
                                    <div class="flex-grow-1 text-start pe-2 overflow-hidden">
                                        <h2 class="fw-bold text-truncate mb-0" t-attf-style="font-family: '{{combo.headingsFont}}', sans-serif; color: {{combo.textColor}}; line-height: 1.2;" t-out="combo.label"/>
                                        <div class="text-truncate" t-attf-style="font-family: '{{combo.bodyFont}}', sans-serif; color: {{combo.textColor}}; margin: 0; font-size: 12px; line-height: 1.3;" t-out="combo.description"/>
                                    </div>
                                    <div class="d-flex gap-1 flex-shrink-0">
                                        <div t-attf-style="background-color: {{combo.colors.color1}}; width: 26px; height: 26px; border-radius: 4px;"/>
                                        <div t-attf-style="background-color: {{combo.colors.color2}}; width: 26px; height: 26px; border-radius: 4px;"/>
                                    </div>
                                </button>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </div>
        <SkipButton skip="this.props.skip"/>
    </div>
</t>

<t t-name="website.Configurator.FeatureSelection">
    <div class="o_configurator_screen h-100 d-flex flex-column o_feature_selection_screen">
        <div class="o_configurator_screen_content container d-flex flex-grow-1 align-items-center">
            <div class="m-auto d-flex mh-100 flex-column">
                <div class="o_configurator_typing_text o_configurator_show_fast">Add <b class="text-info">Pages</b> and <b class="text-warning">Features</b></div>
                <h2 class="o_configurator_show_fast text-muted pb-lg-3">You'll be able to create your pages later on.</h2>
                <div class="page_feature_selection o_configurator_show mt-lg-3 mx-n2">
                    <div class="w-100 page_feature_selection d-flex flex-wrap">
                        <t t-foreach="this.state.getFeatures()" t-as="feature" t-key="feature_index">
                            <t t-set='isInstalled' t-value="feature.module_state == 'installed'"/>
                            <div class="o_feature_card_container p-2 w-25" t-if="feature.type != 'empty'">
                                <div t-attf-class="card h-100 {{isInstalled ? 'card_installed' : (feature.selected ? 'border-success' : '')}}"
                                     t-on-click="() => this.state.toggleFeature(feature.id)"
                                     t-on-keydown="this.onKeydown"
                                     tabindex="0"
                                     role="button">
                                    <div class="h3 card-body py-3 px-4 mb-0">
                                        <t t-if="isInstalled">
                                            <i t-attf-class="o_configurator_feature_status fa fa-check-circle text-success" title="Already installed"/>
                                        </t>
                                        <t t-else="">
                                            <i t-attf-class="o_configurator_feature_status fa {{feature.selected ? 'fa-check-circle text-success' : 'fa-circle-o text-300'}}" />
                                        </t>
                                        <div t-attf-class="h2 mb-0 card-title d-flex align-items-center {{isInstalled ? 'text-muted' : ''}}">
                                            <i t-attf-class="me-2 fa {{feature.icon}} {{isInstalled ? 'text-muted' : (feature.type == 'page' ? 'text-info' : 'text-warning')}}"/>
                                            <h3 class="m-1">
                                                <t t-out="feature.name"/>
                                            </h3>
                                        </div>
                                        <p class="small card-text text-muted" t-out="feature.description"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                <div class="pt-2">
                    <button class="btn btn-primary btn-lg" t-on-click="this.buildWebsite">Build my website</button>
                </div>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.ThemeSelectionScreen">
    <div class="o_configurator_screen h-100 d-flex flex-column o_theme_selection_screen">
        <div class="o_configurator_screen_content d-flex flex-column flex-grow-1 align-items-center">
            <div class="m-auto w-100 w-md-75 w-xl-100">
                <div class="o_configurator_typing_text text-center mt-4 mb-lg-4">Pick a <b>Layout</b>
                </div>
                <div class="container">
                    <div class="row g-4 pt-4">
                        <t t-foreach="this.state.themes" t-as="theme" t-key="theme_index">
                            <div class="col-12 col-lg-4">
                                <div class="theme_preview border rounded position-relative w-100 o_configurator_show_fast">
                                    <h6 class="theme_preview_tip text-center text-muted">Click to select</h6>
                                    <!-- Force LTR to prevent SVG issues in RTL languages -->
                                    <div class="theme_svg_container rounded overflow-hidden" t-custom-ref="ThemePreview{{theme_index + 1}}" dir="ltr"/>
                                    <button class="o_btn_reset button_area" t-on-click="() => this.chooseTheme(theme.name)"/>
                                </div>
                            </div>
                        </t>
                    </div>
                    <t t-if="this.showViewMoreThemesButton">
                        <p class="text-center mt-4">
                            <button class="btn btn-secondary btn-lg px-4 py-2" t-on-click="this.getMoreThemes" t-custom-ref="extraThemesButton">Generate more</button>
                        </p>
                    </t>
                    <t t-elif="this.state.extraThemes.length" t-foreach="Array(Math.ceil(this.state.extraThemes.length/3))" t-as="nbrExtraRow" t-key="nbrExtraRow_index">
                        <div class="row pb-4 pt-5">
                            <t t-foreach="Array(3)" t-as="nbrExtraCol" t-key="nbrExtraCol_index">
                                <div class="col-12 col-lg-4 d-flex align-items-end mb-4 mb-lg-0">
                                    <t t-set="extraThemeId" t-value="nbrExtraRow_index * 3 + nbrExtraCol_index"/>
                                    <t t-set="extraThemeName" t-value="this.getExtraThemeName(extraThemeId)"/>
                                    <t t-if="extraThemeName">
                                        <div class="theme_preview border rounded position-relative w-100 small o_configurator_show_fast">
                                            <h6 class="theme_preview_tip text-center text-muted">Click to select</h6>
                                            <!-- Force LTR to prevent SVG issues in RTL languages -->
                                            <div class="theme_svg_container rounded overflow-hidden" t-custom-ref="ExtraThemePreview{{extraThemeId}}" dir="ltr"/>
                                            <button class="o_btn_reset button_area" t-on-click="() => this.chooseTheme(extraThemeName)"/>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </div>
</t>

<t t-name="website.Configurator.Configurator">
    <div class="o_configurator_container">
        <t t-component="this.currentComponent" t-props="this.componentProps"/>
    </div>
</t>

</templates>
