<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.WebsiteBorderConfiguratorOption" t-inherit="html_builder.BorderConfiguratorOption">
    <xpath expr="//BuilderRow[@label.translate=&quot;Round Corners&quot;]" position="replace">
        <t t-if="this.props.withRoundCorner">

            <t t-if="this.showRoundnessSuggestions">
                <BuilderRow label.translate="Round Corners" level="this.props.level">
                    <BuilderSelect>
                        <t t-foreach="this.roundCorners.items" t-as="item" t-key="item.label">

                            <BuilderSelectItem
                                id="item.label === 'Custom' ? 'custom_radius' : ''"
                                action="'setBorderRadius'"
                                actionParam="{ mainParam: item.class, radiusActionParam: this.radiusActionParam }"
                            >
                                <div class="d-flex">
                                    <div class="o-hb-border-radius-text" t-out="item.label"/>
                                    <a
                                        t-if="item.variable"
                                        title="Edit"
                                        class="fa fa-pencil btn o-hb-border-radius-button"
                                        t-on-click="this.getOnEditButtonClick(item.variable)"
                                    />
                                </div>
                            </BuilderSelectItem>

                        </t>
                    </BuilderSelect>
                </BuilderRow>

                <BuilderRow t-if="this.isActiveItem('custom_radius')" label.translate="Border Radius" level="(this.props.level ?? 0) + 1">
                    <t t-call="website.RoundnessInput"/>
                </BuilderRow>
            </t>

            <t t-else="">
                <BuilderRow label.translate="Round Corners" level="this.props.level">
                    <t t-call="website.RoundnessInput"/>
                </BuilderRow>
            </t>

        </t>
    </xpath>
</t>

<t t-name="website.RoundnessInput">
    <BuilderNumberInput
        action="this.props.action"
        actionParam="this.radiusActionParam"
        unit="'px'"
        min="0"
        composable="true"
    />
</t>

</templates>
