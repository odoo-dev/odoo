<t t-name="website.s_countdown_inline.end_message">
    <div class="s_countdown_inline_end_message d-none">
        <div class="oe_structure">
            <div class="s_text_highlight o_colored_level o_cc o_cc2 w-100 my-3">
                <div class="container">
                    <h5>Congratulations! 🎉</h5>
                    <p>Your patience and anticipation have paid off—thank you for waiting, and now it's time to enjoy the exciting surprise we've been building up to!</p>
                </div>
            </div>
        </div>
    </div>
</t>

<t t-name="website.s_countdown_inline.end_redirect_message">
    <p class="s_countdown_inline_end_redirect_message w-100 mt-2 mb-0">Time's up! You can now visit <a class="s_countdown_end_redirect_url" t-attf-href="#{redirectUrl}">this page</a>.</p>
</t>

</templates>
