<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website.CarouselQuotesOption">
        <BuilderRow label.translate="Layout">
            <BuilderSelect action="'updateQuotesCarouselOption'" preview="false">
                <BuilderSelectItem id="'one'" actionParam="{ numberOfElements: '1' }">1 element</BuilderSelectItem>
                <BuilderSelectItem id="'two'" actionParam="{ numberOfElements: '2' }">2 elements</BuilderSelectItem>
                <BuilderSelectItem id="'three'" actionParam="{ numberOfElements: '3' }">3 elements</BuilderSelectItem>
                <BuilderSelectItem id="'four'" actionParam="{ numberOfElements: '4' }">4 elements</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>

        <t t-if="!isActiveItem('one')">
            <BuilderRow label.translate="Scrolling Mode" level="1">
                <BuilderButtonGroup action="'updateQuotesCarouselOption'" preview="false">
                    <BuilderButton actionParam="{ scrollMode: 'all' }">All</BuilderButton>
                    <BuilderButton actionParam="{ scrollMode: 'single' }">Single</BuilderButton>
                </BuilderButtonGroup>
            </BuilderRow>
        </t>
    </t>
</templates>
