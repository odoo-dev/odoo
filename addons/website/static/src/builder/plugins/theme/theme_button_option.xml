<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.ThemeButtonOption">
    <BuilderContext preview="false">
        <BuilderRow label.translate="Primary Style">
            <BuilderSlidingPanel label.translate="Primary Style" icon="'brush'" extraClasses="'btn-success oi oi-fw ms-auto'">
                <t t-set-slot="content">
                    <ThemeButtonStyleOption btnStyle="'primary'"/>
                </t>
            </BuilderSlidingPanel>
        </BuilderRow>
        <BuilderRow label.translate="Secondary Style">
            <BuilderSlidingPanel label.translate="Secondary Style" icon="'brush'" extraClasses="'btn-success oi oi-fw ms-auto'">
                <t t-set-slot="content">
                    <ThemeButtonStyleOption btnStyle="'secondary'"/>
                </t>
            </BuilderSlidingPanel>
        </BuilderRow>
        <ThemeEffectOption target="'btn'"/>
    </BuilderContext>
</t>

<t t-name="website.ThemeButtonStyleOption">
    <BuilderContext preview="false">
        <BuilderRow label.translate="Style">
            <BuilderSelect action="'customizeButtonStyle'" actionParam="this.props.btnStyle">
                <BuilderSelectItem actionValue="'fill'">Fill</BuilderSelectItem>
                <BuilderSelectItem actionValue="'outline'" id="`btn_${this.props.btnStyle}_outline_opt`">Outline</BuilderSelectItem>
                <BuilderSelectItem actionValue="'flat'">Flat</BuilderSelectItem>
            </BuilderSelect>
        </BuilderRow>
        <BuilderRow t-if="!this.state.isFlat"
            label.translate="Border" action="'customizeWebsiteVariable'"
        >
            <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-border-width`" unit="'px'" saveUnit="'rem'" min="0"/>
            <BuilderSelect actionParam="`btn-${this.props.btnStyle}-border-style`">
                <BuilderSelectItem title.translate="Solid" actionValue="'solid'"><div class="o_hb_border_preview" style="border-style: solid;"/></BuilderSelectItem>
                <BuilderSelectItem title.translate="Dashed" actionValue="'dashed'"><div class="o_hb_border_preview" style="border-style: dashed;"/></BuilderSelectItem>
                <BuilderSelectItem title.translate="Dotted" actionValue="'dotted'"><div class="o_hb_border_preview" style="border-style: dotted;"/></BuilderSelectItem>
                <BuilderSelectItem title.translate="Double" actionValue="'double'"><div class="o_hb_border_preview" style="border-style: double; border-left: none; border-right: none;"/></BuilderSelectItem>
            </BuilderSelect>
            <BuilderColorPicker actionParam="`btn-${this.props.btnStyle}-border-color`" enabledTabs="['custom']"/>
        </BuilderRow>
        <BuilderRow label.translate="Font Family">
            <ThemeFontFamilyOption
                cssVariable="`buttons-${this.props.btnStyle}-font`"
                buttonIcon="'delete'"
                buttonIconClass="'oi-filled'"
                buttonTitle.translate="Reset to Default Font Family"/>
        </BuilderRow>
        <BuilderRow label.translate="Padding" tooltip.translate="Padding: 1 to 4 values, as in CSS" action="'customizeWebsiteVariable'">
            <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-padding`" unit="'px'" saveUnit="'rem'" min="0" composable="true"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-padding-sm`" unit="'px'" saveUnit="'rem'" min="0" composable="true"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-padding-lg`" unit="'px'" saveUnit="'rem'" min="0" composable="true"/>
                </BuilderRow>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Margin" tooltip.translate="Margin: 1 to 4 values, as in CSS" action="'customizeWebsiteVariable'">
            <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-margin`" unit="'px'" saveUnit="'rem'" composable="true"/>
        </BuilderRow>
        <BuilderRow label.translate="Font Size" action="'customizeWebsiteVariable'">
            <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-font-size`" unit="'px'" saveUnit="'rem'"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-font-size-sm`" unit="'px'" saveUnit="'rem'"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-font-size-lg`" unit="'px'" saveUnit="'rem'"/>
                </BuilderRow>
            </t>
        </BuilderRow>
        <BuilderRow label.translate="Text Style" action="'customizeWebsiteVariable'" actionParam="`btn-${this.props.btnStyle}-text-transform`">
            <BuilderButtonGroup>
                <BuilderButton actionValue="'none'">Normal</BuilderButton>
                <BuilderButton actionValue="'uppercase'">Uppercase</BuilderButton>
            </BuilderButtonGroup>
        </BuilderRow>
        <ThemeFontWeightOption
            regularVariables="[`btn-${this.props.btnStyle}-font-weight`]"
            boldVariables="[`btn-${this.props.btnStyle}-font-weight-bold`]"
            fontVariable="`buttons-${this.props.btnStyle}-font`"
        />
        <BuilderRow label.translate="Round Corners" action="'customizeWebsiteVariable'">
            <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-border-radius`" unit="'px'" saveUnit="'rem'"/>
            <t t-set-slot="collapse">
                <BuilderRow label.translate="Small" level="1">
                    <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-border-radius-sm`" unit="'px'" saveUnit="'rem'"/>
                </BuilderRow>
                <BuilderRow label.translate="Large" level="1">
                    <BuilderNumberInput actionParam="`btn-${this.props.btnStyle}-border-radius-lg`" unit="'px'" saveUnit="'rem'"/>
                </BuilderRow>
            </t>
        </BuilderRow>
    </BuilderContext>
</t>

</templates>
