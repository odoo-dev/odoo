<?xml version="1.0" encoding="utf-8"?>
<templates>

    <t t-name="website.ResourceEditor">
        <div class="o_resource_editor w-100 h-100">
            <div class="o_resource_editor_title">
                <div class="btn-group o_resource_editor_type_switcher">
                    <Dropdown>
                        <button class="btn btn-info"><t t-out="this.types[this.state.type]"/></button>
                        <t t-set-slot="content">
                            <t t-foreach="Object.keys(this.types)" t-as="type" t-key="type">
                                <DropdownItem onSelected="() => this.onFileTypeChange(type)">
                                    <t t-out="this.types[type]"/>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>
                </div>
                <SelectMenu t-props="this.selectMenuProps" class="'o_resource_editor_resource_list'">
                    <t t-set="resource" t-value="this.state.currentResource"/>
                    <t t-call="website.ResourceEditor.ResourceLabel"
                        resource="resource"
                        label="this.state.type === 'xml' ? resource.name : resource.label"/>
                    <t t-set-slot="choice" t-slot-scope="scope">
                        <t t-call="website.ResourceEditor.ResourceLabel"
                            resource="this.state.resources[this.state.type][scope.data.value]"
                            label="scope.data.label"/>
                    </t>
                </SelectMenu>
                <label t-if="this.state.type === 'xml' and this.debug" class="o_resource_editor_filter">
                    <div class="btn-group o_resource_editor_type_switcher">
                        <Dropdown>
                            <button class="btn btn-primary">Filter</button>
                            <t t-set-slot="content">
                                <t t-foreach="Object.keys(this.xmlFilters)" t-as="filter" t-key="filter">
                                    <CheckboxItem class="{ selected: this.state.xmlFilter === filter }" checked="this.state.xmlFilter === filter" onSelected="() => this.onFilterChange('xml', filter)">
                                        <t t-out="this.xmlFilters[filter]"/>
                                    </CheckboxItem>
                                </t>
                            </t>
                        </Dropdown>
                    </div>
                </label>
                <label t-if="this.state.type === 'scss' and this.debug" class="o_resource_editor_filter">
                    <div class="btn-group o_resource_editor_type_switcher">
                        <Dropdown>
                            <button class="btn btn-primary">Filter</button>
                            <t t-set-slot="content">
                                <t t-foreach="Object.keys(this.scssFilters)" t-as="filter" t-key="filter">
                                    <CheckboxItem class="{ selected: this.state.scssFilter === filter }" checked="this.state.scssFilter === filter" onSelected="() => this.onFilterChange('scss', filter)">
                                        <t t-out="this.scssFilters[filter]"/>
                                    </CheckboxItem>
                                </t>
                            </t>
                        </Dropdown>
                    </div>
                </label>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="this.onSave"><i t-if="this.state.saving" class="oi oi-spin mr8" data-icon="autorenew"/>Save</button>
                    <button class="btn btn-secondary" t-on-click="this.props.close">Close</button>
                </div>
            </div>
            <t t-set="locatedChanges" t-value="this.locatedChanges"/>
            <div t-if="this.state.currentResource" id="resource-editor-id">
                <div class="float-end">
                    <button t-if="this.state.type !== 'xml' and this.isCustomResource(this.state.currentResource.url)" type="button" class="btn btn-sm btn-danger" t-on-click="this.onReset">
                        <i class="oi" data-icon="undo"/>
                        Reset
                    </button>
                    <button t-if="this.state.type === 'xml'" type="button" class="btn btn-sm btn-link" t-on-click="this.onFormat">Format</button>
                </div>
                <span class="o_resource_editor_resource_info" t-out="this.resourceInfo"/>
                <Dropdown t-if="locatedChanges.changes.length">
                    <button type="button"
                        class="btn btn-sm btn-link o_resource_editor_changed_by"
                        t-att-class="{ o_resource_editor_changed_by_warning: this.getNotLocatedCount(locatedChanges) }">
                        <t t-out="this.getChangedByLabel(locatedChanges)"/>
                    </button>
                    <t t-set-slot="content">
                        <t t-foreach="this.getChangingViews(locatedChanges)" t-as="changingView" t-key="changingView.view.id">
                            <DropdownItem onSelected="() => this.openView(changingView.view.id, changingView.changes[0].index)">
                                <span class="d-block">
                                    <t t-call="website.ResourceEditor.ResourceLabel"
                                        resource="changingView.view"
                                        label="changingView.view.name"/>
                                </span>
                                <small class="d-block text-muted" t-out="this.getChangesDescription(changingView.changes)"/>
                            </DropdownItem>
                        </t>
                    </t>
                </Dropdown>
            </div>
            <div t-if="this.state.currentResource" id="resource-editor" t-ref="this.editorRef">
                <ResourceCodeEditor
                    class="'h-100'"
                    value="this.state.currentResource.arch"
                    sessionId="this.state.currentResource.id"
                    mode="this.typeToCodeEditorModeMap[this.state.type]"
                    theme="'monokai'"
                    onChange.bind="this.onEditorChange"
                    banners="this.getCodeEditorBanners(locatedChanges)"
                    onBannerClick.bind="this.openView"
                    markers="this.getCodeEditorMarkers(locatedChanges)"
                    onMarkerClick.bind="this.onMarkerClick"
                    revealRow="this.revealRow()"/>
            </div>
        </div>
        <ResourceEditorWarningOverlay/>
    </t>

    <t t-name="website.ResourceEditor.ResourceLabel">
        <i t-if="resource.customized or resource.dirty" t-att-class="{ 'oi mr8': true, 'text-warning': resource.dirty, 'text-success': resource.customized }" data-icon="save"/>
        <t t-out="label"/>
    </t>

    <t t-name="website.ResourceEditor.ChangesPopover">
        <div class="o_resource_editor_changes_popover py-2">
            <div class="px-3 pb-1 small text-muted" t-out="this.props.title"/>
            <t t-foreach="this.props.items" t-as="item" t-key="item.key">
                <button type="button"
                    class="dropdown-item d-flex align-items-baseline justify-content-between gap-3"
                    t-on-click="() => item.onSelect()">
                    <span>
                        <t t-call="website.ResourceEditor.ResourceLabel"
                            resource="item.view"
                            label="item.view.name"/>
                    </span>
                    <small class="text-muted text-nowrap" t-out="item.description"/>
                </button>
            </t>
        </div>
    </t>

</templates>
