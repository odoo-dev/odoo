</template>

<template id="configurator_layout_impactful_cta_playful" inherit_id="website.configurator_layout_impactful_cta" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Blobs/03","flip":[],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Blobs_03" contenteditable="false"/>
    </xpath>
</template>

<template id="configurator_layout_impactful_vibe_playful"
          name="Configurator Layout: Impactful / Playful"
          inherit_id="website.configurator_layout_impactful" primary="True">
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_impactful_hero']" position="replace">
        <t t-snippet-call="website.configurator_layout_impactful_hero_playful"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_impactful_cta']" position="replace">
        <t t-snippet-call="website.configurator_layout_impactful_cta_playful"/>
    </xpath>
</template>

</odoo>
