<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- ============================================================
     ConfiguratorHeader / ConfiguratorFooter attributes
     ============================================================
     ConfiguratorHeader:
       data-template    header template xmlid suffix
                        (default template_header_default)
       data-color       color combination 1..5 (default 1)
       data-overlay     "true" places header over content
       data-full-width  "true" makes nav use container-fluid
       data-bg          CSS background (solid OR gradient);
                        hardcoded, takes precedence over data-color
       data-border      CSS border shorthand
                        (e.g. "1px solid #111", or "0" / "none")
       data-shadow      raw CSS box-shadow value (e.g.
                        "0 1rem 3rem rgba(0,0,0,.175)" or "none")
       data-text-color  hardcoded header text color
     ConfiguratorFooter:
       data-template, data-color, data-bg only
       (no overlay / full width / border / shadow / text color:
        there is no site wide SCSS variable for footer
        border or shadow, so they are unsupported by design)

     A vibe template may override these by replacing the
     ConfiguratorHeader / ConfiguratorFooter node via xpath; the
     override is honoured in previews, the generated website and
     the /website/demo/configurator-layouts debug page.
     ============================================================ -->
<!-- ============================================================
     PROFESSIONAL layout
     Full-bleed hero, trust strip, structured proof.

     Architecture:
       Layer 1 — Per-snippet clean variants (primary inherits)
       Layer 2 — Assembly (Clean vibe), t-snippet-call
       Layer 3 — Vibe assemblies (primary inherits of Layer 2)
       Layer 4 — Vibe per-snippet variants (primary inherits of Layer 1)
     ============================================================ -->


<!-- ════════════════════════════════════════════════════════════
     LAYER 1 — Per-snippet layout variants (Clean baseline)
     ════════════════════════════════════════════════════════════ -->

<!-- Full-bleed hero (header sits over it) -->
<template id="configurator_layout_professional_hero" inherit_id="website.s_text_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc5 pt0 pb0" remove="pt40 pb40" separator=" "/>
        <attribute name="data-name">Hero</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="replace">
        <div class="container-fluid p-0">
            <div class="position-relative" style="height: 600px;">
                <img src="/web/image/website.s_carousel_default_image_1" class="position-absolute top-0 start-0 w-100 h-100" style="object-fit: cover;" alt=""/>
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to right, #0000005e 30%, #0000)"/>
                <div class="position-absolute top-0 start-0 end-0 bottom-0 d-flex flex-column justify-content-center text-white px-5 px-lg-5">
                    <div class="container">
                        <h1 class="fw-bold m-0" style="font-size: clamp(2.5rem, 5vw, 3.75rem); line-height: 1.05; max-width: 700px;">
                            Built to last,<br/>delivered on time
                        </h1>
                        <p class="mt-3 mb-4" style="max-width: 460px; opacity: .85;">
                            We deliver thoughtfully designed work that meets the evolving needs of modern teams, combining innovation with craftsmanship.
                        </p>
                        <a t-att-href="cta_btn_href" class="btn btn-primary btn-lg align-self-start">View our work <i class="oi oi-arrow-up-right"/></a>
                    </div>
                </div>
                <div class="container position-absolute start-50 translate-middle-x" style="bottom: 40px;">
                    <div class="d-flex flex-wrap gap-3">
                        <span class="rounded-pill o_cc o_cc1 border border-light small px-3 py-2">◇ Certified</span>
                        <span class="rounded-pill o_cc o_cc1 border border-light small px-3 py-2">◇ On budget</span>
                        <span class="rounded-pill o_cc o_cc1 border border-light small px-3 py-2">◇ Guaranteed</span>
                    </div>
                </div>
            </div>
        </div>
    </xpath>
</template>

<!-- Logo strip -->
<template id="configurator_layout_professional_logos" inherit_id="website.s_text_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc5 pt40 pb40" remove="pt40 pb40" separator=" "/>
        <attribute name="data-name">Logos</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="replace">
        <div class="container">
            <div class="row row-cols-2 row-cols-lg-6 g-4 align-items-center text-center fw-semibold">
                <div class="col">◐ Logoipsum</div>
                <div class="col">◑ Logoipsum</div>
                <div class="col">◒ Logoipsum</div>
                <div class="col">◓ Logoipsum</div>
                <div class="col">◔ Logoipsum</div>
                <div class="col">◕ Logoipsum</div>
            </div>
        </div>
    </xpath>
</template>

<!-- About: text + image, with proof stat -->
<template id="configurator_layout_professional_about" inherit_id="website.s_text_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc1 pt96 pb64" remove="pt40 pb40" separator=" "/>
        <attribute name="data-name">About</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="replace">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <p class="small fw-bold text-uppercase mb-3" style="letter-spacing: .16em; color: var(--o-color-1);">↳ About us</p>
                    <h2 class="fw-bold m-0" style="font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.18; letter-spacing: -.01em;">
                        Expert teams built for every project scale
                    </h2>
                    <p class="mt-3 opacity-75" style="max-width: 460px;">
                        We are dedicated to delivering high-quality work that meets the demands of modern clients while respecting timelines and budgets.
                    </p>
                    <a href="#" class="btn btn-primary mt-2">About us <i class="oi oi-arrow-up-right"/></a>
                    <div class="d-flex align-items-center gap-3 mt-4">
                        <div class="d-flex">
                            <img src="/web/image/website.library_image_01" class="rounded-circle border border-2 border-white" style="width: 40px; height: 40px; object-fit: cover;" alt=""/>
                            <img src="/web/image/website.library_image_02" class="rounded-circle border border-2 border-white" style="width: 40px; height: 40px; object-fit: cover; margin-left: -12px;" alt=""/>
                            <img src="/web/image/website.library_image_03" class="rounded-circle border border-2 border-white" style="width: 40px; height: 40px; object-fit: cover; margin-left: -12px;" alt=""/>
                        </div>
                        <p class="m-0"><strong>500+</strong> <span class="opacity-50">projects completed successfully</span></p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <img src="/web/image/website.s_picture_default_image" class="img-fluid rounded-4 w-100" style="height: 380px; object-fit: cover;" alt=""/>
                </div>
            </div>
        </div>
    </xpath>
</template>

<!-- Three feature cards -->
<template id="configurator_layout_professional_features" inherit_id="website.s_text_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc4 pt0 pb64" remove="pt40 pb40" separator=" "/>
        <attribute name="data-name">Features</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="replace">
        <div class="container">
            <div class="row row-cols-1 row-cols-lg-3 g-4">
                <div class="col">
                    <div class="o_cc o_cc3 rounded-4 p-4 h-100">
                        <div class="fs-3 mb-3" style="color: var(--o-color-1);">◇</div>
                        <h3 class="fw-bold" style="font-size: 1.2rem;">Licensed &amp; insured</h3>
                        <p class="opacity-75 m-0">Every project is fully compliant with local codes, carried out by certified professionals.</p>
                    </div>
                </div>
                <div class="col">
                    <div class="o_cc o_cc3 rounded-4 p-4 h-100">
                        <div class="fs-3 mb-3" style="color: var(--o-color-1);">◈</div>
                        <h3 class="fw-bold" style="font-size: 1.2rem;">On-time delivery</h3>
                        <p class="opacity-75 m-0">Milestone-driven management ensures deadlines are met without quality compromise.</p>
                    </div>
                </div>
                <div class="col">
                    <div class="o_cc o_cc3 rounded-4 p-4 h-100">
                        <div class="fs-3 mb-3" style="color: var(--o-color-1);">◉</div>
                        <h3 class="fw-bold" style="font-size: 1.2rem;">Fixed-price quotes</h3>
                        <p class="opacity-75 m-0">Transparent pricing from day one — no hidden charges, no surprises at handover.</p>
                    </div>
                </div>
            </div>
        </div>
    </xpath>
</template>

<!-- Closing statement -->
<template id="configurator_layout_professional_closing" inherit_id="website.s_text_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc4 pt64 pb96" remove="pt40 pb40" separator=" "/>
        <attribute name="data-name">Closing</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="replace">
        <div class="container text-center">
            <p class="small fw-bold text-uppercase mb-3" style="letter-spacing: .16em; color: var(--o-color-1);">↳ What we do</p>
            <h2 class="fw-bold m-0" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
                Quality work for every client
            </h2>
        </div>
    </xpath>
</template>


<!-- ════════════════════════════════════════════════════════════
     LAYER 2 — Assembly template (= Clean vibe)
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_professional" name="Configurator Layout: Professional">
    <ConfiguratorHeader data-template="template_header_boxed" data-color="5" data-overlay="true" data-shadow="none"/>
    <ConfiguratorFooter data-template="template_footer_descriptive" data-color="2"/>

    <t t-snippet-call="website.configurator_layout_professional_hero"/>
    <t t-snippet-call="website.configurator_layout_professional_logos"/>
    <t t-snippet-call="website.configurator_layout_professional_about"/>
    <t t-snippet-call="website.configurator_layout_professional_features"/>
    <t t-snippet-call="website.configurator_layout_professional_closing"/>
</template>


<!-- ════════════════════════════════════════════════════════════
     DYNAMIC vibe
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_professional_about_dynamic" inherit_id="website.configurator_layout_professional_about" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Connections/03","flip":["y"],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Connections_03" style='background-image: url("/html_editor/shape/html_builder/Connections/03.svg?c5=o-color-5&amp;flip=y"); background-position: 50% 0%;' contenteditable="false"/>
    </xpath>
</template>

<template id="configurator_layout_professional_features_dynamic" inherit_id="website.configurator_layout_professional_features" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc2" remove="o_cc4" separator=" "/>
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Connections/01","colors":{"c5":"o-color-3"},"flip":["y"],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":true}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Connections_01" contenteditable="false" style="background-image: url('/html_editor/shape/html_builder/Connections/01.svg?c5=o-color-3&amp;flip=xy'); background-position: 50% 0%;"/>
    </xpath>
</template>

<template id="configurator_layout_professional_vibe_dynamic"
          name="Configurator Layout: Professional / Dynamic"
          inherit_id="website.configurator_layout_professional" primary="True">
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_professional_about']" position="replace">
        <t t-snippet-call="website.configurator_layout_professional_about_dynamic"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_professional_features']" position="replace">
        <t t-snippet-call="website.configurator_layout_professional_features_dynamic"/>
    </xpath>
</template>


<!-- ════════════════════════════════════════════════════════════
     GRADIENT vibe
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_professional_about_gradient" inherit_id="website.configurator_layout_professional_about" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="style" add="background-image: linear-gradient(135deg, var(--o-color-2) -25%, transparent 45%);" separator=";"/>
    </xpath>
</template>

<template id="configurator_layout_professional_features_gradient" inherit_id="website.configurator_layout_professional_features" primary="True">
    <xpath expr="//div[hasclass('o_cc3')]" position="attributes">
        <attribute name="style" add="background-image: linear-gradient(135deg, color-mix(in srgb, var(--o-color-1) 22%, transparent), color-mix(in srgb, var(--o-color-2) 28%, transparent));" separator=";"/>
    </xpath>
</template>

<template id="configurator_layout_professional_vibe_gradient"
          name="Configurator Layout: Professional / Gradient"
          inherit_id="website.configurator_layout_professional" primary="True">
    <xpath expr="//ConfiguratorHeader" position="replace">
        <ConfiguratorHeader data-template="template_header_boxed" data-color="5" data-overlay="true" data-shadow="0 0 100px var(--o-color-1)" data-border="0"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_professional_about']" position="replace">
        <t t-snippet-call="website.configurator_layout_professional_about_gradient"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_professional_features']" position="replace">
        <t t-snippet-call="website.configurator_layout_professional_features_gradient"/>
    </xpath>
</template>


<!-- ════════════════════════════════════════════════════════════
     GLOSSY vibe — handled later
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_professional_vibe_glossy"
          name="Configurator Layout: Professional / Glossy"
          inherit_id="website.configurator_layout_professional" primary="True"/>


<!-- ════════════════════════════════════════════════════════════
     ILLUSTRATIVE vibe — reuses the shared configurator SVGs
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_professional_hero_illustrative" inherit_id="website.configurator_layout_professional_hero" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc1" remove="o_cc5" separator=" "/>
        <attribute name="data-name">Hero</attribute>
    </xpath>
    <xpath expr="//img" position="replace">
        <img class="position-absolute end-0" style="object-fit: contain; top:20%; height: 90%;" src="/website/static/src/img/configurator/vibe_illustrative/doodles-reflecting-reading-book-drawing-handmade-clean-room-sitting-simple.svg"/>
    </xpath>
    <xpath expr="//div[hasclass('position-absolute')]" position="replace"/>
</template>

<template id="configurator_layout_professional_about_illustrative" inherit_id="website.configurator_layout_professional_about" primary="True">
    <xpath expr="//img[hasclass('img-fluid')]" position="replace">
        <img class="img-fluid w-100" style="height: 380px; object-fit: contain;" src="/website/static/src/img/configurator/vibe_illustrative/doodles-doogie-sitting-petting-drawing-handmade-clean-minimal-happy-animals.svg"/>
    </xpath>
</template>

<template id="configurator_layout_professional_vibe_illustrative"
          name="Configurator Layout: Professional / Illustrative"
          inherit_id="website.configurator_layout_professional" primary="True">
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_professional_hero']" position="replace">
        <t t-snippet-call="website.configurator_layout_professional_hero_illustrative"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_professional_about']" position="replace">
        <t t-snippet-call="website.configurator_layout_professional_about_illustrative"/>
    </xpath>
</template>


