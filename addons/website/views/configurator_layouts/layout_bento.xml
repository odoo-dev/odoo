<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- ============================================================
     ConfiguratorHeader / ConfiguratorFooter attributes
     ============================================================
     ConfiguratorHeader:
       data-template    header template xmlid suffix
                        (default template_header_default)
       data-color       color combination 1..5 (default 1)
       data-overlay     "true" places header over content
       data-full-width  "true" makes nav use container-fluid
       data-bg          CSS background (solid OR gradient);
                        hardcoded, takes precedence over data-color
       data-border      CSS border shorthand
                        (e.g. "1px solid #111", or "0" / "none")
       data-shadow      raw CSS box-shadow value (e.g.
                        "0 1rem 3rem rgba(0,0,0,.175)" or "none")
       data-text-color  hardcoded header text color
     ConfiguratorFooter:
       data-template, data-color, data-bg only
       (no overlay / full width / border / shadow / text color:
        there is no site wide SCSS variable for footer
        border or shadow, so they are unsupported by design)

     A vibe template may override these by replacing the
     ConfiguratorHeader / ConfiguratorFooter node via xpath; the
     override is honoured in previews, the generated website and
     the /website/demo/configurator-layouts debug page.
     ============================================================ -->

<!-- ════════════════════════════════════════════════════════════
     LAYER 1 — Per-snippet layout variants (Clean baseline)
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_bento_s_bento_hero" inherit_id="website.s_bento_hero" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="pt80" remove="pt64" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_grid_item')]" position="attributes">
        <attribute name="class" add="d-flex align-items-end" remove="" separator=" "/>
    </xpath>

    <xpath expr="(//div[hasclass('o_grid_item')])[3]" position="attributes">
        <attribute name="class" add="d-flex flex-column justify-content-between" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[3]//br" position="replace"/>

    <xpath expr="(//div[hasclass('o_grid_item')])[4]" position="attributes">
        <attribute name="class" add="d-flex flex-column align-items-end justify-content-between" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[4]/p[2]" position="replace"/>

    <xpath expr="(//div[hasclass('o_grid_item')])[5]" position="attributes">
        <attribute name="class" add="d-flex flex-column justify-content-between" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[5]/p" position="replace"/>

    <xpath expr="(//div[hasclass('o_grid_item')])[6]" position="attributes">
        <attribute name="class" add="d-flex flex-column justify-content-between" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[6]/p" position="replace"/>
</template>

<template id="configurator_layout_bento_s_cover" inherit_id="website.s_cover" primary="True"/>

<template id="configurator_layout_bento_s_image_text_overlap" inherit_id="website.s_image_text_overlap" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc2" remove="o_cc2" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[2]" position="attributes">
        <attribute name="class" remove="o_cc5" add="o_cc1" separator=" "/>
    </xpath>
    <xpath expr="//a" position="attributes">
        <attribute name="class" add="btn-primary btn-lg" remove="btn-secondary" separator=" "/>
    </xpath>
</template>

<template id="configurator_layout_bento_s_call_to_action" inherit_id="website.s_call_to_action" primary="True"/>

<template id="configurator_layout_bento_s_masonry_block" inherit_id="website.s_masonry_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc o_cc2" remove="pt48" separator=" "/>
    </xpath>
</template>

<template id="configurator_layout_bento_s_masonry_block_default_template" inherit_id="website.s_masonry_block_default_template" primary="True">
    <xpath expr="//t" position="attributes">
        <attribute name="t-snippet-call">website.configurator_layout_bento_s_masonry_block</attribute>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[2]" position="attributes">
        <attribute name="class" remove="o_cc2" add="o_cc1" separator=" "/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[5]" position="attributes">
        <attribute name="class" remove="o_cc2" add="o_cc1" separator=" "/>
    </xpath>
</template>


<!-- ════════════════════════════════════════════════════════════
     LAYER 2 — Assembly template (= Clean vibe)
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_bento" name="Configurator Layout: Bento">
    <ConfiguratorHeader data-template="template_header_hamburger" data-color="none" data-bg="transparent" data-shadow="none" data-overlay="true"/>
    <ConfiguratorFooter data-template="template_footer_contact" data-color="2"/>
    <t t-snippet-call="website.configurator_layout_bento_s_bento_hero"/>
    <t t-snippet-call="website.configurator_layout_bento_s_cover"/>
    <t t-snippet-call="website.configurator_layout_bento_s_image_text_overlap"/>
    <t t-snippet-call="website.configurator_layout_bento_s_call_to_action"/>
    <t t-snippet-call="website.configurator_layout_bento_s_masonry_block_default_template"/>
</template>


<!-- ════════════════════════════════════════════════════════════
     DYNAMIC vibe
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_bento_s_bento_hero_dynamic" inherit_id="website.configurator_layout_bento_s_bento_hero" primary="True">
