<template id="configurator_layout_bento_s_bento_hero_gradient" inherit_id="website.configurator_layout_bento_s_bento_hero" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Blurry/04","colors":{"c1":"#ffdf59","c2":"#4db27f","c3":"#d6e9cc"},"flip":[],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Blurry_04"/>
    </xpath>
    <xpath expr="//div[hasclass('o_grid_item')]" position="attributes">
        <attribute name="style" add="background: linear-gradient(45deg, var(--o-color-2), var(--o-color-1))" separator=";"/>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[4]" position="attributes">
