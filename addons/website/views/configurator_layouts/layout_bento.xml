        <attribute name="data-oe-shape-data">{{"shape":"html_builder/Blurry/05","colors":{"c1":"#ffdf59","c2":"#4db27f","c4":"#FFFFFF"},"flip":["y"],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
