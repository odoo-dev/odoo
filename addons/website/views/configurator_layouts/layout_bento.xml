        <attribute name="data-oe-shape-data">{"shape":"html_builder/Bold/14","colors":{"c1":"#ffdf59","c5":"#0a412f"},"flip":[],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Bold_14"/>
    </xpath>
</template>

<template id="configurator_layout_bento_s_cover_dynamic" inherit_id="website.configurator_layout_bento_s_cover" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Bold/14","colors":{"c1":"#ffdf59","c5":"#0a412f"},"flip":["y"],"showOnMobile":true,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Bold_14" style="transform: scaleY(-1)"/>
    </xpath>
</template>

<template id="configurator_layout_bento_s_image_text_overlap_dynamic" inherit_id="website.configurator_layout_bento_s_image_text_overlap" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="pt208 pb208" remove="pt64 pb64" separator=" "/>
        <attribute name="data-oe-shape-data">{"shape":"html_builder/Bold/14","colors":{"c1":"#ffdf59","c5":"#0a412f"},"flip":[],"showOnMobile":false,"shapeAnimationSpeed":"0","selectedColor":false}</attribute>
    </xpath>
    <xpath expr="//div[hasclass('container')]" position="before">
        <div class="o_we_shape o_html_builder_Bold_14"/>
    </xpath>
</template>
<template id="configurator_layout_bento_s_call_to_action_dynamic" inherit_id="website.configurator_layout_bento_s_call_to_action" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc4" remove="o_cc5" separator=" "/>
    </xpath>
</template>

<template id="configurator_layout_bento_vibe_dynamic" name="Configurator Layout: Bento / Dynamic" inherit_id="website.configurator_layout_bento" primary="True">
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_bento_s_bento_hero']" position="replace">
        <t t-snippet-call="website.configurator_layout_bento_s_bento_hero_dynamic"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_bento_s_cover']" position="replace">
        <t t-snippet-call="website.configurator_layout_bento_s_cover_dynamic"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_bento_s_image_text_overlap']" position="replace">
        <t t-snippet-call="website.configurator_layout_bento_s_image_text_overlap_dynamic"/>
    </xpath>
    <xpath expr="//t[@t-snippet-call='website.configurator_layout_bento_s_call_to_action']" position="replace">
        <t t-snippet-call="website.configurator_layout_bento_s_call_to_action_dynamic"/>
    </xpath>
</template>


