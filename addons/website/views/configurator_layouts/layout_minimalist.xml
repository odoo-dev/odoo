<template id="configurator_layout_minimalist" name="Configurator Layout: Minimalist">
    <ConfiguratorHeader data-template="template_header_boxed" data-color="5" data-shadow="none" data-overlay="true"/>
    <ConfiguratorFooter data-template="template_footer_minimalist" data-color="5"/>

    <t t-snippet-call="website.configurator_layout_minimalist_s_title"/>
    <t t-snippet-call="website.configurator_layout_minimalist_s_image_punchy"/>
    <t t-snippet-call="website.configurator_layout_minimalist_s_text_block"/>
    <t t-snippet-call="website.configurator_layout_minimalist_s_nav_minimal"/>
    <t t-snippet-call="website.configurator_layout_minimalist_s_text_block_two"/>
    <t t-snippet-call="website.configurator_layout_minimalist_s_key_images"/>
</template>


