<?xml version="1.0" encoding="UTF-8"?>
<odoo>
<!-- ============================================================
     ConfiguratorHeader / ConfiguratorFooter attributes
     ============================================================
     ConfiguratorHeader:
       data-template    header template xmlid suffix
                        (default template_header_default)
       data-color       color combination 1..5 (default 1)
       data-overlay     "true" places header over content
       data-full-width  "true" makes nav use container-fluid
       data-bg          CSS background (solid OR gradient);
                        hardcoded, takes precedence over data-color
       data-border      CSS border shorthand
                        (e.g. "1px solid #111", or "0" / "none")
       data-shadow      raw CSS box-shadow value (e.g.
                        "0 1rem 3rem rgba(0,0,0,.175)" or "none")
       data-text-color  hardcoded header text color
     ConfiguratorFooter:
       data-template, data-color, data-bg only
       (no overlay / full width / border / shadow / text color:
        there is no site wide SCSS variable for footer
        border or shadow, so they are unsupported by design)

     A vibe template may override these by replacing the
     ConfiguratorHeader / ConfiguratorFooter node via xpath; the
     override is honoured in previews, the generated website and
     the /website/demo/configurator-layouts debug page.
     ============================================================ -->


<!-- ════════════════════════════════════════════════════════════
     LAYER 1 — Per-snippet layout variants (Clean baseline)
     ════════════════════════════════════════════════════════════ -->

<template id="configurator_layout_minimalist_s_title" inherit_id="website.s_title" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="pt144 pb56" remove="pt64 pb40" separator=" "/>
    </xpath>
    <xpath expr="//h2" position="replace">
        <h1 style="text-align: center;" class="display-4">
            <strong>EVERYTHING BEGINS WITH <span style="color: var(--o-color-1)">INTENTION</span></strong>
        </h1>
    </xpath>
</template>

<template id="configurator_layout_minimalist_s_image_punchy" inherit_id="website.s_image_punchy" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="o_cc1" remove="o_cc2 pt64 pb64" separator=" "/>
    </xpath>
    <xpath expr="//div[hasclass('o_grid_mode')]" position="attributes">
        <attribute name="data-row-count">9</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_grid_item')]" position="replace">
        <div class="o_grid_item o_grid_item_image g-col-lg-12 o_colored_level g-height-8 col-lg-12 o_draggable" style="z-index: 1; grid-area: 1 / 1 / 9 / 13;">
            <img src="/web/image/website.s_banner_default_image" class="figure-img img-fluid rounded" alt="" loading="lazy" data-mimetype="image/webp" style=""/>
        </div>
    </xpath>
    <xpath expr="(//div[hasclass('o_grid_item')])[2]" position="replace"/>
</template>

<template id="configurator_layout_minimalist_s_text_block" inherit_id="website.s_text_block" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" remove="pt40" add="pt24" separator=" "/>
    </xpath>
    <xpath expr="//div" position="attributes">
        <attribute name="class" add="o_container_small" remove="container" separator=" "/>
    </xpath>
    <xpath expr="//p" position="replace">
        <p  class="small" style="text-align: center;">
            Great stories have a personality. Consider telling a great story that provides personality. Writing a story with personality for potential clients will assist with making a relationship connection.
        </p>
    </xpath>
    <xpath expr="(//p)[2]" position="replace"/>
</template>

<template id="configurator_layout_minimalist_s_nav_minimal" inherit_id="website.s_nav_minimal" primary="True">
    <xpath expr="//section" position="attributes">
        <attribute name="class" add="pb104" remove="pb24" separator=" "/>
    </xpath>
</template>

