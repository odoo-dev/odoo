<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="account_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n_sg_sale_peppol</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//list[@name='journal_items']/field[@name='product_id']" position="before">
                <field name="l10n_sg_ubl_line_item_ref" string="Order Line Ref" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
