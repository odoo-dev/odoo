<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n_cn_edi_aisino</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_cn_edi.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='l10n_cn_edi_provider']" position="after">
                <setting id="l10n_cn_edi_aisino" string="Aisino Yunshui 爱信诺云税" company_dependent="1"
                    help="Company-specific Aisino credentials (section 7.3 demo style): identity code, platform code and tax-bureau login user.">
                    <div class="content-group">
                        <div class="row" groups="base.group_system">
                            <label for="l10n_cn_edi_aisino_identity_code" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_identity_code" password="True"/>
                        </div>
                        <div class="row" groups="base.group_system">
                            <label for="l10n_cn_edi_aisino_platform_code" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_platform_code"/>
                        </div>
                        <div class="row" groups="base.group_system">
                            <label for="l10n_cn_edi_aisino_region_code" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_region_code"/>
                        </div>
                        <div class="row">
                            <label for="l10n_cn_edi_aisino_gateway" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_gateway"/>
                        </div>
                        <div class="row" groups="base.group_system">
                            <label for="l10n_cn_edi_aisino_username" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_username"/>
                        </div>
                        <div class="row" groups="base.group_system">
                            <label for="l10n_cn_edi_aisino_password" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_password" password="True"/>
                        </div>
                        <div class="row" groups="base.group_system">
                            <label for="l10n_cn_edi_aisino_allow_insecure_sandbox_signature" class="col-lg-4"/>
                            <field name="l10n_cn_edi_aisino_allow_insecure_sandbox_signature"
                                readonly="l10n_cn_edi_aisino_gateway != 'test'"/>
                        </div>
                        <div class="text-warning mt8" groups="base.group_system"
                            invisible="not l10n_cn_edi_aisino_allow_insecure_sandbox_signature">
                            Sandbox-only workaround enabled: production must keep strict response signature verification.
                        </div>
                        <div class="mt16">
                            <button name="action_l10n_cn_edi_aisino_test_connection"
                                type="object"
                                string="Test Connection"
                                class="btn-secondary"
                                icon="network_check"/>
                            <button name="action_l10n_cn_edi_aisino_login"
                                type="object"
                                string="Tax Bureau Login"
                                class="btn-secondary ms-2"
                                icon="qr_code"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
