<templates xml:space="preserve">

<t t-name="html_builder.TextEffectSelectorSvg">
    <svg xmlns="http://www.w3.org/2000/svg" height="18px" width="18px" viewBox="0 0 18 18">
        <text x="12" y="17" text-anchor="middle" font-size="20" font-family="Arial, sans-serif" font-weight="bold" fill="var(--btn-color)" fill-opacity="0.2">A</text>
        <text x="8" y="15" text-anchor="middle" font-size="18" font-family="Arial, sans-serif" font-weight="bold" fill="var(--btn-color)">A</text>
    </svg>
</t>

<t t-name="html_builder.TextEffectOption">
    <div data-prevent-closing-overlay="true" class="o-hb-text-effect-options d-grid gap-2">
        <div class="o-hb-text-effect-presets" role="group" aria-label="Presets">
            <t t-foreach="this.state.presets" t-as="preset" t-key="preset.id">
                <button type="button" class="o-hb-text-effect-preset btn p-0"
                        t-att-class="{ active: this.state.appliedPreset === preset.id, 'o-hb-text-effect-preview-dark': preset.previewBackground === 'dark' }"
                        t-att-title="preset.name" t-att-aria-label="preset.name"
                        t-att-aria-pressed="this.state.appliedPreset === preset.id ? 'true' : 'false'"
                        t-on-click="() => this.onSelectedTextEffect(preset.effectJson)"
                        t-on-mouseenter="() => this.onPreviewTextEffect(preset.effectJson)"
                        t-on-mouseleave="() => this.restoreTextEffectPreview(preset.effectJson)">
                    <i t-if="preset.id === 'no_shadow'" class="oi" data-icon="block"/>
                    <span t-else="" class="o-hb-text-effect-preview-sample" t-att-data-text-effect="preset.effectJson" t-att-style="preset.effectStyle">Aa</span>
                </button>
            </t>
        </div>
        <div class="o-hb-text-effect-section">
            <div class="o-hb-text-effect-caption d-flex align-items-center justify-content-between">
                <span>Shadow<t t-if="(this.domState.shadowIndexes || []).length > 1"> · <t t-out="this.domState.shadowIndexes.length"/></t></span>
                <button type="button" class="o-hb-text-effect-add-shadow btn btn-light" t-on-click="this.onClickAddShadow"
                        title="Add a shadow" aria-label="Add a shadow">
                    <i class="oi oi-fw" data-icon="add"/>
                </button>
            </div>
            <BuilderContext t-if="this.state.hasElement" action="'updateTextEffect'">
                <t t-foreach="this.domState.shadowIndexes || []" t-as="shadowIndex" t-key="shadowIndex">
                    <div class="o-hb-text-effect-shadow d-flex align-items-center gap-1">
                        <BuilderColorPicker actionParam="{ mainParam: 'shadowColor', shadowIndex: shadowIndex }" tooltip.translate="Shadow color" enabledTabs="['custom', 'solid']" selectedTab="'solid'"
                                            colorPickerClassName="''" colorPickerPopoverClassName="''"/>
                        <BuilderNumberInput actionParam="{ mainParam: 'shadowOffsetX', shadowIndex: shadowIndex }" unit="'px'" prefixIcon="'arrow_range'" tooltip.translate="Horizontal offset"/>
                        <BuilderNumberInput actionParam="{ mainParam: 'shadowOffsetY', shadowIndex: shadowIndex }" unit="'px'" prefixIcon="'height'" tooltip.translate="Vertical offset"/>
                        <BuilderNumberInput actionParam="{ mainParam: 'shadowBlur', shadowIndex: shadowIndex }" unit="'px'" min="0" prefixIcon="'blur_on'" tooltip.translate="Blur"/>
                        <button type="button" class="o-hb-text-effect-remove-shadow btn btn-light" t-on-click="() => this.onClickRemoveShadow(shadowIndex)"
                                title="Remove shadow" aria-label="Remove shadow">
                            <i class="oi oi-fw" data-icon="close"/>
                        </button>
                    </div>
                </t>
            </BuilderContext>
            <p t-if="!this.state.hasElement or !(this.domState.shadowIndexes || []).length" class="text-muted mb-0">No shadow. Pick a preset or add one.</p>
        </div>
        <div t-if="this.state.hasElement" class="o-hb-text-effect-section">
            <BuilderContext action="'updateTextEffect'">
                <BuilderRow label.translate="Outline">
                    <BuilderNumberInput actionParam="'outline'" min="0" max="10" unit="'px'" tooltip.translate="Thickness"/>
                    <BuilderColorPicker actionParam="'outlineColor'" tooltip.translate="Outline color" enabledTabs="['custom', 'solid']" selectedTab="'solid'"
                                        colorPickerClassName="''" colorPickerPopoverClassName="''" t-if="this.domState.hasOutline"/>
                </BuilderRow>
            </BuilderContext>
        </div>
    </div>
</t>

</templates>
