<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.AddElementOption">
    <BuilderRow label.translate="Add Elements" level="props.level">
        <BuilderButton
                action="'addElText'"
                preview="false"
                className="'o_we_bg_brand_primary'"
                applyTo="props.applyTo">
            Text
        </BuilderButton>
        <BuilderButton
                action="'addElImage'"
                preview="false"
                className="'o_we_bg_brand_primary'"
                applyTo="props.applyTo">
            Image
        </BuilderButton>
        <BuilderButton
                action="'addElButton'"
                preview="false"
                className="'o_we_bg_brand_primary'"
                applyTo="props.applyTo">
            Button
        </BuilderButton>
    </BuilderRow>
</t>

</templates>
