<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.HeaderNavbarOption">
    <BuilderRow label.translate="Mobile Alignment">
        <BuilderSelect>
            <BuilderSelectItem action="'setMobileAlignment'" actionValue="'left'">Left</BuilderSelectItem>
            <BuilderSelectItem action="'setMobileAlignment'" actionValue="'center'">Center</BuilderSelectItem>
            <BuilderSelectItem action="'setMobileAlignment'" actionValue="'right'">Right</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Font">
        <BuilderSelect>
            <BuilderSelectItem actionValue="'1'">todo font picker</BuilderSelectItem>
            <BuilderSelectItem actionValue="'2'">font 2</BuilderSelectItem>
            <BuilderSelectItem actionValue="'3'">font 3</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Format">
        <BuilderButtonGroup>
            <BuilderNumberInput action="'setIsDirty'" styleAction="'font-size'" unit="'px'" default="16"></BuilderNumberInput>
            <BuilderColorPicker action="'setIsDirty'" applyTo="'.nav-item > .nav-link > *, .nav-item > .nav-link::after, .js_language_selector span, .badge'" styleAction="'color'"/>
            <BuilderSelect applyTo="'#top_menu'">
                <BuilderSelectItem classAction="'me-auto'" ><i class="fa fa-align-left fa-fw"></i></BuilderSelectItem>
                <BuilderSelectItem classAction="''" ><i class="fa fa-align-center fa-fw"></i></BuilderSelectItem>
                <BuilderSelectItem classAction="'ms-auto'" ><i class="fa fa-align-right fa-fw"></i></BuilderSelectItem>
            </BuilderSelect>
        </BuilderButtonGroup>
    </BuilderRow>
    <BuilderRow label.translate="Link Style">
        <BuilderSelect applyTo="'#top_menu'">
            <BuilderSelectItem action="'setLinkStyle'" actionValue="'default'">Default</BuilderSelectItem>
            <BuilderSelectItem action="'setLinkStyle'" actionValue="'fill'">Fill</BuilderSelectItem>
            <BuilderSelectItem action="'setLinkStyle'" actionValue="'outline'">Outline</BuilderSelectItem>
            <BuilderSelectItem action="'setLinkStyle'" actionValue="'pills'">Pills</BuilderSelectItem>
            <BuilderSelectItem action="'setLinkStyle'" actionValue="'block'">Block</BuilderSelectItem>
            <BuilderSelectItem action="'setLinkStyle'" actionValue="'border-bottom'">Border Bottom</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Additional color">
        <BuilderSelect applyTo="'#top_menu'">
            <BuilderSelectItem action="'setAdditionalColor'" actionValue="'default'">Default</BuilderSelectItem>
            <BuilderSelectItem action="'setAdditionalColor'" actionValue="'primary'">Primary</BuilderSelectItem>
            <BuilderSelectItem action="'setAdditionalColor'" actionValue="'secondary'">Secondary</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>
    <BuilderRow label.translate="Sub Menus">
        <BuilderSelect applyTo="'#top_menu'">
            <BuilderSelectItem action="'setSubMenuOpenMode'" actionValue="'on-click'">On Click</BuilderSelectItem>
            <BuilderSelectItem action="'setSubMenuOpenMode'" actionValue="'on-hover'">On Hover</BuilderSelectItem>
        </BuilderSelect>
    </BuilderRow>

</t>

</templates>
