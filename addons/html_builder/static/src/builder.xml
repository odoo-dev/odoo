<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.Builder">
    <div class="h-100 o-snippets-menu d-flex flex-column" t-ref="builder_sidebar">
        <div class="o-snippets-top">
            <div class="o-snippets-top-actions d-flex justify-content-between flex-shrink-0 py-2 pe-2">
                <div class="d-flex">
                    <button type="button" t-on-click="() => this.undo()" class="btn fa fa-undo" t-att-disabled="!state.canUndo"/>
                    <button type="button"  t-on-click="() => this.redo()" class="btn fa fa-repeat" t-att-disabled="!state.canRedo"/>
                </div>
                <div class="d-flex">
                    <div class="d-none mt-2" title="Mysterious Egg">
                            <!-- remove this before merge, otherwise people will see this egg -->
                        <svg width="1.1em" height="1.5em" viewBox="0 0 100 140" xmlns="http://www.w3.org/2000/svg"><ellipse cx="50" cy="80" rx="40" ry="55" fill="#F4E1C6" stroke="#E0C4A8" stroke-width="4"/></svg>
                    </div>
                    <button t-on-click="onMobilePreviewClick" type="button" class="btn ratio ratio-1x1 px-3 fs-3" data-action="mobile" title="Mobile Preview" accesskey="v">
                        <i class="fa fa-mobile translate-middle top-50 start-50 h-auto" role="img"/>
                    </button>
                </div>
                <div class="d-flex gap-1">
                    <button type="button" t-on-click="discard" class="btn" data-action="cancel" title="Tip: Esc to preview" accesskey="j">Discard</button>
                    <button type="button" t-on-click="save" class="btn btn-solid-success" data-action="save" accesskey="s">Save</button>
                </div>
            </div>
            <div class="o-snippets-tabs d-grid gap-1 px-2 mb-1">
                <button data-name="blocks" class="btn btn-success px-0" t-att-class="{'active pe-none': state.activeTab === 'blocks'}" t-on-click="() => this.onTabClick('blocks')" t-att-disabled="props.isTranslation">
                     <i class="oi oi-plus me-1" role="img"/>
                    <span class="text-white">Add</span>
                </button>
                <button data-name="customize" class="btn btn-info px-0" t-att-class="{'active pe-none': state.activeTab === 'customize'}" t-on-click="() => this.onTabClick('customize')">
                    <i class="oi oi-settings-adjust me-1" role="img"/>
                    <span class="text-white">Edit</span>
                </button>
                <button data-name="theme" class="btn btn-global px-0" t-att-class="{'active pe-none': state.activeTab === 'theme'}" t-on-click="() => this.onTabClick('theme')" t-att-disabled="props.isTranslation">
                    <i class="fa fa-cog me-1" role="img"/>
                    <span class="text-white">Theme</span>
                </button>
            </div>
        </div>
        <div class="o-tab-content overflow-y-auto flex-grow-1">
            <t t-if="state.activeTab === 'blocks'">
                <BlockTab />
            </t>
            <t t-if="state.activeTab === 'customize'">
                <CustomizeTab currentOptionsContainers="state.currentOptionsContainers" snippetModel="snippetModel"/>
            </t>
            <t t-if="state.activeTab === 'theme'">
                <ThemeTab/>
            </t>
        </div>
        <InvisibleElementsPanel t-if="state.invisibleEls.length" invisibleEls="state.invisibleEls" invisibleSelector="this.getInvisibleSelector()"/>
    </div>
</t>

</templates>
