<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website_crm_partner_assign.PartnersPageOption">
        <BuilderContext action="'websiteConfig'">
            <BuilderRow label.translate="Show Leads / Opps">
                <BuilderCheckbox actionParam="{views: ['website_crm_partner_assign.portal_my_home_lead']}" />
            </BuilderRow>
            <BuilderRow t-if="google_maps_api_key" label.translate="World Map">
                <BuilderCheckbox actionParam="{views: ['website_crm_partner_assign.ref_country']}" />
            </BuilderRow>
            <BuilderRow label.translate="Address">
                <BuilderCheckbox actionParam="{views: ['website_crm_partner_assign.o_wcrm_partner_address']}" />
            </BuilderRow>
        </BuilderContext>
    </t>

</templates>
