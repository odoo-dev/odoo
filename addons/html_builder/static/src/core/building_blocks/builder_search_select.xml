<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="html_builder.BuilderSearchSelect">
    <BuilderComponent>
        <!-- Render every available item into an invisible node to keep the
        button label resolution working regardless of the current search
        filter, just like BuilderSelect does with its slot. -->
        <div t-custom-ref="root" class="o-hb-select-wrapper">
            <div inert="" class="h-0 w-0 overflow-hidden" t-att-class="this.props.className" t-custom-ref="content">
                <WithIgnoreItem>
                    <t t-foreach="this.allItems" t-as="item" t-key="this.getItemKey(item, item_index)">
                        <BuilderSelectItem t-props="this.getItemProps(item)">
                            <t t-esc="item.label"/>
                        </BuilderSelectItem>
                    </t>
                </WithIgnoreItem>
            </div>
            <Dropdown state="this.dropdown" menuClass="this.props.dropdownClass" onOpened.bind="this.onDropdownOpened">
                <button
                    class="o-hb-select-toggle o-hb-btn btn btn-secondary text-start o-dropdown-caret"
                    t-custom-ref="button"
                    t-att-id="this.props.id"
                    t-att-disabled="this.props.disabled ? 'disabled' : undefined"
                    t-att-aria-disabled="this.props.disabled ? 'true' : undefined"
                    >
                    <t t-call-slot="fixedButton"/>
                </button>
                <t t-set-slot="content">
                    <div t-att-class="this.props.dropdownContainerClass" data-prevent-closing-overlay="true">
                        <div class="o-hb-search-select-search-wrapper p-2">
                            <input
                                type="text"
                                class="o-hb-search-select-search form-control form-control-sm"
                                t-att-placeholder="this.searchPlaceholder"
                                t-att-value="this.state.searchValue"
                                t-on-input="this.onSearchInput"
                                t-on-keydown="this.onSearchKeydown"
                                t-on-pointerdown.stop=""
                                t-on-click.stop=""
                                t-custom-ref="searchInput"
                                autocomplete="off"
                            />
                        </div>
                        <t t-if="this.filteredItems.length">
                            <t t-foreach="this.filteredItems" t-as="item" t-key="this.getItemKey(item, item_index)">
                                <div t-if="this.shouldRenderCategory(this.filteredItems, item_index)"
                                    class="o-hb-select-dropdown-category py-2 ps-2 fst-italic"
                                    t-esc="item.category"/>
                                <BuilderSelectItem t-props="this.getItemProps(item)">
                                    <t t-esc="item.label"/>
                                </BuilderSelectItem>
                            </t>
                        </t>
                        <div t-else="" class="o-hb-search-select-empty text-center py-2 px-3 text-muted"
                            t-esc="this.noResultsLabel"/>
                    </div>
                </t>
            </Dropdown>
        </div>
    </BuilderComponent>
</t>

</templates>
