<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<!-- TODO: support more features from the previous implementation: "callWith", "filterInModel", "filterInField", "nullText" -->

<t t-name="html_builder.DropdownMany2X">
    <Dropdown state="this.dropdown" navigationOptions="{ onEnabled: onNavigationEnabled.bind(this) }">
        <button class="btn btn-primary text-start o-dropdown o-dropdown-caret" style="width: 100%; overflow: hidden; text-overflow: ellipsis;">
            <t t-out="props.message"/>
        </button>
        <t t-set-slot="content">
            <div class="o-navigable">
                <input placeholder="Search for records..." t-on-input="onSearch.bind(this)" t-on-focus="onSearch.bind(this)" t-on-keydown="onKeyDown.bind(this)" t-ref="search"/>
            </div>
            <t t-foreach="this.filteredSearchResult()" t-as="entry" t-key="entry.id">
                <DropdownItem onSelected="() => props.select(entry)">
                    <div t-out="entry.display_name"/>
                </DropdownItem>
            </t>
            <t t-if="state.hasMore">
                <button class="o_we_m2o_search_more o-navigable" title="Search to show more records" t-on-click="searchMore">Search more...</button>
            </t>
            <t t-if="props.create">
                <div class="o_we_m2o_create o-navigable">
                    <input type="text" autocomplete="chrome-off" placeholder="" class="text-start" t-ref="createInput" t-on-input="onCreateInput"/>
                    <button class="btn active" t-att-disabled="!state.createEnabled" t-on-click="() => this.create()">Create</button>
                </div>
            </t>
        </t>
    </Dropdown>
</t>

</templates>
