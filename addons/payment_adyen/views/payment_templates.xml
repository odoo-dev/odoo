<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="checkout" inherit_id="payment.checkout">
        <xpath expr="." position="inside">
            <t t-call="payment_adyen.sdk_assets"/>
        </xpath>
    </template>

    <template id="manage" inherit_id="payment.manage">
        <xpath expr="." position="inside">
            <t t-call="payment_adyen.sdk_assets"/>
        </xpath>
    </template>

    <template id="sdk_assets">
        <script src="https://checkoutshopper-live.adyen.com/checkoutshopper/sdk/6.9.0/adyen.js"
                integrity="sha384-VB3SxkD+sTFJL36cbTToRDKrdvAJWmdf7t42zY4Z7wU9BdqvRjNtAof2qTQjPa/n"
                crossorigin="anonymous">
        </script>
        <link rel="stylesheet"
              href="https://checkoutshopper-live.adyen.com/checkoutshopper/sdk/6.9.0/adyen.css"
              integrity="sha384-Qy8fmdXhmf9H2Pgbmr7b0UkpeSvi7n3RFhpoZXYQPGpKIn9SH+0fT4905fsSA8Am"
              crossorigin="anonymous">
        </link>
    </template>

</odoo>
