<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- views -->

    <record id="action_attendance_validate" model="ir.actions.server">
        <field name="name">Approve</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">records.action_validate()</field>
        <field name="group_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>

    <record id="action_attendance_refuse" model="ir.actions.server">
        <field name="name">Refuse</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">records.action_refuse()</field>
        <field name="group_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>

    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">hr.attendance.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list
                js_class="attendance_list_view"
                class="o_attendance_list"
                string="Employee attendances"
                decoration-info="state == 'draft'"
                decoration-muted="state == 'refused'"
                decoration-it="time_rule_id"
                duplicate="false">
                <header>
                    <button name="%(hr_attendance.action_attendance_validate)d" type="action" string="Approve"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                    <button name="%(hr_attendance.action_attendance_refuse)d" type="action" string="Refuse"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                </header>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="check_in" decoration-danger="is_late_check_in or in_mode == 'manual'" decoration-bf="in_mode == 'manual'"/>
                <field name="check_out" options="{}" decoration-danger="is_early_check_out or out_mode in ('manual', 'auto_check_out')" decoration-bf="out_mode == 'manual'"/>
                <field name="break_duration" widget="float_time" optional="show"/>
                <field name="worked_hours" string="Hours" widget="float_time" decoration-warning="has_overtime" sum="Total Hours"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'refused'"
                       optional="show"/>
                <field name="in_mode" string="Input Mode (In)" optional="hidden"/>
                <field name="out_mode" string="Input Mode (Out)" optional="hidden"/>
                <field name="in_location" string="Location (In)" optional="hidden"/>
                <field name="out_location" string="Location (Out)" optional="hidden"/>
                <field name="create_uid" optional="hidden"/>
                <field name="write_uid" optional="hidden"/>
                <field name="write_date" optional="hidden"/>
                <field name="has_overtime" column_invisible="1"/>
                <field name="is_late_check_in" column_invisible="1"/>
                <field name="is_early_check_out" column_invisible="1"/>
                <field name="time_rule_id" column_invisible="1"/>
                <field name="source_stale" column_invisible="1"/>
                <button name="action_mark_reviewed" type="object"
                        icon="warning"
                        title="Source changed — click to mark as reviewed"
                        class="text-warning p-0"
                        invisible="not source_stale or not time_rule_id"
                        groups="hr_attendance.group_hr_attendance_officer"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_kanban" model="ir.ui.view">
        <field name="name">hr.attendance.kanban</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="check_out"/>
                <field name="source_stale"/>
                <field name="time_rule_id"/>
                <field name="in_mode"/>
                <field name="out_mode"/>
                <field name="is_late_check_in"/>
                <field name="is_early_check_out"/>
                <field name="has_overtime"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                            <field name="employee_id" widget="many2one_avatar_employee" options="{'display_avatar_name': True}" class="fs-5 fw-bold text-truncate"
                                   invisible="context.get('my_attendances')"/>
                            <field name="state" widget="badge" class="ms-auto" invisible="state == 'validated'"
                                   decoration-info="state == 'draft'"
                                   decoration-muted="state == 'refused'"/>
                        </div>
                        <t t-set="check_out" t-value="record.check_out.raw_value"/>
                        <div class="d-flex align-items-center gap-1">
                            <span class="px-1 rounded"
                                  t-att-class="{
                                      'bg-danger-subtle text-danger': record.is_late_check_in.raw_value or record.in_mode.raw_value === 'manual',
                                      'fw-bold': record.in_mode.raw_value === 'manual',
                                  }">
                                <field name="check_in"/>
                            </span>
                            <span>-</span>
                            <span t-if="check_out" class="px-1 rounded"
                                  t-att-class="{
                                      'bg-danger-subtle text-danger': record.is_early_check_out.raw_value or ['manual', 'auto_check_out'].includes(record.out_mode.raw_value),
                                      'fw-bold': record.out_mode.raw_value === 'manual',
                                  }">
                                <t t-set="same_day" t-value="check_out.slice(0, 10) === record.check_in.raw_value.slice(0, 10)"/>
                                <t t-if="same_day" t-out="record.check_out.value.split(', ').pop()"/>
                                <field t-if="!same_day" name="check_out"/>
                            </span>
                            <span t-else="" class="text-muted">In progress</span>
                            <span t-if="check_out" class="ms-auto px-1 rounded fw-bold"
                                  t-att-class="{'o_attendance_overtime': record.has_overtime.raw_value}">
                                <field name="worked_hours" widget="float_time"/>
                            </span>
                        </div>
                        <div t-if="record.source_stale.raw_value and record.time_rule_id.raw_value"
                             class="text-warning small mt-1">
                            <i class="oi me-1" data-icon="warning" role="img" aria-label="Warning" title="Warning"/>Source changed
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form</field>
        <field name="model">hr.attendance</field>
        <field name="priority">0</field>
        <field name="arch" type="xml">
            <form string="Employee attendances" duplicate="false">
                <header>
                    <button name="action_validate" string="Validate" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="state != 'draft'"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'refused'"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,refused"
                           options="{'clickable': '1'}" readonly="0"
                           groups="hr_attendance.group_hr_attendance_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated"
                           groups="!hr_attendance.group_hr_attendance_officer"/>
                </header>
                <sheet>
                    <!-- invisible fields needed for the stale-source warning -->
                    <field name="source_stale" invisible="1"/> <!-- drives invisible of the stale source warning below -->
                    <field name="source_attendance_id" invisible="1"/> <!-- drives invisible of the deleted/modified wording of the stale source warning -->
                    <field name="time_rule_id" invisible="1"/> <!-- drives invisible of the stale source warning below -->
                    <div class="alert alert-warning mb-3 d-flex align-items-center gap-3" role="alert"
                         invisible="not source_stale or not time_rule_id">
                        <div class="flex-grow-1">
                            <i class="oi me-1" data-icon="warning" role="img" aria-label="Warning" title="Warning"/>
                            <strong invisible="source_attendance_id">Source attendance deleted -</strong>
                            <strong invisible="not source_attendance_id">Source attendance modified -</strong>
                            this record may be outdated and should be reviewed.
                        </div>
                        <button name="action_mark_reviewed" type="object"
                                icon="check" title="Mark as Reviewed"
                                class="btn btn-success btn-sm"
                                groups="hr_attendance.group_hr_attendance_officer"/>
                    </div>
                    <group>
                        <group colspan="2">
                            <group col="1" name="group_employee">
                                <field
                                    id="employee_no_officer"
                                    name="employee_id"
                                    widget="many2one_avatar_employee"
                                    readonly="1"
                                    groups="!hr_attendance.group_hr_attendance_officer"/>
                                <field
                                    id="employee_no_manager"
                                    name="employee_id"
                                    widget="many2one_avatar_employee"
                                    domain="[
                                        ('attendance_manager_id', '=', uid),
                                        ('company_id', 'in', allowed_company_ids),
                                    ]"
                                    groups="hr_attendance.group_hr_attendance_officer,!hr_attendance.group_hr_attendance_user"/>
                                <field
                                    id="employee_manager"
                                    name="employee_id"
                                    widget="many2one_avatar_employee"
                                    domain="[
                                        ('company_id', 'in', allowed_company_ids),
                                    ]"
                                    groups="hr_attendance.group_hr_attendance_user"/>
                                <field name="check_in" string="Check In/Out"
                                    widget="daterange"
                                    options="{'end_date_field': 'check_out', 'always_range': True, 'rounding': 0}"
                                    readonly="not can_edit"/>
                                <field name="check_out" options="{'rounding': 0}" invisible="1" readonly="not can_edit"/> <!-- end datetime of the check_in daterange widget and drives invisible of the Check Out log section -->
                                <field name="resource_calendar_id" groups="hr_attendance.group_hr_attendance_manager"/>
                            </group>
                            <group col="2" name="group_worked_hours">
                                <field name="worked_hours" string="Worked Time" widget="float_time" groups="hr_attendance.group_hr_attendance_manager"/>
                                <field name="work_entry_type_id" widget="many2one_work_entry_type" groups="hr_attendance.group_hr_attendance_manager"/>
                                <field name="break_duration" widget="float_time" readonly="not can_edit"/>
                            </group>
                        </group>
                        <notebook groups="base.group_no_one">
                            <page string="Logs" name="logs" groups="hr_attendance.group_hr_attendance_manager"> 
                                <group name="logs_group">
                                    <group name="check_in_group" string="Check In">
                                        <field name="in_mode" string="Mode"/>
                                        <field name="in_ip_address" string="IP Address" invisible="not in_ip_address"/>
                                        <field name="in_browser" string="Browser" invisible="not in_browser"/>
                                        <field name="in_location" string="Location" invisible="not in_location"/>
                                        <label for="in_latitude" string="GPS Coordinates" invisible="not in_latitude and not in_longitude"/>
                                        <div invisible="not in_latitude and not in_longitude">
                                            <div class="o_row">
                                                <span>
                                                    <field name="in_latitude"/>
                                                </span>,
                                                <span>
                                                    <field name="in_longitude" nolabel="1"/>
                                                </span>
                                            </div>
                                            <button
                                                name="action_in_attendance_maps"
                                                type="object"
                                                class="btn btn-link ps-0 pt-0 pb-2"
                                                icon="east"
                                                string="View on Maps"/>
                                        </div>
                                    </group>
                                    <group name="check_out_group" string="Check Out" invisible="not check_out">
                                        <field name="out_mode" string="Mode"/>
                                        <field name="out_ip_address" string="IP Address" invisible="not out_ip_address"/>
                                        <field name="out_browser" string="Browser" invisible="not out_browser"/>
                                        <field name="out_location" string="Location" invisible="not out_location"/>
                                        <label for="out_latitude" string="GPS Coordinates" invisible="not out_latitude and not out_longitude"/>
                                        <div invisible="not out_latitude and not out_longitude">
                                            <div class="o_row">
                                                <span>
                                                    <field name="out_latitude"/>
                                                </span>,
                                                <span>
                                                    <field name="out_longitude" nolabel="1"/>
                                                </span>
                                            </div>
                                            <button
                                                name="action_out_attendance_maps"
                                                type="object"
                                                class="btn btn-link ps-0 pt-0 pb-2"
                                                icon="east"
                                                string="View on Maps"/>
                                        </div>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_attendance_create_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.create.form</field>
        <field name="model">hr.attendance</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <group name="check_in_group" position="attributes">
                <attribute name="invisible">True</attribute>
            </group>
            <group name="check_out_group" position="attributes">
                <attribute name="invisible">True</attribute>
            </group>
            <notebook position="attributes">
                <attribute name="invisible">True</attribute>
            </notebook>
            <form position="inside">
                <footer>
                    <button
                        string="Save &amp; Close"
                        special="save"
                        data-hotkey="s"
                        class="btn btn-primary"
                        close="1"
                        invisible="not can_edit"/>
                    <button
                        special="cancel"
                        data-hotkey="j"
                        class="btn-secondary"
                        close="1"/>
                    <button
                        string="Delete"
                        name="unlink"
                        type="object"
                        data-hotkey="x"
                        class="btn btn-danger ms-auto"
                        close="1"
                        invisible="not id or not is_manager"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_attendance_my_form_view" model="ir.ui.view">
        <field name="name">hr.attendance.my.form</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance_view_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Attendance</attribute>
            </xpath>
            <xpath expr="//field[@id='employee_no_officer']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@id='employee_no_manager']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@id='employee_manager']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_my_calendar_view" model="ir.ui.view">
        <field name="name">hr.attendance.my.calendar</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <calendar string="My Attendances"
                js_class="attendance_calendar_view"
                date_start="check_in"
                date_stop="check_out"
                mode="week"
                quick_create="0"
                event_open_popup="true"
                show_unusual_days="True"
                color="color"
                form_view_id="%(hr_attendance.hr_attendance_my_form_view)d">
                <field name="color" invisible="1"/>
                <field name="work_entry_type_id" filters="1" groups="hr_attendance.group_hr_attendance_manager"/>
                <field name="worked_hours" widget="float_time"/>
                <field name="break_duration" widget="float_time"/>
                <field name="source_stale" invisible="1"/>
                <field name="source_attendance_id" invisible="1"/>
                <popover>
                    <field name="source_stale"/>
                    <field name="source_attendance_id"/>
                    <templates>
                        <t t-name="popover-body" class="gap-3">
                            <div class="alert alert-warning py-1 px-2 mb-0 small" role="status" invisible="not source_stale">
                                <i class="oi oi-fw me-1" data-icon="warning" role="img"
                                   aria-label="Warning" title="Warning"/>
                                <span invisible="source_attendance_id">Source deleted</span>
                                <span invisible="not source_attendance_id">Source modified</span>
                            </div>
                            <div class="d-flex align-items-baseline gap-2" invisible="not work_entry_type_id" groups="hr_attendance.group_hr_attendance_manager">
                                <i class="oi oi-fw text-400" data-icon="label" aria-hidden="true" title="Time Type"/>
                                <field name="work_entry_type_id" widget="many2one_work_entry_type"/>
                            </div>
                            <div class="d-flex align-items-baseline gap-2" invisible="not worked_hours">
                                <i class="oi oi-fw text-400" data-icon="schedule" aria-hidden="true" title="Worked Hours"/>
                                <field name="worked_hours" widget="float_time"/>
                            </div>
                            <div class="d-flex align-items-baseline gap-2" invisible="not break_duration">
                                <i class="oi oi-fw text-400" data-icon="pause_circle" aria-hidden="true" title="Break Duration"/>
                                <field name="break_duration" widget="float_time"/>
                            </div>
                        </t>
                    </templates>
                </popover>
            </calendar>
        </field>
    </record>

    <record id="hr_attendance_view_calendar" model="ir.ui.view">
        <field name="name">hr.attendance.calendar</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance_my_calendar_view"/>
        <field name="mode">primary</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="string">Attendances</attribute>
                <attribute name="form_view_id"></attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_attendance_view_graph" model="ir.ui.view">
        <field name="name">hr.attendance.graph</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <graph string="Worked Hours" type="line" stacked="0" sample="1">
                <field name="employee_id" type="row"/>
                <field name="check_in" interval="day" type="col"/>
                <field name="worked_hours" type="measure" widget="float_time"/>
            </graph>
        </field>
    </record>

    <record id="hr_attendance_view_pivot" model="ir.ui.view">
        <field name="name">hr.attendance.pivot</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <pivot string="Worked Hours">
                <field name="employee_id" type="row"/>
                <field name="check_in" type="col" interval="month"/>
                <field name="worked_hours" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="hr_attendance_view_filter" model="ir.ui.view">
        <field name="name">hr_attendance_view_filter</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search string="Hr Attendance Search">
                <field name="employee_id"/>
                <field name="department_id" operator="child_of"/>
                <field name="check_in"/>
                <filter string="My Attendances" name="myattendances" domain="[('employee_id.user_id', '=', uid)]" />
                <filter string="My Team" name="myteam" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="To Review" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Reviewed" name="state_validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Refused" name="state_refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="At Work" name="nocheckout" domain="[('check_out', '=', False)]" />
                <filter string="Forgot Check-Out" name="auto_check"
                        domain="[('out_mode', '=', 'auto_check_out')]"/>
                <filter string="Late Clock In" name="late_check_in" domain="[('is_late_check_in', '=', True)]"/>
                <filter string="Early Clock Out" name="early_check_out" domain="[('is_early_check_out', '=', True)]"/>
                <filter string="Overtime" name="overtime" domain="[('has_overtime', '=', True)]"/>
                <separator/>
                <filter string="Date" name="check_in_filter" date="check_in"/>
                <field name="resource_calendar_id"/>
                <separator invisible="1"/>
                <filter string="Last 3 Months" invisible="1" name="last_three_months" domain="[('check_in','&gt;=', '-3m')]"/>
                <group>
                    <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="department" context="{'group_by': 'department_id'}"/>
                    <filter string="Manager" name="manager" context="{'group_by': 'manager_id'}"/>
                    <filter string="Method" name="groupby_mode_in" context="{'group_by': 'in_mode'}"/>
                    <filter string="Date" name="groupby_month" context="{'group_by': 'check_in:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- actions -->

    <record id="action_try_kiosk" model="ir.actions.server">
        <field name="name">Try kiosk</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">action = model.action_try_kiosk()</field>
    </record>

    <record id="action_load_demo_data" model="ir.actions.server">
        <field name="name">Load demo data</field>
        <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
        <field name="state">code</field>
        <field name="code">action = model._load_demo_data()</field>
    </record>

    <record id="hr_attendance_action" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="path">attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="group_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_own')), (4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="context">
            {
                "search_default_groupby_month": 1,
                "attendance_welcome_help": 1,
            }
        </field>
        <field name="search_view_id" ref="hr_attendance_view_filter"/>
        <field name="help" type="html">
            <p>
                The attendances of your employees will be displayed here.
            </p>
        </field>
    </record>

    <record id="hr_attendance_my_action" model="ir.actions.act_window">
        <field name="name">My Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,kanban,calendar,form,pivot,graph</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_attendance_tree')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_hr_attendance_kanban')}),
            (0, 0, {'view_mode': 'calendar', 'view_id': ref('hr_attendance_my_calendar_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('hr_attendance_my_form_view')}),
        ]"/>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="search_view_id" ref="hr_attendance_view_filter"/>
        <field name="context">{"search_default_groupby_week": 1, "my_attendances": 1}</field>
    </record>

    <record id="hr_attendance_reporting" model="ir.actions.act_window">
        <field name="name">Attendances</field>
        <field name="res_model">hr.attendance</field>
        <field name="path">attendance-report</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="hr_attendance_view_filter"/>
        <field name="context">
            {
                "search_default_employee": 2,
                "search_default_last_three_months": 1
            }
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No attendance records found
            </p><p>
                The attendance reporting of your employees will be displayed here.
            </p>
        </field>
    </record>

    <record id="hr_attendance_management_view_filter" model="ir.ui.view">
        <field name="name">hr_attendance_management_view_filter</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id" operator="child_of"/>
                <filter string="My Attendances" name="myattendances" domain="[('employee_id.user_id', '=', uid)]" />
                <filter string="My Team" name="myteam" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="To Review" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Reviewed" name="state_validated" domain="[('state', '=', 'validated')]"/>
                <filter string="Refused" name="state_refused" domain="[('state', '=', 'refused')]"/>
                <separator/>
                <filter string="At Work" name="nocheckout" domain="[('check_out', '=', False)]"/>
                <filter string="Forgot Check-Out" name="auto_check" domain="[('out_mode', '=', 'auto_check_out')]"/>
                <filter string="Late Clock In" name="late_check_in" domain="[('is_late_check_in', '=', True)]"/>
                <filter string="Early Clock Out" name="early_check_out" domain="[('is_early_check_out', '=', True)]"/>
                <filter string="Overtime" name="overtime" domain="[('has_overtime', '=', True)]"/>
                <separator/>
                <filter string="Date" name="check_in_filter" date="check_in"/>
                <group>
                    <filter string="Employee" name="employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'check_in'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_attendance_tree_management" model="ir.ui.view">
        <field name="name">hr.attendance.list</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <list js_class="attendance_list_view" class="o_attendance_list" string="Employee attendances" create="0">
                <header>
                    <button name="%(hr_attendance.action_attendance_validate)d" type="action" string="Approve"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                    <button name="%(hr_attendance.action_attendance_refuse)d" type="action" string="Refuse"
                            groups="hr_attendance.group_hr_attendance_officer"/>
                </header>
                <field name="employee_id" widget="many2one_avatar_employee" readonly="1"/>
                <field name="check_in" readonly="1" decoration-danger="is_late_check_in or in_mode == 'manual'" decoration-bf="in_mode == 'manual'"/>
                <field name="check_out" readonly="1" decoration-danger="is_early_check_out or out_mode in ('manual', 'auto_check_out')" decoration-bf="out_mode == 'manual'"/>
                <field name="break_duration" readonly="1" widget="float_time"/>
                <field name="worked_hours" readonly="1" string="Worked Time" widget="float_time" decoration-warning="has_overtime"/>
                <field name="has_overtime" column_invisible="1"/>
                <field name="in_mode" column_invisible="1"/>
                <field name="is_late_check_in" column_invisible="1"/>
                <field name="is_early_check_out" column_invisible="1"/>
                <field name="out_mode" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'validated'"
                       decoration-info="state == 'draft'"
                       decoration-muted="state == 'refused'"
                       readonly="1"/>
                <button name="action_validate" string="Validate" type="object"
                        icon="check"
                        invisible="state != 'draft'"
                        groups="hr_attendance.group_hr_attendance_officer"/>
                <button name="action_refuse" string="Refuse" type="object"
                        icon="close"
                        invisible="state not in ('draft', 'validated')"
                        groups="hr_attendance.group_hr_attendance_officer"/>
                <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        icon="undo"
                        invisible="state != 'refused'"
                        groups="hr_attendance.group_hr_attendance_officer"/>
            </list>
        </field>
    </record>

    <record id="hr_attendance_management_action" model="ir.actions.act_window">
        <field name="name">To Review</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="search_view_id" ref="hr_attendance_management_view_filter"/>
        <field name="view_id" ref="view_attendance_tree_management"/>
        <field name="context">
            {
                "search_default_state_draft": 1,
            }
        </field>
        <field name="help" type="html">
            <p>
                No attendance to review: you're all set!
            </p>
        </field>
    </record>

    <record id="hr_attendance_action_greeting_message" model="ir.actions.client">
        <field name="name">Message</field>
        <field name="tag">hr_attendance_greeting_message</field>
    </record>

    <record model="ir.actions.server" id="open_kiosk_url">
        <field name="name">Open Kiosk Url</field>
        <field name="model_id" ref="hr_attendance.model_res_company"/>
        <field name="path">attendance-kiosk</field>
        <field name="binding_model_id" ref="hr_attendance.model_res_company"/>
        <field name="state">code</field>
        <field name="code">
            action = model._action_open_kiosk_mode()
        </field>
        <field name="group_ids" eval="[(4, ref('hr_attendance.group_hr_attendance_user'))]"/>
    </record>

    <record id="action_open_attendance_systray" model="ir.actions.client">
        <field name="name">Attendances</field>
        <field name="tag">hr_attendance.open_systray</field>
    </record>

    <!-- Menus -->

    <menuitem id="menu_hr_attendance_root" name="Attendances" sequence="200" action="action_open_attendance_systray" groups="hr_attendance.group_hr_attendance_own,hr_attendance.group_hr_attendance_officer" web_icon="hr_attendance,static/description/icon.png"/>

    <menuitem
        id="menu_hr_attendance_reporting"
        name="Reporting"
        parent="menu_hr_attendance_root"
        sequence="15"
        groups="hr_attendance.group_hr_attendance_officer"/>

    <menuitem
        id="menu_hr_attendance_attendance_reporting"
        name="Attendances"
        action="hr_attendance_reporting"
        parent="menu_hr_attendance_reporting"
        sequence="10"/>

    <menuitem id="menu_hr_attendance_view_dashboard" name="Overview" action="hr_attendance_action" parent="menu_hr_attendance_root" sequence="1" groups="hr_attendance.group_hr_attendance_user"/>

    <menuitem id="menu_hr_attendance_management_list" name="To Review" action="hr_attendance_management_action" parent="menu_hr_attendance_root" sequence="2" groups="hr_attendance.group_hr_attendance_user"/>

    <menuitem id="menu_hr_attendance_configuration" name="Configuration" parent="menu_hr_attendance_root" sequence="99" groups="hr_attendance.group_hr_attendance_officer"/>

    <menuitem id="menu_hr_attendance_config" name="Config" parent="menu_hr_attendance_configuration" sequence="10"/>

    <menuitem id="menu_hr_attendance_kiosk" name="Kiosk" parent="menu_hr_attendance_configuration" sequence="20"/>

    <menuitem id="menu_hr_attendance_onboarding" name="Onboarding" action="action_try_kiosk" parent="menu_hr_attendance_kiosk" sequence="10" groups="base.group_no_one"/>

    <menuitem id="menu_action_open_form" name="Open Kiosk" action="open_kiosk_url" parent="menu_hr_attendance_kiosk" sequence="20" groups="hr_attendance.group_hr_attendance_user"/>

    <menuitem
        id="menu_hr_attendance_work_entry_type"
        name="Time Types"
        parent="menu_hr_attendance_config"
        action="hr_work_entry.hr_work_entry_type_action"
