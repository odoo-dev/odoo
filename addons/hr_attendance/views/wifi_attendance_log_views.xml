    <record id="action_wifi_attendance_log" model="ir.actions.act_window">
        <field name="name">Wi-Fi Connection Logs</field>
        <field name="res_model">wifi.attendance.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>
