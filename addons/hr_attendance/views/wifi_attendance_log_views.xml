<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wifi_attendance_log_list" model="ir.ui.view">
        <field name="name">wifi.attendance.log.list</field>
        <field name="model">wifi.attendance.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="event_time"/>
                <field name="employee_id"/>
                <field name="mac_address"/>
                <field name="event_type"/>
                <field name="ip_address"/>
                <field name="ssid"/>
                <field name="state" decoration-danger="state == 'error'"
                       decoration-muted="state == 'ignored'"
                       decoration-success="state == 'processed'"/>
            </list>
        </field>
    </record>

    <record id="view_wifi_attendance_log_form" model="ir.ui.view">
        <field name="name">wifi.attendance.log.form</field>
        <field name="model">wifi.attendance.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="event_time"/>
                            <field name="event_type"/>
                            <field name="employee_id"/>
                            <field name="device_id"/>
                            <field name="attendance_id"/>
                        </group>
                        <group>
                            <field name="mac_address"/>
                            <field name="ip_address"/>
                            <field name="hostname"/>
                            <field name="ssid"/>
                            <field name="access_point"/>
                            <field name="state"/>
                            <field name="error_message" invisible="state != 'error'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Raw Payload">
                            <field name="raw_payload" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

