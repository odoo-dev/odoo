<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale_unicommerce</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <xpath expr="//form/app[@name='sale_management']/block[@id='connectors_setting_container']" position="inside">
                <setting id="unicommerce_connector" help="Enable syncing Unicommerce orders, inventory, and deliveries with Odoo.">
                    <field name="module_sale_unicommerce" widget="upgrade_boolean" class="text-end"/>
                    <div class="content-group" name="unicommerce_connector" invisible="not module_sale_unicommerce">
                        <div class="mt16">
                            <button
                                string="Link My Account"
                                type="action"
                                name="%(sale_unicommerce.link_account_action)d"
                                icon="fa-arrow-right"
                                class="btn-link mt8"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
