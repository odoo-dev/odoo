<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sync Sales Orders -->
        <record id="ir_cron_unicommerce_sync_sales_orders" model="ir.cron">
            <field name="name">Unicommerce: Sync Sales Orders</field>
            <field name="model_id" ref="model_unicommerce_account"/>
            <field name="state">code</field>
            <field name="code">model.search([]).filtered(lambda acc: acc.state == 'connected').action_sync_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Sync Product Catalog -->
        <record id="ir_cron_unicommerce_sync_catalog" model="ir.cron">
            <field name="name">Unicommerce: Sync Catalog</field>
            <field name="model_id" ref="model_unicommerce_account"/>
            <field name="state">code</field>
            <field name="code">model.search([]).filtered(lambda acc: acc.state == 'connected').action_sync_products()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Sync Inventory -->
        <record id="ir_cron_unicommerce_sync_inventory" model="ir.cron">
            <field name="name">Unicommerce: Sync Inventory</field>
            <field name="model_id" ref="model_unicommerce_account"/>
            <field name="state">code</field>
            <field name="code">model.search([]).filtered(lambda acc: acc.state == 'connected').action_update_inventory()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
