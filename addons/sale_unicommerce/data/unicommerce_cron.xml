<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_refresh_access_token" model="ir.cron">
            <field name="name">Unicommerce: Refresh Access Token</field>
            <field name="model_id" ref="model_unicommerce_account"/>
            <field name="state">code</field>
            <field name="code">model.refresh_access_token()</field>
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">30</field>
            <field name="interval_type">days</field>
            <field name="priority">6</field>
        </record>
    </data>
</odoo>
