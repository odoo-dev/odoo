<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<!-- Products Search Bar autocomplete item -->
<we-button t-name="website_sale.ribbonSelectItem" t-att-data-set-ribbon="this.ribbon.id">
    <t t-out="this.ribbon.name"/>
    <span class="oi ms-1" t-attf-data-icon="#{this.isLeft ? 'arrow_back' : 'arrow_forward'}"></span>
    <span
        t-attf-class="o_wsale_color_preview ms-1"
        t-attf-style="background-color: #{this.ribbon.bg_color}"
    />
    <span
        t-attf-class="o_wsale_color_preview ms-1"
        t-attf-style="background-color: #{this.textColor} !important;"
    />
</we-button>

</templates>
