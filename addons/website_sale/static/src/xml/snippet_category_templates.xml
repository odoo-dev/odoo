<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="website_sale.dynamic_filter_template_categories">
        <t t-foreach="data" t-as="category" t-key="category.id">
            <div
                class="category_item rounded position-relative bg-black overflow-hidden oe_unremovable oe_unmovable"
                t-att-data-category-id="category.id"
                t-attf-style="grid-row: span {{size}};"
                contenteditable="false"
                role="article"
            >
                <t t-set="ribbon" t-value="get_ribbon(category['website_ribbon_id'])"/>
                <t t-set="bg_color" t-value="ribbon['bg_color'] || ''"/>
                <t t-set="bg_class" t-value="`o_${ribbon['style']} o_${ribbon['position']}`"/>
                <img
                    loading="lazy"
                    t-attf-src="/web/image/product.public.category/{{category.id}}/image_1920"
                    alt="Category Image"
                    class="s_category_image img-fluid position-absolute w-100 h-100 object-fit-cover"
                />
                <div t-attf-class="s_category_overlay p-3 bg-black-25 position-relative w-100 h-100 d-flex flex-column justify-content-between {{alignmentClass}}">
                    <h3 class="h4 text-light" t-out="category.name"/>
                    <a
                        role="button"
                        t-attf-href="/shop/category/{{category.id}}"
                        class="btn btn-primary align-self-start oe_unremovable"
                        t-out="buttonText"
                    />
                </div>
                <span
                    t-att-data-category-id="category.id"
                    t-attf-class="o_ribbons #{bg_class} z-3"
                    t-attf-style="#{'color: ' + ribbon['text_color']};#{'background-color: ' + bg_color}"
                    t-out="ribbon['name'] or ''"
                    t-att-data-ribbon-id="ribbon['id']"
                    t-att-data-record-id="category.id"
                    data-record-model="product.public.category"
                />
            </div>
        </t>
    </t>
</templates>
