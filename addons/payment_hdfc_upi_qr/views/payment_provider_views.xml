<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_hdfc_upi" model="ir.ui.view">
        <field name="name">HDFC UPI Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'hdfc_upi'">
                    <field name="hdfc_upi_merchant_id"
                           string="Merchant ID"
                           required="code == 'hdfc_upi' and state != 'disabled'"/>
                    <field name="hdfc_upi_merchant_name"
                           string="Merchant Name"
                           required="code == 'hdfc_upi' and state != 'disabled'"/>
                    <field name="hdfc_upi_merchant_category"
                           string="Merchant Category"
                           required="code == 'hdfc_upi' and state != 'disabled'"/>
                    <field name="hdfc_upi_encryption_key"
                           string="Encryption Key"
                           required="code == 'hdfc_upi' and state != 'disabled'"
                           password="True"/>
                </group>
            </group>
            <group name="provider_credentials" position="after">
                <div class="alert alert-warning"
                     role="alert"
                     invisible="code != 'hdfc_upi'">
                    <strong>Note:</strong> The UPI Id used here is the one set in the Company form
                    (Settings &gt; Companies &gt; Your Indian Company &gt; UPI Id).
                </div>
            </group>
        </field>
    </record>

</odoo>
