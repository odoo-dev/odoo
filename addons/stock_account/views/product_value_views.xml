<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_value_form_view" model="ir.ui.view">
        <field name="name">product.value.form.view</field>
        <field name="model">product.value</field>
        <field name="arch" type="xml">
            <form string="Adjust Valuation">
                <sheet>
                <field name="move_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1" force_save="1"/>
                <group>
                    <group>
                        <label for="current_value" class="oe_inline"/>
                        <div class="oe_inline">
                            <field name="current_value" style="width: 100px;" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                            <span><field name="current_value_details" class="oe_inline me-5"/></span>
                        </div>
                        <field name="value" string="New Value" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                        <field name="description"/>
                    </group>
                    <group>
                        <field class="alert alert-info" role="alert" name="current_value_description" nolabel="1" colspan="2"/>
                        <field class="alert alert-info" role="alert" name="computed_value_description" nolabel="1" colspan="2" invisible="not computed_value_description"/>
                    </group>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="product_value_list_view">
        <field name="name">product.value.list.view</field>
        <field name="model">product.value</field>
        <field name="arch" type="xml">
            <!-- ? editable="top" multi_edit="1" ? pas de create/edit/delete pour l'instant -->
            <list default_order="id, date desc" create="0" edit="0" delete="0">
                <field name="company_id" readonly="1" force_save="1"/>
                <field name="date"/>
                <field name="description"/>
                <field name="product_id" readonly="id"/>
                <field name="lot_id" readonly="id" required="tracking in ('serial', 'lot')" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}" optional="hide" groups="stock.group_production_lot" />
                <!-- <field name="move_id" column_invisible="1"/> -->
                <field name="move_id" readonly="1" />
                <field name="quantity" readonly="1"/>
                <field name="old_value" readonly="1"/> <!-- a retirer apres-->
                <field name="value"/> <!-- readonly="move_id" ? -->
                <field name="original_value" readonly="1"/>
                <field name="new_value" readonly="1"/>
                <field name="adjustment" readonly="1"/>
                <field name="account_move_id" readonly="1"/>
                <field name="user_id" string="Done By"/>
            </list>
        </field>
    </record>

    <record id="product_value_action" model="ir.actions.act_window">
        <field name="name">Adjust Valuation</field>
        <field name="res_model">product.value</field>
        <field name="view_mode">form</field>
    </record>

    <record id="product_value_list_action" model="ir.actions.act_window">
        <field name="name">Valuation Adjustments</field>
        <field name="res_model">product.value</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem action="product_value_list_action" id="valuation_adjustments_menu" name="Valuation Adjustments" parent="stock.menu_warehouse_report" sequence="300"/>

</odoo>
