<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_adjust_valuation_view_form" model="ir.ui.view">
        <field name="name">stock.adjust.valuation.view.form</field>
        <field name="model">stock.adjust.valuation</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Adjust Valuation">
                <sheet>
                <field name="move_ids" invisible="1"/>
                <group>
                    <group>
                        <field name="current_value"/>
                        <field name="new_value"/>
                        <field name="new_value_by_unit"/>
                        <field name="description"/>
                    </group>
                    <group>
                        <field name="quantity"/>
                    </group>
                </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="stock_adjust_valuation_action" model="ir.actions.act_window">
        <field name="name">Adjust Valuation</field>
        <field name="res_model">stock.adjust.valuation</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
