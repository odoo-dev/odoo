<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="report_printer_view" model="ir.ui.view">
            <field name="name">report.printer.form</field>
            <field name="model">report.printer</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="printer_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="printer_email" invisible="printer_type != 'email'" required="printer_type == 'email'" placeholder="test@epson.com"/>
                        <field name="printer_ip" invisible="printer_type != 'ip'" required="printer_type == 'ip'" placeholder="192.168.1.2"/>
                    </group>
                </form>
            </field>
        </record>

        <record id="report_printer_list_view" model="ir.ui.view">
            <field name="name">report.printer.list</field>
            <field name="model">report.printer</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="printer_type"/>
                    <field name="printer_email" placeholder="test@epson.com"/>
                    <field name="printer_ip" placeholder="192.168.1.2"/>
                </list>
            </field>
        </record>

    </data>
</odoo>
