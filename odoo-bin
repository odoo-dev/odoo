def my_set_level(self: logging.Logger, level):
    please_filters = list(filter(lambda filter: isinstance(filter, PleaseShowImportantLogsDearGodoo), self.filters))
    if not please_filters:
        if self.name in ('', 'root'):
            self.addFilter(PleaseShowImportantLogsDearGodoo(level, self))
        else:
            raise RuntimeError('Could not find any custom filter, is there a problem with the init of the logger ?')
    if len(please_filters) > 1:
        raise RuntimeError('Found way too many filters !')
    if please_filters:
        please_filters[0].min_log_level = level
    origin_logger_set_level(self, min(info_level, level))


def my_logger_init(self: logging.Logger, name, level=logging.NOTSET):
    origin_logger_init(self, name, level)
    if level:
        self.addFilter(PleaseShowImportantLogsDearGodoo(level, self))
    else:
        i_logger = self
        while True:
            if i_logger.filters:
                please_filters = list(filter(lambda filter: isinstance(filter, PleaseShowImportantLogsDearGodoo), i_logger.filters))
                if please_filters:
                    if len(please_filters) == 1:
                        self.please_filter = PleaseShowImportantLogsDearGodoo(please_filters[0].min_log_level, self)
                        self.addFilter(self.please_filter)
                        break
                    raise RuntimeError('Found way too many filters !')
            if not i_logger.parent or i_logger.parent == i_logger:
                target_level = i_logger.parent.level if not level and i_logger.parent else level
                self.please_filter = PleaseShowImportantLogsDearGodoo(target_level, self)
                self.addFilter(self.please_filter)
                break
            i_logger = i_logger.parent

    origin_logger_set_level(self, min(level, info_level))


# logging.getLogger = my_get_logger
logging.Logger.setLevel = my_set_level
logging.Logger.__init__ = my_logger_init


import odoo.cli


