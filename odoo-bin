#!/usr/bin/env python3

import logging

origin_logger_get_logger = logging.getLogger
origin_logger_set_level = logging.Logger.setLevel
origin_logger_init = logging.Logger.__init__


class PleaseShowImportantLogsDearGodoo(logging.Filter):
    def __init__(self, min_log_level, logger):
        super().__init__()
        self.min_log_level = min_log_level
        levels = ('INFO', 'WARNING', 'ERROR', 'CRITICAL')
        self.level_by_name = {name: getattr(logging, name, logging.INFO) for name in levels}
        self.logger = logger

    def filter(self, record):        # %(asctime)s %(process)s %(levelname)s %(dbname)s %(name)s: %(message)s %(perf_info)s
        if record.name == 'odoo.modules.loading':
            print(f'{record.process} {record.levelname} {record.dbname} {record.name}: {record.msg} {record.perf_info}')
        return ((record.levelname not in self.level_by_name or self.level_by_name[record.levelname] >= self.min_log_level)
            or record.name in ('odoo.service.server', 'odoo.tests.stats', 'odoo.tests.result')
            or (record.name == 'odoo.modules.loading' and record.message.find('modules loaded in') != -1)
            or (record.name == 'odoo.modules.loading' and record.message.find('Loading module') != -1))


info_level = getattr(logging, 'INFO', logging.INFO)


